# American Fit — variables públicas (se hornean en el build, van al navegador).
# Copia este archivo a .env y completa lo que uses. Nada aquí es secreto.

# Cloudflare Stream: código de cliente (customer-XXXX) para reproducir
# videos/directos guardados como "cf:<id>" en src/data/media.ts.
VITE_CLOUDFLARE_STREAM_CODE=

# Supabase (cuentas en la nube, historial sincronizado y pagos).
# Sin estas dos variables la app usa cuentas en el dispositivo y pagos en modo de prueba.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Soporte: muestra los botones de WhatsApp y correo en el panel de ayuda.
# WhatsApp con indicativo de país, solo números (ej. 573001234567).
VITE_SUPPORT_WHATSAPP=
VITE_SUPPORT_EMAIL=
