# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# --- Supabase (login/registro) -------------------------------------------
# Project Settings -> API in your Supabase project. The anon key is safe
# to expose in the client bundle — access is controlled by the Row Level
# Security policies in supabase/schema.sql, not by keeping this secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Login con Google: no lleva variables acá — se activa en el dashboard de
# Supabase (Authentication -> Providers -> Google). Ver SETUP.md sección 1.

# Server-only. Project Settings -> API -> "service_role". Se salta las
# políticas RLS a propósito: solo la usa el servidor para registrar pagos
# (webhook de Stripe) y mandar push. NUNCA con prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (pagos) --------------------------------------------------------
# Server-only — never prefix these with VITE_ or they would end up in the
# public client bundle.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DIAGNOSTICO_MADUREZ=
STRIPE_PRICE_ANALISIS_MERCADO=
# Optional: a recurring price here turns the plan into a subscription
# automatically (the server reads the price type and picks the mode).
STRIPE_PRICE_ACOMPANAMIENTO=
# Pack of 50 extra Marco Polo research lookups (Kalodata / Sicex).
STRIPE_PRICE_CREDITOS_MARCO_POLO=

# Base URL Stripe redirects back to after checkout (your deployed domain).
PUBLIC_APP_URL=http://localhost:3000

# --- Calendario (opcional) --------------------------------------------------
# Tu URL de Calendly o Cal.com. Si la dejas vacía, el botón "Agenda 20
# minutos" simplemente hace scroll al formulario de contacto.
VITE_CALENDLY_URL=

# --- Tracking / Ads (opcional pero muy recomendado si corres ads) ----------
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
VITE_GA_MEASUREMENT_ID=

# --- Chatbot con IA real (opcional) -----------------------------------------
# Server-only. Sin esto, el chatbot sigue funcionando con respuestas
# basadas en reglas (client/src/lib/chatbotKnowledge.ts) — esto solo lo
# mejora para preguntas abiertas. Consigue tu key en console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Marco Polo: voz premium (opcional) ------------------------------------
# Sin esto Marco Polo habla con la voz del navegador (gratis, ya funciona).
# Con una cuenta de elevenlabs.io suena a locutor: creá o elegí una voz en
# español y copiá su Voice ID. Server-only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Monitoreo de errores y eventos de seguridad (opcional) -----------------
# sentry.io -> crear proyecto Node (servidor) y React (cliente). Sin esto,
# todo sigue yendo a los logs del hosting.
SENTRY_DSN=
VITE_SENTRY_DSN=

# --- Backups (solo para el script pnpm backup:db, no lo usa la app) ---------
# Supabase -> Project Settings -> Database -> Connection string. NUNCA en el
# hosting ni en el repo: solo en tu máquina o en el runner que hace backups.
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# --- Inteligencia de mercado (pendiente) -------------------------------------
# Server-only. Reservadas para cuando tengamos acceso a las APIs; el panel
# de Integraciones del dashboard las muestra como "no conectado" hasta
# entonces.
# Marco Polo's research desk. BOTH the key and the endpoint are needed
# for a source to be usable; with only one of them the app says "not
# connected" instead of showing anything invented.
# AUTH_STYLE: bearer (default) | header | query. AUTH_NAME is the header
# or query parameter name when the style is not bearer.
KALODATA_API_KEY=
KALODATA_API_URL=
KALODATA_AUTH_STYLE=
KALODATA_AUTH_NAME=
SICEX_API_KEY=
SICEX_API_URL=
SICEX_AUTH_STYLE=
SICEX_AUTH_NAME=

# --- Notificaciones push reales (opcional) ----------------------------------
# Sin esto, las notificaciones siguen funcionando dentro de la app (la
# campanita) pero no llegan si la pestaña/app está cerrada. Ver SETUP.md
# sección 6 para los pasos completos (generar claves + webhook de Supabase).
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@easycomex.com
# (SUPABASE_SERVICE_ROLE_KEY de arriba también se usa acá.)
# Un secreto random tuyo (ej. `openssl rand -hex 32`) para que solo tu
# proyecto de Supabase pueda llamar a /api/push/notify.
PUSH_WEBHOOK_SECRET=
