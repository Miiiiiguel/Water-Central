# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# --- Supabase (login/registro) -------------------------------------------
# Project Settings -> API in your Supabase project. The anon key is safe
# to expose in the client bundle — access is controlled by the Row Level
# Security policies in supabase/schema.sql, not by keeping this secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Login con Google: no lleva variables acá — se activa en el dashboard de
# Supabase (Authentication -> Providers -> Google). Ver SETUP.md sección 1.

# Server-only. Project Settings -> API -> "service_role". Se salta las
# políticas RLS a propósito: solo la usa el servidor para registrar pagos
# (webhook de Stripe) y mandar push. NUNCA con prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (pagos) --------------------------------------------------------
# Server-only — never prefix these with VITE_ or they would end up in the
# public client bundle.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# (El diagnóstico de madurez se cobra con Wompi, ver abajo; este price
# solo aplica si algún día quieres venderlo también por Stripe.)
STRIPE_PRICE_DIAGNOSTICO_MADUREZ=
STRIPE_PRICE_ANALISIS_MERCADO=
# Optional: a recurring price here turns the plan into a subscription
# automatically (the server reads the price type and picks the mode).
STRIPE_PRICE_ACOMPANAMIENTO=
# Pack of 50 extra Marco Polo research lookups (Kalodata / Sicex).
STRIPE_PRICE_CREDITOS_MARCO_POLO=
# Reportes de la calculadora ROI (USD 39.90 y USD 99.90 de lanzamiento).
STRIPE_PRICE_REPORTE_DETALLE=
STRIPE_PRICE_REPORTE_PRONOSTICO=

# --- Wompi (Colombia) — diagnóstico de madurez ------------------------------
# comercios.wompi.co -> Desarrolladores. La pública va al navegador (es
# pública por diseño); las otras tres son server-only, NUNCA con VITE_.
#   WOMPI_INTEGRITY_SECRET  firma lo que el widget puede cobrar.
#   WOMPI_EVENTS_SECRET     firma el webhook. En el panel de Wompi va UNA
#                           sola URL de eventos:
#                           https://tu-dominio.com/api/wompi-events
#   WOMPI_PRIVATE_KEY       para leer la transacción de vuelta al confirmar.
# WOMPI_ENV=sandbox mientras pruebas con llaves pub_test_/prv_test_.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_ENV=sandbox
# Precio del plan de acción. Wompi cobra en pesos: un solo monto en
# centavos COP (3990000 = $39.900) y el texto que ve un comprador de
# fuera de Colombia.
DIAGNOSTIC_PRICE_COP_CENTS=3990000
DIAGNOSTIC_PRICE_USD_DISPLAY=9.99

# Precios del resto del catalogo (server/catalog.ts). Todo se cobra en
# pesos; el dolar es solo la etiqueta para quien no esta en Colombia.
# USD_COP_RATE convierte los precios publicados en dolares a pesos:
# en 4000, USD 9.99 da exactamente los $39.900 que dice la web.
USD_COP_RATE=4000
# Y si quieres un precio en pesos redondo, fijalo aca, EN PESOS, y manda
# sobre la conversion:
# PRICE_ANALISIS_MERCADO_COP=2000000
# PRICE_CREDITOS_MARCO_POLO_COP=76000
# PRICE_REPORTE_DETALLE_COP=159600
# PRICE_REPORTE_PRONOSTICO_COP=399600

# Base URL Stripe redirects back to after checkout (your deployed domain).
PUBLIC_APP_URL=http://localhost:3000
# Solo para compilar la app nativa (iOS/Android): el servidor al que llama.
# Vacío = https://easycomex.onrender.com. Debe ser https.
VITE_API_URL=

# --- Calendario (opcional) --------------------------------------------------
# Tu URL de Calendly o Cal.com. Si la dejas vacía, el botón "Agenda 20
# minutos" simplemente hace scroll al formulario de contacto.
VITE_CALENDLY_URL=

# --- Tracking / Ads (opcional pero muy recomendado si corres ads) ----------
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
VITE_GA_MEASUREMENT_ID=

# --- Chatbot con IA real (opcional) -----------------------------------------
# Server-only. Sin esto, el chatbot sigue funcionando con respuestas
# basadas en reglas (client/src/lib/chatbotKnowledge.ts) — esto solo lo
# mejora para preguntas abiertas. Consigue tu key en console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Lectura de etiquetas (/analizar). Usa la misma llave de arriba; sólo el
# modelo es distinto, porque leer letra chica sobre tela arrugada pide
# más capacidad que contestar el chat.
ANTHROPIC_OCR_MODEL=claude-sonnet-5

# Partidas sugeridas al terminar de analizar una etiqueta (SETUP §2d).
# API de código armonizado de FedEx: las dos llaves del proyecto en
# developer.fedex.com. Sin ellas la etiqueta se analiza igual, sin
# partidas. Nada de lo que devuelvan se muestra si no existe en el
# arancel cargado.
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
# Vacío = sandbox. Sólo `production`, escrito así, apunta a producción.
FEDEX_ENV=

# --- Correo saliente (Resend) ------------------------------------------
# Sin esto la app no manda ningún correo y dos cosas se rompen en
# silencio: quien paga el plan de acción no recibe el enlace para volver
# a entrar (la referencia sólo vive en su navegador), y un lead que entra
# de madrugada se queda esperando a que alguien abra el dashboard.
# resend.com -> API Keys. Hay que verificar el dominio allá.
RESEND_API_KEY=
# Remitente verificado: "Easycomex <hola@easycomex.com>"
EMAIL_FROM=
# A dónde le llegan los avisos de lead al equipo.
TEAM_EMAIL=

# --- Marco Polo: voz premium (opcional) ------------------------------------
# Sin esto Marco Polo habla con la voz del navegador (gratis, ya funciona).
# Con una cuenta de elevenlabs.io suena a locutor: creá o elegí una voz en
# español y copiá su Voice ID. Server-only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Monitoreo de errores y eventos de seguridad (opcional) -----------------
# sentry.io -> crear proyecto Node (servidor) y React (cliente). Sin esto,
# todo sigue yendo a los logs del hosting.
SENTRY_DSN=
VITE_SENTRY_DSN=

# --- Backups (solo para el script pnpm backup:db, no lo usa la app) ---------
# Supabase -> Project Settings -> Database -> Connection string. NUNCA en el
# hosting ni en el repo: solo en tu máquina o en el runner que hace backups.
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# --- Inteligencia de mercado (pendiente) -------------------------------------
# Server-only. Reservadas para cuando tengamos acceso a las APIs; el panel
# de Integraciones del dashboard las muestra como "no conectado" hasta
# entonces.
# Marco Polo's research desk. BOTH the key and the endpoint are needed
# for a source to be usable; with only one of them the app says "not
# connected" instead of showing anything invented.
# AUTH_STYLE: bearer (default) | header | query. AUTH_NAME is the header
# or query parameter name when the style is not bearer.
# La llave se genera en el Centro Abierto de Kalodata (Cuenta -> Gestión
# de claves de API). OJO: generar una nueva invalida la anterior al
# instante, y la clave no se vuelve a mostrar.
#
# El endpoint y la forma de la peticion ya viven en server/kalodata.ts
# (POST + JSON, llave en el encabezado `secret-key`). Con la llave basta.
#
# ¿Dudas de que el encabezado sea ese? Pon la llave acá y corre
#   pnpm kalodata:check
# Usa los parametros fijos de depuracion que Kalodata publica, prueba los
# nombres de encabezado habituales y PARA en cuanto uno funciona: una
# llamada que pasa gasta creditos (1 credito ~ 0.1 USD).
KALODATA_API_KEY=
# Vacio salvo que cambien de dominio. Va la BASE, no un endpoint completo.
KALODATA_API_URL=
# Solo si algun dia renombran el encabezado; por defecto es `secret-key`.
KALODATA_AUTH_NAME=
# Sicex entrega los datos como una carpeta de Azure Data Lake con un SAS
# de solo lectura — el mismo endpoint que documentan para PowerBI, Tableau
# y Python. Es UNA sola variable, la URL completa con su token:
#   https://<cuenta>.dfs.core.windows.net/<filesystem>/<carpeta>?sv=...&sig=...
# Es una credencial viva y con fecha de vencimiento: va acá, nunca en el repo.
SICEX_SAS_URL=
# Las de abajo solo aplican si algún día Sicex expone una API HTTP directa.
SICEX_API_KEY=
SICEX_API_URL=
SICEX_AUTH_STYLE=
SICEX_AUTH_NAME=

# --- Notificaciones push reales (opcional) ----------------------------------
# Sin esto, las notificaciones siguen funcionando dentro de la app (la
# campanita) pero no llegan si la pestaña/app está cerrada. Ver SETUP.md
# sección 6 para los pasos completos (generar claves + webhook de Supabase).
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@easycomex.com
# (SUPABASE_SERVICE_ROLE_KEY de arriba también se usa acá.)
# Un secreto random tuyo (ej. `openssl rand -hex 32`) para que solo tu
# proyecto de Supabase pueda llamar a /api/push/notify.
PUSH_WEBHOOK_SECRET=
