                                  <div class="promotion-container">
                                    <a
                                      {% if block_st.promotion_link_2 == blank %}
                                        role="link" aria-disabled="true"
                                      {% else %}
                                        href="{{ block_st.promotion_link_2 }}"
                                      {% endif %}
                                      {% if block_st.promotion_link_newtab_2 != blank %}
                                        target="_blank"
                                      {% endif %}
