<script>
  const menuTitle = document.querySelector('.menu-mobile-title');
  if (menuTitle) {
    menuTitle.querySelectorAll('.tab-link').forEach(tab => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        menuTitle.querySelectorAll('.tab-link').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const menu = tab.dataset.menu;
        document.querySelector('.horizontal-list').classList.remove('active-menu');
        const categoriesList = document.querySelector('.categories-list');
        if (categoriesList) {
          categoriesList.classList.remove('active-menu');
        }
        document.querySelector(`.${menu}`).classList.add('active-menu');
      });
    });
  }
</script>

