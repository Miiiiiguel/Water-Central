                                        type: banner,
                                        container: section_width,
                                        image: block_st.promotion_image_1,
                                        image_alt: banner_alt,
                                        colunm: colunm,
                                        colunm_mobile: colunm_mobile,
                                        padding: 20,
                                        sizes: '(min-width: 1200px) 450px, 360px',
                                        class: 'rounded'
                                      %}
                                    </a>

