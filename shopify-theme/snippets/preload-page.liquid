{% liquid
  assign enable_preload = settings.enable_preload
  assign preload_page = settings.preload_page
  assign preload_custom_image = settings.preload_custom_image
  assign preloader_size = settings.preloader_size | default: 60
  assign preloader_duration = settings.preloader_duration | default: 0.8
%}

{% if enable_preload %}
<preload-page
  class="preload-page"
  aria-hidden="true"
  style="
    position: fixed;
    inset: 0;
    height: 100dvh;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-background, #fff);
    opacity: 1;
    transition: opacity 0.5s ease;
  "
>
  {% if preload_custom_image != blank %}
    <div style="width: {{ preloader_size }}px; height: {{ preloader_size }}px;">
      <img
        src="{{ preload_custom_image | img_url: '200x' }}"
        alt="Loading"
        width="{{ preloader_size }}"
        height="{{ preloader_size }}"
        style="width:100%;height:100%;object-fit:contain;"
        fetchpriority="high"
      >
    </div>
  {% else %}
    {%- comment -%}
      CSS-only loaders — no external GIFs, no network dependency.
      Each variant is a self-contained CSS animation.
    {%- endcomment -%}
    {% case preload_page %}
      {% when 'dot' %}
        <div class="sudafin-loader sudafin-loader--dots" style="--sz: {{ preloader_size }}px;">
          <span></span><span></span><span></span>
        </div>
      {% when 'spin' %}
        <div class="sudafin-loader sudafin-loader--ring" style="--sz: {{ preloader_size }}px;"></div>
      {% when 'ripple' %}
        <div class="sudafin-loader sudafin-loader--ripple" style="--sz: {{ preloader_size }}px;"></div>
      {% when 'wave_path', 'double_line_spin' %}
        <div class="sudafin-loader sudafin-loader--wave" style="--sz: {{ preloader_size }}px;">
          <span></span><span></span><span></span><span></span><span></span>
        </div>
      {% else %}
        <div class="sudafin-loader sudafin-loader--ring" style="--sz: {{ preloader_size }}px;"></div>
    {% endcase %}
  {% endif %}
</preload-page>

<style>
  /* ── Shared base ─────────────────────────────────────────── */
  .sudafin-loader {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(var(--sz) * 0.15);
  }

  /* ── Spinning ring ───────────────────────────────────────── */
  .sudafin-loader--ring {
    width: var(--sz);
    height: var(--sz);
    border-radius: 50%;
    border: calc(var(--sz) * 0.08) solid var(--color-border, #e5e5e5);
    border-top-color: var(--color-primary, #d4af37);
    animation: sudafin-spin 0.8s linear infinite;
  }
  @keyframes sudafin-spin {
    to { transform: rotate(360deg); }
  }

  /* ── Bouncing dots ───────────────────────────────────────── */
  .sudafin-loader--dots span {
    display: block;
    width: calc(var(--sz) * 0.22);
    height: calc(var(--sz) * 0.22);
    border-radius: 50%;
    background: var(--color-primary, #d4af37);
    animation: sudafin-bounce 1.2s ease-in-out infinite;
  }
  .sudafin-loader--dots span:nth-child(2) { animation-delay: 0.2s; }
  .sudafin-loader--dots span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes sudafin-bounce {
    0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
    40%            { transform: scale(1);   opacity: 1;   }
  }

  /* ── Ripple ──────────────────────────────────────────────── */
  .sudafin-loader--ripple {
    position: relative;
    width: var(--sz);
    height: var(--sz);
  }
  .sudafin-loader--ripple::before,
  .sudafin-loader--ripple::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: calc(var(--sz) * 0.06) solid var(--color-primary, #d4af37);
    animation: sudafin-ripple 1.5s ease-out infinite;
  }
  .sudafin-loader--ripple::after { animation-delay: 0.75s; }
  @keyframes sudafin-ripple {
    0%   { transform: scale(0.2); opacity: 1; }
    100% { transform: scale(1);   opacity: 0; }
  }

  /* ── Wave bars ───────────────────────────────────────────── */
  .sudafin-loader--wave span {
    display: block;
    width: calc(var(--sz) * 0.1);
    height: calc(var(--sz) * 0.5);
    background: var(--color-primary, #d4af37);
    border-radius: 3px;
    animation: sudafin-wave 1s ease-in-out infinite;
  }
  .sudafin-loader--wave span:nth-child(2) { animation-delay: 0.1s; }
  .sudafin-loader--wave span:nth-child(3) { animation-delay: 0.2s; }
  .sudafin-loader--wave span:nth-child(4) { animation-delay: 0.3s; }
  .sudafin-loader--wave span:nth-child(5) { animation-delay: 0.4s; }
  @keyframes sudafin-wave {
    0%, 100% { transform: scaleY(0.4); }
    50%       { transform: scaleY(1);   }
  }
</style>

<script>
  (function () {
    var removeDelay = {{ preloader_duration | times: 1000 }};
    function removeLoader() {
      var preload = document.querySelector('.preload-page');
      if (!preload) return;
      preload.style.opacity = '0';
      setTimeout(function () { preload.remove(); }, 600);
    }
    // Remove on load, or after timeout + 500ms safety margin
    window.addEventListener('load', removeLoader);
    setTimeout(removeLoader, removeDelay + 500);
  })();
</script>
{% endif %}
