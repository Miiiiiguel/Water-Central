<style>
  /* Base Styles */
  .search__input.field__input.flex-1.max-w-custom.hidden.block-md {
    --input-padding: 0.7rem;
    --input-height: 3rem;
    --max-width: 500px;
    border: solid 1px #dbdbdb;
  }
  .search-results-list.grid.grid-cols.gap-15.gap-lg-20 {
    {% if search_type == 'default' or search_type == 'popup' %}
      --col-number: 1;
      --col-tablet: 1;
      --col-desktop-small: 3;
      --col-desktop: 5;
    {% endif %}
  }
  /* Search Popup and Content Styles */
  .content-search-form,
  .quick-search {
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }
  .search-suggest.search-list-item {
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }
  /* Trending Search Pills */
  .quick-url {
    background-color: var(--trending-pill-bg-color) !important;
    color: var(--trending-pill-text-color) !important;
    border-radius: var(--trending-pill-border-radius) !important;
    padding: 8px 20px;
    border: none;
    display: inline-block;
    transition: all 0.3s ease-in-out;
    text-decoration: none;
  }
  .quick-url:hover {
    background-color: var(--trending-pill-hover-bg-color) !important;
    border: none;
    transition: all 0.3s ease-in-out;
  }
  /* Input Container */
  .container-input {
    position: relative;
    transform: translateX(44%);
  }
  .container-input svg.search-icon {
    position: absolute;
    top: 50%;
    right: 45px;
    transform: translateY(-50%);
    pointer-events: none;
    z-index: 10;
    fill: #000000;
  }
  .container-input svg {
    position: absolute;
    top: 50%;
    padding-right: 100px;
    opacity: 1;
    transform: translateX(-50px) scale(1);
    cursor: pointer;
    pointer-events: none;
    z-index: 9999;
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease-in-out, fill 0.3s ease-in-out;
  }
  .container-input:hover svg {
    fill: #000;
    transform: translateY(-50%) scale(1.1);
  }
  /* Form Styles */
  .form {
    --timing: 0.3s;
    --width-of-input: 200px;
    --height-of-input: 20px;
    --border-height: 2px;
    --border-radius: 30px;
    position: relative;
    width: 100%;
    height: 20px;
    display: flex;
    align-items: center;
    padding-inline: 0.8em;
    border-radius: var(--border-radius);
    transition: border-radius 0.5s ease;
    background: transparent;
    gap: 10px !important;
  }
  .form button {
    border: none;
    background: none;
    color: #8b8ba7;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .reset {
    border: none;
    background: none;
    opacity: 0;
    display: none;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    cursor: pointer;
  }
  .input:not(:placeholder-shown) ~ .reset {
    opacity: 0;
    display: none;
    padding-right: 100px;
    visibility: visible;
  }
  .form svg {
    position: relative;
    padding-top: 1.8px;
    right: -67px;
    pointer-events: auto;
    z-index: 10;
  }
  .search-modal__content {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .search__input {
    padding: 0;
    margin: 0;
  }
  /* Close Button Styles */
  .close-modal {
    position: absolute;
    top: 10px;
    right: 10px;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 20;
  }
  .close-modal svg {
    width: 24px;
    height: 24px;
    fill: #000;
    transition: transform 0.3s ease;
  }
  .close-modal:hover svg {
    transform: scale(1.1);
  }
  /* Popup Search Modal - Common Styles */
  .popup-search.popup-search-form {
    position: absolute;
    left: 0;
    width: 100%;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  /* Initially hidden: opacity 0, moved slightly up */
  .popup-search.popup-search-form.invisible {
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
  }
  /* Visible state */
  .popup-search.popup-search-form:not(.invisible) {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  /* Mobile Styles */
  @media (max-width: 768px) {
    .header_search .block-quick-search.search-type-default.me-md-10 {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
    }
    .quick-search .quick-search-title {
      color: var(--color-heading) !important;
    }
    .block-search-full.search-layout-form {
      display: none !important;
    }
    .content-search-form {
      background-color: transparent !important;
    }
    .dropdown-toggle.mobile-search-toggle {
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      margin-right: 10px;
    }
    .top-search-toggle svg {
      width: 20px;
      height: 20px;
    }
    .cart-icon {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .popup-search.popup-search-form {
      top: 0 !important;
      left: 0 !important;
      width: 100% !important;
      height: 100vh !important;
      border-top: none !important;
      padding: 20px !important;
    }
  }
  /* Desktop Styles */
  @media (min-width: 769px) {
    .dropdown-toggle.mobile-search-toggle {
      display: none !important;
    }
    .form svg {
      position: relative;
      padding-top: -1.8px;
      right: -67px;
    }
    .header_search .block-quick-search.search-type-default.me-md-10 {
      display: flex;
      justify-content: flex-end;
      padding-right: 5px;
      align-items: center;
      gap: 20px;
    }
    .block-search-full.search-layout-form {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 1;
    }
    .search-modal.search-full {
      width: auto;
      max-width: none;
    }
    .form {
      margin-left: 10px;
      z-index: 2;
    }
    .header_search {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .block-search-full.search-layout-form {
      flex: 1;
    }
    .form button svg {
      width: 20px;
      height: 20px;
    }
    /* Position popup modal directly beneath the header search area */
    .popup-search.popup-search-form {
      top: 100%;
      height: auto;
      padding: 20px 0;
      border-top: none;
    }
  }
</style>

{%- capture content_for_query_string -%}
  {{ content_for_header }}
{%- endcapture -%}

{%- assign page_url = content_for_query_string
  | split: '"pageurl":"'
  | last
  | split: '"'
  | first
  | split: request.host
  | last
  | replace: '\/', '/'
  | replace: '%20', ' '
  | replace: '\u0026', '&'
-%}

{%- assign page_query_string = page_url | split: '?' | last -%}

{%- liquid
  assign theme_st = settings
  assign search_type = theme_st.search_type
  assign show_search_price = theme_st.show_search_price
  assign popular_key_word = theme_st.popular_key_word
  assign search_terms = search.terms
  assign key_terms = search_terms
  assign enable_search_suggestion = theme_st.enable_search_suggestion
  assign collection_suggestion = theme_st.collection_suggestion
  assign search_result = theme_st.search_result

  if search_terms contains 'product_type:'
    assign arr_terms = search_terms | remove: 'product_type:' | split: ' AND '
    assign product_type = arr_terms[0] | strip
    assign search_terms = arr_terms[1] | strip
    if search_terms == blank
      assign key_terms = key_terms | remove: ' AND '
      assign search_terms = product_type
    endif
  endif

  if page_query_string contains 'ajax=1' and page_query_string contains 'type=default'
    assign search_type = 'default'
  elsif page_query_string contains 'ajax=1' and page_query_string contains 'type=popup'
    assign search_type = 'popup'
  endif
-%}

{% if search_type == 'default' or search_type == 'popup' %}
  {{ 'search-type-default.css' | asset_url | stylesheet_tag }}
{% endif %}

<header-search class="header_search search_type_{{ search_type }}">
  <div class="block block-quick-search block-search predictive_search_suggest search_{{ search_type }}{% if search_type == 'default' %} search-type-default me-md-10{% endif %}">
    {%- if search_type == 'default' -%}
      <!-- Desktop Search Form -->
      <div class="block-search-full search-layout-form">
        <div class="search-modal search-full">
          <div class="search-modal__content">
            <!-- Replaced Search Form Start -->
            <form
              action="{{ routes.search_url }}"
              id="search_mini_form"
              method="get"
              role="search"
              class="form search search-modal__form"
            >
              <input type="hidden" name="type" value="product">
              <!-- Search Input Container -->
              <div class="container-input">
                <input
                  class="input search__input field__input flex-1 max-w-custom"
                  placeholder="{{ 'Search...' }}"
                  required
                  type="search"
                  name="q"
                  id="search-template"
                  value="{{ search.terms | escape }}"
                  maxlength="128"
                  role="combobox"
                  aria-expanded="false"
                  aria-owns="predictive-search-results"
                  aria-controls="predictive-search-results"
                  aria-haspopup="listbox"
                  aria-autocomplete="list"
                  autocorrect="off"
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"
                >
                <label class="field__label visually-hidden" for="search-template">
                  {{ 'Search...' }}
                </label>
              </div>
              <!-- Search Button (Moved to Right) -->
              <button
                aria-label="{{ 'general.search.search' | t }}"
                class="header-icon header-color w-44 h-44 inline-flex content-center hover:header-hover-color"
                style="transform: translateY(0px);"
              >
                <svg
                  width="22"
                  height="22"
                  fill="currentColor"
                  version="1.1"
                  id="Capa_1"
                  xmlns="http://www.w3.org/2000/svg"
                  xmlns:xlink="http://www.w3.org/1999/xlink"
                  viewBox="-14.65 -14.65 517.70 517.70"
                  stroke="currentColor"
                  stroke-width="5.3724"
                  transform="rotate(0)"
                  aria-labelledby="search"
                  class="header-color transition-all duration-300 ease-in-out"
                >
                  <title id="search">Search</title>
                  <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                  <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor" stroke-width="0.9768"></g>
                  <g id="SVGRepo_iconCarrier">
                    <g>
                      <g>
                        <path d="M0,203.25c0,112.1,91.2,203.2,203.2,203.2c51.6,0,98.8-19.4,134.7-51.2l129.5,129.5c2.4,2.4,5.5,3.6,8.7,3.6
                          s6.3-1.2,8.7-3.6c4.8-4.8,4.8-12.5,0-17.3l-129.6-129.5c31.8-35.9,51.2-83,51.2-134.7c0-112.1-91.2-203.2-203.2-203.2
                          S0,91.15,0,203.25z M381.9,203.25c0,98.5-80.2,178.7-178.7,178.7s-178.7-80.2-178.7-178.7s80.2-178.7,178.7-178.7
                          S381.9,104.65,381.9,203.25z"></path>
                      </g>
                    </g>
                  </g>
                </svg>
              </button>
              <input type="hidden" name="options[unavailable_products]" value="last">
              <input type="hidden" name="options[prefix]" value="last">
              <input type="hidden" name="options[fields]" value="title,vendor,product_type,variants.title">
              <input type="hidden" name="type" value="{{ search_result }}">
              <!-- Reset Button -->
              <button class="reset" type="reset" aria-label="Clear search">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-6 w-6"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </button>
              <!-- Loading Icon -->
              <span class="loading-icon absolute inline-flex align-center inset-y-0 invisible{% if settings.rtl %} left-45{% else %} right-15{% endif %}">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="spin">
                  <use href="#icon-load"></use>
                </svg>
              </span>
            </form>
            <!-- Replaced Search Form End -->
          </div>
        </div>

        <!-- Popup Search Modal -->
        <div class="popup-search popup-search-form transition-popup absolute z-15 color-default inset-x-0 invisible border-top{% if enable_search_suggestion == blank and popular_key_word == blank and collection_suggestion == blank %} search-not-sugges search-hidden{% endif %}">
          <!-- Close Button -->
          <button class="close-modal" aria-label="Close Search">
            <svg viewBox="0 0 24 24">
              <path d="M18 6 L6 18 M6 6 L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
          <div class="content-search-form py-60 px-sm-15 overflow-y-auto">
            <div class="{% if section_width == 'container' %}container{% else %}fluid_container{% endif %}">
              {%- if enable_search_suggestion and popular_key_word != blank -%}
                {%- capture link_quick_search -%}
                  {{ routes.search_url }}?type=product&options%5Bfields%5D=title,tag,vendor,product_type,variants.title,variants.sku&options%5Bunavailable_products%5D=last&options%5Bprefix%5D=last&q=
                {%- endcapture -%}
                <div id="quick-search" class="quick-search">
                  <h3 class="quick-search-title h5 m-0">{{ 'general.search.quick_search' | t }}</h3>
                  <ul class="quick-search-list mt-15 list-unstyled flex flex-wrap gap-10">
                    {%- assign popular_key_word = popular_key_word
                      | replace: ' ,', ','
                      | replace: ', ', ','
                      | split: ','
                    -%}
                    {%- for qr in popular_key_word -%}
                      {%- assign quick_text = qr | strip -%}
                      {%- if quick_text -%}
                        <li>
                          <a
                            class="quick-url btn-rounded no-underline lh-normal px-20 py-8 border hover-heading-color hover-grey-bg inline-block"
                            href="{{ link_quick_search }}{{ quick_text }}"
                            aria-label="{{ quick_text }}"
                          >
                            {{ quick_text }}
                          </a>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
              <div id="predictive-search" class="predictive-search--header">
                <div class="predictive-search" data-predictive-search>
                  {%- if enable_search_suggestion and collection_suggestion -%}
                    {%- assign collection = collections[collection_suggestion] -%}
                    {%- if collection.products.size > 0 -%}
                      <div class="search-suggest search-list-item mt-25">
                        <h5 class="m-0" style="color: var(--bestselling-text-color);">
                          {{ section.settings.bestselling_text }}
                        </h5>
                        <div id="search-results">
                          <div class="search__grid mt-15 {{ product_style }}">
                            <div
                              id="search-results-list"
                              class="search-results-list{% if search_type == 'default' or search_type == 'popup' %} grid grid-cols gap-15 gap-lg-20{% endif %}"
                              style="{% if search_type == 'default' or search_type == 'popup' %}--col-number: 1;--col-tablet: 1;--col-desktop-small:3;--col-desktop: 5;{% endif %}"
                            >
                              {%- assign sizes = '(min-width: 1200px) calc((1200px -  30px * 3) * 0.2), (min-width: 768px) calc( (100vw - 30px - 30px * 2 ) * 0.33), 80px' -%}
                              {%- for product in collection.products limit: 5 -%}
                                {% render 'product-item',
                                  card_product: product,
                                  section_id: section.id,
                                  template_enable_action: false,
                                  template_enable_product_vendor: false,
                                  template_enable_rate: true,
                                  template_enable_price: show_search_price,
                                  template_enable_product_short_description: false,
                                  template_enable_color_swatches: false,
                                  type: 'normal',
                                  sizes: sizes
                                %}
                              {%- endfor -%}
                            </div>
                          </div>
                        </div>
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                  <div class="search__loading-state mt-15">
                    <div class="loading-search"></div>
                  </div>
                </div>
                <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Mobile Search Toggle Button -->
      <div class="dropdown-toggle mobile-search-toggle">
        <button
          class="btn-reset top-search-toggle header-icon header-color w-44 h-44 inline-flex content-center overlay pointer transition"
          aria-label="{{ 'templates.search.tooltip' | t }}"
        >
          <svg width="17" height="17" viewBox="0 0 17 17" fill="currentColor">
            <use href="#icon-search" />
          </svg>
        </button>
      </div>
    {%- else -%}
      <!-- Non-Default Search Types: Popup or Drawer -->
      <div class="dropdown-toggle">
        <button
          class="btn-reset top-search-toggle header-icon header-color w-44 h-44 inline-flex content-center overlay pointer transition"
          aria-label="{{ 'templates.search.tooltip' | t }}"
        >
          <svg width="17" height="17" viewBox="0 0 17 17" fill="currentColor">
            <use href="#icon-search" />
          </svg>
        </button>
      </div>
      <!-- Popup/Drawer for Search -->
      <div
        id="search-form"
        class="search__type-{{ search_type }} invisible{% if search_type == 'default' %} absolute right-0{% elsif search_type == 'popup' %} bls__drawer invisible top{% if settings.rtl %} left right-0{% else %} right left-0{% endif %}{% else %} bls__drawer invisible{% if settings.rtl %} right left-0{% else %} left right-0{% endif %}{% endif %} color-default fixed w-full z-16 inset-y-0 h-full transition-popup"
      >
        {%- case search_type -%}
          {%- when 'popup' -%}
            {%- render 'search-popup' -%}
          {%- when 'drawer' -%}
            {%- render 'search-drawer' -%}
        {%- endcase -%}
      </div>
    {%- endif -%}
  </div>
</header-search>

<!-- JavaScript to Handle Search Modal Behavior -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    var searchInput = document.querySelector('#search-template');
    var popupSearch = document.querySelector('.popup-search-form');
    var mobileSearchToggle = document.querySelector('.dropdown-toggle.mobile-search-toggle');
    var closeModalBtn = document.querySelector('.close-modal');

    // Desktop: open modal when search input is focused
    if (searchInput && popupSearch) {
      searchInput.addEventListener('focus', function() {
        popupSearch.classList.remove('invisible');
      });
    }

    // Close the modal smoothly when clicking outside or on the close button
    document.addEventListener('click', function(e) {
      if (popupSearch && !popupSearch.contains(e.target) && (!searchInput || !searchInput.contains(e.target))) {
        popupSearch.classList.add('invisible');
      }
    });

    // Prevent propagation when clicking inside the modal
    if (popupSearch) {
      popupSearch.addEventListener('click', function(e) {
        e.stopPropagation();
      });
    }

    // Close button click handler
    if (closeModalBtn && popupSearch) {
      closeModalBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        popupSearch.classList.add('invisible');
      });
    }

    // Mobile toggle button for opening/closing modal
    if (mobileSearchToggle && popupSearch) {
      mobileSearchToggle.addEventListener('click', function(e) {
        e.stopPropagation();
        popupSearch.classList.toggle('invisible');
      });
    }
  });
</script>
