{% comment %}
  SOCIAL ICONS SECTION
  Keeps all original code and adds:
   - Desktop Icon Size slider
   - Mobile Icon Size slider
   - Hover Color customizer
   - Horizontal Gap slider
{% endcomment %}

<style>
      /* Original color setting, now with a hover color override */
      .list-social__item svg {
        color: {{ settings.social_icons_color }};
        transition: color 0.3s ease;
     }

    .list-social {

        margin-bottom: 15px !important;


  }


      /* Use new hover color setting instead of brightness filter */
      .list-social__item:hover svg {
        color: {{ settings.social_icons_hover_color }} ;
      }

      /* Control horizontal gap via custom property (slider in settings) */
      .list-social {
        --col-gap: {{ settings.social_icons_gap }}px;
      }

      /* Default to desktop icon size; override with media query for mobile */
      .list-social__item a {
        width: {{ settings.social_icons_size_desktop }}px !important;
        height: {{ settings.social_icons_size_desktop }}px !important;
      }

      @media (max-width: 767px) {
        .list-social__item a {
          width: {{ settings.social_icons_size_mobile }}px !important;
          height: {{ settings.social_icons_size_mobile }}px !important;
        }
      }
</style>

