<script>
    document.addEventListener("DOMContentLoaded", function() {
  var enableIntro = {{ settings.enable_website_intro }};
  if (!enableIntro) {
    // If intro is not enabled, do nothing.
    return;
  }

  // Grab relevant settings
  var showIntroOnlyFirstLoad = {{ settings.show_intro_only_first_load }};
  var introBehavior = "{{ settings.intro_behavior }}"; // "show_on_first_access", "show_on_every_page", ...
  var introDuration = {{ settings.intro_duration }};
  var enableBgColorInsteadOfImage = {{ settings.enable_background_color_instead_of_image }};
  var bgColor = "{{ settings.intro_background_color }}";
  var bgImageUrl = "{{ settings.intro_background_image | img_url: '2048x' }}";
  var bgBrightness = {{ settings.intro_background_brightness }};
  var bgBlur = {{ settings.intro_background_blur }};

  var overlay = document.getElementById("website-intro-overlay");
  var bgDiv = document.getElementById("website-intro-bg");
  if (!overlay || !bgDiv) return;

  // If "Show intro only on the first load" is toggled, override the behavior to "show_on_first_access".
  if (showIntroOnlyFirstLoad) {
    introBehavior = "show_on_first_access";
  }

  // Toggle glow on loading bar if enabled
  var enableLoadingBarGlow = {{ settings.enable_loading_bar_glow }};
  if (enableLoadingBarGlow) {
    var loadingBarFill = overlay.querySelector(".loading-bar-fill");
    if (loadingBarFill) {
      loadingBarFill.classList.add("glow");
    }
  }

  // Function: Check Behavior logic using localStorage
  function shouldShowIntro() {
    var now = new Date().getTime();
    var shownKey = "websiteIntroShown";
    var storedValue = localStorage.getItem(shownKey);

    switch(introBehavior) {
      case "show_on_first_access":
        if (!storedValue) {
          localStorage.setItem(shownKey, "true");
          return true;
        }
        return false;

      case "show_on_every_page":
        // Always show if we haven't forced it off
        return true;

      case "show_always":
        // Always show, no matter what
        return true;

      case "show_once_per_day":
        var oneDay = 24 * 60 * 60 * 1000;
        if (!storedValue) {
          localStorage.setItem(shownKey, now.toString());
          return true;
        } else {
          var storedTime = parseInt(storedValue, 10);
          if (now - storedTime > oneDay) {
            localStorage.setItem(shownKey, now.toString());
            return true;
          }
          return false;
        }

      default:
        return true;
    }
  }

  // Decide if we show the intro based on settings
  if (!shouldShowIntro()) {
    return;
  }

  // Display the overlay
  overlay.style.display = "flex"; // Make it visible (we used flex for alignment)

  // Apply background color or background image
  if (enableBgColorInsteadOfImage) {
    bgDiv.style.backgroundColor = bgColor;
    bgDiv.style.backgroundImage = "none";
  } else {
    bgDiv.style.backgroundColor = "transparent";
    if (bgImageUrl !== "") {
      bgDiv.style.backgroundImage = "url('" + bgImageUrl + "')";
    }
  }

  // Apply brightness and blur via CSS filters on #website-intro-bg
  var filterString = "";
  // brightness is fraction 0-1 from user’s 0-100
  var brightnessFraction = bgBrightness / 100;
  filterString += "brightness(" + brightnessFraction + ") ";
  filterString += "blur(" + bgBlur + "px)";
  bgDiv.style.filter = filterString;

  // Animate the loading bar (fill over the entire introDuration)
  var loadingBarFill = overlay.querySelector(".loading-bar-fill");
  if (loadingBarFill) {
    loadingBarFill.style.transitionDuration = introDuration + "s";
    setTimeout(function() {
      loadingBarFill.style.width = "100%";
    }, 50);
  }

  // After the duration, fade out overlay
  setTimeout(function() {
    overlay.style.opacity = 1;
    overlay.style.transition = "opacity 0.5s ease";
    overlay.style.opacity = 0;
    setTimeout(function(){
      overlay.style.display = "none";
    }, 500);
  }, introDuration * 1000);
});
</script>

