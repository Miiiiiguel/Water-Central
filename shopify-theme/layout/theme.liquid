{% if settings.enable_speed_optimization %}
<script>
/* ---------- Speed Optimizer (safe defaults) ---------- */
(function () {
  /* Polyfill requestIdleCallback for broader support */
  window.requestIdleCallback = window.requestIdleCallback || function (cb) {
    return setTimeout(function () { cb({ didTimeout: false, timeRemaining: function () { return 1; } }); }, 1);
  };

  /* Helper: mark a single image as LCP (use data-lcp on the hero image) */
  function tuneLCPImage() {
    var lcp = document.querySelector('img[data-lcp], picture[data-lcp] img, picture img[data-lcp]');
    if (!lcp) return;
    try {
      lcp.setAttribute('loading', 'eager');
      lcp.setAttribute('fetchpriority', 'high');
      lcp.setAttribute('decoding', 'async');
    } catch (e) {}
  }

  /* Images: lazy-load non-critical & set decoding=async */
  function optimizeImages() {
    var imgs = document.querySelectorAll('img');
    for (var i = 0; i < imgs.length; i++) {
      var img = imgs[i];

      // Respect explicit opt-outs/ins:
      // data-eager → load immediately; data-lcp → handled separately
      if (img.hasAttribute('data-eager') || img.hasAttribute('data-lcp')) {
        if (!img.hasAttribute('loading')) img.setAttribute('loading', 'eager');
        if (!img.hasAttribute('fetchpriority')) img.setAttribute('fetchpriority', 'high');
      } else {
        if (!img.hasAttribute('loading')) img.setAttribute('loading', 'lazy');
        // Lower network priority for obviously non-critical images
        if (!img.hasAttribute('fetchpriority')) img.setAttribute('fetchpriority', 'low');
      }

      if (!img.hasAttribute('decoding')) img.setAttribute('decoding', 'async');
    }

    // Iframes: lazy by default, unless explicitly eager
    var ifr = document.querySelectorAll('iframe');
    for (var j = 0; j < ifr.length; j++) {
      var f = ifr[j];
      if (!f.hasAttribute('data-eager') && !f.hasAttribute('loading')) {
        f.setAttribute('loading', 'lazy');
      }
    }
  }

  /* Background images: lazy apply when entering viewport
     Use: <div data-bg="{{ 'hero.jpg' | image_url }}"></div> */
  function lazyBackgrounds() {
    var bgEls = document.querySelectorAll('[data-bg]');
    if (!bgEls.length || !('IntersectionObserver' in window)) return;

    var io = new IntersectionObserver(function (entries, obs) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          var el = entry.target;
          var url = el.getAttribute('data-bg');
          if (url) {
            el.style.backgroundImage = 'url("' + url + '")';
            el.removeAttribute('data-bg');
          }
          obs.unobserve(el);
        }
      });
    }, { rootMargin: '200px 0px' });

    bgEls.forEach(function (el) { io.observe(el); });
  }

  /* Scripts: defer non-critical external scripts safely
     Opt-out: add data-nodefer to any <script src>
     We also skip Shopify/checkout/analytics scripts by default. */
  function deferScripts() {
    var external = document.querySelectorAll('script[src]');
    var skipRe = /(shopify|checkout|cart|analytics|google-analytics|gtm|gtag)/i;

    for (var i = 0; i < external.length; i++) {
      var s = external[i];
      // already async/defer/module → respect it
      if (s.async || s.defer || s.type === 'module') continue;
      // explicit opt-out
      if (s.hasAttribute('data-nodefer')) continue;
      // likely critical platform scripts
      if (skipRe.test(s.src)) continue;

      // Defer execution without changing load order
      s.setAttribute('defer', 'true');
    }
  }

  /* Fonts: add preconnect for Google Fonts only if used */
  function maybePreconnectFonts() {
    if (document.querySelector('link[href*="fonts.googleapis.com"]')) {
      if (!document.querySelector('link[rel="preconnect"][href*="fonts.gstatic.com"]')) {
        var pre = document.createElement('link');
        pre.rel = 'preconnect';
        pre.href = 'https://fonts.gstatic.com';
        pre.crossOrigin = 'anonymous';
        document.head.appendChild(pre);
      }
    }
  }

  tuneLCPImage();


  document.addEventListener('DOMContentLoaded', function () {
    optimizeImages();
    lazyBackgrounds();
    deferScripts();
    maybePreconnectFonts();

    
    requestIdleCallback(function () {
     
      var all = document.querySelectorAll('img[fetchpriority]');
      for (var i = 0; i < all.length; i++) {
        if (all[i].complete) all[i].removeAttribute('fetchpriority');
      }
    });
  });
})();
</script>
