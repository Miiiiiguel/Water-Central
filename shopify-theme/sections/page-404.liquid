<style>
  :is(.btn-primary) {
    background-color: var(--primary-button-bg-color, #0033FF);
    color: var(--primary-button-text-color, #FFFFFF);
    border: var(--primary-button-border-weight, 1px) solid var(--primary-button-border-color, #000000);
    border-radius: var(--primary-button-border-radius, 8px);
    font-size: 16px;
    padding: 11px 18px !important;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: none; /* Ensures the button has no shadow */
  }

  /* Mobile styles override for headings and subheadings */
  @media (max-width: 767px) {
    .m-page404 h1 {
      font-size: {{ section.settings.heading_mobile_font_size }}px !important;
    }
    .m-page404 p.h1 {
      font-size: {{ section.settings.subheading_mobile_font_size }}px !important;
    }
    .m-page404 {
      height: {{ section.settings.mobile_height }}vh !important;
    }
  }
</style>

<div
  class="m-page404"
  style="{% if section.settings.enable_bg_gradient %}background: linear-gradient({{ section.settings.bg_gradient_degree }}deg, {{ section.settings.bg_gradient_1 }}, {{ section.settings.bg_gradient_2 }}, {{ section.settings.bg_gradient_3 }});{% else %}background: {{ section.settings.bg_color }};{% endif %} display: flex; align-items: center; justify-content: center; height: {{ section.settings.desktop_height }}vh; flex-direction: column; text-align: center; padding: 20px; box-sizing: border-box;"
>
  <!-- SVG sad face icon -->
  <span class="m-page404__icon" style="margin-bottom: 20px;">
    {% if section.settings.enable_custom_icon and section.settings.custom_svg != blank %}
      {{ section.settings.custom_svg }}
    {% else %}
      <svg
        width="92px"
        height="92px"
        version="1.1"
        id="Capa_1"
        xmlns="http://www.w3.org/2000/svg"
        xmlns:xlink="http://www.w3.org/1999/xlink"
        viewBox="0 0 60 60"
        xml:space="preserve"
        fill="currentColor"
        style="color: {{ section.settings.icon_color }} !important;"
      >
        <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
        <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
        <g id="SVGRepo_iconCarrier">
          <g>
            <path d="M9,39h6v8c0,0.552,0.448,1,1,1s1-0.448,1-1v-8h3c0.552,0,1-0.448,1-1s-0.448-1-1-1h-3v-2c0-0.552-0.448-1-1-1s-1,0.448-1,1v2h-5V27c0-0.552-0.448-1-1-1s-1,0.448-1,1v11C8,38.552,8.448,39,9,39z"></path>
            <path d="M40,39h6v8c0,0.552,0.448,1,1,1s1-0.448,1-1v-8h3c0.552,0,1-0.448,1-1s-0.448-1-1-1h-3v-2c0-0.552-0.448-1-1-1s-1,0.448-1,1v2h-5V27c0-0.552-0.448-1-1-1s-1,0.448-1,1v11C39,38.552,39.448,39,40,39z"></path>
            <path d="M29.5,48c3.584,0,6.5-2.916,6.5-6.5v-9c0-3.584-2.916-6.5-6.5-6.5S23,28.916,23,32.5v9C23,45.084,25.916,48,29.5,48z M25,32.5c0-2.481,2.019-4.5,4.5-4.5s4.5,2.019,4.5,4.5v9c0,2.481-2.019,4.5-4.5,4.5S25,43.981,25,41.5V32.5z"></path>
            <path d="M0,0v14v46h60V14V0H0z M2,2h56v10H2V2z M58,58H2V14h56V58z"></path>
            <polygon points="54.293,3.293 52,5.586 49.707,3.293 48.293,4.707 50.586,7 48.293,9.293 49.707,10.707 52,8.414 54.293,10.707 55.707,9.293 53.414,7 55.707,4.707 "></polygon>
            <path d="M3,11h39V3H3V11z M5,5h35v4H5V5z"></path>
          </g>
        </g>
      </svg>
    {% endif %}
  </span>

  <!-- 404 Heading -->
  <h1
    class="h1"
    style="color: {{ section.settings.t1_color }} !important; font-size: {{ section.settings.heading_desktop_font_size }}px; line-height: 1.2; margin: 0 0 10px; font-weight: 700;"
  >
    404
  </h1>

  <!-- Subtext -->
  <p
    class="h1"
    style="color: {{ section.settings.t2_color }} !important; font-size: {{ section.settings.subheading_desktop_font_size }}px; line-height: 1.6; max-width: 600px; margin: 0 auto 30px; padding: 0 15px; font-weight: 400;"
  >
    {{ 'sudafin.page_404' | t }}
  </p>

  <!-- Button linking back to the homepage using the primary button style (no shadows) -->
  <a
    href="{{ routes.root_url }}"
    class="btn-primary"
    style="text-decoration: none;"
  >
    Go to Homepage
  </a>
</div>

{% schema %}
{
  "name": "404",
  "class": "h-full",
  "settings": [
    {
      "type": "header",
      "content": "Page Height"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Page Height (Desktop)",
      "min": 50,
      "max": 200,
      "step": 5,
      "default": 100,
      "unit": "vh"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Page Height (Mobile)",
      "min": 50,
      "max": 200,
      "step": 5,
      "default": 100,
      "unit": "vh"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5f1ed",
      "info": "Used when Background Gradient is disabled."
    },
    {
      "type": "checkbox",
      "id": "enable_bg_gradient",
      "label": "Enable Background Color Gradient Customizer",
      "default": false
    },
    {
      "type": "header",
      "content": "Background Gradient",
      "info": "Configure background gradient settings (active when enabled)."
    },
    {
      "type": "color",
      "id": "bg_gradient_1",
      "label": "Background Gradient Color 1",
      "default": "#ff0000",
      "info": "Only used when Background Gradient is enabled."
    },
    {
      "type": "color",
      "id": "bg_gradient_2",
      "label": "Background Gradient Color 2",
      "default": "#00ff00",
      "info": "Only used when Background Gradient is enabled."
    },
    {
      "type": "color",
      "id": "bg_gradient_3",
      "label": "Background Gradient Color 3",
      "default": "#0000ff",
      "info": "Only used when Background Gradient is enabled."
    },
    {
      "type": "select",
      "id": "bg_gradient_degree",
      "label": "Background Gradient Degree",
      "default": "90",
      "options": [
        { "value": "0", "label": "0°" },
        { "value": "45", "label": "45°" },
        { "value": "90", "label": "90°" },
        { "value": "135", "label": "135°" },
        { "value": "180", "label": "180°" },
        { "value": "225", "label": "225°" },
        { "value": "270", "label": "270°" },
        { "value": "315", "label": "315°" }
      ],
      "info": "Select the angle for the background gradient (active when enabled)."
    },
    {
      "type": "header",
      "content": "Texts"
    },
    {
      "type": "color",
      "id": "t1_color",
      "label": "Heading Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "t2_color",
      "label": "Subheading Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "SVG Icon Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "heading_desktop_font_size",
      "label": "Heading Font Size (Desktop)",
      "min": 10,
      "max": 100,
      "step": 1,
      "default": 64
    },
    {
      "type": "range",
      "id": "heading_mobile_font_size",
      "label": "Heading Font Size (Mobile)",
      "min": 10,
      "max": 100,
      "step": 1,
      "default": 48
    },
    {
      "type": "range",
      "id": "subheading_desktop_font_size",
      "label": "Subheading Font Size (Desktop)",
      "min": 10,
      "max": 100,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "subheading_mobile_font_size",
      "label": "Subheading Font Size (Mobile)",
      "min": 10,
      "max": 100,
      "step": 1,
      "default": 15
    },
    {
      "type": "header",
      "content": "Custom Icon"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_icon",
      "label": "Enable Custom SVG ICON for the 404 page",
      "default": false
    },
    {
      "type": "textarea",
      "id": "custom_svg",
      "label": "Custom SVG Icon Code",
      "default": "/",
      "info": "Enter your own SVG icon code here. This will replace the default icon when the toggle is enabled."
    }
  ]
}
{% endschema %}