{%- liquid      
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme
  assign column_gap = section_st.column_gap
  assign items_per_row_mobile = section_st.items_per_row_mobile
  assign heading = section_st.heading
  assign show_view_all_button = section_st.show_view_all_button
  assign carousel_pagination = section_st.carousel_pagination
  assign display_mode = section_st.display_mode
  assign collection_title_position = section_st.collection_title_position
  assign enable_overlay_fade = section_st.enable_overlay_fade
  assign block_border_radius = section_st.block_border_radius
  assign enable_block_button = section_st.enable_block_button
  assign button_bg_color = section_st.button_bg_color
  assign button_hover_bg_color = section_st.button_hover_bg_color
  assign button_border_radius = section_st.button_border_radius
  assign button_vertical_position = section_st.button_vertical_position
  assign button_width = section_st.button_width
  assign button_text_color = section_st.button_text_color
  assign button_hover_text_color = section_st.button_hover_text_color
  assign button_border_color = section_st.button_border_color
  assign button_border_thickness = section_st.button_border_thickness
  assign design = 'default'
  assign infinite = section_st.infinite
  assign autoplay = section_st.autoplay
  assign autorotate_speed = section_st.autorotate_speed
  assign reveal = section_st.reveal
  assign items_per_row = section_st.items_per_row
  assign header_size_slider = section_st.header_size_slider
  assign reset_spacing = section.settings.reset_spacing

  if section_st.items_per_row_mobile > 1 and section_st.items_per_row_mobile < 2
    assign data_free_scroll = 'true'
  elsif section_st.items_per_row_mobile > 2 and section_st.items_per_row_mobile < 3
    assign data_free_scroll = 'true'
  endif

  assign rounded_image = section_st.rounded_image
  assign scroll_animation = settings.scroll_animation
  assign collection_hover_animation = section_st.collection_hover_animation

  if collection_title_position == 'inside'
    assign collection_information_position = 'overlay'
  else
    assign collection_information_position = 'below_image'
  endif

  
  if collection_title_position == 'outside'
    assign enable_overlay_fade = false
  endif

  assign effective_image_ratio = section_st.image_ratio
  if rounded_image
    assign effective_image_ratio = 'square'
  endif
-%}

{%- capture style -%}
  --section-pt-desktop: {{ section_st.padding_top_desktop }}px; --section-pb-desktop: {{ section_st.padding_bottom_desktop }}px;
  --section-pl-desktop: {{ section_st.padding_left_desktop }}px; --section-pr-desktop: {{ section_st.padding_right_desktop }}px;
  --section-pt-mobile: {{ section_st.padding_top_mobile }}px; --section-pb-mobile: {{ section_st.padding_bottom_mobile }}px;
  --section-pl-mobile: {{ section_st.padding_left_mobile }}px; --section-pr-mobile: {{ section_st.padding_right_mobile }}px;
{%- endcapture -%}

{%- capture col_style -%}
  --col-desktop: {{ items_per_row }};--col-number:{{ items_per_row_mobile }};{% if items_per_row > 3 %}--col-tablet: 3;{% else %}--col-tablet: {{ items_per_row }};{% endif %}
  --col-gap: {{ column_gap }}px;--repeat: {{ section.blocks.size }}; --col-mobile: {{ items_per_row_mobile }};
  --block-border-radius: {{ block_border_radius }}px;
{%- endcapture -%}

<!-- Base CSS -->
<style>
  /* Per-section control for vertical spacing between controls (dots/nav) and content */
  .section-{{ section.id }}{
    --controls-gap: {{ section_st.nav_dots_vertical_gap | default: 24 }}px;
    padding-top: var(--section-pt-desktop);
    padding-bottom: var(--section-pb-desktop);
    padding-left: var(--section-pl-desktop);
    padding-right: var(--section-pr-desktop);
  }

  @media (max-width: 767px) {
    .section-{{ section.id }} {
      padding-top: var(--section-pt-mobile);
      padding-bottom: var(--section-pb-mobile);
      padding-left: var(--section-pl-mobile);
      padding-right: var(--section-pr-mobile);
    }
  }

  .section-{{ section.id }} .swiper-wrapper {
    margin-top: 20px;
    margin-bottom: 15px;
  }
  .section-{{ section.id }} .reveal_on_scroll {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  .section-{{ section.id }} .reveal_on_scroll.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* Ensure collection buttons sit above any overlay fade */
  .section-{{ section.id }} .collection-item{
    position: relative;
  }
  {% if enable_overlay_fade %}
  .section-{{ section.id }} .collection-item::after{
    content:'';
    position:absolute;
    bottom:0;left:0;width:100%;height:50%;
    background:linear-gradient(to bottom, transparent, rgba(0,0,0,0.7));
    pointer-events:none;
    z-index:1; /* overlay layer */
  }
  {% endif %}
  .section-{{ section.id }} .collection-button{
    position:absolute;
    bottom: {{ button_vertical_position }}px;
    left:50%;
    transform: translateX(-50%);
    width: {{ button_width }}px;
    background-color: {{ button_bg_color }};
    color: {{ button_text_color }};
    border: {{ button_border_thickness }}px solid {{ button_border_color }};
    border-radius: {{ button_border_radius }}px;
    padding: 10px 20px;
    text-align: center;
    text-decoration: none;
    font-weight: bold;
    transition: background-color 0.3s ease, color 0.3s ease;
    z-index: 2; /* ABOVE overlay fade */
  }
  .section-{{ section.id }} .collection-button:hover{
    background-color: {{ button_hover_bg_color }};
    color: {{ button_hover_text_color }};
  }

  /* Navigation arrows base */
  .section-{{ section.id }} .custom-swiper-button-prev,
  .section-{{ section.id }} .custom-swiper-button-next {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ section_st.arrow_bg_color }};
    width: {{ section_st.arrow_bg_size }}px;
    height: {{ section_st.arrow_bg_size }}px;
    border-radius: 50%;
    top: {{ section_st.arrow_vertical_position_desktop }}%;
  }
  .section-{{ section.id }} .custom-swiper-button-prev svg,
  .section-{{ section.id }} .custom-swiper-button-next svg {
    width: 110%;
    height: 110%;
    justify-content: center;
    display: block;
  }
  .section-{{ section.id }} .custom-swiper-button-prev::after,
  .section-{{ section.id }} .custom-swiper-button-next::after {
    content: none;
  }
  @media (max-width: 767px) {
    .section-{{ section.id }} .custom-swiper-button-prev,
    .section-{{ section.id }} .custom-swiper-button-next {
      top: {{ section_st.arrow_vertical_position_mobile }}%;
    }
  }

  /* Add extra breathing room below the carousel for dots/navigation as requested */
  .section-{{ section.id }} .swiper{
    margin-bottom: var(--controls-gap);
  }

  /* Grid styles */
  .section-{{ section.id }} .collection-grid {
    display: grid;
    grid-template-columns: repeat(var(--col-desktop), 1fr);
    gap: var(--col-gap);
  }
  @media (max-width: 1024px) {
    .section-{{ section.id }} .collection-grid {
      grid-template-columns: repeat(var(--col-tablet), 1fr);
    }
  }
  @media (max-width: 768px) {
    .section-{{ section.id }} .collection-grid {
      grid-template-columns: repeat(var(--col-mobile), 1fr);
    }
  }

  /* Collection item wrapper */
  .section-{{ section.id }} .collection-item {
    border-radius: var(--block-border-radius);
    overflow: hidden;
  }

  /* Fallback enforcement: if circle images, softly coerce square ratio + circle mask */
  {% if rounded_image %}
  .section-{{ section.id }} .collection-item img,
  .section-{{ section.id }} .collection-item picture,
  .section-{{ section.id }} .collection-item .media,
  .section-{{ section.id }} .collection-item .image,
  .section-{{ section.id }} .collection-item .collection-image,
  .section-{{ section.id }} .collection-item .media--image {
    aspect-ratio: 1 / 1;
    object-fit: cover;
    width: 100%;
    height: auto;
    border-radius: 50%;
  }
  {% endif %}
</style>

<!-- Navigation Arrows Visibility -->
{% if section_st.enable_navigation_arrows and section_st.arrow_visibility != 'hide' %}
  <style>
    {% if section_st.arrow_visibility == 'both' %}
      .section-{{ section.id }} .custom-swiper-button-prev,
      .section-{{ section.id }} .custom-swiper-button-next {
        display: flex;
      }
    {% elsif section_st.arrow_visibility == 'desktop_only' %}
      .section-{{ section.id }} .custom-swiper-button-prev,
      .section-{{ section.id }} .custom-swiper-button-next {
        display: none;
      }
      @media (min-width: 768px) {
        .section-{{ section.id }} .custom-swiper-button-prev,
        .section-{{ section.id }} .custom-swiper-button-next {
          display: flex;
        }
      }
    {% elsif section_st.arrow_visibility == 'mobile_only' %}
      .section-{{ section.id }} .custom-swiper-button-prev,
      .section-{{ section.id }} .custom-swiper-button-next {
        display: none;
      }
      @media (max-width: 767px) {
        .section-{{ section.id }} .custom-swiper-button-prev,
        .section-{{ section.id }} .custom-swiper-button-next {
          display: flex;
        }
      }
    {% endif %}
    .section-{{ section.id }} .custom-swiper-button-prev:hover,
    .section-{{ section.id }} .custom-swiper-button-next:hover {
      opacity: 0.8;
      transition: opacity 0.3s ease;
    }
  </style>
{% endif %}

<!-- Hover Animation -->
{% if section_st.collection_hover_animation == 'smoot_fade' %}
  <style>
    .section-{{ section.id }} .hover-smoot_fade {
      transition: opacity 0.3s ease, transform 0.3s ease;
      transform-origin: center;
    }
    .section-{{ section.id }} .hover-smoot_fade:hover {
      opacity: 0.88;
      transform: scale(1);
    }
  </style>
{% endif %}

<div
  class="section-{{ section.id }} section sec__collection-list color-{{ color_scheme }} gradient{% if reveal %} overflow-hidden{% endif %}"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    {%- if heading != blank or show_view_all_button == true -%}
      <div
        class="section__header mb-33 mb-sm-20 text-{{ section_st.header_alignment }} {% if section_st.section_width == 'full_width' %} px-20 {% endif %}{% if show_view_all_button == true %} flex gap-15 gap-md-30 flex-wrap {% if section_st.header_alignment == 'center' %} justify-content-{{ section_st.header_alignment }} {% else %} justify-between {% endif %} align-center{% if section_st.header_alignment == 'right' %} flex-row-reverse{% endif %}{% endif %}"
      >
        {%- if heading != blank -%}
          <div class="secion__header-inner">
            <h2
              class="section__header-heading heading-letter-spacing mt-0 mb-0 {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }}{% endif %}"
              style="font-size: {{ header_size_slider }}px; {% if section_st.enable_custom_title_color %} color: {{ section_st.custom_title_text_color }} !important;{% endif %}{% if scroll_animation != 'none' %} --animation-order: 0; {% endif %}"
            >
              {{ section_st.heading }}
            </h2>
          </div>
        {% endif %}
        {% if show_view_all_button == true and section_st.header_alignment != 'center' %}
          <a
            class="btn_view-all no-underline inline-flex btn-link"
            href="{{ section_st.view_all_url }}"
            aria-label="{{ 'general.view_all' | t }}"
          >
            {{ 'general.view_all' | t }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      {% if display_mode == 'grid' %}
        <div class="collection-grid{% if reveal %} reveal_on_scroll{% endif %}" style="{{ col_style | strip | strip_newlines }}">
          {% for block in section.blocks %}
            {% assign block_st = block.settings %}
            <div
              class="
                collection-item
                {% if scroll_animation != 'none' and scroll_animation != null %}
                  scroll-trigger {{ scroll_animation }}
                {% endif %}
                {% if collection_hover_animation != 'none' %}
                  hover-{{ collection_hover_animation }}
                {% endif %}
              "
              {{ block.shopify_attributes }}
              onclick="window.location.href='{{ block_st.collection_url }}'"
              style="cursor: pointer; {% if scroll_animation != 'none' %}--animation-order: {{ forloop.index }};{% endif %}"
            >
              {% render 'collection-item',
                image: block_st.collection_image,
                link: block_st.collection_url,
                title: block_st.collection_title,
                section: section,
                block: block,
                collection_information_position: collection_information_position,
                design: design,
                container: section_width,
                colunm: items_per_row,
                colunm_mobile: section_st.items_per_row_mobile,
                padding: column_gap,
                collection_title_alignment: 'center',
                image_ratio_override: effective_image_ratio
              %}
              {% if enable_block_button %}
                <a href="{{ block_st.collection_url }}" class="collection-button">
                  {{ block_st.collection_title }}
                </a>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% else %}
        {% if section_st.items_per_row_mobile > 1 and section_st.items_per_row_mobile < 2 %}
          <div class="free-scroll">
        {% elsif section_st.items_per_row_mobile > 2 and section_st.items_per_row_mobile < 3 %}
          <div class="free-scroll">
        {% endif %}

        <slide-section
          class="swiper{% if reveal %} reveal_on_scroll{% endif %}"
          data-section-id="{{ section.id }}"
          data-autoplay="{{ autoplay }}"
          data-effect="slide"
          data-loop="{{ infinite }}"
          data-speed="500"
          data-autoplay-speed="{{ autorotate_speed }}"
          data-spacing="{{ column_gap }}"
          data-mobile="{{ items_per_row_mobile }}"
          data-desktop="{{ items_per_row }}"
          data-tablet="{% if items_per_row > 5 %}4{% elsif items_per_row > 4 %}3{% elsif items_per_row > 3 %}3{% else %}{{ items_per_row }}{% endif %}"
          data-free-scroll="{{ data_free_scroll }}"
          style="{{ col_style | strip | strip_newlines }}"
        >
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              {% assign block_st = block.settings %}
              <div
                class="
                  collection-item swiper-slide
                  {% if scroll_animation != 'none' and scroll_animation != null %}
                    scroll-trigger {{ scroll_animation }}
                  {% endif %}
                  {% if collection_hover_animation != 'none' %}
                    hover-{{ collection_hover_animation }}
                  {% endif %}
                "
                {{ block.shopify_attributes }}
                onclick="window.location.href='{{ block_st.collection_url }}'"
                style="cursor: pointer; {% if scroll_animation != 'none' %}--animation-order: {{ forloop.index }};{% endif %}"
              >
                {% render 'collection-item',
                  image: block_st.collection_image,
                  link: block_st.collection_url,
                  title: block_st.collection_title,
                  section: section,
                  block: block,
                  collection_information_position: collection_information_position,
                  design: design,
                  container: section_width,
                  colunm: items_per_row,
                  colunm_mobile: section_st.items_per_row_mobile,
                  padding: column_gap,
                  collection_title_alignment: 'center',
                  image_ratio_override: effective_image_ratio
                %}
                {% if enable_block_button %}
                  <a href="{{ block_st.collection_url }}" class="collection-button">
                    {{ block_st.collection_title }}
                  </a>
                {% endif %}
              </div>
            {% endfor %}
          </div>

          {%- if carousel_pagination == 'show_dots' or carousel_pagination == 'show_dots_on_mobile' -%}
            <div
              class="swiper-pagination flex flex-wrap px-15 lh-1 {% if carousel_pagination == 'show_dots_on_mobile' %} hidden-md{% endif %} justify-content-center{% if section_st.content_below_image %} absolute-md-impo{% endif %}"
              style="--swiper-pagination-position: static; margin-top: {{ section_st.nav_dots_vertical_gap | default: 24 }}px;"
            ></div>
          {%- endif -%}

          <!-- Navigation Arrows -->
          {% if section_st.enable_navigation_arrows and section_st.arrow_visibility != 'hide' %}
            <div class="swiper-button-prev custom-swiper-button-prev" style="transform: translateX(4px);">
              <svg width="256px" height="256px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                <g id="SVGRepo_iconCarrier">
                  <path d="M15 7L10 12L15 17" stroke="{{ section_st.arrow_icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                </g>
              </svg>
            </div>
            <div class="swiper-button-next custom-swiper-button-next" style="transform: translateX(4px);">
              <svg width="256px" height="256px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" transform="matrix(-1, 0, 0, 1, 0, 0)">
                <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                <g id="SVGRepo_iconCarrier">
                  <path d="M15 7L10 12L15 17" stroke="{{ section_st.arrow_icon_color }}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                </g>
              </svg>
            </div>
          {% endif %}
        </slide-section>

        {% if section_st.items_per_row_mobile > 1 and section_st.items_per_row_mobile < 2 %}
          </div>
        {% elsif section_st.items_per_row_mobile > 2 and section_st.items_per_row_mobile < 3 %}
          </div>
        {% endif %}
      {% endif %}
    {% endif %}

    {% if show_view_all_button == true and section_st.header_alignment == 'center' %}
      <div class="text-center mt-30">
        <a
          class="inline-flex btn-primary load-more no-underline relative"
          href="{{ section_st.view_all_url }}"
          aria-label="{{ 'general.view_all' | t }}"
        >
          {{ 'general.view_all' | t }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    var revealElements = document.querySelectorAll('.section-{{ section.id }} .reveal_on_scroll');
    revealElements.forEach(function(el) {
      setTimeout(function(){
        el.classList.add('revealed');
      }, 100);
    });
  });
  document.addEventListener('shopify:section:load', function(event) {
    if (event.detail.sectionId === '{{ section.id }}') {
      var revealElements = document.querySelectorAll('.section-{{ section.id }} .reveal_on_scroll');
      revealElements.forEach(function(el) {
        setTimeout(function(){
          el.classList.add('revealed');
        }, 100);
      });
    }
  });
</script>

{% schema %}
{
  "name": "Collection Showcase",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section Padding Options"
    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top Section Padding (Desktop)",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom Section Padding (Desktop)",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_left_desktop",
      "label": "Left Section Padding (Desktop)",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_right_desktop",
      "label": "Right Section Padding (Desktop)",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top Section Padding (Mobile)",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom Section Padding (Mobile)",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "label": "Left Section Padding (Mobile)",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "label": "Right Section Padding (Mobile)",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Lazy Loading Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_lazy_load",
      "label": "Activate Lazy Load Images",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout Options"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Layout Container Type",
      "default": "fluid_container",
      "options": [
        {"value": "container", "label": "Fixed Container"},
        {"value": "fluid_container", "label": "Fluid Container"},
        {"value": "stretch_width", "label": "Stretched Container"},
        {"value": "full_width", "label": "Edge-to-Edge Layout"}
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Palette",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Title & Header Options"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Title",
      "default": "Collection List"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_title_color",
      "label": "Enable Custom Title Text Color",
      "default": false
    },
    {
      "type": "color",
      "id": "custom_title_text_color",
      "label": "Custom Title Text Color",
      "default": "#000000"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View All URL",
      "default": "/"
    },
    {
      "type": "checkbox",
      "id": "show_view_all_button",
      "label": "Display 'See All' Button"
    },
    {
      "type": "range",
      "id": "header_size_slider",
      "label": "Title Font Size",
      "min": 12,
      "max": 72,
      "step": 1,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Title Alignment",
      "default": "left",
      "options": [
        {"value": "left", "label": "Align Left"},
        {"value": "center", "label": "Align Center"},
        {"value": "right", "label": "Align Right"}
      ]
    },
    {
      "type": "header",
      "content": "Image & Grid Options"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Picture Aspect Ratio",
      "default": "custom",
      "options": [
        {"value": "adapt", "label": "Adaptive Ratio"},
        {"value": "square", "label": "Square Ratio"},
        {"value": "portrait", "label": "Portrait Ratio"},
        {"value": "landscape", "label": "Landscape Ratio"},
        {"value": "custom", "label": "Custom Ratio"}
      ]
