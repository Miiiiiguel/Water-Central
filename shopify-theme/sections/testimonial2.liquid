        {% when 'outline_stars' %}
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M11.2418 2.55063C10.8982 1.83216 9.83613 1.80092 9.46127 2.55063L7.4308 6.70529L2.83882 7.36128C2.02663 7.48624 1.71425 8.48585 2.30777 9.07938L5.58776 12.2969L4.80681 16.8264C4.68186 17.6386 5.55652 18.2633 6.275 17.8885L10.3672 15.7331L14.4281 17.8885C15.1466 18.2633 16.0213 17.6386 15.8963 16.8264L15.1153 12.2969L18.3953 9.07938C18.9889 8.48585 18.6765 7.48624 17.8643 7.36128L13.3035 6.70529L11.2418 2.55063ZM16.2108 8.84095L12.1777 8.26084L10.3564 4.59071L8.56273 8.26084L4.49356 8.84215L7.41447 11.7074L6.72051 15.7324L10.3702 13.8101L13.9816 15.7269L13.2886 11.7074L16.2108 8.84095Z" fill="var(--section-empty-stars-color)"/>
            </svg>
        {% else %}
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                {% case section.settings.stars_shape %}
                    {% when 'stars' %}
                        <path d="M9.46127 2.55063L7.4308 6.70529L2.83882 7.36128C2.02663 7.48624 1.71425 8.48585 2.30777 9.07938L5.58776 12.2969L4.80681 16.8264C4.68186 17.6386 5.55652 18.2633 6.275 17.8885L10.3672 15.7331L14.4281 17.8885C15.1466 18.2633 16.0213 17.6386 15.8963 16.8264L15.1153 12.2969L18.3953 9.07938C18.9889 8.48585 18.6765 7.48624 17.8643 7.36128L13.3035 6.70529L11.2418 2.55063C10.8982 1.83216 9.83613 1.80092 9.46127 2.55063Z" stroke="var(--section-empty-stars-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                    {% when 'pointed_stars' %}
                        <path d="M10.5 1L12.6329 7.56434H19.535L13.9511 11.6213L16.084 18.1857L10.5 14.1287L4.91604 18.1857L7.04893 11.6213L1.46497 7.56434H8.36712L10.5 1Z" stroke="var(--section-empty-stars-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                    {% when 'heart_stars' %}
                        <path d="M10 4.89321L10.6121 4.27677C12.3022 2.57449 15.0423 2.57448 16.7324 4.27677C18.4225 5.97905 18.4225 8.739 16.7324 10.4413L10 17.2223L3.26757 10.4412C1.57748 8.73895 1.57747 5.979 3.26757 4.27671C4.95767 2.57443 7.69786 2.57443 9.38796 4.27671L10 4.89321Z" stroke="var(--section-empty-stars-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
