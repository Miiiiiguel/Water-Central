{% style %}
:root {
--loudz-neutral-100: #222;
--loudz-neutral-70: #5e5e5e;
--loudz-neutral-03: #f8f8f8;
--loudz-neutral-01: #fff;
--loudz-size-0: 0px;
--loudz-size-1: 1px;
--loudz-size-2: 2px;
--loudz-size-4: 4px;
--loudz-size-6: 6px;
--loudz-size-12: 12px;
--loudz-size-14: 14px;
--loudz-size-16: 16px;
--loudz-size-20: 20px;
--loudz-size-24: 24px;
--loudz-size-32: 32px;
--loudz-size-40: 40px;
--loudz-size-48: 48px;
--loudz-size-80: 80px;
--loudz-size-full: 9999px;
--loudz-font-weight-100: 100;
--loudz-font-weight-300: 300;
--loudz-font-weight-400: 400;
--loudz-font-weight-600: 600;
--loudz-font-weight-700: 700;
--loudz-line-height-140: 1.4;
--loudz-line-height-150: 1.5;
--loudz-text-decoration-none: none;
--loudz-text-decoration-underline: underline;
--loudz-border-radius-full: var(--loudz-size-full);
--loudz-border-width-1: var(--loudz-size-1);
--loudz-color-bg-fill-default-on-light: var(--loudz-neutral-100);
--loudz-color-bg-fill-inverse-on-light: var(--loudz-neutral-01);
--loudz-color-bg-surface-tertiary-on-light: var(--loudz-neutral-03);
--loudz-color-text-disable-on-light: var(--loudz-neutral-70);
--loudz-space-0: var(--loudz-size-0);
--loudz-space-1: var(--loudz-size-1);
--loudz-space-2: var(--loudz-size-2);
--loudz-space-4: var(--loudz-size-4);
--loudz-space-6: var(--loudz-size-6);
--loudz-space-12: var(--loudz-size-12);
--loudz-space-16: var(--loudz-size-16);
--loudz-space-20: var(--loudz-size-20);
--loudz-space-24: var(--loudz-size-24);
--loudz-space-32: var(--loudz-size-32);
--loudz-space-40: var(--loudz-size-40);
--loudz-space-48: var(--loudz-size-48);
--loudz-space-80: var(--loudz-size-80);
--loudz-font-size-12: var(--loudz-size-12);
--loudz-font-size-14: var(--loudz-size-14);
}


{% endstyle %}

<!-- --UUID-c1da888b-- -->

<script>
	if (typeof window.loudzBreakpoints === 'undefined') {
		window.loudzBreakpoints = {
			mobile: {
				minWidth: 0,
				maxWidth: 479,
			},
			tablet: {
				minWidth: 480,
				maxWidth: 991,
			},
			desktop: {
				minWidth: 992,
				maxWidth: 10000,
			},
		};
	}
</script>

{% style %}
	

@media(max-width: 479px){.LoudzResponsiveness--TabletAndDesktop{display:none}}@media(min-width: 992px){.LoudzResponsiveness--MobileAndTablet{display:none}}@media(min-width: 480px){.LoudzResponsiveness--Mobile{display:none}}@media not ((min-width: 480px) and (max-width: 991px)){.LoudzResponsiveness--Tablet{display:none}}@media(max-width: 991px){.LoudzResponsiveness--Desktop{display:none}}

{% endstyle %}


{% capture loudz_filled_icon %}
    {% case section.settings.stars_shape %}
        {% when 'stars' %}
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9.46127 2.55063L7.4308 6.70529L2.83882 7.36128C2.02663 7.48624 1.71425 8.48585 2.30777 9.07938L5.58776 12.2969L4.80681 16.8264C4.68186 17.6386 5.55652 18.2633 6.275 17.8885L10.3672 15.7331L14.4281 17.8885C15.1466 18.2633 16.0213 17.6386 15.8963 16.8264L15.1153 12.2969L18.3953 9.07938C18.9889 8.48585 18.6765 7.48624 17.8643 7.36128L13.3035 6.70529L11.2418 2.55063C10.8982 1.83216 9.83613 1.80092 9.46127 2.55063Z" fill="var(--section-stars-color)"/>
            </svg>    
        {% when 'outline_stars' %}
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M11.2418 2.55063C10.8982 1.83216 9.83613 1.80092 9.46127 2.55063L7.4308 6.70529L2.83882 7.36128C2.02663 7.48624 1.71425 8.48585 2.30777 9.07938L5.58776 12.2969L4.80681 16.8264C4.68186 17.6386 5.55652 18.2633 6.275 17.8885L10.3672 15.7331L14.4281 17.8885C15.1466 18.2633 16.0213 17.6386 15.8963 16.8264L15.1153 12.2969L18.3953 9.07938C18.9889 8.48585 18.6765 7.48624 17.8643 7.36128L13.3035 6.70529L11.2418 2.55063Z" fill="var(--section-stars-color)"/>
            </svg>  
        {% when 'pointed_stars' %}
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10.5 1L12.6329 7.56434H19.535L13.9511 11.6213L16.084 18.1857L10.5 14.1287L4.91604 18.1857L7.04893 11.6213L1.46497 7.56434H8.36712L10.5 1Z" fill="var(--section-stars-color)"/>
            </svg>    
        {% when 'heart_stars' %}
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 4.89321L10.6121 4.27677C12.3022 2.57449 15.0423 2.57448 16.7324 4.27677C18.4225 5.97905 18.4225 8.739 16.7324 10.4413L10 17.2223L3.26757 10.4412C1.57748 8.73895 1.57747 5.979 3.26757 4.27671C4.95767 2.57443 7.69786 2.57443 9.38796 4.27671L10 4.89321Z" fill="var(--section-stars-color)"/>
            </svg>     
  {% endcase %}
{% endcapture %}

{% capture loudz_empty_icon %}
