<loudz-testimonial-text
	class="
		Loudz-{{ section.id | handle }} LoudzTestimonialText
		{% if section.settings.section_width == 100 %}LoudzTestimonialText--fullWidth{% endif %}
		{% if section.settings.enable_fade %}LoudzTestimonialText--fade-enabled{% endif %}
	"
>
	<div class="LoudzTestimonialTextContainer LoudzCarouselContainer">
		<div class="LoudzTestimonialTextContent">
			{%- for block in section.blocks -%}
				 {%- if block.type == 'heading' and block.settings.heading != blank -%}
				<h2 class="LoudzTestimonialTextContent__Heading LoudzTestimonialTextContent__Heading--style-{{ block.settings.heading_style }}">
					{{ block.settings.heading }}
				</h2>
				 {%- elsif block.type == 'description' and block.settings.description != blank -%}
				<div class="LoudzTestimonialTextContent__Description">
					{{ block.settings.description }}
				</div>
				 {%- endif -%}
			{%- endfor -%}
			{% if section.settings.button_label != blank %}
				<div class="LoudzTestimonialTextContent__Button">
					{%- if section.settings.button_label != blank -%}
						<a
							{% if section.settings.new_tab == true %}
								target="_blank"
								rel="noopener noreferrer"
							{% endif %}
							class="LoudzTestimonialTextContentButton LoudzTestimonialTextContentButton--{{ section.settings.button_style }}"
							href="{{ section.settings.button_link | default: "#" }}"
						>
							{{- section.settings.button_label | escape -}}
						</a>
					{%- endif -%}
				</div>
			{% endif %}
		</div>
		<div
			class="LoudzCarousel"
			data-section-width="{{ section.settings.section_width }}"
		>
			<div class="LoudzCarousel__Content">
				<ul class="LoudzCarouselList">
					{%- for block in section.blocks -%}
						 {%- if block.type == 'testimonial' -%}
						{%- liquid
							assign testimonial_text = block.settings.testimonial_text
							assign author_name = block.settings.author_name
							assign author_additional_text = block.settings.author_additional_text
							assign author_photo = block.settings.author_photo
						-%}
						<li
							class="LoudzTestimonialBlock"
							{{ block.shopify_attributes }}
						>
							<div class="LoudzTestimonialBlock__Wrapper">
								<div
									class="
										LoudzTestimonialBlock__Content
										LoudzTestimonialBlock__Content--blockStyle-{{ section.settings.testimonial_box_style }}
									"
								>
									{% if testimonial_text != blank %}
										<div class="LoudzTestimonialBlockDescription">
											<div class="LoudzTestimonialBlockStarShape">
												{% assign rating = block.settings.stars_rating | default: 5 %}
												{% assign full_count = rating | floor %}
												{% assign decimal = rating | modulo: 1 %}
												{% if decimal > 0 %}
													{% assign has_half = true %}
													{% assign empty_count = 5 | minus: full_count | minus: 1 %}
												{% else %}
													{% assign has_half = false %}
													{% assign empty_count = 5 | minus: full_count %}
												{% endif %}
												{% for i in (1..full_count) %}
													{{ loudz_filled_icon }}
												{% endfor %}
												{% if has_half %}
													<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
														<defs>
															<clipPath id="left-half-{{ block.id }}">
																<rect x="0" y="0" width="10" height="20"/>
															</clipPath>
															<clipPath id="right-half-{{ block.id }}">
																<rect x="10" y="0" width="10" height="20"/>
															</clipPath>
														</defs>
														<!-- Left half: filled -->
														<g clip-path="url(#left-half-{{ block.id }})">
															{% case section.settings.stars_shape %}
																{% when 'stars' %}
																	<path d="M9.46127 2.55063L7.4308 6.70529L2.83882 7.36128C2.02663 7.48624 1.71425 8.48585 2.30777 9.07938L5.58776 12.2969L4.80681 16.8264C4.68186 17.6386 5.55652 18.2633 6.275 17.8885L10.3672 15.7331L14.4281 17.8885C15.1466 18.2633 16.0213 17.6386 15.8963 16.8264L15.1153 12.2969L18.3953 9.07938C18.9889 8.48585 18.6765 7.48624 17.8643 7.36128L13.3035 6.70529L11.2418 2.55063C10.8982 1.83216 9.83613 1.80092 9.46127 2.55063Z" fill="var(--section-stars-color)"/>
																{% when 'outline_stars' %}
																	<path d="M11.2418 2.55063C10.8982 1.83216 9.83613 1.80092 9.46127 2.55063L7.4308 6.70529L2.83882 7.36128C2.02663 7.48624 1.71425 8.48585 2.30777 9.07938L5.58776 12.2969L4.80681 16.8264C4.68186 17.6386 5.55652 18.2633 6.275 17.8885L10.3672 15.7331L14.4281 17.8885C15.1466 18.2633 16.0213 17.6386 15.8963 16.8264L15.1153 12.2969L18.3953 9.07938C18.9889 8.48585 18.6765 7.48624 17.8643 7.36128L13.3035 6.70529L11.2418 2.55063Z" fill="var(--section-stars-color)"/>
																{% when 'pointed_stars' %}
																	<path d="M10.5 1L12.6329 7.56434H19.535L13.9511 11.6213L16.084 18.1857L10.5 14.1287L4.91604 18.1857L7.04893 11.6213L1.46497 7.56434H8.36712L10.5 1Z" fill="var(--section-stars-color)"/>
																{% when 'heart_stars' %}
																	<path d="M10 4.89321L10.6121 4.27677C12.3022 2.57449 15.0423 2.57448 16.7324 4.27677C18.4225 5.97905 18.4225 8.739 16.7324 10.4413L10 17.2223L3.26757 10.4412C1.57748 8.73895 1.57747 5.979 3.26757 4.27671C4.95767 2.57443 7.69786 2.57443 9.38796 4.27671L10 4.89321Z" fill="var(--section-stars-color)"/>
															{% endcase %}
														</g>
														<!-- Right half: empty -->
														<g clip-path="url(#right-half-{{ block.id }})">
															{% case section.settings.stars_shape %}
																{% when 'outline_stars' %}
																	<path fill-rule="evenodd" clip-rule="evenodd" d="M11.2418 2.55063C10.8982 1.83216 9.83613 1.80092 9.46127 2.55063L7.4308 6.70529L2.83882 7.36128C2.02663 7.48624 1.71425 8.48585 2.30777 9.07938L5.58776 12.2969L4.80681 16.8264C4.68186 17.6386 5.55652 18.2633 6.275 17.8885L10.3672 15.7331L14.4281 17.8885C15.1466 18.2633 16.0213 17.6386 15.8963 16.8264L15.1153 12.2969L18.3953 9.07938C18.9889 8.48585 18.6765 7.48624 17.8643 7.36128L13.3035 6.70529L11.2418 2.55063ZM16.2108 8.84095L12.1777 8.26084L10.3564 4.59071L8.56273 8.26084L4.49356 8.84215L7.41447 11.7074L6.72051 15.7324L10.3702 13.8101L13.9816 15.7269L13.2886 11.7074L16.2108 8.84095Z" fill="var(--section-empty-stars-color)"/>
																{% else %}
																	{% case section.settings.stars_shape %}
																		{% when 'stars' %}
																			<path d="M9.46127 2.55063L7.4308 6.70529L2.83882 7.36128C2.02663 7.48624 1.71425 8.48585 2.30777 9.07938L5.58776 12.2969L4.80681 16.8264C4.68186 17.6386 5.55652 18.2633 6.275 17.8885L10.3672 15.7331L14.4281 17.8885C15.1466 18.2633 16.0213 17.6386 15.8963 16.8264L15.1153 12.2969L18.3953 9.07938C18.9889 8.48585 18.6765 7.48624 17.8643 7.36128L13.3035 6.70529L11.2418 2.55063C10.8982 1.83216 9.83613 1.80092 9.46127 2.55063Z" stroke="var(--section-empty-stars-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
																		{% when 'pointed_stars' %}
																			<path d="M10.5 1L12.6329 7.56434H19.535L13.9511 11.6213L16.084 18.1857L10.5 14.1287L4.91604 18.1857L7.04893 11.6213L1.46497 7.56434H8.36712L10.5 1Z" stroke="var(--section-empty-stars-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
																		{% when 'heart_stars' %}
																			<path d="M10 4.89321L10.6121 4.27677C12.3022 2.57449 15.0423 2.57448 16.7324 4.27677C18.4225 5.97905 18.4225 8.739 16.7324 10.4413L10 17.2223L3.26757 10.4412C1.57748 8.73895 1.57747 5.979 3.26757 4.27671C4.95767 2.57443 7.69786 2.57443 9.38796 4.27671L10 4.89321Z" stroke="var(--section-empty-stars-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
																	{% endcase %}
																{% endcase %}
															</g>
													</svg>
												{% endif %}
												{% for i in (1..empty_count) %}
													{{ loudz_empty_icon }}
												{% endfor %}
											</div>
											{%- liquid
												assign testimonial_text_words = testimonial_text | split: " "
												assign testimonial_html_arr = ""

												for word in testimonial_text_words
													assign testimonial_html_arr = testimonial_html_arr | append: "<span> " | append: word | append: " </span>"
												endfor

												assign testimonial_html = testimonial_html_arr | join: " "
											-%}
											<div class="LoudzTestimonialBlockTextWrapper">
												<loudz-expandable-text class="LoudzTestimonialBlockText">
													{{ testimonial_html }}
												</loudz-expandable-text>
												<span class="LoudzTestimonialBlockText--arrow">
													<svg
														width="14"
														height="8"
														viewBox="0 0 14 8"
														fill="none"
														xmlns="http://www.w3.org/2000/svg"
													>
														<path d="M13 1L7 7L1 1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
													</svg>
												</span>
											</div>
										</div>
									{% endif %}
									{% assign show_author = false %}
									{% if author_name != blank or author_additional_text != blank or author_photo != blank or section.settings.enable_reviewer_photo %}
										{% assign show_author = true %}
									{% endif %}
									{% if show_author %}
										<div class="LoudzTestimonialBlockAuthor">
											{%- if section.settings.enable_reviewer_photo -%}
												<div class="LoudzTestimonialBlockAuthor__AuthorPhoto">
													{%- if author_photo != blank -%}
														{{-
															author_photo
															| image_url: width: author_photo.width
															| image_tag:
																sizes: "100vw",
																widths: "400, 600, 800, 1200, 1600, 1800, 2400, 2800, 3200",
																fetchpriority: "low",
																loading: "lazy",
																class: "LoudzTestimonialBlockAuthor__AuthorPhoto--photo"
														-}}
													{%- else -%}
														<img
															src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E"
															class="LoudzTestimonialBlockAuthor__AuthorPhoto--photo"
															alt="Reviewer placeholder"
															loading="lazy"
															width="48"
															height="48"
														>
													{%- endif -%}
												</div>
											{%- endif -%}
											<div class="LoudzTestimonialBlockAuthor__Text">
												<div class="LoudzTestimonialBlockAuthor__AuthorName">
													{{ author_name }}
												</div>
												<div class="LoudzTestimonialBlockAuthor__AuthorAddText">
													{{ author_additional_text }}
												</div>
											</div>
										</div>
									{% endif %}
								</div>
							</div>
						</li>
						 {%- endif -%}
					{%- endfor -%}
				</ul>
				<div class="LoudzCarousel__Navigation">
					<div class="LoudzNavigationButtons">
						<button class="LoudzNavigationButtons__Button LoudzNavigationButtons__Button--disabled left-chevron">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="24"
								height="24"
								viewBox="0 0 24 24"
								fill="none"
							>
								<path d="M14 18L8 12L14 6" stroke="#222" stroke-linecap="round"></path>
							</svg>
						</button>
						<button class="LoudzNavigationButtons__Button right-chevron">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="24"
								height="24"
								viewBox="0 0 24 24"
								fill="none"
							>
								<path d="M9 6L15 12L9 18" stroke="#222" stroke-linecap="round"></path>
							</svg>
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</loudz-testimonial-text>

{% schema %}
{
	"name": "Testimonial 2",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
