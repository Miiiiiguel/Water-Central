		}
	}
	@media screen and (min-width: 1024px) {
  .loudz__form.loudz__flex {
    margin-left: 0;    /* reset */
    transform: translateX(-12px); /* move left by 50px */
  }
}

</style>

<script>
	function setStorageItem(key, value, days) {
		const expiry = new Date(Date.now() + days * 86400000).getTime();
		localStorage.setItem(key, JSON.stringify({ value, expiry }));
	}

	function getStorageItem(key) {
		const item = localStorage.getItem(key);
		if (!item) return null;
		const { value, expiry } = JSON.parse(item);
		if (expiry && Date.now() > expiry) {
			localStorage.removeItem(key);
			return null;
		}
		return value;
	}

	function initializePopup() {
		const popupOverlay = document.querySelector('.loudz__popup');
		if (!popupOverlay) return;

		const customizationMode = popupOverlay.getAttribute('data-customization-mode') === 'true';
		const shouldShow = customizationMode || (!getStorageItem('popup_closed') && !getStorageItem('popup_subscribed'));
		if (!shouldShow) return;

		const popupContainer = popupOverlay.querySelector('.loudz__container');
		const closeBtn = popupOverlay.querySelector('.icon-close');
		const popupLink = popupOverlay.querySelector('.loudz__popup-link');
		const form = popupOverlay.querySelector('form');

		if (!popupContainer) return;

		const delaySeconds = Number(popupOverlay.getAttribute('data-delay')) || 0;

		// Show popup function
		const showPopup = () => {
			popupOverlay.classList.add('active');
			popupContainer.classList.add('active');
		};

		// Close popup function
		const closePopup = () => {
			popupOverlay.classList.remove('active');
			popupContainer.classList.remove('active');
			if (!customizationMode) {
				setStorageItem('popup_closed', true, 1);
			}
		};

		// Delay logic
		if (delaySeconds === 0) {
			showPopup();
		} else {
			const delayMs = delaySeconds * 1000;
			setTimeout(showPopup, delayMs);
		}

		// Close popup when clicking on overlay (loudz__popup)
		popupOverlay.addEventListener('click', () => {
			closePopup();
		});

		// Prevent close when clicking inside the container
		popupContainer.addEventListener('click', (event) => {
			event.stopPropagation();
		});

		// Close popup on clicking the close button
		if (closeBtn) {
			closeBtn.addEventListener('click', (event) => {
				event.stopPropagation(); // Optional, prevents bubbling
				closePopup();
			});
		}

		// Close popup on clicking the popup link
		if (popupLink) {
			popupLink.addEventListener('click', (event) => {
				event.stopPropagation();
				closePopup();
			});
		}

		// Handle form submission for subscribe
		if (form) {
			form.addEventListener('submit', (event) => {
				// Close popup immediately
				closePopup();
				// Set subscribed cookie after a short delay to assume success
				setTimeout(() => {
					if (!customizationMode) {
						setStorageItem('popup_subscribed', true, 20);
					}
				}, 1000);
			});
		}
	}	

document.addEventListener('DOMContentLoaded', initializePopup);
document.addEventListener('shopify:section:load', initializePopup);
document.addEventListener('shopify:section:select', initializePopup);

</script>

<div id="loudz-{{ section.id }}" class="loudz-{{ section.id }}" >
	<div {{ html_id }} data-delay="{{ section.settings.popup_delay }}" data-customization-mode="{{ section.settings.enable_customization_mode | json }}" class="{{'loudz__popup loudz__flex '| append: section.settings.html_class | strip }}">
		<div class="loudz__container loudz__flex">
			<div class="loudz__image-wrapper">
				{% if section.settings.image != blank %}
					{{ section.settings.image | image_url: width: 354 |  image_tag: loading: 'lazy', class: "loudz__img"  }}
					{% else %}
					<img src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E" alt="Placeholder" class="loudz__img" loading="lazy">
				{% endif %}
			</div>

<div class="loudz__form loudz__flex"> 
	{% unless section.settings.disable_icon %}
	<div class="loudz__icon{% if section.settings.custom_svg_code != blank %} loudz-svg-custom{% endif %}">
		{% if section.settings.enable_custom_image and section.settings.popup_icon != blank %}
			{{ section.settings.popup_icon |  image_url: width: 200 | image_tag: loading: 'lazy' }}
		{% elsif section.settings.custom_svg_code != blank %}
			{{ section.settings.custom_svg_code }}
		{% else %}
			<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
				<g id="SVGRepo_bgCarrier" stroke-width="0"></g>
				<g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
				<g id="SVGRepo_iconCarrier">
