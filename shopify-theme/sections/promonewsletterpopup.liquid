{% capture html_id %} 
	{% if section.settings.html_id != blank %}
		id= "{{ section.settings.html_id | handleize }}"
	{% endif %}
{% endcapture %}

{% stylesheet %}
	.loudz-newsletter-2 * {
		margin: 0;
		padding: 0;
	}

	.loudz-newsletter-2 a {
		color: inherit;
	}

	.loudz-newsletter-2 .loudz__popup {
		opacity: 0;
		visibility: hidden;
		align-items: center;
		justify-content: center;
		height: 100vh;
		position: fixed;
		inset: 0;
		transition: all 0.3s ease-in-out;
	}

	.loudz-newsletter-2 .loudz__popup.active {
		visibility: visible;
		pointer-events: all;
		opacity: 1;
		z-index: 999;
	}

	.loudz-newsletter-2 .loudz__popup:after {
    content: "";
  position: fixed;       /* fixes it to the viewport */
  top: 0;                /* anchor to top */
  left: 0;               /* anchor to left */
  width: 100%;           /* span entire width */
  height: 100%;          /* span entire height */
  background-color: var(--loudz-overlay-color, #000000);
  opacity: var(--loudz-overlay-opacity, 0.5);
  z-index: -1;
	}
	
	.loudz-newsletter-2 .loudz__container {
		position: relative;
		padding-block: var(--loudz-padding-top, 0px) var(--loudz-padding-bottom, 0px);
		background: var(--loudz-section-background, #FFFFFF);
		max-width: var(--loudz-section-width, 790px);
		flex-direction: var(--loudz-image-position, row);
		gap: var(--loudz-horizontal-gap, 50px);
		margin-inline: auto;
		padding-inline: 20px;
		width: calc(100% - 40px);
		justify-content: center;
		align-items: center;
		max-height: 90vh;
		overflow: scroll;
		border-radius: var(--loudz-popup-border-radius, 0px);
	}

	.loudz-newsletter-2 .loudz__container::-webkit-scrollbar {
  	display: none;	
	}	

	.loudz-newsletter-2 .loudz__container.active {
		opacity: 1;
		visibility: visible;
	}
	
	.loudz-newsletter-2 .loudz__flex {
		display: flex;
	}

	.loudz-newsletter-2 .loudz__icon {
		width: var(--loudz-icon-width, 72px);
		font-size: 0;
		color: var(--loudz-svg-color, #000000);
	}

	.loudz-newsletter-2 .loudz__icon.loudz-svg-custom {
		width: var(--loudz-svg-size, 72px);
		height: var(--loudz-svg-size, 72px);
	}
	
	.loudz-newsletter-2 .loudz__icon svg {
		width: 100%;
		height: 100%;
		object-fit: contain;
		stroke: currentColor;
	}
	
	.loudz-newsletter-2 .loudz__top-text {
		font-size: var(--loudz-top-text-size, 18px);
		font-weight: var(--loudz-top-text-weight, 400);
		color: var(--loudz-heading-color, #000000);
		text-align: center;
		margin-bottom: var(--loudz-top-text-to-heading-gap, 8px);
	}
	
	.loudz-newsletter-2 .loudz__form {
		background: var(--loudz-section-background, #FFFFFF);
		max-width: 340px;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		position: static;
		padding: 0;
	}
	
	.loudz-newsletter-2 .loudz__form .loudz__popup-link {
		color: var(--loudz-popup-link-color, #000000);
		font-size: 16px;
		font-weight: 400;
		margin-top: 20px;
		cursor: pointer;
		transition: all 0.2s ease-in-out;
	}
	
	.loudz-newsletter-2 .loudz__form .loudz__popup-link a {
		border-bottom: 1px solid currentColor;
		text-decoration: none;
		color: inherit;
	}
	
	.loudz-newsletter-2 .loudz__form .loudz__popup-link:hover {
		opacity: 0.7;
	}
	
	.loudz-newsletter-2 .loudz__overlay {
		background-color: var(--loudz-overlay-color);
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		transition: all 0.3s ease-in-out;
		visibility: hidden;
		display: flex;
		justify-content: center;
		align-items: center;
		z-index: -1;
	}
	
	.loudz-newsletter-2 .loudz__overlay.active {
		opacity: var(--loudz-overlay-opacity, 1);
		visibility: visible;
	}
	
	.loudz-newsletter-2 .loudz__form form {
		margin-top: var(--loudz-form-top-space, 32px);
		width: 100%;
	}
	
	.loudz-newsletter-2 .loudz__heading {
		font-size: var(--loudz-heading-size, 24px);
		font-weight: var(--loudz-heading-text-weight, 500);
		color: var(--loudz-heading-color, #000000);
		margin-top: var(--loudz-heading-top-space, 16px);
		text-align: center;
	}
	
	.loudz-newsletter-2 .loudz__heading a {
		color: inherit;
	}
	
	.loudz-newsletter-2 p {
		font-size: var(--loudz-description-size, 16px);
		font-weight: var(--loudz-description-text-weight, 400);
		color: var(--loudz-description-color, #4B4D6C);
		margin-top: var(--loudz-heading-top-space, 16px);
		text-align: center;
	}

	.loudz-newsletter-2 .loudz__icon img,
	.loudz-newsletter-2 .loudz__icon svg {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	
	.loudz-newsletter-2 input[type="email"] {
		width: 100%;
		color: var(--loudz-input-color, #000000);
		font-size: var(--loudz-input-text-size, 16px);
		font-weight: var(--loudz-input-text-weight, 400);
		border: var(--loudz-input-border-thickness, 1px) solid var(--loudz-input-border-color, #808080);
		border-radius: var(--loudz-input-border-radius, 0px);
		background: var(--loudz-input-background-color, #FFFFFF);
		padding: 16px 12px;
	}
	
	.loudz-newsletter-2 input[type="email"]::placeholder {
		color: var(--loudz-input-placeholder-color);
	}
	
	.loudz-newsletter-2 .loudz__submit-button {
		width: 100%;
		color: var(--loudz-button-text-color, #FFFFFF);
		background-color: var(--loudz-button-background-color, #000000);
		font-size: var(--loudz-button-text-size, 16px);
		font-weight: var(--loudz-button-text-weight, 400);
		margin-top: var(--loudz-button-top-space, 12px);
		border-radius: var(--loudz-button-border-radius, 0px);
		padding-block: 16px;
		border: 1px solid transparent;
		cursor: pointer;
		transition: all 0.2s ease-in-out;
	}
	
	.loudz-newsletter-2 .loudz__submit-button:hover {
		filter: brightness(0.9);
	}
	
	.loudz-newsletter-2 .loudz__image-wrapper {
		background-color: #f8f8f8;
		width: calc(100% + 40px);
		position: relative;
		aspect-ratio: 1 / 1;
		align-self: normal;
		margin-left: -20px;
	}
	
	.loudz-newsletter-2 .loudz__image-wrapper svg,
	.loudz-newsletter-2 .loudz__image-wrapper img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		position: absolute;
	}
	
	.loudz-newsletter-2 .icon-close {
		stroke: #000000;
		width: 16px;
		height: 16px;
		position: absolute;
		top: 30px;
		right: 30px;
		cursor: pointer;
	}
	
	@media screen and (min-width: 768px) {
		.loudz-newsletter-2 .loudz__form {
			padding-block: 60px;
			position: relative;
		}
	
		.loudz-newsletter-2 .loudz__image-wrapper {
			aspect-ratio: auto;
			max-width: 433px;
		}
	
		.loudz-newsletter-2 .icon-close {
			top: 24px;
			right: 10px;
		}
	}
{% endstylesheet %}

<style>
	#loudz-{{ section.id }} {
		--loudz-padding-top: {{ section.settings.mobile_top_padding }}px;
    --loudz-padding-bottom: {{ section.settings.mobile_bottom_padding }}px;
		--loudz-section-width: {{ section.settings.section_width }}px;
		--loudz-section-background: {{ section.settings.background_gradient | default: section.settings.background_color }};
		--loudz-overlay-color: {{ section.settings.overlay_color}};
		--loudz-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
		--loudz-icon-width: {{ section.settings.mobile_icon_width }}px;
		--loudz-svg-size: {{ section.settings.svg_size }}px;
		--loudz-svg-color: {{ section.settings.svg_color }};
		--loudz-image-position: {{ section.settings.mobile_image_position }};
		--loudz-heading-top-space: {{ section.settings.mobile_heading_top_space }}px;
		--loudz-heading-size: {{ section.settings.mobile_heading_text_size }}px;
		--loudz-heading-text-weight: {{ section.settings.heading_text_weight }};
		--loudz-heading-color: {{ section.settings.heading_color }};
		--loudz-description-top-space: {{ section.settings.mobile_top_space }}px;
		--loudz-description-size: {{ section.settings.mobile_description_text_size }}px;
		--loudz-description-text-weight: {{ section.settings.description_text_weight }};
		--loudz-description-color: {{ section.settings.description_color }};
		--loudz-form-top-space: {{ section.settings.mobile_form_top_space }}px;
		--loudz-input-text-size: {{ section.settings.mobile_input_text_size }}px;
		--loudz-input-color: {{ section.settings.input_color }};
		--loudz-input-background-color: {{ section.settings.input_background_color }};
		--loudz-input-text-weight: {{ section.settings.input_text_weight }};
		--loudz-input-border-radius: {{ section.settings.input_border_radius }}px;
		--loudz-input-border-color: {{ section.settings.input_border_color }};
		--loudz-input-border-thickness: {{ section.settings.input_border_thickness }}px;
		--loudz-input-placeholder-color: {{ section.settings.input_placeholder_color }};
		--loudz-button-top-space: {{ section.settings.mobile_button_top_space }}px;
		--loudz-button-width: {{ section.settings.button_width }}%;
		--loudz-button-border-radius: {{ section.settings.button_border_radius }}px;
		--loudz-button-text-size: {{ section.settings.mobile_button_text_size }}px;
		--loudz-button-text-color: {{ section.settings.button_text_color }};
		--loudz-button-background-color: {{ section.settings.button_background }};
		--loudz-button-text-weight: {{ section.settings.button_text_weight }};
		--loudz-horizontal-gap : {{ section.settings.desktop_gap_between_image_form }}px;
		--loudz-popup-link-color: {{ section.settings.popup_link_color }};
		--loudz-popup-border-radius: {{ section.settings.popup_border_radius }}px;
		--loudz-top-text-size: {{ section.settings.mobile_top_text_size }}px;
		--loudz-top-text-weight: {{ section.settings.top_text_weight }};
		--loudz-top-text-to-heading-gap: {{ section.settings.top_text_to_heading_gap }}px;
		}

	@media screen and (min-width: 768px) {
		#loudz-{{ section.id }} {
			--loudz-padding-top: {{ section.settings.desktop_top_padding }}px;
			--loudz-padding-bottom: {{ section.settings.desktop_bottom_padding }}px;
			--loudz-icon-width: {{ section.settings.desktop_icon_width }}px;
			--loudz-heading-top-space: {{ section.settings.desktop_heading_top_space }}px;
			--loudz-heading-size: {{ section.settings.desktop_heading_text_size }}px;
			--loudz-description-top-space: {{ section.settings.desktop_top_space }}px;
			--loudz-description-size: {{ section.settings.desktop_description_text_size }}px;
			--loudz-form-top-space: {{ section.settings.desktop_form_top_space }}px;
			--loudz-input-text-size: {{ section.settings.desktop_input_text_size }}px;
			--loudz-button-top-space: {{ section.settings.desktop_button_top_space }}px;
			--loudz-button-text-size: {{ section.settings.desktop_button_text_size }}px;
			--loudz-horizontal-gap: {{ section.settings.desktop_gap_between_image_form }}px;
			--loudz-image-position: {{ section.settings.desktop_image_position }};
