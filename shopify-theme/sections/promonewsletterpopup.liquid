				</g>
			</svg>
		{% endif %}

				</div>
	{% endunless %}
	{% if section.settings.enable_top_text %}
	<div class="loudz__top-text">{{ section.settings.top_text }}</div>
	{% endif %}
				<h2 class="loudz__heading">{{ section.settings.heading }}</h2>
				<p>{{ section.settings.description }}</p>
				{% form 'customer'%}
					<input type="email" name="contact[email]" value="{{ form.email }}" required placeholder="{{ section.settings.placeholder_text }}">
					<button class="loudz__submit-button" type="submit">{{ section.settings.button_text }}</button>
				{% endform %}
				{% if section.settings.popup_link != blank %}
					<span class="loudz__popup-link">{{ section.settings.popup_link }}</span>
				{% endif %}
					<svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" class="icon icon-close" fill="none" viewBox="0 0 18 17">
						<path d="M.865 15.978a.5.5 0 00.707.707l7.433-7.431 7.579 7.282a.501.501 0 00.846-.37.5.5 0 00-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 10-.707-.708L8.991 7.853 1.413.573a.5.5 0 10-.693.72l7.563 7.268-7.418 7.417z" fill="currentColor">
					</svg>
				</div>
		</div>
	</div>
</div>

{% schema %}
{
	"name": "Promotional Newsletter",

	"class": "loudz-section loudz-newsletter-2",
	"tag": "section",
	"settings": [
		{


			"type": "header",
			"content": "Display Behavior"
		},
		{
			"type": "checkbox",
			"id": "enable_customization_mode",
			"label": "Enable Customization Mode (ignores cookies for editing)",
			"default": true

			},
		{
			"type": "number",
			"id": "popup_delay",
			"default": 0,
			"label": "Delay before popup appears (seconds)",
			"info": "Set to 0 for immediate display; otherwise, enter seconds to wait."
		},
		{
			"type": "header",
			"content": "Top Text"
		},
		{
			"type": "checkbox",
			"id": "enable_top_text",
			"label": "Enable Top Text",
			"default": true
		},
		{
			"type": "text",
			"id": "top_text",
			"label": "Top Text Content",
			"default": "👋 Hey You"
		},
		{
			"type": "select",
			"id": "top_text_weight",
			"label": "Top Text Font Weight",
			"options": [
				{
					"value": "100",
					"label": "Thin"
				},
				{
					"value": "200",
					"label": "Extra light"
				},
				{
					"value": "300",
					"label": "Light"
				},
				{
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra Bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
			],
			"default": "400"
		},
		{
			"type": "range",
			"id": "desktop_top_text_size",
			"label": "Desktop: Top Text Font Size (px)",
			"min": 12,
			"max": 48,
			"step": 1,
			"unit": "px",
			"default": 18
		},
		{
			"type": "range",
			"id": "mobile_top_text_size",
			"label": "Mobile: Top Text Font Size (px)",
			"min": 12,
			"max": 48,
			"step": 1,
			"unit": "px",
			"default": 18
		},
		{
			"type": "range",
			"id": "top_text_to_heading_gap",
			"label": "Gap between Top Text and Heading (px)",
			"min": 0,
