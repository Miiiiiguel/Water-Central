<section
  id="nike-vaporfly-section-{{ section.id }}"
  data-speed="{{ section.settings.speed_progress }}"
  data-endurance="{{ section.settings.endurance_progress }}"
  data-comfort="{{ section.settings.comfort_progress }}"
  data-lasting="{{ section.settings.lasting_progress }}"
>
  <div class="container">
    <!-- Inline editable heading -->
    <div class="header">
      <div class="inline-richtext" contenteditable="true">
        {{ section.settings.heading_text }}
      </div>
    </div>
    <div class="circles">
      <div class="circle-item circle-speed">
        <div class="circle-svg">
          <svg viewBox="0 0 100 100">
            <circle class="circle-bg" cx="50" cy="50" r="48"></circle>
            <circle class="circle-progress"
                    cx="50" cy="50" r="48"
                    stroke-dasharray="301"
                    stroke-dashoffset="0"></circle>
          </svg>
          <!-- Editable progress value -->
          <div class="circle-text inline-richtext" contenteditable="true">
            {{ section.settings.speed_progress }}
          </div>
        </div>
        <div class="circle-label">{{ section.settings.speed_label }}</div>
      </div>
      <div class="circle-item circle-endurance">
        <div class="circle-svg">
          <svg viewBox="0 0 100 100">
            <circle class="circle-bg" cx="50" cy="50" r="48"></circle>
            <circle class="circle-progress"
                    cx="50" cy="50" r="48"
                    stroke-dasharray="301"
                    stroke-dashoffset="0"></circle>
          </svg>
          <div class="circle-text inline-richtext" contenteditable="true">
            {{ section.settings.endurance_progress }}
          </div>
        </div>
        <div class="circle-label">{{ section.settings.endurance_label }}</div>
      </div>
      <div class="circle-item circle-comfort">
        <div class="circle-svg">
          <svg viewBox="0 0 100 100">
            <circle class="circle-bg" cx="50" cy="50" r="48"></circle>
            <circle class="circle-progress"
                    cx="50" cy="50" r="48"
                    stroke-dasharray="301"
                    stroke-dashoffset="0"></circle>
          </svg>
          <div class="circle-text inline-richtext" contenteditable="true">
            {{ section.settings.comfort_progress }}
          </div>
        </div>
        <div class="circle-label">{{ section.settings.comfort_label }}</div>
      </div>
      <div class="circle-item circle-lasting">
        <div class="circle-svg">
          <svg viewBox="0 0 100 100">
            <circle class="circle-bg" cx="50" cy="50" r="48"></circle>
            <circle class="circle-progress"
                    cx="50" cy="50" r="48"
                    stroke-dasharray="301"
                    stroke-dashoffset="0"></circle>
          </svg>
          <div class="circle-text inline-richtext" contenteditable="true">
            {{ section.settings.lasting_progress }}
          </div>
        </div>
        <div class="circle-label">{{ section.settings.lasting_label }}</div>
      </div>
    </div>
  </div>

  <style>
    /* Scoped CSS for Nike Vaporfly Section */
    #nike-vaporfly-section-{{ section.id }} {
      background-color: {{ section.settings.section_bg_color }};
      text-align: center;
      /* Desktop side padding */
      padding-left: {{ section.settings.padding_desktop }}px;
      padding-right: {{ section.settings.padding_desktop }}px;
      /* Top & Bottom padding */
      padding-top: {{ section.settings.top_padding }}px;
      padding-bottom: {{ section.settings.bottom_padding }}px;
    }
    /* Header and instruction styling */
    #nike-vaporfly-section-{{ section.id }} .header {
      margin-bottom: {{ section.settings.vertical_spacing }}px;
    }
    #nike-vaporfly-section-{{ section.id }} .header .inline-richtext {
      color: {{ section.settings.heading_text_color }};
      font-size: 2rem;
      margin: 0;
    }
    #nike-vaporfly-section-{{ section.id }} .instruction {
      font-size: 0.9rem;
      color: #666;
      margin-top: 4px;
    }
    #nike-vaporfly-section-{{ section.id }} .circles {
      display: flex;
      justify-content: center;
      gap: {{ section.settings.circle_spacing_desktop }}px;
    }
    #nike-vaporfly-section-{{ section.id }} .circle-item {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    /* Circle SVG dimensions for desktop */
    #nike-vaporfly-section-{{ section.id }} .circle-svg {
      position: relative;
      width: {{ section.settings.circle_scale_desktop }}px;
      height: {{ section.settings.circle_scale_desktop }}px;
    }
    #nike-vaporfly-section-{{ section.id }} .circle-svg svg {
      width: 100%;
      height: 100%;
    }
    /* Unfilled circle */
    #nike-vaporfly-section-{{ section.id }} .circle-bg {
      stroke: {{ section.settings.circle_bg_color }};
      stroke-width: {{ section.settings.circle_thickness }};
      fill: transparent;
    }
    /* Filled circle */
    #nike-vaporfly-section-{{ section.id }} .circle-progress {
      stroke: {{ section.settings.circle_progress_color }};
      stroke-width: calc({{ section.settings.circle_thickness }} + 0.35) !important;
      stroke-linecap: round;
      fill: transparent;
      transition: stroke-dashoffset 0.3s ease;
    }
    /* Editable progress number */
    #nike-vaporfly-section-{{ section.id }} .circle-text {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: {{ section.settings.number_font_size }}px;
      font-weight: 600;
      color: {{ section.settings.number_text_color }};
      outline: none;
    }
    /* Label texts */
    #nike-vaporfly-section-{{ section.id }} .circle-label {
      margin-top: 1rem;
      font-size: {{ section.settings.label_font_size }}px;
      color: {{ section.settings.label_text_color }};
    }
    /* Mobile Responsive Styles */
    @media (max-width: 767px) {
      #nike-vaporfly-section-{{ section.id }} {
        padding-left: {{ section.settings.padding_mobile }}px;
        padding-right: {{ section.settings.padding_mobile }}px;
      }
      #nike-vaporfly-section-{{ section.id }} .circles {
        gap: {{ section.settings.circle_spacing_mobile }}px;
        flex-wrap: wrap;
        row-gap: {{ section.settings.vertical_gap_mobile }}px;
      }
      #nike-vaporfly-section-{{ section.id }} .circle-svg {
        width: {{ section.settings.circle_scale_mobile }}px;
        height: {{ section.settings.circle_scale_mobile }}px;
      }
    }
  </style>

  <script>
    (function(){
      // Get the section element by its unique id.
      var sectionElement = document.getElementById('nike-vaporfly-section-{{ section.id }}');
      if (!sectionElement) return;
      
      // Update a single progress circle based on its inline editable text.
      function updateCircle(circleElement) {
        var progressTextElement = circleElement.querySelector('.circle-text');
        var percentage = parseInt(progressTextElement.textContent) || 0;
        var circle = circleElement.querySelector('.circle-progress');
        var dasharray = 301;
        var offset = (100 - percentage) * dasharray / 100;
        circle.setAttribute('stroke-dashoffset', offset);
        progressTextElement.textContent = percentage + '%';
      }
      // Update all progress circles within this section.
      function updateAllCircles() {
        var circles = sectionElement.querySelectorAll('.circle-item');
        circles.forEach(function(circle) {
          updateCircle(circle);
        });
      }
      // Listen for input changes on inline-richtext elements within this section.
      function addRichtextListeners() {
        var richtextElements = sectionElement.querySelectorAll('.inline-richtext');
        richtextElements.forEach(function(el) {
          el.addEventListener('input', function() {
            updateAllCircles();
          });
        });
      }
      document.addEventListener("DOMContentLoaded", function(){
        updateAllCircles();
        addRichtextListeners();
        // Observe changes in the section attributes (for theme editor live updates)
        var observer = new MutationObserver(function(mutationsList) {
          mutationsList.forEach(function(mutation) {
            if (mutation.type === 'attributes') {
              updateAllCircles();
            }
          });
        });
        observer.observe(sectionElement, { attributes: true });
      });
    })();
  </script>
</section>

