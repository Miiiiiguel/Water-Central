<style> 
  /* Container: Mobile max-width is used by default */
  .cookiebanner-{{ section.id }} {
    position: fixed;
    z-index: 9999;
    overflow: hidden;
    max-width: {{ section.settings.max_width_mobile }}px;
  }
  @media (min-width: 750px) {
    .cookiebanner-{{ section.id }} {
      max-width: {{ section.settings.max_width_desktop }}px;
    }
  }

  /* Mobile padding override using new mobile padding settings */
  @media (max-width: 749px) {
    .cookiebanner-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px !important;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px !important;
      padding-left: {{ section.settings.mobile_padding_left }}px !important;
      padding-right: {{ section.settings.mobile_padding_right }}px !important;
    }
  }

  /* Heading and text styles */
  .cookiebanner-{{ section.id }} .cookiebanner-heading {
    font-size: 19px;
    margin-bottom: 10px;
    font-weight: 700;
    /* Heading color is now customizable via the heading_color setting */
    color: {{ section.settings.heading_color }};
    text-align: {{ section.settings.heading_position }};
  }
  .cookiebanner-{{ section.id }} .cookiebanner-text,
  .cookiebanner-{{ section.id }} .cookiebanner-text p {
    font-size: 16px;
    margin-top: 0;
    margin-bottom: 20px;
  }

  /* Button styles */
  .cookiebanner-{{ section.id }} .cookiebanner-btn {
    padding: 10px 20px;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    width: fit-content;
    /* Added transition for smooth hover effects */
    transition: background-color 0.3s ease, color 0.3s ease, filter 0.3s ease;
  }
  .cookiebanner-{{ section.id }} .btn-wrapper {
    display: flex;
    gap: 12px;
  }

  /* Desktop Layout Banner 2:
     When the toggle is on, only on screens ≥750px, wrap the text and button wrapper in a flex container
     so that the text appears to the left and the buttons appear to the right.
     (Note: the heading remains above.) */
  @media (min-width: 750px) {
    .cookiebanner-{{ section.id }} .layout-banner-2-wrapper {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .cookiebanner-{{ section.id }} .layout-banner-2-wrapper .cookiebanner-text {
      flex: 1;
      margin-right: 20px;
    }
  }

  /* Mobile placement override using the mobile vertical position and (optional) horizontal offset */
  @media (max-width: 749px) {
    .cookiebanner-{{ section.id }} {
      {% if section.settings.placement_mobile == 'bottom-left' %}
        left: 20px !important;
        right: auto !important;
        bottom: {{ section.settings.vertical_position_mobile }}px !important;
        transform: none !important;
      {% elsif section.settings.placement_mobile == 'bottom-right' %}
        right: 20px !important;
        left: auto !important;
        bottom: {{ section.settings.vertical_position_mobile }}px !important;
        transform: none !important;
      {% elsif section.settings.placement_mobile == 'bottom-center' %}
        left: 50% !important;
        right: auto !important;
        bottom: {{ section.settings.vertical_position_mobile }}px !important;
        {% if section.settings.enable_mobile_banner_placement_slider %}
          transform: translateX(calc(-50% + {{ section.settings.mobile_banner_horizontal_offset }}px)) !important;
        {% else %}
          transform: translateX(-50%) !important;
        {% endif %}
      {% endif %}
    }
  }
</style>

<div
  class="cookiebanner-{{ section.id }}"
  style="
    {% if section.settings.enable_gradient_background %}
      background: linear-gradient({{ section.settings.gradient_degrees }}deg, {{ section.settings.gradient_color_1 }}, {{ section.settings.gradient_color_2 }}, {{ section.settings.gradient_color_3 }});
    {% else %}
      background-color: {{ section.settings.background_color }};
    {% endif %}

    border-radius: {{ section.settings.border_radius }}px;
    /* Desktop padding using separate top & bottom values */
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    padding-left: {{ section.settings.horizontal_padding_desktop }}px;
    padding-right: {{ section.settings.horizontal_padding_desktop }}px;

    /* Desktop placement using vertical_position_desktop */
    {% if section.settings.placement_desktop == 'bottom-left' %}
      bottom: {{ section.settings.vertical_position_desktop }}px;
      left: 20px;
    {% elsif section.settings.placement_desktop == 'bottom-right' %}
      bottom: {{ section.settings.vertical_position_desktop }}px;
      right: 20px;
    {% elsif section.settings.placement_desktop == 'bottom-center' %}
      bottom: {{ section.settings.vertical_position_desktop }}px;
      left: 50%;
      {% if section.settings.enable_desktop_banner_placement_slider %}
        transform: translateX(calc(-50% + {{ section.settings.desktop_banner_horizontal_offset }}px));
      {% else %}
        transform: translateX(-50%);
      {% endif %}
    {% endif %}

    {% if section.settings.banner_shadow == 'low' %}
      box-shadow: 0px 2px 4px rgba(0,0,0,0.1);
    {% elsif section.settings.banner_shadow == 'medium' %}
      box-shadow: 0px 4px 8px rgba(0,0,0,0.2);
    {% elsif section.settings.banner_shadow == 'high' %}
      box-shadow: 0px 8px 16px rgba(0,0,0,0.3);
    {% endif %}
  "
>
  {% if section.settings.heading != blank %}
    <div class="cookiebanner-heading">
      {{ section.settings.heading }}
    </div>
  {% endif %}

  {%- if section.settings.enable_layout_banner_2 -%}
    <!-- When Layout Banner 2 is enabled, wrap text and buttons in a flex container on desktop -->
    <div class="layout-banner-2-wrapper">
      {% if section.settings.text != blank %}
        <div
          class="cookiebanner-text"
          style="color: {{ section.settings.text_color }}; font-size: {{ section.settings.text_size }}px;"
        >
          {{ section.settings.text }}
        </div>
      {% endif %}
      <div class="btn-wrapper">
        {% for block in section.blocks %}
          {% assign block_id = block.id %}
          {% if block.settings.redirect_url != blank %}
            <a
              id="cookiebanner-btn-{{ block_id }}"
              class="cookiebanner-btn"
              href="{{ block.settings.redirect_url }}"
              style="
                background-color: {{ block.settings.button_color }};
                color: {{ block.settings.button_text_color }};
                border-color: {{ block.settings.button_border_color }};
                border-width: {{ block.settings.button_border_width }}px;
                border-style: solid;
                border-radius: {{ block.settings.button_border_radius }}px;
              "
              data-button-type="{{ block.type }}"
            >
              {{ block.settings.button_text }}
            </a>
          {% else %}
            <div
              id="cookiebanner-btn-{{ block_id }}"
              class="cookiebanner-btn"
              style="
                background-color: {{ block.settings.button_color }};
                color: {{ block.settings.button_text_color }};
                border-color: {{ block.settings.button_border_color }};
                border-width: {{ block.settings.button_border_width }}px;
                border-style: solid;
                border-radius: {{ block.settings.button_border_radius }}px;
              "
              data-button-type="{{ block.type }}"
            >
              {{ block.settings.button_text }}
            </div>
          {% endif %}
          <style>
            #cookiebanner-btn-{{ block_id }}:hover {
              background-color: {{ block.settings.button_hover_color }};
              color: {{ block.settings.button_hover_text_color }};
              filter: brightness(85%);
            }
          </style>
        {% endfor %}
      </div>
    </div>
  {%- else -%}
    <!-- Standard layout (stacked) -->
    {% if section.settings.text != blank %}
      <div
        class="cookiebanner-text"
        style="color: {{ section.settings.text_color }}; font-size: {{ section.settings.text_size }}px;"
      >
        {{ section.settings.text }}
      </div>
    {% endif %}
    <div class="btn-wrapper">
      {% for block in section.blocks %}
        {% assign block_id = block.id %}
        {% if block.settings.redirect_url != blank %}
          <a
            id="cookiebanner-btn-{{ block_id }}"
            class="cookiebanner-btn"
            href="{{ block.settings.redirect_url }}"
            style="
              background-color: {{ block.settings.button_color }};
              color: {{ block.settings.button_text_color }};
              border-color: {{ block.settings.button_border_color }};
              border-width: {{ block.settings.button_border_width }}px;
              border-style: solid;
              border-radius: {{ block.settings.button_border_radius }}px;
            "
            data-button-type="{{ block.type }}"
          >
            {{ block.settings.button_text }}
          </a>
        {% else %}
          <div
            id="cookiebanner-btn-{{ block_id }}"
            class="cookiebanner-btn"
            style="
              background-color: {{ block.settings.button_color }};
              color: {{ block.settings.button_text_color }};
              border-color: {{ block.settings.button_border_color }};
              border-width: {{ block.settings.button_border_width }}px;
              border-style: solid;
              border-radius: {{ block.settings.button_border_radius }}px;
            "
            data-button-type="{{ block.type }}"
          >
            {{ block.settings.button_text }}
          </div>
        {% endif %}
        <style>
          #cookiebanner-btn-{{ block_id }}:hover {
            background-color: {{ block.settings.button_hover_color }};
            color: {{ block.settings.button_hover_text_color }};
            filter: brightness(85%);
          }
        </style>
      {% endfor %}
    </div>
  {%- endif -%}
</div>

<script>
  // Handle accept or decline button clicks:
  (function () {
    const cookieConsent = document.cookie.split('; ').find((row) => row.startsWith('cookie_consent='));
    if (cookieConsent && cookieConsent.split('=')[1] === '1') {
      var banner = document.querySelector('.cookiebanner-{{ section.id }}');
      if(banner) banner.style.display = 'none';
      return;
    }
    const allButtons = document.querySelectorAll('.cookiebanner-{{ section.id }} .cookiebanner-btn');
    allButtons.forEach((button) => {
      button.addEventListener('click', function() {
        const buttonType = this.dataset.buttonType;
        if (buttonType === 'accept_button') {
          const date = new Date();
          const durationHours = parseFloat("{{ section.settings.cookie_acceptance_duration }}") || 720;
          date.setTime(date.getTime() + durationHours * 60 * 60 * 1000);
          document.cookie = `cookie_consent=1; expires=${date.toUTCString()}; path=/`;
        } else if (buttonType === 'decline_button') {
          document.cookie = 'cookie_consent=0; path=/';
        }
        var banner = document.querySelector('.cookiebanner-{{ section.id }}');
        if(banner) banner.style.display = 'none';
      });
    });
  })();
</script>

