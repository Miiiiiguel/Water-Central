<script>
function initHeader() {
  let header = document.querySelector('.header-{{ section.id }}');
  if (!header) return;

  // RESET any previous “forced” state (important when toggling in the editor)
  header.classList.remove('always-transparent'); 
  header.classList.remove('onscroll');

  const forceAlways = {{ force_always_transparent | json }};
  const transparentMode = {{ transparent_bg | json }}; // "all" | "home" | "none"
  const autoWhite = {{ auto_white_over_dark | json }} && !forceAlways;
  const isAlways = header.classList.contains('always');
  const isReveal = header.classList.contains('reveal');

  // Apply forced glass only when enabled
  if (forceAlways) {
    header.classList.add('transparent', 'always-transparent');
  } else {
    // If user chose "None", ensure we’re not stuck in transparent mode
    if (transparentMode === "none") {
      header.classList.remove('transparent');
    }
  }
  const html = document.documentElement;

// reflect the setting as a class on <html>
if ({{ disable_default_spacing | json }}) {
  html.classList.add('no-default-spacing-{{ section.id }}');
} else {
  html.classList.remove('no-default-spacing-{{ section.id }}');
}

// sticky class on <html> when behavior is "always" or "scroll_up"
function setStickyClass(){
  const isSticky = !header.classList.contains('top'); // “top” = not sticky
  html.classList.toggle('is-sticky-header', isSticky);
}

// keep CSS var in sync with the real rendered height (includes header padding)
function setHeaderHeight(){
  html.style.setProperty('--header-height', header.offsetHeight + 'px');
}

setStickyClass();
setHeaderHeight();
window.addEventListener('resize', setHeaderHeight);
window.addEventListener('scroll', setHeaderHeight);
window.addEventListener('load', setHeaderHeight); // after images/fonts load

  // Initialize scroll behavior if header has 'scroll' class
  if(header.classList.contains('scroll') && !header.classList.contains('top')) {
    const SCROLL_THRESHOLD = 100;
    const HIDE_DELAY = 60;
    let lastScroll = window.scrollY || 0;
    let ticking = false;
    let hideTimeout = null;

    function handleScroll() {
      if (ticking) return;
      ticking = true;
      
      window.requestAnimationFrame(() => {
        const currentScroll = window.scrollY || 0;
        const scrollDiff = currentScroll - lastScroll;
        
        // Always show header at the very top
        if (currentScroll === 0) {
          if (hideTimeout) clearTimeout(hideTimeout);
          header.classList.add('active');
          html.classList.remove('header-hidden');
        }
        // Handle reveal/hide for reveal mode only
        if (isReveal) {
          // Scrolling up - show header
          if (scrollDiff < -5) { // -5px threshold to prevent micro-scrolls
            if (hideTimeout) clearTimeout(hideTimeout);
            header.classList.add('active');
            html.classList.remove('header-hidden');
          } 
          // Scrolling down - hide header after delay if past threshold
          else if (scrollDiff > 5 && currentScroll > SCROLL_THRESHOLD) {
            if (hideTimeout) clearTimeout(hideTimeout);
            hideTimeout = setTimeout(() => {
              header.classList.remove('active');
              html.classList.add('header-hidden');
            }, HIDE_DELAY);
          }
        }
        // For always mode, ensure active when scrolled
        if (isAlways && currentScroll > 0) {
          header.classList.add('active');
        }
        
        // Handle transparent header states
        if (header.classList.contains('transparent') && !forceAlways) {
          if (currentScroll === 0) {
            header.classList.remove('onscroll');
          } else {
            header.classList.add('onscroll');
          }
        }
        
        lastScroll = currentScroll;
        ticking = false;
      });
    }

    // Set initial state
    if (window.scrollY > 0) {
      header.classList.add('onscroll');
    }

    if (isReveal && window.scrollY > SCROLL_THRESHOLD) {
      header.classList.remove('active');
      html.classList.add('header-hidden');
    }
    
    // Add scroll event listener
    window.addEventListener('scroll', handleScroll, { passive: true });
    
    // Initial update
    handleScroll();
  }
if (autoWhite) { checkUnderlyingColor(); } else { header.classList.remove('over-dark'); }
  let items = header.querySelectorAll('.header-menu-item-parent-{{ section.id }}');
  if(items) {
    items.forEach(el => {
      el.addEventListener("mouseenter", () => { header.classList.add('open'); });  
      el.addEventListener("mouseleave", () => { header.classList.remove('open'); });  
    })
  }

  let burger_icon = header.querySelector('.header-menu-icon-{{ section.id }}');
  let headerBody = header.querySelector('.header-body-{{ section.id }}');
  let headerMobileInner = header.querySelector('.header-menu-mobile-inner-{{ section.id }}');
  let headerMegaMenus = header.querySelectorAll('.header-mega-menu-{{ section.id }}');
  
  if(burger_icon) {
    const toggleMobile = () => {
      header.classList.toggle('open');
      const isOpen = header.classList.contains('open');
      burger_icon.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      headerMobileInner.style.paddingTop = (headerBody.clientHeight + {{ padding_top_mobile | times: 3 }} - 25) + "px";
      document.body.style.overflow = isOpen ? 'hidden' : '';
      if(!isOpen){
        document.querySelectorAll('.header-tab-text-{{ section.id }}').forEach(panel => {
          panel.style.display = 'none';
          panel.style.height = '0px';
          panel.style.paddingTop = '0';
          panel.style.paddingBottom = '0';
        });
        document.querySelectorAll('.header-tab-toggle-arrow-{{ section.id }}').forEach(ic => {
          ic.style.setProperty('--rotate','-90deg');
        });
        document.querySelectorAll('.header-tab-toggle-{{ section.id }}').forEach(btn => btn.setAttribute('aria-expanded','false'));
      }
    };
    burger_icon.addEventListener('click', toggleMobile);
    burger_icon.addEventListener('keydown', (e)=>{ if(e.key==='Enter' || e.key===' '){ e.preventDefault(); toggleMobile(); }});
  }

  if(headerMegaMenus) { headerMegaMenus.forEach(el => { el.style.paddingTop = "20px"; }) }

  const answerPaddingTop = 30;
  const answerPaddingBottom = 0;

  const buttons = document.querySelectorAll('.header-tab-toggle-{{ section.id }}');

  buttons.forEach(button => {
    button.addEventListener('click', () => handleToggle(button));
    button.addEventListener('keydown', (e)=>{ if(e.key==='Enter' || e.key===' '){ e.preventDefault(); handleToggle(button); }});
  });

  function handleToggle(button){
    const currentTab = button.closest('.header-tab-{{ section.id }}');
    const answer = currentTab.querySelector('.header-tab-text-{{ section.id }}');
    const icon = currentTab.querySelector('.header-tab-toggle-arrow-{{ section.id }}');
    const isOpen = answer.style.display === 'block';

    if (isOpen) {
      closeAnswer(answer, icon);
      button.setAttribute('aria-expanded','false');
    } else {
      // close siblings
      let parent = currentTab.parentElement;
      let container = parent.classList.contains('header-menu-item-{{ section.id }}') ? parent.parentElement : parent;
      const otherTabs = container.querySelectorAll('.header-tab-{{ section.id }}');
      otherTabs.forEach(otherTab => {
        if (otherTab !== currentTab) {
          const otherAnswer = otherTab.querySelector('.header-tab-text-{{ section.id }}');
          const otherIcon = otherTab.querySelector('.header-tab-toggle-arrow-{{ section.id }}');
          const otherBtn = otherTab.querySelector('.header-tab-toggle-{{ section.id }}');
          if (otherAnswer && otherAnswer.style.display === 'block') {
            closeAnswer(otherAnswer, otherIcon);
            if(otherBtn) otherBtn.setAttribute('aria-expanded','false');
          }
        }
      });
      openAnswer(answer, icon);
      button.setAttribute('aria-expanded','true');
    }
  }

  function openAnswer(answer, icon) {
    answer.style.display = 'block';
    const height = answer.scrollHeight;
    answer.style.height = '0px';
    requestAnimationFrame(()=> {
      answer.style.paddingTop = `${answerPaddingTop}px`;
      answer.style.paddingBottom = `${answerPaddingBottom}px`;
      answer.style.height = `${height}px`;
      icon?.style.setProperty('--rotate', '0deg');
    });
    const done = () => { answer.style.height = ''; answer.removeEventListener('transitionend', done); };
    answer.addEventListener('transitionend', done);
  }

  function closeAnswer(answer, icon) {
    const height = answer.scrollHeight;
    answer.style.height = `${height}px`;
    answer.style.overflow = 'hidden';
    requestAnimationFrame(()=> {
      answer.style.paddingTop = '0px';
      answer.style.paddingBottom = '0px';
      answer.style.height = '0px';
      icon?.style.setProperty('--rotate', '-90deg');
    });
    const done = () => { answer.style.display = 'none'; answer.style.overflow = ''; answer.removeEventListener('transitionend', done); };
    answer.addEventListener('transitionend', done);
  }

  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      const openAnswers = document.querySelectorAll('.header-tab-text-{{ section.id }}[style*="display: block"]');
      openAnswers.forEach(answer => { answer.style.height = ''; });
    }, 250);
  });

  function getEffectiveBackgroundColor(el) {
    while (el && el.tagName !== 'HTML') {
      let style = window.getComputedStyle(el);
      let bg = style.backgroundColor;
      if (bg !== 'rgba(0, 0, 0, 0)' && bg !== 'transparent') { return bg; }
      el = el.parentElement;
    }
    return 'rgb(255, 255, 255)';
  }

  function checkUnderlyingColor() {
    let headerRect = header.getBoundingClientRect();
    let x = window.innerWidth / 2;
    let y = headerRect.bottom + 1;
    if (y > window.innerHeight) return;
    let underEl = document.elementFromPoint(x, y);
    if (!underEl) return;
    let bgColor = getEffectiveBackgroundColor(underEl);
    let rgb = bgColor && bgColor.match(/\d+/g);
    if (!rgb) return;
    rgb = rgb.map(Number);
    let r = rgb[0], g = rgb[1], b = rgb[2];
    let luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
    if (luminance < 0.5) { header.classList.add('over-dark'); } else { header.classList.remove('over-dark'); }
  }

   if (autoWhite) { checkUnderlyingColor(); } else { header.classList.remove('over-dark'); }
}  

document.addEventListener('DOMContentLoaded', initHeader);

if (Shopify.designMode) {
  document.addEventListener('shopify:section:unload', initHeader);
  document.addEventListener('shopify:section:load', initHeader);
}

