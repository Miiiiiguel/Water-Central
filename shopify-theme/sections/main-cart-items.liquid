<script>
  // Countdown Timer Script
  document.addEventListener('DOMContentLoaded', function() {
    const countdownElement = document.querySelector('.countdown-inner');
    if (!countdownElement) return;

    const countdownText = "{{ section_st.countdown_text }}";
    const startMinutes = parseInt("{{ section_st.countdown_start_minutes | default: 5 }}");
    const startSeconds = parseInt("{{ section_st.countdown_start_seconds | default: 0 }}");

    let countdown;

    function initializeCountdown() {
      const savedTime = localStorage.getItem('cartCountdown');
      let timeLeft;
      if (savedTime) {
        timeLeft = parseInt(savedTime);
      } else {
        timeLeft = startMinutes * 60 + startSeconds;
        localStorage.setItem('cartCountdown', timeLeft);
      }
      return timeLeft;
    }

    let timeLeft = initializeCountdown();

    countdown = setInterval(function() {
      if (timeLeft <= 0) {
        clearInterval(countdown);
        countdownElement.innerHTML = "{{ section_st.countdown_timeout_message | default: 'Time offer expired!' }}";
        localStorage.removeItem('cartCountdown');
        return;
      }

      let minutes = Math.floor(timeLeft / 60);
      let seconds = timeLeft % 60;

      countdownElement.innerHTML = `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
      timeLeft--;
      localStorage.setItem('cartCountdown', timeLeft);
    }, 1000);
  });

document.querySelectorAll('.cart-remove-text').forEach(link => {
  link.addEventListener('click', function(e) {
    e.preventDefault(); // prevent the default link action
    const removeUrl = this.getAttribute('href');
    fetch(removeUrl, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      }
    })
    .then(response => response.json())
    .then(data => {
      // Option 1: reload the page to reflect the updated cart
      location.reload();
      // Option 2: Update the cart UI dynamically based on data
    })
    .catch(error => console.error('Error removing item:', error));
  });
});
</script>
<script>
(function () {
  // Formats money using Shopify's formatter if present, otherwise a light fallback
  const MONEY_FORMAT = {{ shop.money_format | json }};
  const MONEY_WITH_CURRENCY_FORMAT = {{ shop.money_with_currency_format | json }};
  const USE_CURRENCY = {{ settings.currency_code_enabled | json }};
  const FMT = USE_CURRENCY ? MONEY_WITH_CURRENCY_FORMAT : MONEY_FORMAT;

  function formatMoney(cents) {
    if (window.Shopify && typeof Shopify.formatMoney === 'function') {
      return Shopify.formatMoney(cents, FMT);
    }
    // naive fallback for {{amount}} only
    const amount = (cents / 100).toFixed(2);
    return FMT.replace('{{amount}}', amount).replace('{{ amount }}', amount);
  }

  function wireRow(row) {
    const unitWrap = row.querySelector('.qtyxprice');
    const qtySpan = unitWrap && unitWrap.querySelector('.js-qty');
    const totalSpan = unitWrap && unitWrap.querySelector('.js-line-total');
    const qtyInput = row.querySelector('input.quantity-input');
    if (!unitWrap || !qtySpan || !totalSpan || !qtyInput) return;

    const unitCents = parseInt(unitWrap.getAttribute('data-unit-price-cents'), 10) || 0;

    const repaint = () => {
      const q = Math.max(0, parseInt(qtyInput.value, 10) || 0);
      qtySpan.textContent = q;
      totalSpan.textContent = formatMoney(unitCents * q);
    };

    // direct typing
    qtyInput.addEventListener('input', repaint);

    // +/- buttons
    row.querySelectorAll('.quantity__button').forEach(btn => {
      btn.addEventListener('click', () => setTimeout(repaint, 0));
    });

    // initial paint
    repaint();
  }

  function wireAll() {
    document.querySelectorAll('tr.cart-item').forEach(wireRow);
  }

  document.addEventListener('DOMContentLoaded', wireAll);

  // If your theme re-renders the cart via AJAX, listen and re-bind
  document.addEventListener('cart:updated', wireAll);
})();
</script>