                <!-- Estimated Delivery Badge -->
                {%- if enable_estimated_delivery -%}
                  <div class="estimated-delivery-badge mt-10 p-10 rounded text-center" style="background-color: var(--delivery-badge-bg); color: var(--delivery-badge-text);">
                    {{ estimated_delivery_text }}
                  </div>
                {%- endif %}
                <!-- /Estimated Delivery Badge -->
              {% endif %}

              <div id="cart-errors"></div>
            </div>

            <!-- Additional Info Boxes: Delivery & Guarantee -->
            <div
              class="cart-content mt-30 p-30 rounded"
              style="background-color: var(--cart-info-bg); border-radius: var(--cart-info-br);"
            >
              {%- if heading_delivery or description_delivery -%}
                <div class="cart-block">
                  <span
                    class="heading mb-10 block fs-big-1 flex items-center"
                    style="color: var(--heading-delivery-text-color); gap: 8px;"
                  >
                    <!-- Delivery Icon from user textarea code -->
                    <span
                      class="delivery-info-icon"
                      style="color: {{ section_st.heading_delivery_icon_svg_color }}; "
                    >
                      {{ section_st.heading_delivery_icon_svg_code }}
                    </span>
                    {% if heading_delivery != blank %}
                      {{ heading_delivery }}
                    {% else %}
                      {{ 'general.cart.heading_delivery' | t }}
                    {% endif %}
                  </span>
                  <div class="content rich__text-mt-0">
                    {{ description_delivery }}
                  </div>
                </div>
              {% endif %}

              {%- if heading_guarantee or description_guarantee -%}
                <div class="cart-block">
                  <span
                    class="heading mb-10 block fs-big-1 flex items-center"
                    style="color: var(--heading-guarantee-text-color); gap: 8px;"
                  >
                    <!-- Guarantee Icon from user textarea code -->
                    <span
                      class="guarantee-info-icon"
                      style="color: {{ section_st.heading_guarantee_icon_svg_color }}"
                    >
                      {{ section_st.heading_guarantee_icon_svg_code }}
                    </span>
                    {% if heading_guarantee != blank %}
                      {{ heading_guarantee }}
                    {% else %}
                      {{ 'general.cart.heading_guarantee' | t }}
                    {% endif %}
                  </span>
                  <div class="content rich__text-mt-0">
                    {{ description_guarantee }}
                  </div>
                </div>
              {% endif %}
            </div>
            <!-- /Additional Info Boxes -->
          </div>
        </div>
      {% endif %}
