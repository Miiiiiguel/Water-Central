{{ 'cart-page.css' | asset_url | stylesheet_tag }}
{{ 'minicart.css' | asset_url | stylesheet_tag }}
{{ 'critical.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign theme_st = settings
  assign section_st = section.settings
  assign free_shipping = theme_st.show_on_minicart_cart_page
  assign show_currency_code = theme_st.show_currency_code
  assign shipping_rate = theme_st.free_shipping_minimum | times: 1 | default: 0
  assign shipping_rate_price = shipping_rate | money
  assign cart_duration_show = theme_st.show_duration_on_minicart_cart_page
  assign cart_duration = theme_st.cart_duration
  assign enable_cart_note = section_st.enable_cart_note
  assign section_width = section_st.section_width
  assign disable_free_shipping_bar = section_st.disable_free_shipping_bar
  assign disable_countdown_timer = section_st.disable_countdown_timer
assign show_countdown = cart_duration_show
if disable_countdown_timer
  assign show_countdown = false
endif
  assign enable_slim_dividers = section_st.enable_slim_dividers
  assign enable_payment_support = section_st.enable_payment_support
  assign enable_estimated_delivery = section_st.enable_estimated_delivery
  assign use_custom_delivery_text = section_st.use_custom_delivery_text

  assign heading_payment = section_st.heading_payment
  assign payment_width = section_st.payment_width
  assign heading_delivery = section_st.heading_delivery
  assign description_delivery = section_st.description_delivery
  assign heading_guarantee = section_st.heading_guarantee
  assign description_guarantee = section_st.description_guarantee
  assign show_estimate_shipping = section_st.show_estimate_shipping

if use_custom_delivery_text and section_st.custom_delivery_text != blank
  assign estimated_delivery_text = section_st.custom_delivery_text
else
  assign estimated_delivery_text = 'Estimated delivery in 3-5 business days'
endif

%}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

{%- capture style -%}
  --section-pt-desktop: {{ section_st.padding_top_desktop | default: 50 }}px;
  --section-pb-desktop: {{ section_st.padding_bottom_desktop | default: 50 }}px;
  --section-pt-mobile: {{ section_st.padding_top_mobile | default: 20 }}px;
  --section-pb-mobile: {{ section_st.padding_bottom_mobile | default: 20 }}px;
  --col-gap-desktop: 5rem;
  --col-width: 45rem;

  /* X Remove Icon customizers */
  --x-remove-icon-color: {{ section_st.x_remove_icon_color }};
  --x-remove-icon-hover-color: {{ section_st.x_remove_icon_hover_color }};
  --x-remove-icon-size: {{ section_st.x_remove_icon_size | append: 'px' }};
  --remove-text-color: {{ section_st.remove_text_color }};
  --remove-text-hover_color: {{ section_st.remove_text_hover_color }};

  /* Original requested custom properties */
  --order-note-svg-color: {{ section_st.order_note_svg_color }};
  --add_order_note_text_color: {{ section_st.add_order_note_text_color }};
  --cart-item-totals-price-bg: {{ section_st.cart_item_totals_price_bg }};
  --cart-item-totals-price-br: {{ section_st.cart_item_totals_price_br | append: 'px' }};
  --product-option-bg: {{ section_st.product_option_bg }};
  --product-option-border-radius: {{ section_st.product_option_border_radius | append: 'px' }};
  --cart-page-countdown-bg: {{ section_st.cart_page_countdown_bg }};
  --cart-page-countdown-br: {{ section_st.cart_page_countdown_border_radius | append: 'px' }};
  --cart-page-countdown-text-color: {{ section_st.cart_page_countdown_text_color }};
  --countdown-inner-color: {{ section_st.countdown_inner_color }};

  /* NEW custom properties for the cart note textarea */
  --cart-note-bg: {{ section_st.cart_note_bg }};
  --cart-note-border-radius: {{ section_st.cart_note_br | append: 'px' }};
  --cart-note-width: {{ section_st.cart_note_width | append: '%' }};
  --cart-note-border-color: {{ section_st.cart_note_border_color }};
  --cart-note-border-color-focus: {{ section_st.cart_note_border_color_focus }};

  /* NEW background & radius for the .cart-info box */
  --cart-info-bg: {{ section_st.cart_info_bg }};
  --cart-info-br: {{ section_st.cart_info_br | append: 'px' }};

  /* NEW heading color customizers for Delivery & Guarantee headings */
  --heading-delivery-text-color: {{ section_st.heading_delivery_text_color }};
  --heading-guarantee-text-color: {{ section_st.heading_guarantee_text_color }};

  /* NEW Countdown Timer Styles */
  --countdown-slider-minutes: {{ section_st.countdown_start_minutes | default: 5 }};
  --countdown-slider-seconds: {{ section_st.countdown_start_seconds | default: 0 }};

  /* NEW for card backgrounds/text and gap */
  --cards-gap: {{ section_st.cards_gap_slider | default: 20 }}px;

  /* NEW for controlling icons (desktop vs. mobile) */
  --svg-icons-gap-desktop: {{ section_st.svg_icons_gap | default: 10 }}px;
  --svg-icons-gap-mobile: {{ section_st.svg_icons_gap_mobile | default: 10 }}px;
  --svg-icons-overall-width-mobile: {{ section_st.overall_svg_icons_width_mobile | default: 20 }}px;

  /* NEW Slim Top Bar Color */
  --slim-top-bar-color: {{ section_st.slim_top_bar_color | default: '#E9E9E9' }};

  /* NEW Slim Dividers Color */
  --slim-dividers-color: {{ section_st.slim_dividers_color | default: '#E9E9E9' }};

  /* NEW for Estimated Delivery Badge */
  --delivery-badge-bg: {{ section_st.delivery_badge_bg | default: '#f0f0f0' }};
  --delivery-badge-text: {{ section_st.delivery_badge_text | default: '#000000' }};

  /* NEW card text font size */
  --card-text-font-size: {{ section_st.card_text_font_size | default: 14 }}px;
{%- endcapture -%}

<div
  class="page-cart section{% if cart == empty %} is-empty{% endif %}{% if enable_slim_dividers %} has-slim-dividers{% endif %}"
  id="main-cart-items"
  data-id="{{ section.id }}"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    <!-- Icon Trash definition -->
    <svg hidden>
      <symbol id="icon-trash">
        <path fill="currentColor" d="M10.5 4.25h-7v7.588c0 .073.014.146.041.219a.727.727 0 0 0 .137.191.416.416 0 0 0 .177.123c.073.027.15.041.233.041h5.824c.082 0 .16-.014.232-.04a.416.416 0 0 0 .178-.124.53.53 0 0 0 .123-.191.485.485 0 0 0 .055-.22V4.25Zm-.588-1.162h2.338c.164 0 .3.06.41.178a.52.52 0 0 1 .178.396c0 .164-.06.305-.178.424a.557.557 0 0 1-.41.164h-.588v7.588c0 .237-.046.465-.137.684-.09.21-.214.391-.369.546a1.615 1.615 0 0 1-.56.383c-.21.091-.438.137-.684.137H4.088c-.246 0-.474-.05-.684-.15a1.931 1.931 0 0 1-.56-.37 1.755 1.755 0 0 1-.37-.546 1.76 1.76 0 0 1-.136-.684V4.25H1.75a.603.603 0 0 1-.424-.164.603.603 0 0 1-.164-.424.54.54 0 0 1 .164-.396.579.579 0 0 1 .424-.178h2.338V2.5c0-.237.045-.46.137-.67.09-.219.214-.406.369-.56.155-.165.337-.292.547-.383.218-.091.45-.137.697-.137h2.324c.246 0 .474.046.684.137.21.09.396.218.56.383.155.154.278.341.37.56.09.21.136.433.136.67v.588Zm0 3.5c0-.164.055-.3.164-.41A.579.a579 0 0 1 5.838 6.a52.a52 0 0 1 .396.178c.119.11.178.246.178.41v3.5c0 .155-.06.292-.178.41a.54.a54 0 0 1-.396.164.a603.a603 0 0 1-.424-.164.a587.a587 0 0 1-.164-.41v-3.5Zm2.338 0c0-.164.055-.3.164-.41a.563.a563 0 0 1 .82 0c.119.11.178.246.178.41v3.5c0 .155-.06.292-.178.41a.556.a556 0 0 1-.41.164.a587.a587 0 0 1-.41-.164.a587.a587 0 0 1-.164-.41v-3.5Z"/>
      </symbol>
    </svg>
    <!-- /Icon Trash -->

    {% comment %}
      ================
      CONDITIONAL COUNTDOWN POSITION
      ================
    {% endcomment %}
    {% if cart != empty %}
      {% if section_st.position_countdown_above_cart == false %}
        <!-- Original position (top of cart) for countdown timer -->
        <div class="page-title text-center mb-80">
          {%- if show_countdown -%}
            <countdown-timer
              data-minutes-left="{{ cart_duration }}"
              data-timeout-message="{{ section_st.countdown_text }}"
              class="cart_page-countdown heading-style flex flex-wrap content-center pt-17 pb-15 btn-rounded mx-auto w-full max-w-custom px-15"
              style="--max-width: 80.3rem"
            >
              <span class="me-5">{{ section_st.countdown_text }}</span>
              <div class="countdown-inner inline-flex align-center"></div>
            </countdown-timer>
          {% endif %}
        </div>
      {% endif %}
    {% endif %}

    <div class="main-cart flex flex-wrap flex-1025-nowrap gap-40 justify-between mt-50">
      <div class="cart-left w-full{% if cart != empty %} col-1025-remaining{% endif %}">
        <div class="sticky-1025 top-30">
          <cart-items class="js-contents{% if cart == empty %} is-empty{% endif %}">
            {% if cart == empty %}
              <div class="cart__warnings text-center">
                <h1 class="heading-letter-spacing cart__empty-title mb-20" style="font-size: 35px;">
                  {{ 'general.cart.empty' | t }}
                </h1>
                 <a href="{{ section.settings.continue_shopping_url }}" class="btn-primary no-underline inline-block">
  {{ 'general.continue_shopping' | t }}
</a>
                {%- if shop.customer_accounts_enabled and customer == null -%}
                  <h2 class="heading-letter-spacing cart__login-title" style="font-size: 25px;">
                    {{ 'general.cart.login.title' | t }}
                  </h2>
                  <p class="cart__login-paragraph">
                    {{ 'general.cart.login.paragraph_html' | t: link: routes.account_login_url }}
                  </p>
                {% endif %}
              </div>
            {% endif %}
            {%- if cart != empty -%}
              <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
                <table class="cart-items w-full border-0">
                  <caption class="visually-hidden">
                    {{ 'general.cart.title' | t }}
                  </caption>
               
                  <tbody>
                    {%- for item in cart.items -%}
                      <tr
                        class="cart-item page__cart-item"
                        id="CartItem-{{ item.index | plus: 1 }}"
                        style="--custom-width: 8rem"
                      >
                        <td
                          class="cart-item__media border-0 px-0 border-bottom py-30 w-custom"
                        >
                          <a
                            href="{{ item.url }}"
                            class="cart-item__link fs-0 rounded-5 overflow-hidden block w-custom"
                            aria-hidden="true"
                            tabindex="-1"
                          >
                            {% if item.image != blank %}
                              {%- assign image_alt = item.image.alt | default: 'product' -%}
                              {% render 'responsive-image',
                                type: 'other',
                                container: section_width,
                                image: item.image,
                                image_alt: image_alt,
                                class: 'rounded-5'
                              %}
                            {% else %}
                              {% render 'placeholder-render', class: 'rounded-5' %}
                            {% endif %}
                          </a>
                        </td>
                        <td
                          class="cart-item__details px-0 border-0 border-bottom py-30 pe-10"
                          data-title="{{ 'general.cart.headings.product' | t }}"
                        >
                          <div class="cart_info ms-md-20 relative">
                            <a
                              href="{{ item.url }}"
                              class="product-item__name unset heading-style no-underline fs-custom block lh-normal pe-20 pe-md-0 word-break"
                            >
                              {{- item.product.title | escape -}}
                            </a>

                            <!-- Mobile remove text link -->
                            <a href="{{ item.url_to_remove }}" class="cart-remove-text">{{ 'sections.cart.remove' | t }}</a>
                            <!-- /Mobile remove text -->

             {%- if item.product.has_only_default_variant == false
  or item.properties.size != 0
  or item.selling_plan_allocation != null
-%}
  {%- if item.product.has_only_default_variant == false -%}
   {%- for option in item.options_with_values -%}
  <div class="cart-option-line">{{ option.name }}: {{ option.value }}</div>
{%- endfor -%}
  {%- endif -%}
                                {%- if item.properties.size != 0 -%}
                                  <div class="product-option-property flex flex-wrap flex-column">
                                {% endif %}
                                {%- for property in item.properties -%}
                                  {%- assign property_first_char = property.first | slice: 0 -%}
                                  {%- if property.last != blank and property_first_char != '_' -%}
                                    <div class="product-option inline-flex">
                                      <span class="ml-1">{{ property.first }}:</span>
                                      <span class="m-0">
                                        {%- if property.last contains '/uploads/' -%}
                                          <a href="{{ property.last }}" class="link" target="_blank">
                                            {{ property.last | split: '/' | last }}
                                          </a>
                                        {%- else -%}
                                          {{ property.last }}
                                        {% endif %}
                                      </span>
                                    </div>
                                  {% endif %}
                                {%- endfor -%}
                                {%- if item.properties.size != 0 -%}</div>{% endif %}
                              </dl>
                              <p class="product-option my-0">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                            {% endif %}
                            <ul
                              class="discounts list-unstyled fs-small light-dark-grey"
                              role="list"
                              aria-label="{{ 'customer.order.discount' | t }}"
                            >
                              {%- for discount in item.line_level_discount_allocations -%}
                                <li class="discounts__discount fs-14 d-inline-flex align-center">
                                  {{ discount.discount_application.title }}
                                </li>
                              {%- endfor -%}
                            </ul>
                          </div>
                        </td>

                     
                        <!-- Quantity -->
                        <td
                          class="cart-item__quantity border-0 border-bottom py-30 px-10"
                          data-title="{{ 'general.cart.headings.quantity' | t }}"
                        >
                          <div class="cart-item__quantity-wrapper">
                            <quantity-input class="quantity btn-rounded border inline-flex text-center grey-bg overflow-hidden">
                              <button
                                class="quantity__button pointer border-0 no-js-hidden w-custom grey-bg ps-20"
                                name="minus"
                                type="button"
                                data-id="{{- item.key -}}"
                                style="--custom-width: 4rem"
                                aria-label="minus"
                              >
                                <svg width="11" height="12" viewBox="0 0 11 2" fill="none">
                                  <path d="M11 0.5L11 1.5L-4.37114e-08 1.5L0 0.5L11 0.5Z" fill="currentColor"></path>
                                </svg>
                              </button>
                              <label class="visually-hidden" for="{{- item.quantity -}}">
                                {{ 'general.cart.headings.quantity' | t }}
                              </label>
                              <input
                                class="quantity-input bg-unset text-center appearance-none p-0-important w-custom"
                                type="number"
                                name="updates[]"
                                data-id="{{- item.key -}}"
                                value="{{- item.quantity -}}"
                                data-value="{{ item.quantity }}"
                                data-index="{{ item.index | plus: 1 }}"
                                min="0"
                                style="--input-padding: 0;--inputs-border-width: 0;--input-height: 43px;--custom-width: 3.8rem;--input-border-radius: 0;--input-bg: transparent"
                              >
                              <button
                                class="quantity__button pointer border-0 no-js-hidden w-custom grey-bg pe-20"
                                name="plus"
                                type="button"
                                data-id="{{- item.key -}}"
                                style="--custom-width: 4rem"
                                aria-label="plus"
                              >
                                <svg width="11" height="12" viewBox="0 0 11 12" fill="none">
                                  <path fill-rule="evenodd" clip-rule="evenodd" d="M5 11.5H6L6 6.5H11V5.5H6L6 0.5H5L5 5.5H0V6.5H5L5 11.5Z" fill="currentColor"></path>
                                </svg>
                              </button>
                            </quantity-input>
                          </div>
                        </td>
                        <!-- /Quantity -->

                       <!-- Totals (qty × total) -->
<td class="cart-item__totals text-md-end small-hide border-0 border-bottom-lg py-30 px-10">
  <div class="cart-item__price-wrapper heading-style">
    <span class="qtyxprice" data-unit-price-cents="{{ item.final_price }}">
      <span class="js-qty">{{ item.quantity }}</span>
      &nbsp;×&nbsp;
      <span class="js-line-total">
        {% if settings.currency_code_enabled %}
          {{ item.final_line_price | money_with_currency }}
        {% else %}
          {{ item.final_line_price | money }}
        {% endif %}
      </span>
    </span>
  </div>
</td>
<!-- /Totals (qty × total) -->
                      </tr>
                    {%- endfor -%}
                  </tbody>
                </table>
              </form>
            {% endif %}

            {%- if cart != empty -%}
              <div
                class="loading-overlay absolute inset-0 invisible transition pointer-none z-2 gradient color-default"
              ></div>
            {% endif %}
          </cart-items>

          {%- if cart != empty -%}
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'recommendations' %}
                  {%- liquid
                    assign recommendations_heading = block.settings.recommendations_heading
                    assign product_recommendations_type = block.settings.product_recommendations_type
                    assign select_product_recommendations = block.settings.select_product_recommendations
                  -%}
                  <div class="cart_page-recommend cart-recommend mt-60 inside" id="{{ block.id }}">
                    <style>
                      .cart_page-recommend#{{ block.id }} .product-item__wrapper {
                        background-color: {{ block.settings.product_recommendations_bg_color | default: "#F8F8F8" }} !important;
                        border: {{ block.settings.product_recommendations_border_weight | default: 1 }}px solid {{ block.settings.product_recommendations_border_color | default: "#E8E8E8" }} !important;
                        border-radius: {{ block.settings.product_recommendations_card_border_radius | default: 8 }}px !important;
                        transition: all 0.3s ease;
                      }
                      .cart_page-recommend#{{ block.id }} .product-item__wrapper:hover {
                        background-color: {{ block.settings.product_recommendations_hover_bg_color | default: "#FFFFFF" }} !important;
                      }
                      .cart_page-recommend#{{ block.id }} .bls-add-cart-list {
                        color: {{ block.settings.add_to_cart_text_color | default: "#000000" }} !important;
                        text-decoration: none;
                        border-bottom: {{ block.settings.add_to_cart_underline_thickness | default: 0 }}px solid transparent !important;
                      }
                      .cart_page-recommend#{{ block.id }} .bls-add-cart-list:hover {
                        color: {{ block.settings.add_to_cart_text_hover_color | default: "#FF0000" }} !important;
                        border-bottom: {{ block.settings.add_to_cart_underline_thickness | default: 0 }}px solid {{ block.settings.add_to_cart_underline_color | default: "#007BFF" }} !important;
                      }
                      .cart_page-recommend#{{ block.id }} .add-to-cart-hover-button {
                        display: none !important;
                      }
                      .cart_page-recommend#{{ block.id }} .bls-add-cart-list {
                        position: static !important;
                        margin-top: 8px;
                        display: block !important;
                        text-align: left;
                      }
                      .cart_page-recommend#{{ block.id }} .bls__product {
                        display: flex;
                        flex-direction: column;
                        justify-content: flex-start;
                      }
                    </style>
                    {%- if product_recommendations_type == 'auto' -%}
                      <minicart-recommendations
                        data-url="{{ routes.product_recommendations_url }}?product_id={{ cart.items.first.product_id }}&limit=6&section_id=cart-upsell"
                        class="block no-js-hidden"
                        id="{{ block.id }}"
                      >
                        {%- if recommendations_heading -%}
                          <h4 class="minicart-heading mt-0 mb-15 fs-18 heading-letter-spacing">
                            {{ recommendations_heading }}
                          </h4>
                        {% endif %}
                    {%- else -%}
                      {% if select_product_recommendations != blank %}
                        <div id="{{ block.id }}">
                          {%- if recommendations_heading -%}
                            <h4 class="minicart-heading mt-0 mb-15 fs-18 heading-letter-spacing">
                              {{ recommendations_heading }}
                            </h4>
                          {% endif %}
                      {% endif %}
                    {% endif %}

                    <slide-section
                      class="swiper swiper swiper-cart-upsell"
                      id="swiper-cart-upsell"
                      data-section-id="cart-upsell"
                      data-autoplay="false"
                      data-loop="false"
                      data-mobile="1"
                      data-tablet="2"
                      data-desktop="2"
                      data-item-mobile="1"
                      data-spacing="20"
                    >
                      <div class="swiper-wrapper">
                        {%- if product_recommendations_type != 'auto' -%}
                          {%- for item in select_product_recommendations -%}
                            <div class="swiper-slide">
                              {% render 'product-item',
                                card_product: item,
                                template_enable_price: true,
                                template_enable_add_cart: true,
                                template_enable_options: false,
                                template_enable_product_vendor: false,
                                template_enable_rate: false,
                                template_enable_product_short_description: false,
                                template_enable_color_swatches: false,
                                type: 'list'
                              %}
                            </div>
                          {%- endfor -%}
                        {% endif %}
                      </div>
                      <div class="swiper-pagination"></div>
                    </slide-section>

                    {%- if product_recommendations_type == 'auto' -%}
                      </minicart-recommendations>
                    {%- else -%}
                      {% if select_product_recommendations != blank %}
                        </div>
                      {% endif %}
                    {%- endif %}
                  </div>
              {% endcase %}
            {% endfor %}

            {%- comment %}
              ADD 3(4) MODERN CARDS UNDER LEFT COLUMN (after recommendations)
            {%- endcomment %}
            <div class="custom-cards-container mt-30{% if section_st.disable_custom_cards_mobile %} disable-mobile{% endif %}">
              <!-- Horizontal scroll (slider) on mobile -->
              <div class="custom-cards-slider flex overflow-x-auto" style="scroll-snap-type: x mandatory;">
                {% for block in section.blocks %}
                  {% if block.type == 'custom_card' %}
<div
  id="card-{{ block.id }}"
  class="custom-card min-w-[240px] p-15 rounded"
  style="
    flex: 0 0 auto;
    scroll-snap-align: start;
    --card-text-color: {{ block.settings.text_color }};
  "
>
                      {% if block.settings.svg_icon != blank %}
                        <div class="card-icon mb-10" style="width: {{ block.settings.icon_size | default: 40 }}px; height: {{ block.settings.icon_size | default: 40 }}px;">
                          {{ block.settings.svg_icon }}
                        </div>
                      {% elsif block.settings.image != blank %}
                        <div class="card-image mb-10">
                          <img
                            src="{{ block.settings.image | img_url: '100x' }}"
                            alt="{{ block.settings.title | escape }} Icon"
                            style="max-width: 60px; height: auto;"
                          >
                        </div>
                      {% endif %}
                      {% if block.settings.title != blank %}
                        <h4 class="card-title mb-5" style="color: var(--card-text-color) !important;">
  {{ block.settings.title }}
</h4>
                      {% endif %}
        {% if block.settings.text != blank %}
  <div class="card-text">
    {{ block.settings.text }}
  </div>
{% endif %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>

          {% endif %}
        </div>
      </div>

      {%- if cart != empty -%}
        <div class="cart-right w-full col-1025-w-custom mt-15">
          <div class="sticky-1025 top-30">
            {%- comment %}
              If toggle is ON, show the countdown here (above .cart-info)
            {%- endcomment %}
            {% if section_st.position_countdown_above_cart == true %}
              <div class="page-title text-center mb-80">
                {%- if show_countdown -%}
                  <countdown-timer
                    data-minutes-left="{{ cart_duration }}"
                    data-timeout-message="{{ section_st.countdown_text }}"
                    class="cart_page-countdown heading-style flex flex-wrap content-center pt-17 pb-15 btn-rounded mx-auto w-full max-w-custom px-15"
                    style="--max-width: 80.3rem"
                  >
                    <span class="me-5">{{ section_st.countdown_text }}</span>
                    <div class="countdown-inner inline-flex align-center"></div>
                  </countdown-timer>
                {% endif %}
              </div>
            {% endif %}

            <!-- .cart-info with custom background & border radius -->
            <div
              class="cart-info p-30 rounded"
              style="background-color: var(--cart-info-bg); border-radius: var(--cart-info-br);"
            >
              {%- if free_shipping and shipping_rate > 0 and disable_free_shipping_bar == false -%}
                {% liquid
                  assign items_subtotal_price = cart.items_subtotal_price
                  assign shipping_price = shipping_rate
                %}
                <free-ship-progress-bar
                  data-order="{{ cart.items_subtotal_price }}"
                  data-fe-amount="{{ shipping_rate }}"
                  data-fe-unavaiable="{{ 'general.cart.free_shipping' | t }}"
                  data-fe-avaiable="{{ 'general.cart.free_shipping_avaiable' | t }}"
                  class="block cart_shipping cart_threshold border-0 border-bottom mt-15 pb-25{% if items_subtotal_price >= shipping_price %} cart_shipping_free{% endif %}"
                >
                  <div class="progress-bar cart_bar_w relative rounded-10">
                    <span
                      class="progress percent_shipping_bar transition relative primary-color rounded-10"
                      style="width: 0%;"
                    >
                      <!-- shipping cart icon removed for brevity -->
                    </span>
                  </div>

                  <!-- This block is what prints the "Spend €xx more..." or the new text -->
                  <div class="free-shipping-message mt-17 cart-thres cart_thres_1 heading-color opacity-0">
                    {{ 'general.cart.cart_thres1_html' | t: price: shipping_rate_price }}
                  </div>
                </free-ship-progress-bar>
              {% endif %}

              {%- if enable_cart_note -%}
                <cart-note class="cart__note field block gap-0 border-0 border-bottom lh-1{% if free_shipping and shipping_rate > 0 and disable_free_shipping_bar == false %} pt-25 pb-30{% else %} pb-30{% endif %} mb-25">
                  <h6 class="add-order-note">
                    {{ 'Custom Order Note' }}
                    <svg
                      fill="var(--order-note-svg-color)"
                      width="18px"
                      height="18px"
                      viewBox="0 0 24 24"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path d="M19,14.5 L19,5.5 C19,4.67157288 18.3284271,4 17.5,4 L6.5,4 C5.67157288,4 5,4.67157288 5,5.5 L5,18.5 C5,19.3284271 5.67157288,20 6.5,20 L13.5,20 C14.3284271,20 15,19.3284271 15,18.5 C15,17.1192881 16.1192881,16 17.5,16 C18.3284271,16 19,15.3284271 19,14.5 L19,14.5 Z M18.5014408,16.7913481 C18.1948298,16.9255432 17.8561101,17 17.5,17 C16.6715729,17 16,17.6715729 16,18.5 C16,18.8561101 15.9255432,19.1948298 15.7913481,19.5014408 C16.9873685,18.9526013 17.9526013,17.9873685 18.5014408,16.7913481 L18.5014408,16.7913481 Z M4,5.5 C4,4.11928813 5.11928813,3 6.5,3 L17.5,3 C18.8807119,3 20,4.11928813 20,5.5 L20,14.5 C20,18.0898509 17.0898509,21 13.5,21 L6.5,21 C5.11928813,21 4,19.8807119 4,18.5 L4,5.5 Z M8.5,9 C8.22385763,9 8,8.77614237 8,8.5 C8,8.22385763 8.22385763,8 8.5,8 L15.5,8 C15.7761424,8 16,8.22385763 16,8.5 C16,8.77614237 15.7761424,9 15.5,9 L8.5,9 Z M8.5,12 C8.22385763,12 8,11.7761424 8,11.5 C8,11.2238576 8.22385763,11 8.5,11 L15.5,11 C15.7761424,11 16,11.2238576 16,11.5 C16,11.7761424 15.7761424,12 15.5,12 L8.5,12 Z M8.5,15 C8.22385763,15 8,14.7761424 8,14.5 C8,14.2238576 8.22385763,14 8.5,14 L13.5,14 C13.7761424,14 14,14.2238576 14,14.5 C14,14.7761424 13.7761424,15 13.5,15 Z"/>
                    </svg>
                  </h6>

                  <!-- Textarea styling with new custom properties -->
                  <textarea
                    class="text-area field__input"
                    style="
                      width: var(--cart-note-width);
                      background-color: var(--cart-note-bg);
                      border-radius: var(--cart-note-border-radius);
                      border: 1px solid var(--cart-note-border-color);
                    "
                    onfocus="this.style.borderColor = getComputedStyle(this).getPropertyValue('--cart-note-border-color-focus');"
                    onblur="this.style.borderColor = getComputedStyle(this).getPropertyValue('--cart-note-border-color');"
                    name="note"
                    form="cart"
                    id="Cart-note"
                    placeholder="Enter custom note for your order..."
                  >{{ cart.note }}</textarea>
                </cart-note>
              {% endif %}

              <div class="totals flex flex-wrap gap-5 align-center justify-between mb-10 h5 mt-20 pt-25 border-top">
                <span class="totals__subtotal"> {{ 'general.cart.subtotal' | t }}:</span>
                {{ cart.total_price | money_with_currency }}
              </div>
              <div class="js-contents">
                {%- if cart.cart_level_discount_applications.size > 0 -%}
                  <ul
                    class="discounts list-none pl-0 ml-0 mb-5"
                    role="list"
                    aria-label="{{ 'customer.order.discount' | t }}"
                  >
                    {%- for discount in cart.cart_level_discount_applications -%}
                      <li class="discounts__discount discounts__discount--position">
                        {{ discount.title }}
                        (-{{ discount.total_allocated_amount | money }})
                      </li>
                    {%- endfor -%}
                  </ul>
                {% endif %}

                <p class="caption-large rte mt-8">
                  {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
                    {{ 'general.cart.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
                  {%- elsif cart.taxes_included -%}
                    {{ 'general.cart.taxes_included_but_shipping_at_checkout' | t }}
                  {%- elsif shop.shipping_policy.body != blank -%}
                    {{ 'general.cart.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
                  {%- else -%}
                    {{ 'general.cart.taxes_and_shipping_at_checkout' | t }}
                  {% endif %}
                </p>
              </div>

              {%- if theme_st.enable_catalog_mode == false -%}
                <div class="cart__ctas mt-25 pt-25 border-top">
                  {%- if theme_st.show_check_box_in_cart -%}
                    <terms-conditions class="terms-conditions flex mb-25" data-custom-class="term-and-condition">
                      <div class="checkbox-group relative">
                        <input
                          class="input w-20 h-20 m-0 opacity-0 absolute inset-0 pointer conditions_form_minicart"
                          type="checkbox"
                          name="conditions"
                          id="conditions_form_minicart"
                        >
                        <span class="checkmark relative me-10 pointer-none pointer inline-flex"></span>
                      </div>
                      <label
                        class="label pointer rich__text-m0"
                        for="conditions_form_minicart"
                        style="--color-link: var(--color-heading);"
                      >
                        {{ theme_st.text_terms_conditions }}
                      </label>
                    </terms-conditions>
                  {% endif %}
                  <button
                    type="submit"
                    id="checkout"
                    class="btn-checkout cart__checkout-button button w-full btn-primary"
                    name="checkout"
                    {% if cart == empty or theme_st.show_check_box_in_cart %}
                      disabled
                    {% endif %}
                    form="cart"
                  >
                    <span id="cart-live-region-text" aria-live="polite" role="status">
                      {{ 'general.page_cart.checkout' | t }}
                    </span>
                  </button>
                </div>
                {%- if additional_checkout_buttons -%}
                  <div class="cart__dynamic-checkout-buttons mt-10 additional-checkout-buttons">
                    {{ content_for_additional_checkout_buttons }}
                  </div>
                {% endif %}
