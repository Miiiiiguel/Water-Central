{% comment %}
  Quote Banner — 1:1 like screenshot
  - Text sits directly on the blue card (no white quote box anywhere)
  - Reset theme defaults on <blockquote> (no bg, no border, no padding)
  - Centered content with max text width for perfect measure
{% endcomment %}

<section id="qb-{{ section.id }}" class="quote-banner">
  <div class="qb-wrap">
    <div class="qb-card">
      <div class="qb-content">
        {%- assign quote_block = section.blocks | where: 'type', 'quote' | first -%}
        {%- assign author_block = section.blocks | where: 'type', 'author' | first -%}

        {%- if quote_block -%}
          <blockquote class="qb-quote{% if quote_block.settings.use_curly_quotes %} qb-quote--curly{% endif %}">
            {{ quote_block.settings.quote_text }}
          </blockquote>
        {%- endif -%}

        {%- if author_block -%}
          {%- assign signature_src = author_block.settings.signature_image | img_url: 'master' -%}
          {%- if signature_src == blank -%}
            {%- assign signature_src = 'https://cdn.shopify.com/s/files/1/0918/6322/0561/files/Design_fara_titlu_28.png?v=1759557478' -%}
          {%- endif -%}
          {%- assign avatar = author_block.settings.avatar -%}
          {%- assign avatar_fallback = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E' -%}
          <div class="qb-author">
            <span class="qb-avatar">
              <img
                src="{{ avatar | img_url: '200x200' | default: avatar_fallback }}"
                alt="{{ author_block.settings.author_name | escape }}"
                loading="lazy"
                width="{{ author_block.settings.avatar_size }}"
                height="{{ author_block.settings.avatar_size }}"
              >
            </span>
            <span class="qb-author-text">
              <span class="qb-author-name">{{ author_block.settings.author_name }}</span>
              {%- if author_block.settings.author_role != blank -%}
                <span class="qb-author-sep"> – </span>
                <span class="qb-author-role">{{ author_block.settings.author_role }}</span>
              {%- endif -%}
              {%- if author_block.settings.enable_signature and author_block.settings.signature_position == 'right' -%}
                <span class="qb-signature qb-signature--inline">
                  <img
                    src="{{ signature_src }}"
                    alt="Signature"
                    loading="lazy"
                    style="max-width: var(--qb-sig-size); height: auto;"
                  >
                </span>
              {%- endif -%}
            </span>
          </div>
          {%- if author_block.settings.enable_signature -%}
            <div class="qb-signature-block{% if author_block.settings.signature_position == 'below' %} qb-visible-desktop{% endif %}">
              <img
                src="{{ signature_src }}"
                alt="Signature"
                loading="lazy"
                style="max-width: var(--qb-sig-size); height: auto;"
              >
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>

  <style>
    #qb-{{ section.id }} {
      --qb-bg: {{ section.settings.bg_color }};
      --qb-radius: {{ section.settings.radius }}px;
      --qb-pad-y: {{ section.settings.pad_y_desktop }}px;
      --qb-pad-x: {{ section.settings.pad_x_desktop }}px;
      --qb-max: {% if section.settings.max_width == 'full' %}100%{% else %}{{ section.settings.custom_max_width }}px{% endif %};
      --qb-shadow: {% if section.settings.enable_shadow %}0 8px 28px rgba(0,0,0,.18){% else %}none{% endif %};
      --qb-align: {{ section.settings.text_align_desktop }};
      --qb-text-max: {{ section.settings.text_max_width }}px;
      --qb-gap-top: {{ section.settings.gap_top }}px;
      --qb-quote-color: {{ quote_block.settings.quote_color }};
      --qb-quote-size: {{ quote_block.settings.quote_size }}px;
      --qb-quote-size-mobile: {{ quote_block.settings.quote_size_mobile }}px;
      --qb-quote-weight: {{ quote_block.settings.quote_weight }};
      --qb-author-color: {{ author_block.settings.author_color }};
      --qb-author-size: {{ author_block.settings.author_size }}px;
      --qb-author-size-mobile: {{ author_block.settings.author_size_mobile }}px;
      --qb-avatar: {{ author_block.settings.avatar_size }}px;
      --qb-sig-size: {{ author_block.settings.signature_size_desktop }}px;
      --qb-sig-size-mobile: {{ author_block.settings.signature_size_mobile }}px;
    }

    #qb-{{ section.id }} .qb-wrap {
      width: 100%;
      display: flex;
      justify-content: center;
      padding: 20px;
    }

    #qb-{{ section.id }} .qb-card {
      width: 100%;
      max-width: var(--qb-max);
      background: var(--qb-bg);
      border-radius: var(--qb-radius);
      padding: var(--qb-pad-y) var(--qb-pad-x);
      box-shadow: var(--qb-shadow);
      text-align: var(--qb-align);
    }

    /* Inner width so the text line-length matches the screenshot */
    #qb-{{ section.id }} .qb-content {
      margin: 0 auto;
      max-width: var(--qb-text-max);
    }

    /* Kill all theme defaults that add white boxes/borders */
    #qb-{{ section.id }} .qb-quote {
      background: transparent !important;
      border: 0 !important;
      padding: 0 !important;
      margin: 0;
      line-height: 1.3;
      font-size: var(--qb-quote-size);
      letter-spacing: 0.2px;
      color: var(--qb-quote-color) !important;
      font-weight: var(--qb-quote-weight);
    }

    #qb-{{ section.id }} .qb-quote--curly:before,
    #qb-{{ section.id }} .qb-quote--curly:after {
      content: "“";
      font-weight: var(--qb-quote-weight);
    }
    #qb-{{ section.id }} .qb-quote--curly:after { content: "”"; }

    #qb-{{ section.id }} .qb-author {
      margin-top: var(--qb-gap-top);
      display: inline-flex;
      align-items: center;
      gap: 12px;
      font-size: var(--qb-author-size);
      font-weight: 600;
      color: var(--qb-author-color);
    }

    #qb-{{ section.id }} .qb-avatar {
      display: inline-flex;
      width: var(--qb-avatar);
      height: var(--qb-avatar);
      border-radius: 9999px;
      overflow: hidden;
      flex: 0 0 auto;
      box-shadow: 0 0 0 2px rgba(255,255,255,.25); /* subtle rim like screenshot */
    }
    #qb-{{ section.id }} .qb-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    #qb-{{ section.id }} .qb-author-name { font-weight: 700; }
    #qb-{{ section.id }} .qb-author-role { opacity: .95; font-weight: 500; }
    #qb-{{ section.id }} .qb-author-sep { opacity: .9; }

    #qb-{{ section.id }} .qb-signature-block {
      display: none;
      margin-top: 12px;
      text-align: var(--qb-align);
    }

    #qb-{{ section.id }} .qb-signature--inline {
      display: none;
      margin-left: 8px;
      vertical-align: middle;
    }

    @media (min-width: 769px) {
      #qb-{{ section.id }} .qb-visible-desktop {
        display: block;
      }
      #qb-{{ section.id }} .qb-signature--inline {
        display: inline-block;
      }
    }

    @media (max-width: 768px) {
      #qb-{{ section.id }} {
        --qb-pad-y: {{ section.settings.pad_y_mobile }}px;
        --qb-pad-x: {{ section.settings.pad_x_mobile }}px;
        --qb-align: {{ section.settings.text_align_mobile }};
        --qb-sig-size: var(--qb-sig-size-mobile);
      }
      #qb-{{ section.id }} .qb-card {
        padding: var(--qb-pad-y) var(--qb-pad-x);
      }
      #qb-{{ section.id }} .qb-content { max-width: 100%; }
      #qb-{{ section.id }} .qb-quote { font-size: var(--qb-quote-size-mobile); }
      #qb-{{ section.id }} .qb-author { font-size: var(--qb-author-size-mobile); }
      #qb-{{ section.id }} .qb-signature-block {
        display: block;
      }
      #qb-{{ section.id }} .qb-signature--inline {
        display: none;
      }
    }
  </style>
</section>

{% schema %}
{
  "name": "Quote Banner",
  "tag": "section",
  "class": "section-quote-banner",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Card background color", "default": "#3A49A4" },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 56, "step": 2, "default": 28 },
    { "type": "checkbox", "id": "enable_shadow", "label": "Soft shadow", "default": true },
    { "type": "select", "id": "text_align_desktop", "label": "Content alignment (desktop)", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ] },
    { "type": "select", "id": "text_align_mobile", "label": "Content alignment (mobile)", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ] },
    { "type": "range", "id": "pad_y_desktop", "label": "Vertical padding (desktop px)", "min": 12, "max": 120, "step": 2, "default": 72 },
    { "type": "range", "id": "pad_y_mobile", "label": "Vertical padding (mobile px)", "min": 12, "max": 120, "step": 2, "default": 42 },
    { "type": "range", "id": "pad_x_desktop", "label": "Horizontal padding (desktop px)", "min": 12, "max": 120, "step": 2, "default": 72 },
    { "type": "range", "id": "pad_x_mobile", "label": "Horizontal padding (mobile px)", "min": 12, "max": 120, "step": 2, "default": 24 },
    { "type": "select", "id": "max_width", "label": "Card max width", "default": "custom",
      "options": [ { "value": "custom", "label": "Custom (set below)" }, { "value": "full", "label": "Full width" } ] },
    { "type": "range", "id": "custom_max_width", "label": "Custom card max width (px)", "min": 600, "max": 2000, "step": 20, "default": 1080 },
    { "type": "range", "id": "text_max_width", "label": "Max text width inside card (px)", "min": 600, "max": 1400, "step": 10, "default": 1200 },
    { "type": "range", "id": "gap_top", "label": "Gap above author row (px)", "min": 8, "max": 60, "step": 1, "default": 28 }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "limit": 1,
      "settings": [
        { "type": "textarea", "id": "quote_text", "label": "Quote text",
          "default": "Based on ingredients, NutraCore offers a well-rounded approach to skin health and reducing dryness." },
        { "type": "color", "id": "quote_color", "label": "Quote color", "default": "#FFFFFF" },
        { "type": "select", "id": "quote_weight", "label": "Quote font weight", "default": "600",
          "options": [
            { "value": "300", "label": "Light" },
            { "value": "400", "label": "Normal" },
            { "value": "600", "label": "Semi Bold" },
            { "value": "700", "label": "Bold" },
            { "value": "800", "label": "Extra Bold" }
          ]
        },
        { "type": "range", "id": "quote_size", "label": "Quote font size (desktop px)", "min": 24, "max": 72, "step": 1, "default": 32 },
        { "type": "range", "id": "quote_size_mobile", "label": "Quote font size (mobile px)", "min": 16, "max": 40, "step": 1, "default": 20 },
        { "type": "checkbox", "id": "use_curly_quotes", "label": "Auto add curly quote marks", "default": true }
      ]
    },
    {
      "type": "author",
      "name": "Author",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "avatar", "label": "Author avatar (optional)" },
        { "type": "text", "id": "author_name", "label": "Author name", "default": "Andrew Schulz" },
        { "type": "text", "id": "author_role", "label": "Author role / title", "default": "Technologist" },
        { "type": "color", "id": "author_color", "label": "Author color", "default": "#FFFFFF" },
        { "type": "range", "id": "author_size", "label": "Author font size (desktop px)", "min": 12, "max": 28, "step": 1, "default": 18 },
        { "type": "range", "id": "author_size_mobile", "label": "Author font size (mobile px)", "min": 12, "max": 22, "step": 1, "default": 16 },
        { "type": "range", "id": "avatar_size", "label": "Avatar size (px)", "min": 24, "max": 96, "step": 2, "default": 44 },
        { "type": "checkbox", "id": "enable_signature", "label": "Enable Signature", "default": false },
        { "type": "image_picker", "id": "signature_image", "label": "Signature image" },
        { "type": "select", "id": "signature_position", "label": "Desktop position", "default": "right",
          "options": [
            { "value": "right", "label": "Right of title" },
            { "value": "below", "label": "Below author" }
          ]
        },
        { "type": "range", "id": "signature_size_desktop", "label": "Signature max width desktop (px)", "min": 50, "max": 300, "step": 10, "default": 150 },
        { "type": "range", "id": "signature_size_mobile", "label": "Signature max width mobile (px)", "min": 50, "max": 200, "step": 10, "default": 100 }
      ]
    }
  ],
  "presets": [
    { "name": "Quote Banner", "category": "Banners", "blocks": [ { "type": "quote" }, { "type": "author" } ] }
  ]
}
{% endschema %}