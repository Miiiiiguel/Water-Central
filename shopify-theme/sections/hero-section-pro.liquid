<!-- Scoped JavaScript -->
<script>
  (function () {
    document.addEventListener('DOMContentLoaded', function () {
      const heroSection = document.getElementById('unique-hero-section');
      if (!heroSection) return;

      // Main CTA Button
      const ctaButton = heroSection.querySelector('.cta-button');
      if (ctaButton) {
        ctaButton.addEventListener('click', function () {
          console.log('Main CTA Button clicked within Hero Section');
        });
      }

      // Secondary CTA Button
      const secondaryCtaButton = heroSection.querySelector('.secondary-cta-button');
      if (secondaryCtaButton) {
        secondaryCtaButton.addEventListener('click', function () {
          console.log('Secondary CTA Button clicked within Hero Section');
        });
      }

      // Mouse Move Parallax Effect (Toggle Enabled)
      const heroBackground = heroSection.querySelector('.hero-background');
      const enableParallax = {{ section.settings.enable_parallax_mouse | json }};
      if (heroBackground && enableParallax) {
        heroSection.addEventListener('mousemove', function (e) {
          const rect = heroSection.getBoundingClientRect();
          const offsetX = e.clientX - rect.left;
          const offsetY = e.clientY - rect.top;
          const centerX = rect.width / 2;
          const centerY = rect.height / 2;
          const strength = 0.03;
          const moveX = (offsetX - centerX) * strength;
          const moveY = (offsetY - centerY) * strength;
          heroBackground.style.transform = `translate(${moveX}px, ${moveY}px) scale(1.03)`;
        });
      }
    });
  })();
</script>
