{%- liquid
  assign ai_gen_id = section.id | replace: '-', ''
  assign bg_color  = section.settings.bg_color
  assign title     = section.settings.title
  assign collection = collections[section.settings.collection]
  assign max_items  = section.settings.max_items
  assign gap        = section.settings.product_gap
-%}

<style>
  #pc-{{ ai_gen_id }} {
    background-color: {{ bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #pc-{{ ai_gen_id }} .ai-pc-title {
    text-align: center;
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    color: {{ section.settings.title_color }};
    margin: 0 0 1.5rem;
  }
  #pc-{{ ai_gen_id }} .ai-pc-outer {
    max-width: {{ section.settings.section_width }}px;
    margin: 0 auto;
    padding: 0 16px;
  }
  .ai-product-carousel-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 4px;
  }
  .ai-product-carousel-wrapper-{{ ai_gen_id }}::-webkit-scrollbar { display: none; }

  .ai-product-carousel-item-{{ ai_gen_id }} {
    flex: 0 0 {{ section.settings.card_width }}px;
    scroll-snap-align: start;
    background: {{ section.settings.card_bg }};
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    border: 1px solid rgba(212,175,55,0.15);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .ai-product-carousel-item-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.4);
  }
  .ai-pc-img-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #111;
  }
  .ai-pc-img-wrap img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .ai-product-carousel-item-{{ ai_gen_id }}:hover .ai-pc-img-wrap img {
    transform: scale(1.04);
  }
  .ai-pc-body {
    padding: 14px;
  }
  .ai-pc-vendor {
    font-size: 11px;
    color: #d4af37;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 4px;
  }
  .ai-pc-name {
    font-size: 14px;
    font-weight: 600;
    color: {{ section.settings.card_text_color }};
    margin-bottom: 8px;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ai-pc-price {
    font-size: 16px;
    font-weight: 700;
    color: #d4af37;
    margin-bottom: 12px;
  }
  .ai-pc-price s {
    color: rgba(255,255,255,0.35);
    font-weight: 400;
    font-size: 13px;
    margin-left: 6px;
  }
  .ai-pc-btn {
    display: block;
    width: 100%;
    text-align: center;
    background: #22c55e;
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    padding: 9px 12px;
    border-radius: 50px;
    text-decoration: none;
    letter-spacing: 0.03em;
    transition: background 0.2s, transform 0.2s;
  }
  .ai-pc-btn:hover {
    background: #16a34a;
    transform: scale(1.02);
    color: #fff;
    text-decoration: none;
  }
  /* Dots */
  .ai-pc-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }
  .ai-product-carousel-dot-{{ ai_gen_id }} {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: rgba(212,175,55,0.3);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s, transform 0.2s;
  }
  .ai-product-carousel-dot-{{ ai_gen_id }}.active {
    background: #d4af37;
    transform: scale(1.35);
  }
  @media (max-width: 600px) {
    .ai-product-carousel-item-{{ ai_gen_id }} {
      flex: 0 0 calc(80vw - 32px);
    }
  }
</style>

<section id="pc-{{ ai_gen_id }}">
  <div class="ai-pc-outer">
    {%- if title != blank -%}
      <h2 class="ai-pc-title">{{ title }}</h2>
    {%- endif -%}

    <product-carousel-{{ ai_gen_id }}>
      <div class="ai-product-carousel-wrapper-{{ ai_gen_id }}">
        {%- if collection != blank -%}
          {%- for product in collection.products limit: max_items -%}
            <div class="ai-product-carousel-item-{{ ai_gen_id }}">
              <a href="{{ product.url }}" class="ai-pc-img-wrap" aria-label="{{ product.title | escape }}">
                {%- if product.featured_image -%}
                  <img src="{{ product.featured_image | image_url: width: 600 }}"
                       alt="{{ product.featured_image.alt | default: product.title | escape }}"
                       width="600" height="600" loading="lazy">
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'ai-pc-placeholder' }}
                {%- endif -%}
              </a>
              <div class="ai-pc-body">
                {%- if product.vendor != blank -%}
                  <p class="ai-pc-vendor">{{ product.vendor }}</p>
                {%- endif -%}
                <p class="ai-pc-name">{{ product.title }}</p>
                <div class="ai-pc-price">
                  {{ product.price | money }}
                  {%- if product.compare_at_price > product.price -%}
                    <s>{{ product.compare_at_price | money }}</s>
                  {%- endif -%}
                </div>
                <a href="{{ product.url }}" class="ai-pc-btn">
                  {{ section.settings.btn_label | default: 'Ver producto' }}
                </a>
              </div>
            </div>
          {%- else -%}
            <p style="color:rgba(255,255,255,0.5);padding:20px;">
              Selecciona una colección en los ajustes de la sección.
            </p>
          {%- endfor -%}
        {%- else -%}
          <p style="color:rgba(255,255,255,0.5);padding:20px;">
            Selecciona una colección en los ajustes de la sección.
          </p>
        {%- endif -%}
      </div>

      {%- if collection != blank and collection.products_count > 1 -%}
        <div class="ai-pc-dots">
          {%- for product in collection.products limit: max_items -%}
            <button class="ai-product-carousel-dot-{{ ai_gen_id }}"
                    data-index="{{ forloop.index0 }}"
                    aria-label="{{ 'Ir al producto' }} {{ forloop.index }}"
                    type="button"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </product-carousel-{{ ai_gen_id }}>
  </div>
</section>

<script>
  (function() {
    class ProductCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.autoplayInterval = null;
        this.autoplayDelay = 3000;
      }
      connectedCallback() {
        this.wrapper = this.querySelector('.ai-product-carousel-wrapper-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-product-carousel-dot-{{ ai_gen_id }}');
        this.items = this.querySelectorAll('.ai-product-carousel-item-{{ ai_gen_id }}');
        if (!this.wrapper || this.items.length === 0) return;
        this.currentIndex = 0;
        this.setupEventListeners();
        this.updateActiveDot();
        this.startAutoplay();
      }
      disconnectedCallback() { this.stopAutoplay(); }
      setupEventListeners() {
        this.wrapper.addEventListener('scroll', () => this.handleScroll());
        this.dots.forEach((dot) => {
          dot.addEventListener('click', (e) => {
            const index = parseInt(e.target.getAttribute('data-index'));
            this.stopAutoplay();
            this.scrollToIndex(index);
            this.startAutoplay();
          });
        });
        this.wrapper.addEventListener('touchstart', () => this.stopAutoplay(), { passive: true });
        this.wrapper.addEventListener('touchend', () => this.startAutoplay(), { passive: true });
        this.wrapper.addEventListener('mouseenter', () => this.stopAutoplay());
        this.wrapper.addEventListener('mouseleave', () => this.startAutoplay());
      }
      startAutoplay() {
        this.stopAutoplay();
        this.autoplayInterval = setInterval(() => {
          const nextIndex = (this.currentIndex + 1) % this.items.length;
          this.scrollToIndex(nextIndex);
        }, this.autoplayDelay);
      }
      stopAutoplay() {
        if (this.autoplayInterval) { clearInterval(this.autoplayInterval); this.autoplayInterval = null; }
      }
      handleScroll() {
        const scrollLeft = this.wrapper.scrollLeft;
        const itemWidth = this.items[0].offsetWidth;
        const gap = {{ section.settings.product_gap }};
        const newIndex = Math.round(scrollLeft / (itemWidth + gap));
        if (newIndex !== this.currentIndex) { this.currentIndex = newIndex; this.updateActiveDot(); }
      }
      scrollToIndex(index) {
        const itemWidth = this.items[0].offsetWidth;
        const gap = {{ section.settings.product_gap }};
        const scrollPosition = index * (itemWidth + gap);
        this.currentIndex = index;
        this.updateActiveDot();
        this.wrapper.scrollTo({ left: scrollPosition, behavior: 'smooth' });
      }
      updateActiveDot() {
        this.dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === this.currentIndex);
        });
      }
    }
    if (!customElements.get('product-carousel-{{ ai_gen_id }}')) {
      customElements.define('product-carousel-{{ ai_gen_id }}', ProductCarousel{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Carrusel de productos",
  "tag": "div",
  "class": "sudafin-product-carousel",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título de la sección",
      "default": "Nuestros productos"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color del título",
      "default": "#ffffff"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección a mostrar"
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "Número máximo de productos",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Tarjeta de producto"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Ancho de cada tarjeta (px)",
      "min": 180,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 240
    },
    {
      "type": "range",
      "id": "product_gap",
      "label": "Espacio entre tarjetas (px)",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Radio de esquinas (px)",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Fondo de tarjeta",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Color del nombre del producto",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Texto del botón",
      "default": "Ver producto"
    },
    {
      "type": "header",
      "content": "Sección"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "section_width",
      "label": "Ancho máximo (px)",
      "min": 800,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Carrusel de productos"
    }
  ]
}
{% endschema %}
