{% schema %}
{
  "name": "RichText Pro",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings",
      "info": "Configure the overall appearance and layout of the section."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff",
      "info": "Choose the background color for the section."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 200,
      "default": 40,
      "step": 10,
      "unit": "px",
      "info": "Set the top padding of the section."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 200,
      "default": 40,
      "step": 10,
      "unit": "px",
      "info": "Set the bottom padding of the section."
    },
    {
      "type": "select",
      "id": "elements_alignment",
      "label": "Elements Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "info": "Align the elements within the section."
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show Section on Mobile",
      "default": true,
      "info": "Toggle the visibility of the section on mobile devices."
    },

    {
      "type": "header",
      "content": "Typography Settings",
      "info": "Customize the fonts and text styles for titles, descriptions, and buttons."
    },
    {
      "type": "checkbox",
      "id": "enable_custom_font",
      "label": "Enable Custom Font",
      "default": false,
      "info": "Use custom fonts for the title, description, and button texts."
    },

    {
      "type": "header",
      "content": "Title Settings",
      "info": "Manage the title text and its styling."
    },

    {
      "type": "header",
      "content": "Description Settings",
      "info": "Manage the description text and its styling."
    },

    {
      "type": "header",
      "content": "Button Settings",
      "info": "Customize the appearance and behavior of the button."
    },

    {
      "type": "header",
      "content": "Image Settings",
      "info": "Configure the images, their appearance, and positioning."
    },
    {
      "type": "checkbox",
      "id": "show_left_circles",
      "label": "Show Left Floating Circles",
      "default": false,
      "info": "Toggle the visibility of floating circles on the left side."
    },
    {
      "type": "image_picker",
      "id": "left_big_circle_image",
      "label": "Left Big Circle Image",
      "info": "Upload the image for the left big floating circle."
    },
    {
      "type": "image_picker",
      "id": "left_medium_circle_image",
      "label": "Left Medium Circle Image",
      "info": "Upload the image for the left medium floating circle."
    },
    {
      "type": "range",
      "id": "left_circles_horizontal_position",
      "label": "Left Circles Horizontal Position",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 80,
      "info": "Adjust the horizontal position of the left floating circles."
    },
    {
      "type": "checkbox",
      "id": "show_right_circles",
      "label": "Show Right Floating Circles",
      "default": false,
      "info": "Toggle the visibility of floating circles on the right side."
    },
    {
      "type": "image_picker",
      "id": "right_big_circle_image",
      "label": "Right Big Circle Image",
      "info": "Upload the image for the right big floating circle."
    },
    {
      "type": "image_picker",
      "id": "right_medium_circle_image",
      "label": "Right Medium Circle Image",
      "info": "Upload the image for the right medium floating circle."
    },
    {
      "type": "range",
      "id": "right_circles_horizontal_position",
      "label": "Right Circles Horizontal Position",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 80,
      "info": "Adjust the horizontal position of the right floating circles."
    },
    {
      "type": "range",
      "id": "circles_spacing",
      "label": "Spacing Between Circles",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 88,
      "info": "Set the spacing between the floating circles."
    },

    {
      "type": "header",
      "content": "Main Demo Image Settings",
      "info": "Configure the main demo image that appears above the title."
    },
    {
      "type": "image_picker",
      "id": "main_demo_image",
      "label": "Main Demo Image",
      "info": "Upload/select the image to display above the title."
    },
    {
      "type": "range",
      "id": "main_demo_image_width",
      "label": "Image Width (px)",
      "min": 50,
      "max": 1000,
      "step": 10,
      "default": 400,
      "info": "Set the width of the main demo image."
    },
    {
      "type": "range",
      "id": "main_demo_image_height",
      "label": "Image Height (px)",
      "min": 50,
      "max": 1000,
      "step": 10,
      "default": 200,
      "info": "Set the height of the main demo image."
    },
    {
      "type": "range",
      "id": "main_demo_image_horizontal_position",
      "label": "Image Horizontal Position (px)",
      "min": -500,
      "max": 500,
      "step": 10,
      "default": 0,
      "info": "Adjust the horizontal position of the main demo image."
    },
    {
      "type": "range",
      "id": "main_demo_image_vertical_position_desktop",
      "label": "Image Vertical Position Desktop (px)",
      "min": -500,
      "max": 500,
      "step": 10,
      "default": 0,
      "info": "Adjust the vertical position of the main demo image on desktop."
    },
    {
      "type": "range",
      "id": "main_demo_image_vertical_position_mobile",
      "label": "Image Vertical Position Mobile (px)",
      "min": -500,
      "max": 500,
      "step": 10,
      "default": 0,
      "info": "Adjust the vertical position of the main demo image on mobile."
    },

    {
      "type": "header",
      "content": "Badge Settings",
      "info": "Configure the Pill Shaped Badge above the text heading."
    },
    {
      "type": "checkbox",
      "id": "enable_badge",
      "label": "Enable Pill Shaped Badge Above Text Heading",
      "default": false,
      "info": "When enabled, a center pill shaped badge is displayed above the title text heading."
    },
    {
      "type": "checkbox",
      "id": "badge_enable_gradient",
      "label": "Enable Badge Gradient Background",
      "default": false,
      "info": "Apply a 3-color gradient effect to the badge background."
    },
    {
      "type": "color",
      "id": "badge_gradient_color1",
      "label": "Badge Gradient Color 1",
      "default": "#ff7e5f",
      "info": "Choose the first color for the badge gradient."
    },
    {
      "type": "color",
      "id": "badge_gradient_color2",
      "label": "Badge Gradient Color 2",
      "default": "#feb47b",
      "info": "Choose the second color for the badge gradient."
    },
    {
      "type": "color",
      "id": "badge_gradient_color3",
      "label": "Badge Gradient Color 3",
      "default": "#ffffff",
      "info": "Choose the third color for the badge gradient."
    },
    {
      "type": "select",
      "id": "badge_gradient_degrees",
      "label": "Badge Gradient Degrees",
      "options": [
        { "value": "to right", "label": "To Right" },
        { "value": "to left", "label": "To Left" },
        { "value": "to top", "label": "To Top" },
        { "value": "to bottom", "label": "To Bottom" },
        { "value": "45deg", "label": "45 Degrees" },
        { "value": "90deg", "label": "90 Degrees" },
        { "value": "135deg", "label": "135 Degrees" },
        { "value": "180deg", "label": "180 Degrees" }
      ],
      "default": "to right",
      "info": "Set the direction of the badge gradient."
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "BADGE",
      "info": "Enter the text to display inside the badge."
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge Text Color",
      "default": "#ffffff",
      "info": "Choose the text color of the badge."
    },
    {
      "type": "color",
      "id": "badge_border_color",
      "label": "Badge Border Color",
      "default": "#ffffff",
      "info": "Choose the border color of the badge."
    },
    {
      "type": "range",
      "id": "badge_border_thickness",
      "label": "Badge Border Thickness",
      "min": 0,
      "max": 5,
      "default": 0,
      "unit": "px",
      "info": "Set the thickness of the badge border."
    },
    {
      "type": "range",
      "id": "badge_text_font_size",
      "label": "Badge Text Font Size",
      "min": 8,
      "max": 40,
      "default": 14,
      "step": 1,
      "unit": "px",
      "info": "Adjust the font size of the badge text."
    },
    {
      "type": "range",
      "id": "badge_overall_size_desktop",
      "label": "Badge Overall Size",
      "min": 50,
      "max": 200,
      "step": 10,
      "default": 100,
      "info": "Scale the entire badge size on desktop (100 = normal)."

    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge Color",
      "default": "#265AFF",
      "info": "Choose the badge background color (used if gradient is disabled)."
    },
    {
      "type": "range",
      "id": "badge_vertical_position_desktop",
      "label": "Badge Vertical Position (Desktop)",
      "min": -100,
      "max": 200,
      "step": 10,
      "default": 0,
      "unit": "px",
      "info": "Adjust the vertical position of the badge on desktop."
    },
    {
      "type": "range",
      "id": "badge_vertical_position_mobile",
      "label": "Badge Vertical Position (Mobile)",
      "min": -100,
      "max": 200,
      "step": 10,
      "default": 0,
      "unit": "px",
      "info": "Adjust the vertical position of the badge on mobile."
    },
    {
      "type": "range",
      "id": "badge_width",
      "label": "Badge Width",
      "min": 50,
      "max": 500,
      "default": 120,
      "step": 10,
      "unit": "px",
      "info": "Set the width of the badge."
    },
    {
      "type": "range",
      "id": "badge_height",
      "label": "Badge Height",
      "min": 20,
      "max": 200,
      "step": 10,
      "default": 40,
      "unit": "px",
      "info": "Set the height of the badge."
    },
    {
      "type": "range",
      "id": "badge_border_radius",
      "label": "Badge Border Radius",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 20,
      "unit": "px",
      "info": "Adjust the border radius of the badge."
    }
  ],
