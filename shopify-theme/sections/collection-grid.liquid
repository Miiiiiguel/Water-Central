{% schema %}
{
  "name": "Collection Grid Pro",
  "tag": "section",
  "class": "simple-gallery--gallery-",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "collection_block",
      "name": "Collection Block",
      "settings": [
        {
          "type": "textarea",
          "id": "video_url",
          "label": "Video URL",
          "info": "Optional: paste a video URL to autoplay in place of the image."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Block Image",
          "info": "Select the image for this block."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Choose Collection",
          "info": "Select the collection to link when this block is clicked."
        },
        {
          "type": "text",
          "id": "collection_title",
          "label": "Collection Title Text",
          "info": "Title displayed over the image."
        },
        {
          "type": "range",
          "id": "collection_title_font_size",
          "label": "Collection Title Font Size",
          "min": 10,
          "max": 50,
          "step": 1,
          "unit": "px",
          "default": 20,
          "info": "Adjust the font size for the collection title."
        },
        {
          "type": "range",
          "id": "collection_title_vertical_position",
          "label": "Collection Title Vertical Position",
          "min": -200,
          "max": 200,
          "step": 10,
          "unit": "px",
          "default": 0,
          "info": "Shift the title up/down inside the overlay."
        },
        {
          "type": "inline_richtext",
          "id": "button_label",
          "label": "Button Label",
          "default": "See collection",
          "info": "Text for the bottom button."
        },
        {
          "type": "range",
          "id": "button_overall_size",
          "label": "Button Overall Size",
          "min": 10,
          "max": 50,
          "step": 1,
          "unit": "px",
          "default": 14,
          "info": "Controls the button font size & padding."
        },
        {
          "type": "range",
          "id": "button_vertical_position",
          "label": "Button Vertical Position",
          "min": -200,
          "max": 200,
          "step": 10,
          "unit": "px",
          "default": 0,
          "info": "Shift the button up/down inside the overlay."
        },
        {
          "type": "color",
          "id": "button_bg_color",
          "label": "Button Background Color",
          "default": "#000000"
        },
        {
          "type": "color",
