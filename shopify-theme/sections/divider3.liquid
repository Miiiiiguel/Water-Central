{% style %}
	.Loudz-{{ section.id | handle }} {
		--section-margin-top-mobile: {{- section.settings.top_margin_mobile -}}px;
		--section-margin-bottom-mobile: {{- section.settings.bottom_margin_mobile -}}px;
		--section-margin-top-desktop: {{- section.settings.top_margin_desktop -}}px;
		--section-margin-bottom-desktop: {{- section.settings.bottom_margin_desktop -}}px;
		--section-vertical-margin-mobile: {{- section.settings.vertical_margin_mobile -}}px;
		--section-divider-color: {{- section.settings.divider_color -}};
		--section-max-width: {{- section.settings.section_max_width -}}px;
		--section-width: {{- section.settings.section_width -}}%;
	  --section-divider-thickness: {{- section.settings.divider_thickness -}}px;
		--section-two-line-divider-thickness: {{- section.settings.two_line_divider_thickness -}}px;
		--section-circle-divider-thickness: {{- section.settings.circle_divider_thickness -}}px;
		--section-lines-divider-thickness: {{- section.settings.lines_divider_thickness -}}px;
		--section-rectangles-divider-thickness: {{- section.settings.rectangles_divider_thickness -}}px;
		--section-wave-line-divider-thickness: {{- section.settings.wave_line_divider_thickness -}}px;
		--section-waves-divider-thickness: {{- section.settings.waves_divider_thickness -}}px;
		--section-waves-2-divider-thickness: {{- section.settings.waves2_divider_thickness -}}px;
		--section-marks-divider-thickness: {{- section.settings.marks_divider_thickness -}}px;
		--section-leaf-divider-width: {{- section.settings.leaf_divider_width -}}%;
		--section-brush-1-divider-width: {{- section.settings.brush1_divider_width -}}%;
		--section-brush-2-divider-width: {{- section.settings.brush2_divider_width -}}%;
		--section-pointed-stars-divider-width: {{- section.settings.pointed_stars_divider_width -}}%;
	}

	

