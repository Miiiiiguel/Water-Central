    {
      "type": "header",
      "content": "Display Settings",
      "info": "Control on which devices the gallery section is displayed."
    },
    {
      "type": "select",
      "id": "display_section_on",
      "label": "Display Section On",
      "options": [
        { "value": "all_devices", "label": "All Devices" },
        { "value": "mobile_only", "label": "Mobile Devices Only" },
        { "value": "desktop_only", "label": "Desktop / Larger Screens Only" },
        { "value": "no_devices", "label": "No Devices" }
      ],
      "default": "all_devices",
      "info": "Choose the devices on which the gallery section will be visible."
    },
    {
      "type": "header",
      "content": "Spacing Settings",
      "info": "Adjust vertical spacing between elements."
    },
    {
      "type": "range",
      "id": "vertical_space_title_subheading",
      "label": "Vertical Space Between Title and Subheading",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20,
      "unit": "px",
      "info": "Adjust the vertical space between the gallery title and subheading."
    },
    {
      "type": "range",
      "id": "vertical_space_subheading_gallery",
      "label": "Vertical Space Between Subheading and Gallery",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 30,
      "unit": "px",
      "info": "Adjust the vertical space between the gallery subheading and the gallery."
    },
    {
      "type": "header",
      "content": "Gallery Wrap Settings",
