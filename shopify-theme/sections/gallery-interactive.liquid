        { "value": "none", "label": "None" },
        { "value": "low", "label": "Low Shadow" },
        { "value": "medium", "label": "Medium Shadow" },
        { "value": "high", "label": "High Shadow" }
      ],
      "default": "low",
      "info": "Select the shadow intensity for the gallery container."
    }
