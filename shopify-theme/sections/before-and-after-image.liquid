{% schema %}
{
  "name": "Before/After Images",
  "settings": [
    {
      "type": "header",
      "content": "Heading Text",
      "info": "Configure the texts displayed above the images."
    },
    {
      "type": "text",
      "id": "before_text",
      "label": "Before Text",
      "default": "Before",
      "info": "Text label for the before image."
    },
    {
      "type": "text",
      "id": "after_text",
      "label": "After Text",
      "default": "After",
      "info": "Text label for the after image."
    },
    {
      "type": "checkbox",
      "id": "show_text",
      "label": "Show Before/After Texts",
      "default": true,
      "info": "Toggle the visibility of the before and after text labels."
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text Size",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 57,
      "info": "Adjust the size of the before and after text labels."
    },
    {
      "type": "color",
      "id": "before_text_color",
      "label": "Before Text Color",
      "default": "#ffffff",
      "info": "Select the color for the before text label."
    },
    {
      "type": "color",
      "id": "after_text_color",
      "label": "After Text Color",
      "default": "#ffffff",
      "info": "Select the color for the after text label."
    },
    {
      "type": "range",
