{% assign short_id = section.id | slice: -3, 3 %} 

<style>

  :root {
    --loudpro-clip-{{ short_id }}: {{ section.settings.start_percent }}%;
    --horizontal-gap-{{ short_id }}: {{ section.settings.horizontal_gap }}px; /* Added Horizontal Gap Variable */
  }

  {%- capture loudpro_content -%} 

  {% if section.settings.override_fonts %}
      {{ section.settings.text_font | font_face }}
      {{ section.settings.headline_font | font_face }}
  {% endif %}

  #loudpro-{{ section.id }} p {
      font-size: {{ section.settings.text_size }}px;
      {% if section.settings.override_fonts %}
      font-family: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
      font-weight: {{ section.settings.text_font.weight }};
    {% endif %}
      {% if section.settings.text_line_height != 'inherit' %}line-height: {{ section.settings.text_line_height }};{% endif %}
      margin: 0 0 {{ section.settings.element_spacing }}px 0;
      padding: 0;
      color: {{ section.settings.content_text_color }};
  }

  #loudpro-{{ section.id }} ul, #loudpro-{{ section.id }} ol {
    margin: 0 0 {{ section.settings.element_spacing }}px 0;
  }

  #loudpro-{{ section.id }} li {
    font-size: {{ section.settings.text_size }}px;
    {% if section.settings.override_fonts %}
    font-family: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
    font-weight: {{ section.settings.text_font.weight }};
    {% endif %}
    {% if section.settings.text_line_height != 'inherit' %}line-height: {{ section.settings.text_line_height }};{% endif %}
    margin: 0 0 5px 0;
    padding: 0;
    color: {{ section.settings.content_text_color }};
  }

  #loudpro-{{ section.id }} li:last-child {
    margin: 0;
  }

  #loudpro-{{ section.id }} p a,
  #loudpro-{{ section.id }} p a:visited,
  #loudpro-{{ section.id }} li a,
  #loudpro-{{ section.id }} li a:visited {
    color: {{ section.settings.link_color }};
  }

  @media (max-width: 800px) {
      #loudpro-{{ section.id }} p,
      #loudpro-{{ section.id }} li {
        font-size: {{ section.settings.mobile_text_size }}px;
      }
  }

  #loudpro-{{ section.id }} h1,
  #loudpro-{{ section.id }} h2,
  #loudpro-{{ section.id }} h3,
  #loudpro-{{ section.id }} h4,
  #loudpro-{{ section.id }} h5 {
      font-size: {{ section.settings.headline_size }}px;
      {% if section.settings.override_fonts %}
      font-family: {{ section.settings.headline_font.family }}, {{ section.settings.headline_font.fallback_families }};
      font-weight: {{ section.settings.headline_font.weight }};
      {% endif %}
      {% if section.settings.headline_line_height != 'inherit' %}line-height: {{ section.settings.headline_line_height }};{% endif %}
      margin: 0 0 {{ section.settings.element_spacing }}px 0;
      padding: 0;
      color: {{ section.settings.headline_color }} !important;
  }

  @media (max-width: 800px) {
      #loudpro-{{ section.id }} h1,
      #loudpro-{{ section.id }} h2,
      #loudpro-{{ section.id }} h3,
      #loudpro-{{ section.id }} h4,
      #loudpro-{{ section.id }} h5 {
      font-size: {{ section.settings.mobile_headline_size }}px;
      }
  }

  #loudpro-{{ section.id }} h2 {
      font-size: {{ section.settings.headline_size | minus:5  | at_least:13 }}px;
  }

  #loudpro-{{ section.id }} h3 {
      font-size: {{ section.settings.headline_size | minus:10 | at_least:13 }}px;
  }

  #loudpro-{{ section.id }} h4 {
      font-size: {{ section.settings.headline_size | minus:15 | at_least:13 }}px;
  }

  #loudpro-{{ section.id }} h5 {
      font-size: {{ section.settings.headline_size | minus:20 | at_least:13 }}px;
  }

  @media (max-width: 800px) {
      #loudpro-{{ section.id }} h2 {
      font-size: {{ section.settings.mobile_headline_size | minus:5 | at_least:13 }}px;
      }

      #loudpro-{{ section.id }} h3 {
      font-size: {{ section.settings.mobile_headline_size | minus:10 | at_least:13 }}px;
      }

      #loudpro-{{ section.id }} h4 {
      font-size: {{ section.settings.mobile_headline_size | minus:15 | at_least:13 }}px;
      }

      #loudpro-{{ section.id }} h5 {
      font-size: {{ section.settings.mobile_headline_size | minus:20 | at_least:13 }}px;
      }
  }

  #loudpro-{{ section.id }} {
      background-color: {{ section.settings.section_background_color }};
      {% if section.settings.section_background_image %}
          background: url({{ section.settings.section_background_image | image_url }});
          background-repeat: no-repeat;
          background-position: center;
          width: 100%;
          background-size: {{ section.settings.section_background_size }};
      {% endif %}
      width: 100%;
      box-sizing: border-box;
      padding: {{ section.settings.section_padding_top_bottom }}px {{ section.settings.section_padding_left_right }}px;
      overflow: hidden;
  }

  @media (max-width: 800px) {
      #loudpro-{{ section.id }} {
        padding: {{ section.settings.mobile_section_padding_top_bottom }}px {{ section.settings.mobile_section_padding_left_right }}px;
      }
  }

  {% if section.settings.show_on_device == 'mobile' %}
    @media (min-width: 801px) {
        #loudpro-{{ section.id }} {
            display: none;
        }
    }
  {% endif %}

  {% if section.settings.show_on_device == 'desktop' %}
    @media (max-width: 800px) {
        #loudpro-{{ section.id }} {
            display: none;
        }
    }
  {% endif %}

  #loudpro-{{ section.id }} .loudpro-container {
      position: relative;
      margin: 0 auto;
      background-color: transparent;
      {% comment %} Removed border-radius, box-shadow, and border properties {% endcomment %}
      max-width: {{ section.settings.container_max_width }}px;
      padding: {{ section.settings.container_padding_top_bottom }}px {{ section.settings.container_padding_left_right }}px;
  }

  @media (max-width: 800px) {
      #loudpro-{{ section.id }} .loudpro-container {
      padding: {{ section.settings.mobile_container_padding_top_bottom }}px {{ section.settings.mobile_container_padding_left_right }}px;
      }
  }


  /* headline */
  #loudpro-{{ section.id }} .loudpro-headline {
    margin: 0;
    padding: 0 0 {{ section.settings.headline_spacing }}px 0;
  }

  #loudpro-{{ section.id }} .loudpro-headline * {
    text-align: {{ section.settings.text_alignment }};
  }

  @media only screen and (max-width: 800px) {
    #loudpro-{{ section.id }} .loudpro-headline * {
      text-align: {{ section.settings.mobile_text_alignment }};
    }
  }

  /* Button styles (button link URL and button text input are set via “link” and “link_text”) */
  #loudpro-{{ section.id }} a.loudpro-cta {
    display: inline-block;
    padding: {{ section.settings.button_padding_tb }}px {{ section.settings.button_padding_lr }}px;
    background-color: {{ section.settings.button_background_color }};
    border-radius: {{ section.settings.button_border_radius }}px;
    color: {{ section.settings.button_text_color }};
    font-size: {{ section.settings.button_text_size }}px !important;
    text-decoration: none;
    cursor: pointer;
    text-shadow: none;
    transition: .25s all;
    font-size: 13px;
  }

  /* Hover Animations */
  {% comment %}
    Button Hover Animation Classes
  {% endcomment %}
  a.loudpro-cta.hover-fade-in:hover {
    opacity: 0.8;
  }

  a.loudpro-cta.hover-zoom-in:hover {
    transform: scale(1.05);
  }

  a.loudpro-cta.hover-shadow:hover {
    box-shadow: 0px 4px 10px rgba(0,0,0,0.3);
  }

  a.loudpro-cta.hover-slide-up:hover {
    transform: translateY(-2px);
  }

  a.loudpro-cta.hover-rotate:hover {
    transform: rotate(3deg);
  }

  a.loudpro-cta.hover-color-change:hover {
    background-color: {{ section.settings.button_background_color | darken: 10 }};
  }

  /* grid */
  #loudpro-{{ section.id }} .loudpro-grid {
    position: relative;
    margin: 0 auto;
    max-width: {{ section.settings.max_width }}px;
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_right }}px {{ section.settings.padding_bottom }}px {{ section.settings.padding_left }}px;
    /* Removed gap: {{ section.settings.grid_gap }}px; */
  }

  #loudpro-{{ section.id }} .loudpro-grid-left {
    display: grid;
    {% if section.settings.media_aspect_ratio == "21 / 9" %}
    grid-template-columns: 3fr 1fr;
    {% elsif section.settings.media_aspect_ratio == "16 / 9"%}
    grid-template-columns: 2fr 1fr;
    {% elsif section.settings.media_aspect_ratio == "3 / 2"%}
    grid-template-columns: 2fr 1fr;
    {% elsif section.settings.media_aspect_ratio == "5 / 4"%}
    grid-template-columns: 2fr 1fr;
    {% elsif section.settings.media_aspect_ratio == "3 / 1"%}
    grid-template-columns: 3fr 1fr;
    {% else %}
    grid-template-columns: 1fr 1fr;
    {% endif %}
    align-items: center;
    column-gap: var(--horizontal-gap-{{ short_id }}); /* Applied Horizontal Gap */
  }

  #loudpro-{{ section.id }} .loudpro-grid-right {
    display: grid;
    {% if section.settings.media_aspect_ratio == "21 / 9" %}
    grid-template-columns: 1fr 3fr;
    {% elsif section.settings.media_aspect_ratio == "16 / 9"%}
    grid-template-columns: 1fr 2fr;
    {% elsif section.settings.media_aspect_ratio == "3 / 2"%}
    grid-template-columns: 1fr 2fr;
    {% elsif section.settings.media_aspect_ratio == "5 / 4"%}
    grid-template-columns: 1fr 2fr;
    {% elsif section.settings.media_aspect_ratio == "3 / 1"%}
    grid-template-columns: 1fr 3fr;
    {% else %}
    grid-template-columns: 1fr 1fr;
    {% endif %}
    align-items: center;
    column-gap: var(--horizontal-gap-{{ short_id }}); /* Applied Horizontal Gap */
  }

  #loudpro-{{ section.id }} .loudpro-grid-left .loudpro-column-media {
    grid-column: 1;
    grid-row: 1;
  }
  
  #loudpro-{{ section.id }} .loudpro-grid-left .loudpro-column-text {
    grid-column: 2;
    grid-row: 1;
  }

  #loudpro-{{ section.id }} .loudpro-grid-right .loudpro-column-media {
    grid-column: 2;
    grid-row: 1;
  }
  
  #loudpro-{{ section.id }} .loudpro-grid-right .loudpro-column-text {
    grid-column: 1;
    grid-row: 1;
  }

  /* bottom */
  #loudpro-{{ section.id }} .loudpro-grid-bottom {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media only screen and (max-width: 900px) {
    #loudpro-{{ section.id }} .loudpro-grid-left,
    #loudpro-{{ section.id }} .loudpro-grid-right {
      display: block;
    }
  }

  @media only screen and (max-width: 900px) {
    #loudpro-{{ section.id }} .loudpro-column-text {
      margin: 0 0 {{ section.settings.grid_gap }}px 0;
    }
  }

  /* before and after */
  #loudpro-{{ section.id }} .loudpro-feature-wrap {
    border-radius: {{ section.settings.media_radius }}px;

    /* Image Shadow */
    {% case section.settings.image_shadow %}
      {% when 'low' %}
        box-shadow: 2px 2px 5px rgba(0,0,0,0.3);
      {% when 'medium' %}
        box-shadow: 4px 4px 10px rgba(0,0,0,0.5);
      {% when 'high' %}
        box-shadow: 6px 6px 15px rgba(0,0,0,0.7);
      {% else %}
        box-shadow: none;
    {% endcase %}
  }
  
  #loudpro-{{ section.id }} .loudpro-feature {
    width: 100%;
    aspect-ratio: {{ section.settings.media_aspect_ratio }};
    position: relative;
    clip-path: border-box;
    overflow: hidden;
    border-radius: {{ section.settings.media_radius }}px;
  }

  #loudpro-{{ section.id }} .loudpro-feature img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: 100%;
    aspect-ratio: {{ section.settings.media_aspect_ratio }};
    object-fit: cover;
    /* Removed border */

    /* Removed Image Shadow from img */
  }

  #loudpro-{{ section.id }} .loudpro-feature img:first-child {
  }

  #loudpro-{{ section.id }} .loudpro-feature img:nth-child(2) {
    clip-path: polygon(0 0, var(--loudpro-clip-{{ short_id }}) 0, var(--loudpro-clip-{{ short_id }}) 100%, 0% 100%);
  }

  #loudpro-{{ section.id }} .loudpro-slider {
    display: flex;
    justify-content: center;
    align-items: center;
    position: absolute;
    -webkit-appearance: none;
    appearance: none;
    width: calc(100% - 20px);
    height: calc(100% - 20px);
    background: rgba(0, 0, 0, 0);
    outline: none;
    margin: 10px;
    border: 0px;
    padding: 0;
  }

  #loudpro-{{ section.id }} .loudpro-slider::-webkit-slider-thumb {
    -moz-appearance: none;
    appearance: none;
    width: 20px;
    height: 800px;
    background: transparent;
    cursor: pointer;
    border: none;
    outline: none;
    box-shadow: none;
  }

  #loudpro-{{ section.id }} .loudpro-slider::-moz-range-thumb {
    -moz-appearance: none;
    appearance: none;
    width: 20px;
    height: 800px;
    background: transparent;
    cursor: pointer;
    outline: none;
    box-shadow: none;
    border: none;
  }

  #loudpro-{{ section.id }} .loudpro-icon {
    position: absolute;
    top: 50%;
    left: var(--loudpro-clip-{{ short_id }});
    width: 50px;
    height: 50px;
    transform: translateX(-25px) translateY(-25px);
    pointer-events: none;
    background: {{ section.settings.circle_color }};
    opacity: {{ section.settings.circle_opacity }}%;
    border-radius: 50%;
    transition: transform 0.3s ease, opacity 0.3s ease;
    /* Animation classes have been removed */
  }

  #loudpro-{{ section.id }} .loudpro-icon svg {
    width: 25px;
    height: 25px;
    fill: {{ section.settings.circle_icon_color }};
    pointer-events: none;
    transform: translateX(12.5px) translateY(12.5px);
  }

  #loudpro-{{ section.id }} .loudpro-bar {
    position: absolute;
    top: 0;
    left: var(--loudpro-clip-{{ short_id }});
    width: {{ section.settings.vertical_line_weight }}px;
    height: 100%;
    transform: translateX(-{{ section.settings.vertical_line_weight | divided_by: 2 }}px);
    pointer-events: none;
    background: {{ section.settings.bar_color }};
    opacity: {{ section.settings.bar_opacity }}%;
  }

  #loudpro-{{ section.id }} .loudpro-before,
  #loudpro-{{ section.id }} .loudpro-after {
    display: inline-block;
    position: absolute;
    background: {{ section.settings.before_after_background_color }};
    padding: 5px 10px;
    border-radius: 5px;
    font-size: 13px;
    color: {{ section.settings.before_after_text_color }};
  }

  #loudpro-{{ section.id }} .loudpro-before {
    top: 15px;
    left: 15px;
  }

  #loudpro-{{ section.id }} .loudpro-after {
    top: 15px;
    right: 15px;
  }
  
  /* Removed Hover Animations */

  /* Icon Selection Styles */
  {% comment %}
    Dynamically insert the selected SVG icon into the .loudpro-icon span.
    This is handled by Liquid conditionals based on the selected icon.
  {% endcomment %}

  {%- endcapture -%} 

  {%- liquid
    assign chunks = loudpro_content | strip_newlines | split: ' ' | join: ' ' | split: '*/'
    for chunk in chunks
      assign mini = chunk | split: '/*' | first | strip | replace: ': ', ':' | replace: '; ', ';' | replace: '} ', '}' | replace: ' {', '{' | replace: ';}', '}'
      echo mini
    endfor
  %}
</style>

<div id="loudpro-{{ section.id }}" class="loudpro-section" loudpro-section>

  <div class="loudpro-container" loudpro-container>

    <div class="loudpro-grid loudpro-grid-{{ section.settings.media_location }}" loudpro-grid>

      {% if section.settings.headline != '' or section.settings.content != '' or section.settings.link_text != '' %}
      <div class="loudpro-column loudpro-headline loudpro-column-text" loudpro-column>
        {% if section.settings.headline != '' %}<h2 class="loudpro-heading">{{ section.settings.headline }}</h2>{% endif %}
        {% if section.settings.content != '' %}<div class="loudpro-content">{{ section.settings.content }}</div>{% endif %}
        {% if section.settings.enable_button and section.settings.link_text != '' %}
          <p>
            <a class="loudpro-cta {% unless section.settings.button_hover_animation == 'none' %}hover-{{ section.settings.button_hover_animation }}{% endunless %}" href="{{ section.settings.link }}">
              {{ section.settings.link_text }}
            </a>
          </p>
        {% endif %}
      </div>
      {% endif %}

      <div class="loudpro-column loudpro-column-media" loudpro-column>

        <div class="loudpro-feature-wrap">
          <div class="loudpro-feature">
         {% if section.settings.after_image != blank %}
  <img 
    src="{{ section.settings.after_image | image_url: width: 1024 }}"
    loading="lazy"
    srcset="{{ section.settings.after_image | image_url: width: 600 }} 600w, {{ section.settings.after_image | image_url: width: 1024 }} 1100w">
{% else %}
  <img 
    src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E"
    alt="Placeholder for After Image">
{% endif %}
           {% if section.settings.before_image != blank %}
  <img 
    src="{{ section.settings.before_image | image_url: width: 1024 }}"
    loading="lazy"
    srcset="{{ section.settings.before_image | image_url: width: 600 }} 600w, {{ section.settings.before_image | image_url: width: 1024 }} 1100w">
{% else %}
  <img 
    src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E"
    alt="Placeholder for Before Image">
{% endif %}


            {% if section.settings.before_caption != '' %}<span class="loudpro-before">{{ section.settings.before_caption }}</span>{% endif %}
            {% if section.settings.after_caption != '' %}<span class="loudpro-after">{{ section.settings.after_caption }}</span>{% endif %}

            <input id="loudpro-slider-{{ short_id }}" type="range" min="0" max="100" value="50" class="loudpro-slider">

            {% if section.settings.show_bar %}<span class="loudpro-bar"></span>{% endif %}

            {% if section.settings.show_circle %}
            <span class="loudpro-icon">
              {% case section.settings.circle_icon %}
                {% when 'icon1' %}
                  <!-- Icon 1: Chevron Double Left -->
                  <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M9 7L4 12L9 17M15 7L20 12L15 17" stroke="{{ section.settings.circle_icon_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {% when 'icon2' %}
                  <!-- Icon 2: Double Arrow Left/Right -->
                  <svg enable-background="new 0 0 32 32" height="32px" id="Double_Arrow_Left_Right" version="1.1" viewBox="0 0 32 32" width="32px" xml:space="preserve" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
                    <g id="Double_Arrow_Left_Right">
                      <path d="M3.404,13.019h15.593c0.552,0,1-0.452,1-1.01c0-0.558-0.448-1.01-1-1.01H3.404l5.2-5.275c0.391-0.395,0.391-1.034,0-1.428c-0.391-0.395-1.024-0.395-1.414,0l-6.899,6.999c-0.385,0.389-0.389,1.04,0,1.429l6.9,6.999c0.391,0.395,1.024,0.394,1.414,0c0.391-0.394,0.391-1.034,0-1.428L3.404,13.019z" fill="#121313"/>
                      <path d="M31.71,19.277l-6.9-6.999c-0.391-0.395-1.024-0.394-1.414,0c-0.391,0.394-0.391,1.034,0,1.428l5.2,5.275H13.003c-0.552,0-1,0.452-1,1.01c0,0.558,0.448,1.01,1,1.01h15.593l-5.2,5.275c-0.391,0.395-0.391,1.034,0,1.428c0.391,0.395,1.024,0.395,1.414,0l6.899-6.999C32.095,20.317,32.099,19.666,31.71,19.277z" fill="#121313"/>
                    </g>
                  </svg>
                {% when 'icon3' %}
                  <!-- Icon 3: Star -->
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M12 2l2.39 6.93L22 9.24l-5 4.87L18.78 22 12 18.56 5.22 22 7 14.11 2 9.24l7.61-0.31L12 2z" stroke="{{ section.settings.circle_icon_color }}" stroke-width="2" fill="none"/>
                  </svg>
                {% when 'icon4' %}
                  <!-- Icon 4: Heart -->
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M12 21C12 21 5 14.5 5 8.5C5 5.42 7.42 3 10.5 3C12.24 3 13.91 3.81 15 5.08C16.09 3.81 17.76 3 19.5 3C22.58 3 25 5.42 25 8.5C25 14.5 18 21 18 21H12Z" stroke="{{ section.settings.circle_icon_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {% when 'icon5' %}
                  <!-- Icon 5: Pencil -->
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M12 20H21V13L17 9L12 14L3 5L-2 12V21H7L12 16L17 21Z" stroke="{{ section.settings.circle_icon_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {% when 'icon6' %}
                  <!-- Icon 6: Camera -->
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M23 19V7C23 5.34315 21.6569 4 20 4H4C2.34315 4 1 5.34315 1 7V19C1 20.6569 2.34315 22 4 22H20C21.6569 22 23 20.6569 23 19Z" stroke="{{ section.settings.circle_icon_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="12" cy="13" r="4" stroke="{{ section.settings.circle_icon_color }}" stroke-width="2"/>
                  </svg>
                {% when 'icon7' %}
                  <!-- Icon 7: Bell -->
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M18 8C18 5.23858 15.7614 3 13 3C10.2386 3 8 5.23858 8 8C8 14 5 16 5 16H21C21 16 18 14 18 8Z" stroke="{{ section.settings.circle_icon_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M13.73 21C13.73 21 11.86 21 11.86 19.07C11.86 17.14 12.55 16.63 12.55 16.63C12.55 16.63 13.87 16.21 14 15.04C14.13 13.88 14 13 14 13" stroke="{{ section.settings.circle_icon_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
