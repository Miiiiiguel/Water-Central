{% schema %}
{
  "name": "Faq-1",
  "tag": "section",
  "class": "faq1",

  "settings": [
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Desktop top spacing",
      "default": 90,
      "info": "Adjust the top spacing for desktop"
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Desktop bottom spacing",
      "default": 120,
      "info": "Adjust the bottom spacing for desktop"
    },
    {
      "type": "range",
      "id": "section_padding_left",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Desktop left spacing",
      "default": 180,
      "info": "Adjust the left spacing for desktop"
    },
    {
      "type": "range",
      "id": "section_padding_right",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Desktop right spacing",
      "default": 180,
      "info": "Adjust the right spacing for desktop"
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Mobile top spacing",
      "default": 70,
      "info": "Adjust the top spacing for mobile"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Mobile bottom spacing",
      "default": 100,
      "info": "Adjust the bottom spacing for mobile"
    },
    {
      "type": "range",
      "id": "section_padding_left_mobile",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Mobile left spacing",
      "default": 0,
      "info": "Adjust the left spacing for mobile"
    },
    {
      "type": "range",
      "id": "section_padding_right_mobile",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Mobile right spacing",
      "default": 0,
      "info": "Adjust the right spacing for mobile"
    },
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "checkbox",
      "id": "inherit_fonts",
      "default": false,
      "label": "Use theme font sizes?",
      "info": "Enable this to inherit font sizes from your theme"
    },
    {
      "type": "checkbox",
      "id": "is_fullwidth",
      "default": false,
      "label": "Make section full width",
      "info": "Stretch this section to the full screen width"
    },
    {
      "type": "checkbox",
      "id": "is_first_opened",
      "default": true,
      "label": "Expand first FAQ by default",
      "info": "Open the first FAQ item automatically when the page loads"
    },
    {
      "type": "select",
      "id": "faq_position",
      "label": "FAQ alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "info": "Control the overall alignment of the FAQ items"
    },
    {
      "type": "select",
      "id": "heading_text_position",
      "label": "Heading text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "info": "Align the main heading text"
    },
    {
      "type": "color",
      "id": "heading_text_color",
      "label": "Heading text color",
      "default": "#292929",
      "info": "Customize the color of the main heading"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "FAQ title color",
      "default": "#212121",
      "info": "Customize the color of the accordion (FAQ) titles"
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "FAQ content color",
      "default": "#5D5D5D",
      "info": "Customize the text color of the FAQ content"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow color",
      "default": "#000000",
      "info": "Customize the color of the collapsible arrow icon"
    },
    {
      "type": "range",
      "id": "arrow_icon_size",
      "min": 10,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Arrow icon size",
      "default": 15,
      "info": "Customize the size of the arrow SVG icon"
    },
    {
      "type": "color",
      "id": "arrow_bg_color",
      "label": "Arrow background color",
      "default": "#F3F3F3",
      "info": "Customize the background color of the arrow button."
    },
    {
      "type": "range",
      "id": "arrow_padding",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Arrow background size",
      "default": 11,
      "info": "Adjust the padding inside the arrow background."
    },
    {
      "type": "range",
      "id": "arrow_border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Button arrow background border radius",
      "default": 50,
      "info": "Control the border radius of the arrow background."
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Accordion border color",
      "default": "#DEDEDE",
      "info": "Set the border color separating each FAQ item"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Main heading font size",
      "default": 31,
      "info": "Adjust the font size of the main heading"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "FAQ title font size",
      "default": 21,
      "info": "Adjust the font size of each FAQ title"
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "FAQ title font weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400",
      "info": "Choose how thick or thin the FAQ titles appear"
    },
    {
      "type": "range",
      "id": "title_padding_left_mobile",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "FAQ Title Left Padding (Mobile)",
      "default": 15,
      "info": "Adjust left padding for FAQ title on mobile"
    },
    {
      "type": "range",
      "id": "title_padding_right_mobile",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "FAQ Title Right Padding (Mobile)",
      "default": 15,
      "info": "Adjust right padding for FAQ title on mobile"
    },
    {
      "type": "range",
      "id": "content_font_size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "FAQ content font size",
      "default": 16,
      "info": "Adjust the font size of the FAQ content text"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "transparent",
      "info": "Choose a background color for this section"
    },
    {
      "type": "number",
      "id": "container_max_width",
      "label": "Content width limit (px)",
      "default": 1320,
      "info": "Limit the maximum width of the content container"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class",
      "info": "Adds a custom CSS class to the outermost section wrapper"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS",
      "info": "Add additional custom CSS here if desired"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2",
      "info": "Select the HTML heading tag for the main title"
    }
  ],
  "blocks": [
    {
      "name": "Heading",
      "type": "heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading_text",
          "label": "Heading text",
          "default": "Heading text",
          "info": "Enter your main heading"
        }
      ]
    },
    {
      "name": "Accordion",
      "type": "accordion",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "acc_heading",
          "label": "Title",
          "default": "Title",
          "info": "Enter the FAQ item title"
        },
        {
          "type": "richtext",
          "id": "acc_text",
          "label": "Content",
          "default": "<p>Content goes here...</p>",
          "info": "Enter the main body content for this FAQ item"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ-1",
        "category": "FAQ",
      "settings": {
        "container_max_width": 850,
        "background_color": "transparent"
      },
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "heading_text": "Frequently Asked Questions"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "acc_heading": "Question Goes Here ",
            "acc_text": "<p>Typography in web design is used to create a hierarchy of information on a page, with the most important information displayed in larger, more prominent typefaces. This helps users quickly grasp the structure and content.</p>"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "acc_heading": "Question Goes Here ",
            "acc_text": "<p>Good web typography should be easy to read, with clear, legible typefaces and appropriate line spacing and font sizes.</p>"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "acc_heading": "Question Goes Here ",
            "acc_text": "<p>Typography is crucial for branding, helping convey a company's personality. Thoughtfully chosen typefaces create a cohesive visual identity across a website and its marketing materials.</p>"
