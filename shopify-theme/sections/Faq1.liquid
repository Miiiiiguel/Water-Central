{% endschema %}

{% assign sec_id = section.id | slice: -6, 6 | replace: '-', '_' %}
{% assign sec_id = sec_id | prepend: 'loudecomz' %}

{%- style -%}
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  .loudecomz-container,
  .loudecomz-container-fluid {
    width: 100%;
    padding-right: var(--loudecomz-gutter-x, 15px);
    padding-left: var(--loudecomz-gutter-x, 15px);
    margin-right: auto;
    margin-left: auto;
  }

  @media (min-width: 576px) {
    .loudecomz-container {
      max-width: 540px;
    }
  }
  @media (min-width: 750px) {
    .loudecomz-container {
      max-width: 720px;
    }
  }
  @media (min-width: 992px) {
    .loudecomz-container {
      max-width: 960px;
    }
    {% if section.settings.container_max_width >= 720 and section.settings.container_max_width <= 960 %}
      .loudecomz-section__{{sec_id}} .loudecomz-container {
        max-width: {{section.settings.container_max_width}}px;
      }
    {% endif %}
  }
  @media (min-width: 1200px) {
    .loudecomz-container {
      max-width: 1140px;
    }
    {% if section.settings.container_max_width >= 720 and section.settings.container_max_width <= 1140 %}
      .loudecomz-section__{{sec_id}} .loudecomz-container {
        max-width: {{section.settings.container_max_width}}px;
      }
    {% endif %}
  }
  @media (min-width: 1400px) {
    .loudecomz-container {
      max-width: 1320px;
    }
    {% if section.settings.container_max_width >= 720 and section.settings.container_max_width != 1320 %}
      .loudecomz-section__{{sec_id}} .loudecomz-container {
        max-width: {{section.settings.container_max_width}}px;
      }
    {% endif %}
  }

  .loudecomz-section__{{sec_id}} {
    --loudecomz-gutter-x: 25px;
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
    padding-left: {{ section.settings.section_padding_left }}px;
    padding-right: {{ section.settings.section_padding_right }}px;
    line-height: 1.5;
  }

  /* Mobile overrides */
  @media only screen and (max-width: 749px) {
    .loudecomz-section__{{sec_id}} {
      padding-top: {{ section.settings.section_padding_top_mobile }}px !important;
      padding-bottom: {{ section.settings.section_padding_bottom_mobile }}px !important;
      padding-left: {{ section.settings.section_padding_left_mobile }}px !important;
      padding-right: {{ section.settings.section_padding_right_mobile }}px !important;
    }
    .loudecomz-section__{{sec_id}} .loudecomz-accordion-btn {
      padding-left: {{ section.settings.title_padding_left_mobile }}px;
      /* Removed the complex padding-right calculation */
    }
  }

  /* Heading & Subheading styling */
  .loudecomz-section__{{sec_id}} .loudecomz-section-title {
    color: {{ section.settings.heading_text_color }} !important;
    text-align: {{ section.settings.heading_text_position }};
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 30px;
  }
  .loudecomz-section__{{sec_id}} .loudecomz-section-subtitle {
    color: {{ section.settings.heading_text_color }} !important;
    text-align: {{ section.settings.heading_text_position }};
    margin: 0 auto 40px;
    max-width: 800px;
  }

  /* FAQ alignment */
  .loudecomz-section__{{sec_id}} .loudecomz-accordion {
    text-align: {{ section.settings.faq_position }};
  }

  /* Accordion items */
  .loudecomz-section__{{sec_id}} .loudecomz-accordion-item {
    margin-bottom: 0; /* Just to keep items stacked nicely */
  }
  .loudecomz-section__{{sec_id}} .loudecomz-accordion-header {
    cursor: pointer;
    padding: 20px 0;
    width: 100%;
    transition: 0.3s;
    position: relative; /* for arrow positioning */
  }
  .loudecomz-section__{{sec_id}} .loudecomz-accordion-btn {
    margin: 0;
    padding: 0 15px 0 0; /* Added padding-right: 15px for spacing */
    display: inline-block; /* so text flows normally, arrow is absolute */
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: {{ section.settings.title_font_weight }};
    color: {{ section.settings.title_color }} !important;
    max-width: calc(100% - ({{ section.settings.arrow_icon_size }}px + {{ section.settings.arrow_padding | times: 2 }}px)); /* Added to prevent overlap */
  }

  /* Arrow Icon - pinned to the far right */
  .loudecomz-section__{{sec_id}} .accordion-arrow {
    position: absolute;
    right: 0;
    top: 50%;
    background-color: {{ section.settings.arrow_bg_color }};
    border-radius: {{ section.settings.arrow_border_radius }}px;
    padding: {{ section.settings.arrow_padding }}px;
    transform: translateY(-50%);
    display: inline-flex;
  }
  .loudecomz-section__{{sec_id}} .accordion-arrow svg {
    transition: transform 0.4s ease;
    transform-origin: center;
    width: {{ section.settings.arrow_icon_size }}px;
    height: {{ section.settings.arrow_icon_size }}px;
  }
  .loudecomz-section__{{sec_id}} .loudecomz-accordion-item.active .accordion-arrow svg {
    transform: rotate(90deg);
  }

  /* Accordion content area */
  .loudecomz-section__{{sec_id}} .loudecomz-accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease; /* smoother animation */
    border-bottom: 2px solid {{ section.settings.border_color }};
  }
  .loudecomz-section__{{sec_id}} .loudecomz-accordion-content-inner {
    padding-bottom: 20px;
  }

  /* FAQ content text */
  .loudecomz-section__{{sec_id}} .loudecomz-accordion-content p,
  .loudecomz-section__{{sec_id}} .loudecomz-accordion-content li,
  .loudecomz-section__{{sec_id}} .loudecomz-accordion-content a {
    font-size: {{ section.settings.content_font_size }}px;
    color: {{ section.settings.content_color }};
    margin-top: 0;
    margin-bottom: 12px;
  }
  .loudecomz-section__{{sec_id}} .loudecomz-accordion-content ul,
  .loudecomz-section__{{sec_id}} .loudecomz-accordion-content ol {
    margin-top: 12px;
    margin-bottom: 12px;
    padding-left: 20px;
  }

  /* If user wants to rely on the theme's inherent font sizes instead: */
  {% if section.settings.inherit_fonts == true %}
    /* Rely on theme-provided font sizes, if enabled. */
  {% endif %}
{%- endstyle -%}

{% if section.settings.custom_css != blank %}
  {%- style -%}
    {{ section.settings.custom_css }}
  {%- endstyle -%}
{% endif %}

{% if section.settings.is_fullwidth == true %}
  {% assign container = 'loudecomz-container-fluid' %}
{% else %}
  {% assign container = 'loudecomz-container' %}
{% endif %}

<div class="loudecomz-section__{{sec_id}} {{ section.settings.custom_class }}">
  <div class="{{container}}">
    <div class="loudecomz-row">
      <div class="loudecomz-col-lg-12">
        <div class="loudecomz-title-wrapper">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'heading' %}
                {% if block.settings.heading_text != blank %}
                  <{{ section.settings.heading_tag }}
                    class="loudecomz-section-title"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.heading_text | escape }}
                  </{{ section.settings.heading_tag }}>
                {% endif %}
              {% when 'subheading' %}
                {% if block.settings.subheading_text != blank %}
                  <p class="loudecomz-section-subtitle" {{ block.shopify_attributes }}>
                    {{ block.settings.subheading_text }}
                  </p>
                {% endif %}
            {% endcase %}
          {% endfor %}
        </div>
      </div>
      <div class="loudecomz-col-lg-12">
        <div class="loudecomz-accordion">
          {% assign count = 0 %}
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'accordion' %}
                {% assign count = count | plus: 1 %}
                <div
                  class="loudecomz-accordion-item {% if section.settings.is_first_opened and count == 1 %}active{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <div class="loudecomz-accordion-header">
                    {% if block.settings.acc_heading != blank %}
                      <h3 class="loudecomz-accordion-btn">
                        {{ block.settings.acc_heading }}
                      </h3>
                      <!-- Arrow SVG -->
                      <span class="accordion-arrow">
                        <svg
                          fill="{{ section.settings.arrow_color }}"
                          height="20px"
                          width="20px"
                          version="1.1"
                          id="Layer_1"
                          xmlns="http://www.w3.org/2000/svg"
                          xmlns:xlink="http://www.w3.org/1999/xlink"
                          viewBox="0 0 330 330"
                          xml:space="preserve"
                        >
                          <path d="M250.606,154.389l-150-149.996c-5.857-5.858-15.355-5.858-21.213,0.001
                           c-5.857,5.858-5.857,15.355,0.001,21.213l139.393,139.39L79.393,304.394c-5.857,5.858-5.857,15.355,0.001,21.213
                           C82.322,328.536,86.161,330,90,330s7.678-1.464,10.607-4.394l149.999-150.004c2.814-2.813,4.394-6.628,4.394-10.606
                           C255,161.018,253.42,157.202,250.606,154.389z"/>
                        </svg>
                      </span>
                    {% endif %}
                  </div>
                  <div
                    class="loudecomz-accordion-content"
                    {% if section.settings.is_first_opened and count == 1 %}
                      style="max-height: none;"
                    {% endif %}
                  >
                    {% if block.settings.acc_text != blank %}
                      <div class="loudecomz-accordion-content-inner">
                        {{ block.settings.acc_text }}
                      </div>
                    {% endif %}
                  </div>
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Smoother open/close logic
  window.addEventListener('DOMContentLoaded', function() {
    let faqItems = document.querySelectorAll('.loudecomz-section__{{sec_id}} .loudecomz-accordion-item');

    // Expand first item if applicable
    if (faqItems.length && faqItems[0].classList.contains('active')) {
      let firstPanel = faqItems[0].querySelector('.loudecomz-accordion-content');
      if (firstPanel) {
        firstPanel.style.maxHeight = firstPanel.scrollHeight + "px";
      }
    }

    // Toggle each item on click
    faqItems.forEach(function(item) {
      item.addEventListener('click', function() {
        // If it is already open, close it
        if (item.classList.contains('active')) {
          item.classList.remove('active');
          let content = item.querySelector('.loudecomz-accordion-content');
          if (content) content.style.maxHeight = null;
        } else {
          // Close others (if you want an accordion-like one-at-a-time behavior)
          // If you prefer multiple open, just remove the loop below.
          faqItems.forEach(function(otherItem) {
            otherItem.classList.remove('active');
            let otherContent = otherItem.querySelector('.loudecomz-accordion-content');
            if (otherContent) otherContent.style.maxHeight = null;
          });

          // Now open this one
          item.classList.add('active');
          let content = item.querySelector('.loudecomz-accordion-content');
          if (content) content.style.maxHeight = content.scrollHeight + "px";
        }
      });
    });
  });
</script>

