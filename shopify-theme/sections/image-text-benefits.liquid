<!-- /hd-section -->

<!-- Scoped JavaScript -->
<script>
  (function() {
    const sectionId = 'hd-{{ section.id }}';
    const section = document.getElementById(sectionId);
    if (!section) return;

    // Toggle video play on click
    const videos = section.querySelectorAll('video');
    videos.forEach(video => {
      video.addEventListener('click', () => {
        if (video.paused) {
          video.play();
        } else {
          video.pause();
        }
      });
    });
  })();
</script>

