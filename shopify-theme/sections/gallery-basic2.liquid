      "type": "header",
      "content": "Image Settings",
      "info": "Configure the images' appearance and behavior."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "transparent",
      "info": "Set the background color of the gallery section."
    },
    {
      "type": "select",
      "id": "img_proportion",
      "label": "Image Ratio",
      "options": [
        {
          "value": "100%",
          "label": "1x1"
        },
        {
          "value": "150%",
          "label": "2x3"
        },
        {
          "value": "133.333%",
          "label": "3x4"
        },
        {
          "value": "75%",
          "label": "4x3"
        },
        {
          "value": "56.25%",
          "label": "16x9"
        },
        {
          "value": "42.857%",
          "label": "21x9"
        },
        {
          "value": "125%",
          "label": "4x5"
        },
        {
          "value": "80%",
          "label": "5x4"
        }
      ],
      "default": "125%",
      "info": "Choose the aspect ratio for images on desktop."
    },
    {
      "type": "select",
      "id": "img_proportion_mobile",
      "label": "Image Ratio (Mobile)",
      "options": [
        {
          "value": "100%",
          "label": "1x1"
        },
        {
          "value": "150%",
          "label": "2x3"
        },
        {
          "value": "133.333%",
          "label": "3x4"
        },
        {
          "value": "75%",
          "label": "4x3"
        },
        {
          "value": "56.25%",
          "label": "16x9"
        },
        {
          "value": "42.857%",
          "label": "21x9"
        },
        {
          "value": "125%",
          "label": "4x5"
        },
        {
          "value": "80%",
          "label": "5x4"
        }
      ],
      "default": "80%",
      "info": "Choose the aspect ratio for images on mobile devices."
    },
    {
      "type": "select",
      "id": "image_shadow",
      "label": "Image Shadow",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "low",
          "label": "Low Shadow"
        },
        {
          "value": "medium",
          "label": "Medium Shadow"
        },
        {
          "value": "high",
          "label": "High Shadow"
        }
      ],
      "default": "none",
      "info": "Add shadow effects to images for depth."
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Image Border Radius",
      "default": 4,
      "info": "Set the border radius for images to create rounded corners."
    },
    {
      "type": "checkbox",
      "id": "make_images_circle",
      "default": false,
      "label": "Make Images Circle",
      "info": "Enable to display images as circles. Make sure the image ratio is 1:1 / square."
    },
    {
      "type": "select",
      "id": "image_hover_animation",
      "label": "Image Hover Animation",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "zoom_in_subtle",
