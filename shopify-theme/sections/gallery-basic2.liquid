      "info": "Set the top padding for the gallery section on desktop."
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Section Padding Bottom (Desktop)",
      "default": 50,
      "info": "Set the bottom padding for the gallery section on desktop."
    },
    {
      "type": "header",
      "content": "Mobile Padding",
      "info": "Control the padding around the gallery section on mobile devices."
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Section Padding Top (Mobile)",
      "default": 50,
      "info": "Set the top padding for the gallery section on mobile."
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Section Padding Bottom (Mobile)",
      "default": 50,
      "info": "Set the bottom padding for the gallery section on mobile."
    },
    {
      "type": "header",
      "content": "Customization",
      "info": "Advanced customization options for the gallery."
    },
    {
      "type": "number",
