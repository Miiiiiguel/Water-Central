<section class="hero-section-about-us">
  {% if section.settings.background_image != blank %}
    {% assign background_image_url = section.settings.background_image | img_url: 'master' %}
  {% else %}
    {% assign background_image_url = 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E' %}
  {% endif %}
  <div
    class="hero-section-about-us__background-image {{ section.settings.background_image_animation }}"
    style="
      filter: brightness({{ section.settings.bg_image_brightness | default: 100 }}%)
              contrast({{ section.settings.bg_image_contrast | default: 100 }}%)
              blur({{ section.settings.background_blur | default: 0 }}px);
      background-image: url({{ background_image_url }});
    "
  ></div>
  <div class="hero-section-about-us__text-overlay">
    <div class="hero-section-about-us__subtitle">{{ section.settings.subtitle_text }}</div>
    <div class="hero-section-about-us__main-heading {{ section.settings.main_heading_text_animation }}">
      {{ section.settings.main_heading_text }}
    </div>
  </div>
  {% if section.settings.enable_fade_in_bottom_effect %}
    <div class="hero-section-about-us__fade-in-bottom"></div>
  {% endif %}
</section>

{% if section.settings.enable_custom_fonts
  and section.settings.main_heading_font
  or section.settings.enable_custom_fonts_subtitle
  and section.settings.subtitle_font
%}
  <style>
    {% if section.settings.enable_custom_fonts and section.settings.main_heading_font %}
      @import url('https://fonts.googleapis.com/css2?family={{ section.settings.main_heading_font | replace: ' ', '+' }}&display=swap');
    {% endif %}
    {% if section.settings.enable_custom_fonts_subtitle and section.settings.subtitle_font %}
      @import url('https://fonts.googleapis.com/css2?family={{ section.settings.subtitle_font | replace: ' ', '+' }}&display=swap');
    {% endif %}
  </style>
{% endif %}

<style>
  /* Scoped CSS for Hero Section - About Us */
  .hero-section-about-us {
    width: 100%;
    height: {{ section.settings.section_height | default: 500 }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    text-align: center;
    overflow: hidden;
    padding-top: {{ section.settings.padding_top_desktop | default: 50 }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop | default: 50 }}px;
  }

  .hero-section-about-us__background-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    transition: all 0.5s ease;
    z-index: -1;
  }

  /* Background Image Animations */
  .hero-section-about-us .hero-section-about-us__background-image.fade_in_hover:hover {
    opacity: 0.8;
  }
  .hero-section-about-us .hero-section-about-us__background-image.scale_in_hover:hover {
    transform: scale(1.1);
  }
  .hero-section-about-us .hero-section-about-us__background-image.zoom_out_hover:hover {
    transform: scale(0.9);
  }
  .hero-section-about-us .hero-section-about-us__background-image.blur_hover:hover {
    filter: brightness({{ section.settings.bg_image_brightness | default: 100 }}%)
            contrast({{ section.settings.bg_image_contrast | default: 100 }}%)
            blur(5px);
  }
  .hero-section-about-us .hero-section-about-us__background-image.rotate_hover:hover {
    transform: rotate(5deg);
  }

  .hero-section-about-us__text-overlay {
    color: {{ section.settings.text_color | default: '#FFFFFF' }} !important;
    padding: 0 20px;
    z-index: 1;
  }

