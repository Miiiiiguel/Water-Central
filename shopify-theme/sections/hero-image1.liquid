<!-- Scoped JavaScript -->
<script>
  (function() {
    // Unique namespace for the Hero Section - About Us
    const heroAboutUs = {
      init: function() {
        const heroSection = document.querySelector('.hero-section-about-us');
        if (!heroSection) return;
        // Set opacity to 1 immediately (no animation settings are used)
        heroSection.style.opacity = '1';
      }
    };
    document.addEventListener('DOMContentLoaded', function() {
      heroAboutUs.init();
    });
  })();
</script>
