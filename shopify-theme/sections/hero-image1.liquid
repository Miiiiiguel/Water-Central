  }

  @keyframes blinkSmooth-hero-about-us {
    0%, 50%, 100% { opacity: 1; }
    25%, 75% { opacity: 0.5; }
  }

  @keyframes typing-hero-about-us {
    from { width: 0; }
    to { width: 100%; }
  }

  @keyframes blink-caret-hero-about-us {
    from, to { border-color: transparent; }
    50% { border-color: orange; }
  }

  @keyframes fadeIn-hero-about-us {
    to { opacity: 1; }
  }

  @keyframes slideInLeft-hero-about-us {
    from { opacity: 0; transform: translateX(-100%); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes slideInRight-hero-about-us {
    from { opacity: 0; transform: translateX(100%); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes zoomIn-hero-about-us {
    from { opacity: 0; transform: scale(0.5); }
    to { opacity: 1; transform: scale(1); }
  }

