{%- style -%}
  /* Box Sizing and Image Defaults */
  .loudecomz-section__{{ sec_id }} *,
  .loudecomz-section__{{ sec_id }} *:after,
  .loudecomz-section__{{ sec_id }} *:before {
    box-sizing: border-box;
  }

  .loudecomz-section__{{ sec_id }} img {
    max-width: 100%;
    height: auto;
    border-radius: {{ section.settings.image_border_radius }}px;
  }

  /* Container Styles */
  .loudecomz-container,
  .loudecomz-container-fluid {
    width: 100%;
    padding-right: var(--loudecomz-gutter-x, 15px);
    padding-left: var(--loudecomz-gutter-x, 15px);
    margin-right: auto;
    margin-left: auto;
  }

  /* Responsive Container Widths */
  @media (min-width: 576px) {
    .loudecomz-container {
      max-width: 540px;
    }
  }

  @media (min-width: 750px) {
    .loudecomz-container {
      max-width: 720px;
    }
  }

  @media (min-width: 992px) {
    .loudecomz-container {
      max-width: 960px;
    }
    {% if section.settings.container_max_width >= 720 and section.settings.container_max_width <= 960 %}
      .loudecomz-section__{{ sec_id }} .loudecomz-container {
        max-width: {{ section.settings.container_max_width }}px;
      }
    {% endif %}
  }

  @media (min-width: 1200px) {
    .loudecomz-container {
      max-width: 1140px;
    }
    {% if section.settings.container_max_width >= 720 and section.settings.container_max_width <= 1140 %}
      .loudecomz-section__{{ sec_id }} .loudecomz-container {
        max-width: {{ section.settings.container_max_width }}px;
      }
    {% endif %}
  }

  @media (min-width: 1400px) {
    .loudecomz-container {
      max-width: 1320px;
    }
    {% if section.settings.container_max_width >= 720 and section.settings.container_max_width != 1320 %}
      .loudecomz-section__{{ sec_id }} .loudecomz-container {
        max-width: {{ section.settings.container_max_width }}px;
      }
    {% endif %}
  }

  /* Gutter X Adjustment for Desktop and Mobile */
  .loudecomz-section__{{ sec_id }} .loudecomz-container,
  .loudecomz-section__{{ sec_id }} .loudecomz-container-fluid {
    --loudecomz-gutter-x: {{ section.settings.padding_lr_desktop }}px;
  }

  @media only screen and (max-width: 749px) {
    .loudecomz-section__{{ sec_id }} .loudecomz-container,
    .loudecomz-section__{{ sec_id }} .loudecomz-container-fluid {
      --loudecomz-gutter-x: {{ section.settings.padding_lr_mobile }}px;
    }
  }

  /* Section Styles */
  .loudecomz-section__{{ sec_id }} {
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
    position: relative;
    line-height: 1.5;
    {% if section.settings.display_on == 'mobile' %}
      display: none;
    {% elsif section.settings.display_on == 'desktop' %}
      display: none;
    {% elsif section.settings.display_on == 'none' %}
      display: none;
    {% endif %}
  }

  @media only screen and (max-width: 749px) {
    .loudecomz-section__{{ sec_id }} {
      padding-top: {{ section.settings.section_padding_top_mobile }}px;
      padding-bottom: {{ section.settings.section_padding_bottom_mobile }}px;
    }
  }

  {% if section.settings.is_fullwidth == true %}
    .loudecomz-section__{{ sec_id }} .loudecomz-container-fluid {
      padding-left: 0;
      padding-right: 0;
    }
  {% endif %}

  /* Image/Video Wrapper Styles with Adjustable Margins */
  .loudecomz-section__{{ sec_id }} .loudecomz-img-wrapper {
    position: relative;
    min-height: {{ section.settings.img_min_height }}vh;
    margin-top: {{ section.settings.image_margin_top }}px;
    margin-bottom: {{ section.settings.image_margin_bottom }}px;
  }

  /* Media (Image) Positioning */
  .loudecomz-section__{{ sec_id }} .loudecomz-img-wrapper img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.background_position_x }}% {{ section.settings.background_position_y }}%;
    border-radius: {{ section.settings.image_border_radius }}px;
  }

  /* Video Styles */
  .loudecomz-section__{{ sec_id }} .loudecomz-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.background_position_x }}% {{ section.settings.background_position_y }}%;
  }

  /* Image Text Overlay */
  .loudecomz-section__{{ sec_id }} .loudecomz-img-text {
    position: absolute;
    max-width: 90%;
    bottom: 50px;
    z-index: 1;
    text-align: center;
    color: {{ section.settings.image_description_text_color }};
    border-radius: {{ section.settings.image_text_border_radius }}px;
    padding: 10px 15px;
    font-size: {{ section.settings.image_description_fz }}px;
    {% if section.settings.enable_image_text_background %}
      /* Background handled by pseudo-element */
    {% else %}
      background: none;
    {% endif %}
    /* CSS Variables for Positioning */
    left: var(--image-text-horizontal-position, {{ section.settings.image_text_horizontal_position_desktop }}%);
    right: var(--image-text-horizontal-position-right, auto);
    transform: translateX(var(--image-text-translateX, 0));
  }

  /* Pseudo-element for Background with Opacity */
  .loudecomz-section__{{ sec_id }} .loudecomz-img-text::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: {{ section.settings.image_text_background_color }};
    opacity: {{ section.settings.image_text_background_opacity | divided_by: 100.0 }};
    border-radius: {{ section.settings.image_text_border_radius }}px;
    z-index: -1;
    display: {% if section.settings.enable_image_text_background %} block {% else %} none {% endif %};
  }

  /* Position Selector Classes */
  .loudecomz-section__{{ sec_id }} .loudecomz-img-text.position-bottom-left {
    --image-text-horizontal-position: {{ section.settings.image_text_horizontal_position_desktop }}%;
    --image-text-horizontal-position-right: auto;
    --image-text-translateX: 0;
  }

  .loudecomz-section__{{ sec_id }} .loudecomz-img-text.position-bottom-center {
    left: 50%;
    right: auto;
    --image-text-translateX: -50%;
  }

  .loudecomz-section__{{ sec_id }} .loudecomz-img-text.position-bottom-right {
    --image-text-horizontal-position: auto;
    --image-text-horizontal-position-right: {{ section.settings.image_text_horizontal_position_desktop }}%;
    --image-text-translateX: 0;
  }

  /* Responsive Styles for Mobile */
  @media only screen and (max-width: 749px) {
    .loudecomz-section__{{ sec_id }} .loudecomz-img-wrapper {
      min-height: {{ section.settings.img_min_height_mobile }}vh;
      margin-top: {{ section.settings.image_margin_top }}px;
      margin-bottom: {{ section.settings.image_margin_bottom }}px;
    }
    .loudecomz-section__{{ sec_id }} .loudecomz-img-wrapper img,
    .loudecomz-section__{{ sec_id }} .loudecomz-video {
      object-position: {{ section.settings.background_position_x_mobile }}% {{ section.settings.background_position_y_mobile }}%;
    }
    .loudecomz-section__{{ sec_id }} .loudecomz-img-text {
      font-size: {{ section.settings.image_description_fz_mobile }}px;
      bottom: 30px;
      /* Override horizontal position for mobile */
      left: var(--image-text-horizontal-position-mobile, {{ section.settings.image_text_horizontal_position_mobile }}%);
      right: auto;
      transform: translateX(-50%);
    }
    /* Adjust horizontal positioning based on mobile settings */
    .loudecomz-section__{{ sec_id }} .loudecomz-img-text.position-bottom-left,
    .loudecomz-section__{{ sec_id }} .loudecomz-img-text.position-bottom-right {
      left: var(--image-text-horizontal-position-mobile, {{ section.settings.image_text_horizontal_position_mobile }}%);
      right: auto;
      --image-text-translateX: -50%;
    }
    .loudecomz-section__{{ sec_id }} .loudecomz-img-text.position-bottom-right {
      left: auto;
      right: var(--image-text-horizontal-position-mobile, {{ section.settings.image_text_horizontal_position_mobile }}%);
      --image-text-translateX: 0;
    }
  }

  /* Display Section On Classes */
  {% if section.settings.display_on == 'mobile' %}
    /* Mobile Only */
    .loudecomz-section__{{ sec_id }} {
      display: none;
    }
    @media only screen and (max-width: 749px) {
      .loudecomz-section__{{ sec_id }} {
        display: block;
      }
    }
  {% elsif section.settings.display_on == 'desktop' %}
    /* Desktop Only */
    .loudecomz-section__{{ sec_id }} {
      display: none;
    }
    @media only screen and (min-width: 750px) {
      .loudecomz-section__{{ sec_id }} {
        display: block;
      }
    }
  {% elsif section.settings.display_on == 'none' %}
    /* No Devices */
    .loudecomz-section__{{ sec_id }} {
      display: none;
    }
  {% endif %}
{%- endstyle -%}

{% if section.settings.custom_css != blank %}
  {%- style -%}
    .loudecomz-section__{{ sec_id }} {
      {{ section.settings.custom_css }}
    }
  {%- endstyle -%}
{% endif %}

{% if section.settings.is_fullwidth == true %}
  {% assign container = 'loudecomz-container-fluid' %}
{% else %}
  {% assign container = 'loudecomz-container' %}
{% endif %}

{% if section.settings.lazyload == true %}
  {% assign loading = 'lazy' %}
{% else %}
  {% assign loading = 'eager' %}
{% endif %}

<div class="loudecomz-section__{{ sec_id }} {{ section.settings.custom_class }}">
  <div class="{{ container }}">
    <div class="loudecomz-img-wrapper">
      {% if section.settings.use_video %}
        {% if section.settings.video_url != blank %}
          <video autoplay muted loop playsinline class="loudecomz-video">
            <source src="{{ section.settings.video_url }}" type="video/mp4">
          </video>
        {% endif %}
      {% else %}
        {% if section.settings.background_image == blank %}
          <img
            src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E"
            loading="{{ loading }}"
            sizes="100vw"
          >
        {% else %}
          {{
            section.settings.background_image
            | image_url: width: 1920
            | image_tag: widths: '490, 750, 992, 1200, 1920', sizes: '100vw', loading: loading
          }}
        {% endif %}
      {% endif %}
      {% if section.settings.image_description != blank %}
        <div class="loudecomz-img-text position-{{ section.settings.image_description_position | downcase | replace: ' ', '-' }}">
          {{ section.settings.image_description }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
