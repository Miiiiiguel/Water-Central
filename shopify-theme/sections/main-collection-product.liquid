<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Fix for the search drawer to prevent auto-closing on filter changes
    var drawer = document.querySelector('.collection-filter.drawer');
    if (drawer) {
      // Prevent the drawer from auto-closing on change or input events
      drawer.addEventListener('change', function(e) {
        e.stopImmediatePropagation();
      });
      drawer.addEventListener('input', function(e) {
        e.stopImmediatePropagation();
      });
      // Ensure page scrolling is enabled even when the drawer is open
      document.body.style.overflow = 'auto';
    }
  });
</script>
