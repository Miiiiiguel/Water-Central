<!-- Include Font Awesome -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet">

<div class="brand-deal-of-the-month-section">
  <style>
    {% if section.settings.enable_custom_fonts %}
    @import url('https://fonts.googleapis.com/css2?family=Roboto&family=Open+Sans&family=Lato&family=Montserrat&family=Oswald&family=Source+Sans+Pro&family=Raleway&family=Poppins&family=Merriweather&family=Ubuntu&family=Playfair+Display&family=Noto+Sans&family=Nunito&family=PT+Sans&family=Merriweather+Sans&display=swap');
    {% endif %}

    .brand-deal-of-the-month-section .brand-deal-container {
      display: flex;
      flex-wrap: wrap;
      width: 100%;
      margin: 0;
      padding-top: {{ section.settings.section_padding_top_desktop | default: 20 }}px;
      padding-bottom: {{ section.settings.section_padding_bottom_desktop | default: 20 }}px;
      background-color: {{ section.settings.section_background_color | default: '#ffffff' }};
      font-family: Arial, sans-serif;
    }
    .brand-deal-of-the-month-section .brand-deal-image.desktop-image {
      flex: 2;
      min-width: auto;
      height: 290px;
      position: relative;
    }
    .brand-deal-of-the-month-section .brand-deal-image.desktop-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: {{ section.settings.image_position_x_desktop | default: 50 }}% {{ section.settings.image_position_y_desktop | default: 50 }}%;
    }
    .brand-deal-of-the-month-section .brand-deal-image.mobile-image {
      display: none;
      flex: 2;
      min-width: 300px;
      height: auto;
      object-fit: cover;
      position: relative;
    }
    .brand-deal-of-the-month-section .brand-deal-image.mobile-image img {
      width: 100%;
      height: auto;
      object-fit: cover;
      object-position: {{ section.settings.image_position_x_mobile | default: 50 }}% {{ section.settings.image_position_y_mobile | default: 50 }}%;
    }
    .brand-deal-of-the-month-section .brand-deal-text {
      flex: 1;
      {% if section.settings.enable_gradient_background %}
      background: linear-gradient({{ section.settings.gradient_degrees | default: 90 }}deg, {{ section.settings.gradient_start_color }}, {{ section.settings.gradient_middle_color }}, {{ section.settings.gradient_end_color }});
      {% else %}
      background-color: {{ section.settings.brand_deal_text_background_color | default: '#2c3e50' }};
      {% endif %}
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 23px;
      text-align: center;
      height: 290px;
    }
    .brand-deal-of-the-month-section .brand-deal-text p.hashtag {
      font-size: 1.2em;
      margin: 10px 0;
      color: {{ section.settings.hashtag_color | default: '#ffffff' }};
      {% if section.settings.enable_custom_fonts %}
      font-family: '{{ section.settings.hashtag_font }}', sans-serif;
      {% endif %}
    }
    .brand-deal-of-the-month-section .brand-deal-text h1 {
      font-size: 2em;
      margin: 10px 0;
      color: {{ section.settings.title_color | default: '#ffffff' }} !important; /* Title color forced !important */
      {% if section.settings.enable_custom_fonts %}
      font-family: '{{ section.settings.title_font }}', sans-serif;
      {% endif %}
      font-weight: {{ section.settings.title_font_weight | default: '400' }}; /* New font-weight setting */
    }
    .brand-deal-of-the-month-section .brand-deal-text p.discount {
      font-size: 1.2em;
      margin: 10px 0;
      color: {{ section.settings.discount_color | default: '#ffffff' }};
      {% if section.settings.enable_custom_fonts %}
      font-family: '{{ section.settings.discount_font }}', sans-serif;
      {% endif %}
    }

    /* Responsive Adjustments */
    @media (max-width: 768px) {
      .brand-deal-of-the-month-section .brand-deal-container {
        flex-direction: column;
        padding-top: {{ section.settings.section_padding_top_mobile | default: 20 }}px;
        padding-bottom: {{ section.settings.section_padding_bottom_mobile | default: 20 }}px;
      }
      .brand-deal-of-the-month-section .brand-deal-text {
        height: 350px; /* Increased height for mobile */
        {% if section.settings.enable_gradient_background %}
        background: linear-gradient({{ section.settings.gradient_degrees_mobile | default: 90 }}deg, {{ section.settings.gradient_start_color_mobile }}, {{ section.settings.gradient_middle_color_mobile }}, {{ section.settings.gradient_end_color_mobile }});
        {% else %}
        background-color: {{ section.settings.brand_deal_text_background_color | default: '#2c3e50' }};
        {% endif %}
      }
      .brand-deal-of-the-month-section .brand-deal-image.desktop-image {
        display: none;
      }
      .brand-deal-of-the-month-section .brand-deal-image.mobile-image {
        display: block;
        height: auto;
        object-fit: cover;
      }
    }
  </style>

  <div class="brand-deal-container">
    <!-- Desktop Image Section -->
    <div class="brand-deal-image desktop-image">
      <img
        src="{{ section.settings.image | img_url: '1600x' | default: 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E' }}"
        alt="{{ section.settings.image_alt | default: 'Default placeholder description for desktop image.' }}"
      >
    </div>

    <!-- Mobile Image Section -->
    <div class="brand-deal-image mobile-image">
      <img
        src="{{ section.settings.mobile_image | img_url: '1600x' | default: 'data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E' }}"
        alt="{{ section.settings.mobile_image_alt | default: 'Default placeholder description for mobile image.' }}"
      >
    </div>

    <!-- Text Section -->
    <div class="brand-deal-text">
      <p class="hashtag">{{ section.settings.hashtag }}</p>
      <h1>{{ section.settings.title }}</h1>
      <p class="discount">{{ section.settings.discount }}</p>
    </div>
  </div>
</div>

