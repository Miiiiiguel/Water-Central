{% comment %}
  Section Name: Testimonial Grid (70k+ Users)
  Preset Identifier: testimonial-grid-70k
{% endcomment %}

<section class="shopify-section testimonial-grid-70k">
  <div class="testimonial-section">
    <div class="testimonial-container">
      {% assign heading_block = section.blocks | where: "type", "heading" | first %}
      {% assign subheading_block = section.blocks | where: "type", "subheading" | first %}

      <!-- TITLE -->
      {% if heading_block %}
        <h2 class="testimonial-heading testimonial-main-title">
          {{ heading_block.settings.title_text }}
        </h2>
      {% endif %}

      <!-- SUBHEADING -->
      {% if subheading_block %}
        <div class="testimonial-subheading">
          {{ subheading_block.settings.subheading_text }}
        </div>
      {% endif %}

      <div class="testimonial-grid">
        {% for block in section.blocks %}
          {% if block.type == 'testimonial' %}
            <div class="testimonial-card">
              <p class="testimonial-name">
                {{ block.settings.name }}
                {% if block.settings.verified %}
                  <span class="verified">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 19px; height: 19px; vertical-align: middle;">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12ZM16.0303 8.96967C16.3232 9.26256 16.3232 9.73744 16.0303 10.0303L11.0303 15.0303C10.7374 15.3232 10.2626 15.3232 9.96967 15.0303L7.96967 13.0303C7.67678 12.7374 7.67678 12.2626 7.96967 11.9697C8.26256 11.6768 8.73744 11.6768 9.03033 11.9697L10.5 13.4393L12.7348 11.2045L14.9697 8.96967C15.2626 8.67678 15.7374 8.67678 16.0303 8.96967Z" fill="{{ section.settings.verified_icon_color }}"></path>
                    </svg>
                  </span>
                {% endif %}
              </p>
              <div class="testimonial-stars">
                {% assign max_stars = 5 %}
                {% assign rating = block.settings.star_rating %}
                {% for i in (1..max_stars) %}
                  {% if i <= rating %}
                    <span class="star filled">★</span>
                  {% else %}
                    <span class="star unfilled">★</span>
                  {% endif %}
                {% endfor %}
              </div>
              <p class="testimonial-text">{{ block.settings.review_text }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.enable_cta_button %}
        <div class="testimonial-cta-button-wrapper">
          <a
            href="{{ section.settings.cta_button_url | default: '#' }}"
            class="testimonial-cta-button">
            {{ section.settings.cta_button_text }}
          </a>
        </div>
      {% endif %}
    </div>

    <div
      class="testimonial-fade"
      style="
        height: {{ section.settings.fade_stretch | default: 80 }}px;
      ">
    </div>
  </div>
</section>

<style>
/* Wrap everything in .testimonial-grid-70k so it won’t interfere with other sections */
.testimonial-grid-70k {
  /* SECTION STYLING */
}
.testimonial-grid-70k .testimonial-section {
  /* Background & Gradient */
  {% if section.settings.enable_section_gradient %}
    background: linear-gradient({{ section.settings.section_gradient_degrees | default: '90' }}deg, {{ section.settings.section_gradient_color1 | default: '#EBEFFF' }}, {{ section.settings.section_gradient_color2 | default: '#FFFFFF' }}, {{ section.settings.section_gradient_color3 | default: '#FFFFFF' }});
  {% else %}
    background-color: {{ section.settings.section_background_color | default: '#FFFFFF' }};
  {% endif %}

  /* Top/Bottom padding */
  padding-top: {{ section.settings.section_padding_top | default: 20 }}px;
  padding-bottom: {{ section.settings.section_padding_bottom | default: 20 }}px;
  position: relative;
  overflow: hidden;
}

/* Desktop Left/Right padding */
@media screen and (min-width: 1024px) {
  .testimonial-grid-70k .testimonial-section {
    padding-left: {{ section.settings.section_padding_left_desktop | default: 0 }}px;
    padding-right: {{ section.settings.section_padding_right_desktop | default: 0 }}px;
    margin-top: -40px; /* from original code, left intact */
  }
}

/* Mobile Left/Right padding */
@media screen and (max-width: 1023px) {
  .testimonial-grid-70k .testimonial-section {
    padding-left: {{ section.settings.section_padding_left_mobile | default: 20 }}px;
    padding-right: {{ section.settings.section_padding_right_mobile | default: 20 }}px;
  }
}

.testimonial-grid-70k .testimonial-container {
  max-width: 1200px;
  margin: 0 auto;
  text-align: center;
}

/* -------------------- */
/* TITLE & SUBHEADING   */
/* -------------------- */

/* Title */
{% if heading_block %}
.testimonial-grid-70k .testimonial-main-title {
  {% if heading_block.settings.enable_title_gradient %}
    background: linear-gradient({{ heading_block.settings.title_gradient_degrees | default: '90' }}deg, {{ heading_block.settings.title_gradient_color1 | default: '#5956f5' }}, {{ heading_block.settings.title_gradient_color2 | default: '#5956f5' }}, {{ heading_block.settings.title_gradient_color3 | default: '#5956f5' }});
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  {% else %}
    color: #000000;
  {% endif %}

  font-weight: {{ heading_block.settings.font_weight | default: 500 }};
  font-size: {{ heading_block.settings.desktop_title_font_size | default: 32 }}px;
  margin-bottom: {{ section.settings.vertical_space_heading_subheading | default: 10 }}px;
}
{% endif %}

{% if heading_block %}
@media (max-width: 767px) {
  .testimonial-grid-70k .testimonial-main-title {
    font-size: {{ heading_block.settings.mobile_title_font_size | default: 24 }}px;
    margin-bottom: {{ section.settings.vertical_space_heading_subheading | default: 10 }}px;
  }
}
{% endif %}

/* Subheading */
{% if subheading_block %}
.testimonial-grid-70k .testimonial-subheading {
  max-width: 1200px;
  margin: 0 auto;
  padding-left: {{ subheading_block.settings.subheading_padding_left_desktop | default: 0 }}px;
  padding-right: {{ subheading_block.settings.subheading_padding_right_desktop | default: 0 }}px;
  font-size: {{ subheading_block.settings.desktop_subheading_font_size | default: 18 }}px;
  margin-top: {{ section.settings.vertical_space_heading_subheading | default: 10 }}px;
}
{% endif %}

{% if subheading_block %}
@media (max-width: 767px) {
  .testimonial-grid-70k .testimonial-subheading {
    padding-left: {{ subheading_block.settings.subheading_padding_left_mobile | default: 0 }}px;
    padding-right: {{ subheading_block.settings.subheading_padding_right_mobile | default: 0 }}px;
    font-size: {{ subheading_block.settings.mobile_subheading_font_size | default: 16 }}px;
  }
}
{% endif %}

/* -------------- */
/* TESTIMONIALS   */
/* -------------- */

/* Testimonial grid and spacing */
.testimonial-grid-70k .testimonial-grid {
  display: grid;
  gap: 20px;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  margin-top: {{ section.settings.vertical_space_subheading_testimonials | default: 20 }}px;
}

@media (max-width: 767px) {
  .testimonial-grid-70k .testimonial-grid {
    gap: {{ section.settings.vertical_gap_mobile | default: 20 }}px;
  }
}

/* Testimonial Card */
.testimonial-grid-70k .testimonial-card {
  {% if section.settings.enable_card_gradient %}
    background: linear-gradient({{ section.settings.card_gradient_degrees | default: '90' }}deg, {{ section.settings.card_gradient_color1 | default: '#FFFFFF' }}, {{ section.settings.card_gradient_color2 | default: '#FFFFFF' }}, {{ section.settings.card_gradient_color3 | default: '#FFFFFF' }});
  {% else %}
    background-color: {{ section.settings.card_bg_color | default: '#FFFFFF' }};
  {% endif %}
  border-radius: {{ section.settings.card_border_radius | default: 20 }}px;
  padding: 24px;
  text-align: left;
  box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.05);
  font-size: 14px;
}

.testimonial-grid-70k .testimonial-name {
  font-weight: 600;
  font-size: 17px;
  margin-bottom: 4px;
}

.testimonial-grid-70k .verified {
  margin-left: 4px;
  margin-top: -5px;
  display: inline-block;
  vertical-align: middle;
}

.testimonial-grid-70k .testimonial-stars {
  margin-bottom: 13px;
}

.testimonial-grid-70k .star {
  font-size: 18px;
}

.testimonial-grid-70k .star.filled {
  color: {{ section.settings.filled_star_color | default: '#ffc107' }};
}

.testimonial-grid-70k .star.unfilled {
  color: {{ section.settings.unfilled_star_color | default: '#d1d5db' }};
}

.testimonial-grid-70k .testimonial-text {
  color: #4b5563;
  line-height: 1.6;
}

/* Bottom fade, color-customizable */
.testimonial-grid-70k .testimonial-fade {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background: linear-gradient(0deg, {{ section.settings.bottom_fade_color | default: '#ffffff' }}, transparent);
  pointer-events: none;
  transition: height 0.3s ease;
  z-index: 1; /* Below the button */
}

/* CTA Button */
.testimonial-grid-70k .testimonial-cta-button-wrapper {
  text-align: center;
  margin-top: {{ section.settings.vertical_space_testimonials_button | default: 20 }}px;
  position: relative;
  z-index: 10; /* Above the fade */
}

.testimonial-grid-70k .testimonial-cta-button {
  display: inline-block;
  background-color: {{ section.settings.cta_button_bg_color | default: '#5956f5' }};
  color: {{ section.settings.cta_button_text_color | default: '#ffffff' }};
  border-radius: {{ section.settings.cta_button_border_radius | default: 8 }}px;
  padding: 10px 20px;
  text-decoration: none;
  font-weight: 600;
  border: {{ section.settings.cta_button_border_thickness | default: 1 }}px solid {{ section.settings.cta_button_border_color | default: '#5956f5' }};
  transition: all 0.3s ease;
}

.testimonial-grid-70k .testimonial-cta-button:hover {
  opacity: 0.9; /* subtle fade on hover */
}
</style>

