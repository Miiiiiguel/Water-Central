{% liquid
  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif

  assign classes = 'm-section m-scrolling-promotion-section'
  if section.settings.custom_class != blank
    assign classes = classes | append: ' ' | append: section.settings.custom_class
  endif
  assign classes = classes | append: ' m-color-' | append: section.settings.color_scheme
%}

<style>
  /* Dynamically import the selected Google Font if custom font is enabled */
  {% if section.settings.enable_custom_font and section.settings.font_family != blank %}
    {% assign first_font = section.settings.font_family | split: ',' | first | strip | remove: "'" | remove: '"' | replace: ' ', '+' %}
    @import url('https://fonts.googleapis.com/css2?family={{ first_font }}&display=swap');
  {% endif %}

  /* Scoped CSS: All styles are prefixed with the unique section ID */
  #m-section--{{ section.id }} {
    /* CSS Variables */
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --subheading-font-weight: {{ section.settings.subheading_font_weight }};
    --item-gap: {{ section.settings.item_gap }}px;
    --item-gap-mobile: {{ section.settings.item_gap_mobile }}px;
    --duration: {{ section.settings.speed }}s;
    --duration-second: {{ section.settings.speed_second_scrolling }}s; /* Added for second scrolling */
    --slider-scale: {{ section.settings.slider_scale }};
    --gradient-start-color: {{ section.settings.gradient_start_color }};
    --gradient-middle-color: {{ section.settings.gradient_middle_color }};
    --gradient-end-color: {{ section.settings.gradient_end_color }};
    --gradient-degree: {{ section.settings.gradient_degree }};
    --slider-scale-mobile: {{ section.settings.overall_size_mobile }};
    --duration-mobile: {{ section.settings.speed_mobile }}s;
    --duration-second-mobile: {{ section.settings.speed_second_scrolling }}s; /* Added for second scrolling mobile */
    --card-size-mobile: {{ section.settings.card_size_mobile }}; /* Added to match schema */
    --scroll-gap: {{ section.settings.scroll_gap }}px; /* New CSS variable for gap between scrollings */
    --headline-color: {{ section.settings.headline_color }};
    --subheading-color: {{ section.settings.subheading_color }};
    --headline-text-align: {{ section.settings.headline_text_align }};
    --subheading-text-align: {{ section.settings.subheading_text_align }};
    --headline-title-size-desktop: {{ section.settings.headline_title_size_desktop }}px;
    --headline-title-size-mobile: {{ section.settings.headline_title_size_mobile }}px;
    --subheading-size-desktop: {{ section.settings.subheading_size_desktop }}px;
    --subheading-size-mobile: {{ section.settings.subheading_size_mobile }}px;
    --space-between-heading-and-subheading: {{ section.settings.space_between_heading_and_subheading }}px; /* Renamed for consistency */
    --space-between-subheading-and-scrolling-cards: {{ section.settings.vertical_spacing_texts_scrolling_cards }}px; /* Renamed for consistency */
    --user-name-color: {{ section.settings.user_name_color }};
    --testimonial-message-color: {{ section.settings.testimonial_message_color }};
    --filled-star-color: {{ section.settings.filled_star_color }};
    --unfilled-star-color: {{ section.settings.unfilled_star_color }};
    --card-background-color: {{ section.settings.card_background_color }}; /* Added to match schema */
    --card-border-radius: {{ section.settings.card_border_radius }}px;
    --card-shadow: {{ section.settings.card_shadow }};
    --headline-padding-left-desktop: {{ section.settings.headline_padding_left_desktop }}px;
    --headline-padding-right-desktop: {{ section.settings.headline_padding_right_desktop }}px;
    --headline-padding-left-mobile: {{ section.settings.headline_padding_left_mobile }}px;
    --headline-padding-right-mobile: {{ section.settings.headline_padding_right_mobile }}px;
    --subheading-padding-left-desktop: {{ section.settings.subheading_padding_left }}px;
    --subheading-padding-right-desktop: {{ section.settings.subheading_padding_right }}px;
    --subheading-padding-left-mobile: {{ section.settings.subheading_padding_left_mobile }}px;
    --subheading-padding-right-mobile: {{ section.settings.subheading_padding_right_mobile }}px;
    --fade-color: {{ section.settings.background_color }}; /* Changed to section background color for better blending */
    --fade-size: {{ section.settings.fade_size }}px;
    /* Font Family Handling */
    {% if section.settings.enable_custom_font %}
      --font-family: "{{ section.settings.font_family }}";
    {% else %}
      --font-family: inherit;
    {% endif %}
    font-family: var(--font-family); /* Apply font family to the entire section */
    {% if section.settings.enable_gradient_background %}
      /* Gradient is handled within the .card style */
    {% else %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
    width: 100%; /* Ensure full width */
    box-sizing: border-box;
    text-align: center; /* Center content by default */
    position: relative; /* Needed for fading panels */
  }

  /* Container for the scrolling testimonial section */
  #m-section--{{ section.id }} .m-scrolling-promotion {
      display: flex; /* Aligns items horizontally */
      align-items: center; /* Vertically centers the items */
      overflow: hidden; /* Hides content that overflows the container */
      position: relative; /* Ensure fading panels are positioned correctly */
      transform: scale(var(--slider-scale));
  }

  /* Apply margin between scrolling promotions if second scrolling is enabled */
  #m-section--{{ section.id }} .m-scrolling-promotion + .m-scrolling-promotion {
      margin-top: var(--scroll-gap);
  }

  /* Headline Title and Subheading Styles */
  #m-section--{{ section.id }} .headline-title {
      color: var(--headline-color, #000) !important; /* Customizable color */
      font-size: var(--headline-title-size-desktop, 24px);
      text-align: var(--headline-text-align, center); /* Text alignment */
      margin-bottom: var(--space-between-heading-and-subheading, 10px); /* Spacing between Headline and Subheading */
      font-family: var(--font-family, inherit); /* Font family applied */
      padding-left: var(--headline-padding_left_desktop, 0px);
      line-height: 1.1 !important;
      padding-right: var(--headline-padding_right_desktop, 0px);
  }

  #m-section--{{ section.id }} .subheading {
      color: var(--subheading-color, #333); /* Customizable color */
      font-size: var(--subheading-size-desktop, 18px);
      text-align: var(--subheading-text-align, center); /* Text alignment */
      margin-bottom: var(--space-between-subheading-and-scrolling-cards, 20px); /* Spacing between Subheading and Scrolling Cards */
      font-family: var(--font-family, inherit); /* Font family applied */
     font-weight: var(--subheading-font-weight, 400); /* Apply font weight */
      padding-left: var(--subheading-padding-left-desktop, 0px);
      padding-right: var(--subheading-padding-right-desktop, 0px);
  }

  /* Responsive Adjustments for Headline and Subheading Sizes */
  @media screen and (min-width: 750px) {
      #m-section--{{ section.id }} .headline-title {
          padding-left: var(--headline-padding-left-desktop, 0px);
          padding-right: var(--headline-padding-right-desktop, 0px);
          line-height: 1.2 !important;
      }
      #m-section--{{ section.id }} .subheading {
          padding-left: var(--subheading-padding-left-desktop, 0px);
          padding-right: var(--subheading-padding-right-desktop, 0px);
      }
  }

  @media screen and (max-width: 749px) {
      #m-section--{{ section.id }} .headline-title {
          font-size: var(--headline-title-size-mobile, 20px);
          padding-left: var(--headline-padding-left-mobile, 0px);
          line-height: 1.2 !important;
          padding-right: var(--headline-padding-right-mobile, 0px);
      }
      #m-section--{{ section.id }} .subheading {
          font-size: var(--subheading-size-mobile, 16px);
          padding-left: var(--subheading-padding-left-mobile, 0px);
          padding-right: var(--subheading-padding-right-mobile, 0px);
      }
  }

  /* Applies scrolling animation to the promotion items based on scroll direction */
  #m-section--{{ section.id }} .m-scrolling-promotion--left .m-promotion--animated {
      animation-name: scrolling-left-{{ section.id }}; /* Uses the unique keyframe animation */
  }

  #m-section--{{ section.id }} .m-scrolling-promotion--right .m-promotion--animated {
      animation-name: scrolling-right-{{ section.id }}; /* Uses the unique keyframe animation */
  }

  /* Second Scrolling Promotion Animation */
  #m-section--{{ section.id }} .m-scrolling-promotion-second--left .m-promotion--animated {
      animation-name: scrolling-left-{{ section.id }}; /* Uses the unique keyframe animation */
  }

  #m-section--{{ section.id }} .m-scrolling-promotion-second--right .m-promotion--animated {
      animation-name: scrolling-right-{{ section.id }}; /* Uses the unique keyframe animation */
  }

  /* Controls animation play state based on hover and paused state */
  #m-section--{{ section.id }} .m-scrolling-promotion--pause-on-hover:hover .m-promotion--animated {
      animation-play-state: paused; /* Pauses animation on hover if enabled */
  }

  #m-section--{{ section.id }} .m-scrolling-promotion--paused .m-promotion--animated {
      animation-play-state: paused; /* Pauses animation when manually paused */
  }

  /* Keeps animation running continuously when not paused */
  #m-section--{{ section.id }} .m-scrolling-promotion .m-promotion--animated {
      animation-play-state: running;
  }

  /* Removes padding for the full container inside the scrolling promotion section */
  #m-section--{{ section.id }} .container-full {
      padding-left: 0;
      padding-right: 0;
  }

  /* Promotion container styles */
  #m-section--{{ section.id }} .m-promotion {
      flex: 0 0 auto; /* Prevents shrinking or growing of items */
      display: flex; /* Aligns items horizontally */
      align-items: center; /* Vertically centers the items */
      gap: var(--item-gap, 50px); /* Desktop item gap */
      transition: gap 0.3s ease; /* Smooth transition for gap changes */
  }

  /* Styles for individual promotion items */
  #m-section--{{ section.id }} .m-promotion__item {
      margin: 0 calc(var(--item-gap-mobile)/2); /* Adds margin based on the mobile gap variable */
      display: flex; /* Aligns items horizontally */
      align-items: center; /* Vertically centers the items */
      width: 350px; /* Updated to match the new card width */
      box-sizing: border-box;
  }

  /* Card styling with Enhanced Customizations */
  #m-section--{{ section.id }} .card {
    background-color: var(--card-background-color, rgba(243, 244, 246, 1));
    padding: 1.5rem; /* Adjusted padding to fit within the new height */
    width: 350px; /* Fixed width as per user specification */
    height: 200px; /* Fixed height as per user specification */
    border-radius: var(--card-border-radius, 10px);
    box-shadow: var(--card-shadow, 0 20px 30px -20px rgba(5, 5, 5, 0.24));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box; /* Ensures padding and border are included in the total width and height */
    /* Initialize the CSS variables with default values */
    --message-vertical-position: 0px;
    /* Initialize the card size variable for mobile */
    --card-size-mobile: 1;

    /* Gradient Background */
    {% if section.settings.enable_gradient_background %}
      background: linear-gradient(var(--gradient-degree, 90deg), var(--gradient-start-color, #ff7e5f), var(--gradient-middle-color, #feb47b), var(--gradient-end-color, #ff7e5f));
    {% endif %}
    font-family: var(--font-family, inherit); /* Font family applied */
    transition: transform 0.3s ease; /* Smooth transition for scaling */
  }

  #m-section--{{ section.id }} .card .header {
    display: flex;
    align-items: center;
    gap: 1rem;

    font-family: var(--font-family, inherit); /* Font family applied */
  }

  #m-section--{{ section.id }} .card .header .image {
    height: 4rem;
    width: 4rem;
    border-radius: 9999px;
    object-fit: cover;
    background-color: royalblue;
    background-size: cover;
    background-position: center;
    background-image: url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E'); /* Default placeholder image */
    transition: transform 0.3s ease-in-out; /* Smooth transition for zoom effect */
  }

  #m-section--{{ section.id }} .card .stars {
    display: flex;
    justify-content: center;
    gap: 0.125rem;
    margin-top: 0.5rem; /* Adjusted for better positioning */
  }

  #m-section--{{ section.id }} .card .stars svg {
    height: 1.2rem;
    width: 1.2rem;
    fill: var(--unfilled-star-color, gray); /* Default color for unfilled stars */
  }

  #m-section--{{ section.id }} .card .stars .filled-star {
    fill: var(--filled-star-color, #eeb800); /* Color for filled stars */
  }

  #m-section--{{ section.id }} .card .name {
    margin-top: 0.25rem;

       font-size: 15px !Important;
    line-height: 1.75rem;
    font-weight: 600;
    color: var(--user-name-color, rgba(55, 65, 81, 1));
    font-family: var(--font-family, inherit); /* Font family applied */
  }

  #m-section--{{ section.id }} .card .message {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    margin-top: 0.6rem;
    margin-bottom: 0.5rem;
       font-size: 16px !Important;
    color: var(--testimonial-message-color, rgba(107, 114, 128, 1));
    /* Use the CSS variable for vertical positioning */
    transform: translateY(var(--message-vertical-position));
    text-align: left; /* Aligns the text to the left */
    font-family: var(--font-family, inherit); /* Font family applied */
  }

  /* Media query: Adjusts margin for promotion items for screens wider than 750px */
  @media(min-width: 750px) {
      #m-section--{{ section.id }} .m-promotion__item {
          margin: 0 calc(var(--item-gap)/2); /* Adds margin based on the desktop gap variable */
      }
  }

  /* Media query: Adjusts gap for promotion items on mobile devices */
  @media screen and (max-width: 749px) {
      #m-section--{{ section.id }} .m-promotion {
          gap: var(--item-gap-mobile, 30px); /* Mobile item gap */
      }
      #m-section--{{ section.id }} .m-promotion__item {
          margin: 0 calc(var(--item-gap-mobile)/2); /* Adjusts margin based on mobile gap */
      }
      /* Adjust card size based on the slider */
      #m-section--{{ section.id }} .card {
          transform: scale(var(--card-size-mobile)); /* Applies mobile scaling */
      }
  }

  /* Icon container styling */
  #m-section--{{ section.id }} .m-promotion__icon {
      display: inline-flex; /* Aligns items horizontally */
      line-height: 0; /* Removes line-height */
      margin-right: 10px; /* Adds right margin */
      --icon-height: 26px; /* Default icon height variable */
  }

  /* Small icon size */
  #m-section--{{ section.id }} .m-promotion__icon--small {
      --icon-height: 20px; /* Sets icon height to 20px */
  }

  /* Large icon size */
  #m-section--{{ section.id }} .m-promotion__icon--large {
      --icon-height: 32px; /* Sets icon height to 32px */
  }

  /* Styling for SVG or image within icons */
  #m-section--{{ section.id }} .m-promotion__icon svg,
  #m-section--{{ section.id }} .m-promotion__icon img {
      width: auto; /* Width adjusts automatically */
      height: var(--icon-height); /* Sets height based on icon height variable */
      max-width: var(--icon-height); /* Ensures icon does not exceed set height */
      fill: currentColor; /* Fills SVG with current text color */
  }

  /* Text styling for promotion items */
  #m-section--{{ section.id }} .m-promotion__text {
      color: inherit; /* Inherits parent text color */
      line-height: 1; /* Sets line-height to 1 */
      white-space: nowrap; /* Prevents text from wrapping */
      font-size: var(--text-size, 16px); /* Sets font size to text size variable */
      color: var(--color-foreground, #000); /* Sets text color using foreground color variable */
      font-family: var(--font-family, inherit); /* Font family applied */
  }

  /* Media query: Adjusts text size for screens smaller than 767px */
  @media screen and (max-width: 767px) {
      #m-section--{{ section.id }} .m-promotion__text {
          font-size: calc(var(--text-size, 16px) * 0.75); /* Sets font size to 75% of the text size variable */
      }
  }

  /* Animation properties for animated promotion items */
  #m-section--{{ section.id }} .m-promotion--animated {
      animation-iteration-count: infinite; /* Animation repeats indefinitely */
      animation-timing-function: linear; /* Creates a smooth animation */
      animation-duration: var(--duration); /* Sets animation duration */
      animation-play-state: running; /* Keeps animation running */
      width: max-content; /* Adjusts width based on content */
      will-change: transform, width; /* Optimizes animation performance */
      display: flex;
      gap: var(--item-gap-mobile, 18px); /* Ensures gap consistency */
  }

  /* Keyframe animation for scrolling left */
  @keyframes scrolling-left-{{ section.id }} {
      0% {
          transform: translate3d(0, 0, 0); /* Starts at original position */
          visibility: visible; /* Ensures visibility */
      }
      100% {
          transform: translate3d(-100%, 0, 0); /* Moves the content left by 100% */
      }
  }

  /* Keyframe animation for scrolling right */
  @keyframes scrolling-right-{{ section.id }} {
      0% {
          transform: translate3d(-100%, 0, 0); /* Starts off-screen to the left */
          visibility: visible; /* Ensures visibility */
      }
      100% {
          transform: translate3d(0, 0, 0); /* Moves the content right to its original position */
      }
  }

  /* Keyframe animation for scrolling left in RTL (Right-to-Left) mode */
  @keyframes scrolling-left-rtl-{{ section.id }} {
      0% {
          transform: translate3d(0, 0, 0);
          visibility: visible;
      }
      100% {
          transform: translate3d(100%, 0, 0);
      }
  }

  /* Keyframe animation for scrolling right in RTL (Right-to-Left) mode */
  @keyframes scrolling-right-rtl-{{ section.id }} {
      0% {
          transform: translate3d(100%, 0, 0);
          visibility: visible;
      }
      100% {
          transform: translate3d(0, 0, 0);
      }
  }

  /* Fade Panels for Carousel */
  #m-section--{{ section.id }} .fading-panel-left,
  #m-section--{{ section.id }} .fading-panel-right {
      position: absolute;
      top: 0;
      width: var(--fade-size, 50px);
      height: 100%;
      pointer-events: none;
      z-index: 2; /* Ensure fading panels are above the carousel */
      background: linear-gradient(to right, var(--fade-color, white), transparent);
  }

  #m-section--{{ section.id }} .fading-panel-right {
      right: 0;
      background: linear-gradient(to left, var(--fade-color, white), transparent);
  }

  /* Promotion container styles */
  #m-section--{{ section.id }} .m-promotion__item img {
      border-radius: var(--image-border-radius, 9999px); /* Added default value */
      object-fit: cover;
  }

  /* Fade Panels (only visible if fading effect is enabled) */
  {% if section.settings.enable_fading_effect %}
    #m-section--{{ section.id }} .fading-panel-left,
    #m-section--{{ section.id }} .fading-panel-right {
        /* Already defined above */
        background: linear-gradient(to right, var(--fade-color, #ffffff), transparent);
    }
  {% endif %}
</style>

<section
  id="m-section--{{ section.id }}"
  class="{{ classes }}"
  data-section-type="scrolling-promotion"
  data-section-id="{{ section.id }}"
  data-pause-on-hover="{{ section.settings.pause_on_hover }}"
>
  <div class="{{ container }} m-section-py">
    <!-- Headline Title -->
    {% if section.settings.show_headline_title %}
      <h2 class="headline-title">{{ section.settings.headline_title }}</h2>
    {% endif %}

    <!-- Subheading -->
    {% if section.settings.show_subheading %}
      <h3 class="subheading">{{ section.settings.subheading }}</h3>
    {% endif %}

    <!-- First Scrolling Promotion -->
    <m-scrolling-promotion
      class="m-scrolling-promotion m-scrolling-promotion--{{ section.settings.direction }}{% if section.settings.pause_on_hover %} m-scrolling-promotion--pause-on-hover{% endif %}"
      data-pause-on-hover="{{ section.settings.pause_on_hover }}"
    >
      <div class="m-promotion">
        {% assign first_limit = section.settings.enable_second_scrolling %}
        {% if section.settings.enable_second_scrolling %}
          {% assign first_limit = 5 %}
        {% else %}
          {% assign first_limit = section.blocks.size %}
        {% endif %}

        {% for block in section.blocks limit: first_limit %}
          {%- case block.type -%}
            {%- when 'testimonial' -%}
              <div class="m-promotion__item">
                <div
                  class="card"
                  style="--message-vertical-position: {{ block.settings.message_vertical_position }}px;"
                >
                  <div class="header">
                    {% if block.settings.image %}
                      <div
                        class="image"
                        style="background-image: url('{{ block.settings.image | img_url: '400x400' }}');"
                      ></div>
                    {% else %}
                      <div
                        class="image"
                        style="background-image: url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E');"
                      ></div>
                    {% endif %}
                    <div>
                      <div class="stars">
                        {% assign rating = block.settings.rating | plus: 0 %}
                        {% for i in (1..5) %}
                          {% if i <= rating %}
                            <svg class="filled-star" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                            </svg>
                          {% else %}
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                            </svg>
                          {% endif %}
                        {% endfor %}
                      </div>
                      <p class="name">{{ block.settings.name }}</p>
                    </div>
                  </div>

                  <p class="message">
                    {{ block.settings.message }}
                  </p>
                </div>
              </div>
          {%- endcase -%}
        {% endfor %}
      </div>
    </m-scrolling-promotion>

    <!-- Second Scrolling Promotion (if enabled) -->
    {% if section.settings.enable_second_scrolling %}
      <m-scrolling-promotion
        class="m-scrolling-promotion m-scrolling-promotion--{{ section.settings.second_direction }} m-scrolling-promotion-second m-scrolling-promotion-second--{{ section.settings.second_direction }}{% if section.settings.pause_on_hover %} m-scrolling-promotion--pause-on-hover{% endif %}"
        data-pause-on-hover="{{ section.settings.pause_on_hover }}"
      >
        <div class="m-promotion">
          {% assign second_limit = 5 %}
          {% assign second_offset = 5 %}
          {% for block in section.blocks offset: second_offset limit: second_limit %}
            {%- case block.type -%}
              {%- when 'testimonial' -%}
                <div class="m-promotion__item">
                  <div
                    class="card"
                    style="--message-vertical-position: {{ block.settings.message_vertical_position }}px;"
                  >
                    <div class="header">
                      {% if block.settings.image %}
                        <div
                          class="image"
                          style="background-image: url('{{ block.settings.image | img_url: '400x400' }}');"
                        ></div>
                      {% else %}
                        <div
                          class="image"
                          style="background-image: url('data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E');"
                        ></div>
                      {% endif %}
                      <div>
                        <div class="stars">
                          {% assign rating = block.settings.rating | plus: 0 %}
                          {% for i in (1..5) %}
                            {% if i <= rating %}
                              <svg class="filled-star" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                              </svg>
                            {% else %}
                              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                              </svg>
                            {% endif %}
                          {% endfor %}
                        </div>
                        <p class="name">{{ block.settings.name }}</p>
                      </div>
                    </div>

                    <p class="message">
                      {{ block.settings.message }}
                    </p>
                  </div>
                </div>
            {%- endcase -%}
          {% endfor %}
        </div>
      </m-scrolling-promotion>
    {% endif %}

    <!-- Fading Panels (if enabled) -->
    {% if section.settings.enable_fading_effect %}
      <div class="fading-panel-left"></div>
      <div class="fading-panel-right"></div>
    {% endif %}
  </div>
</section>

<script>
  // Scoped JavaScript: Ensures scripts target only elements within this section
  (function() {
    const sectionId = "{{ section.id }}";
    // **Fixed line below**: now correctly gets the element by ID
    const section = document.getElementById("m-section--" + sectionId);
    if (!section) return;

    // Check if the custom element "m-scrolling-promotion" is already defined
    if (!customElements.get("m-scrolling-promotion")) {

      /**
       * Class definition for the custom HTML element <m-scrolling-promotion>.
       */
      class MScrollingPromotion extends HTMLElement {

        // Constructor for the MScrollingPromotion class
        constructor() {
          super();
        }

        /**
         * Called when the element is connected to the DOM.
         * Initializes the promotion element and its functionality.
         */
        connectedCallback() {
          this.promotion = this.querySelector(".m-promotion");
          this.pauseOnHover = this.getAttribute('data-pause-on-hover') === 'true';
          this.init();
        }

        /**
         * Initializes the promotion element.
         * If there is only one child element, it adds multiple clones
         * to create a continuous scrolling effect.
         */
        init() {
          if (this.promotion && this.promotion.children.length > 0) {
            // Add a class to start animation on the promotion element
            this.promotion.classList.add("m-promotion--animated");

            // Create multiple clones of the promotion element for smooth scrolling
            this.createClones();

            // Add zoom effect to images on hover
            this.addZoomEffect();

            // Setup pause on hover functionality if enabled
            if (this.pauseOnHover) {
              this.setupPauseOnHover();
            }

            // Start scrolling the promotion element
            this.scrollingPlay();
          }
        }

        /**
         * Creates multiple clones of the promotion element to ensure continuous scrolling.
         */
        createClones() {
          const cloneCount = 10; // Adjust the number of clones as needed
          for (let index = 0; index < cloneCount; index++) {
            // Clone the promotion element
            const clone = this.promotion.cloneNode(true);

            // Mark the clone as hidden for accessibility purposes
            clone.setAttribute("aria-hidden", true);

            // Append the clone to the promotion container
            this.appendChild(clone);
          }
        }

        /**
         * Adds a smooth zoom effect to all images within the promotion items on hover.
         */
        addZoomEffect() {
          const images = this.querySelectorAll(".card .header .image");

          images.forEach((image) => {
            // Set CSS transition for a smooth zoom-in effect on hover
            image.style.transition = "transform 0.3s ease-in-out";

            // Scale up the image on mouseover with a smooth animation
            image.addEventListener("mouseover", () => {
              image.style.transform = "scale(1.1)";
            });

            // Reset the image scale on mouseout with a smooth animation
            image.addEventListener("mouseout", () => {
              image.style.transform = "scale(1)";
            });
          });
        }

        /**
         * Keeps the scrolling functionality always active by removing any paused state.
         */
        scrollingPlay() {
          this.classList.remove("m-scrolling-promotion--paused");
        }

        /**
         * A placeholder function for pausing scrolling.
         * It is intentionally left empty to prevent pausing.
         */
        scrollingPause() {
          // This function is intentionally empty
        }

        /**
         * Sets up event listeners to pause and resume scrolling on hover.
         */
        setupPauseOnHover() {
          this.addEventListener('mouseenter', () => {
            this.classList.add('m-scrolling-promotion--paused');
          });

          this.addEventListener('mouseleave', () => {
            this.classList.remove('m-scrolling-promotion--paused');
          });
        }
      }

      // Define the custom HTML element <m-scrolling-promotion> with the MScrollingPromotion class
      customElements.define("m-scrolling-promotion", MScrollingPromotion);
    }
  })();
</script>

