    {
      "type": "header",
      "content": "Card Settings",
      "info": "Customize the appearance of the testimonial cards."
    },
    {
      "type": "checkbox",
      "id": "enable_gradient_background",
      "label": "Enable Gradient Background for Cards",
      "default": true,
      "info": "Toggle a gradient background for testimonial cards."
    },
    {
      "type": "color",
      "id": "gradient_start_color",
      "label": "Gradient Start Color",
      "default": "#ECECEC",
      "info": "Choose the starting color for the gradient background."
    },
    {
      "type": "color",
      "id": "gradient_middle_color",
      "label": "Gradient Middle Color",
      "default": "#F7F7F7",
      "info": "Choose the middle color for the gradient background."
    },
    {
      "type": "color",
      "id": "gradient_end_color",
      "label": "Gradient End Color",
      "default": "#FAFAFA",
      "info": "Choose the ending color for the gradient background."
    },
    {
      "type": "select",
      "id": "gradient_degree",
      "label": "Gradient Degree",
      "options": [
        { "label": "0°", "value": "0deg" },
        { "label": "15°", "value": "15deg" },
        { "label": "30°", "value": "30deg" },
        { "label": "45°", "value": "45deg" },
        { "label": "60°", "value": "60deg" },
        { "label": "75°", "value": "75deg" },
        { "label": "90°", "value": "90deg" },
        { "label": "105°", "value": "105deg" },
        { "label": "120°", "value": "120deg" },
        { "label": "135°", "value": "135deg" },
        { "label": "150°", "value": "150deg" },
        { "label": "165°", "value": "165deg" },
        { "label": "180°", "value": "180deg" }
      ],
      "default": "150deg",
      "info": "Set the angle for the gradient background."
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card Border Radius",
      "default": 8,
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "info": "Set the border radius of the testimonial cards."
    },
    {
      "type": "select",
      "id": "card_shadow",
      "label": "Card Shadow",
      "options": [
        { "label": "None", "value": "none" },
        { "label": "Low Shadow", "value": "0 10px 20px -10px rgba(5, 5, 5, 0.2)" },
        { "label": "Medium Shadow", "value": "0 15px 25px -10px rgba(5, 5, 5, 0.3)" },
        { "label": "High Shadow", "value": "0 20px 30px -20px rgba(5, 5, 5, 0.4)" }
      ],
      "default": "0 10px 20px -10px rgba(5, 5, 5, 0.2)",
      "info": "Select the shadow intensity for the testimonial cards."
    },
    {
      "type": "header",
      "content": "Text Settings",
      "info": "Customize the colors and alignments of various text elements."
    },
    {
      "type": "color",
      "id": "user_name_color",
      "label": "User Name Color",
      "default": "#343434",
      "info": "Choose the color for the user's name."
    },
    {
      "type": "color",
      "id": "testimonial_message_color",
      "label": "Testimonial Message Color",
      "default": "#6B7280",
      "info": "Choose the color for the testimonial message."
    },
    {
      "type": "color",
      "id": "filled_star_color",
      "label": "Filled Star Color",
      "default": "#FAC000",
      "info": "Choose the color for filled stars in ratings."
    },
    {
      "type": "color",
      "id": "unfilled_star_color",
      "label": "Unfilled Star Color",
      "default": "#CCCCCC",
      "info": "Choose the color for unfilled stars in ratings."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "User Image",
          "info": "Upload an image of the user. If left blank, a default placeholder image will be used."
        },
        {
          "type": "text",
          "id": "name",
          "label": "User Name",
          "default": "John Doe",
          "info": "Enter the name of the user giving the testimonial."
        },
        {
          "type": "textarea",
          "id": "message",
          "label": "Testimonial Message",
          "default": "Lorem ipsum dolor sit amet consectetur adipisicing elit. Deserunt voluptatem alias ut provident sapiente repellendus.",
