          "type": "eyebrow",
          "settings": {
            "text": "Real Moments",
            "color": "#FFFFFF",
            "weight": "500",
            "transform": "uppercase",
            "letterspace": 0.6,
            "opacity": 100,
            "size_d": 16,
            "size_m": 13
          }
        },
        {
          "type": "heading",
          "settings": {
