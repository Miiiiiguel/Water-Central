      "info": "Set the top padding for the section on mobile devices."
    },
    {
      "type": "range",
      "id": "mobile_section_padding_bottom",
      "min": 0,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 20,
      "info": "Set the bottom padding for the section on mobile devices."
