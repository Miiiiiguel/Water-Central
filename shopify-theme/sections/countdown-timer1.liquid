<style>
  {%- capture loudecomz_content -%}

  {% assign heading_block = section.blocks | where: "type", "heading" | first %}
  {% assign subheading_block = section.blocks | where: "type", "subheading" | first %}

  {% if section.settings.override_fonts %}
    {{ heading_block.settings.headline_font | font_face }}
    {{ subheading_block.settings.text_font | font_face }}
  {% endif %}

  #loudecomz-{{ section.id }} p {
    font-size: {{ subheading_block.settings.text_size }}px;
    {% if section.settings.override_fonts %}
      font-family: {{ subheading_block.settings.text_font.family }}, {{ subheading_block.settings.text_font.fallback_families }};
      font-weight: {{ subheading_block.settings.text_font.weight }};
    {% endif %}
    {% if subheading_block.settings.text_line_height != 'inherit' %}line-height: {{ subheading_block.settings.text_line_height }};{% endif %}
    margin: 0 0 {{ section.settings.element_spacing }}px 0;
    padding: 0;
    color: {{ subheading_block.settings.text_color }};
  }

  #loudecomz-{{ section.id }} ul,
  #loudecomz-{{ section.id }} ol {
    margin: 0 0 {{ section.settings.element_spacing }}px 0;
  }

  #loudecomz-{{ section.id }} li {
    font-size: {{ subheading_block.settings.text_size }}px;
    {% if section.settings.override_fonts %}
      font-family: {{ subheading_block.settings.text_font.family }}, {{ subheading_block.settings.text_font.fallback_families }};
      font-weight: {{ subheading_block.settings.text_font.weight }};
    {% endif %}
    {% if subheading_block.settings.text_line_height != 'inherit' %}line-height: {{ subheading_block.settings.text_line_height }};{% endif %}
    margin: 0 0 5px 0;
    padding: 0;
    color: {{ subheading_block.settings.text_color }};
  }

  #loudecomz-{{ section.id }} li:last-child { margin: 0; }

  #loudecomz-{{ section.id }} p a,
  #loudecomz-{{ section.id }} p a:visited,
  #loudecomz-{{ section.id }} li a,
  #loudecomz-{{ section.id }} li a:visited {
    color: {{ subheading_block.settings.link_color }};
  }

  @media (max-width: 800px) {
    #loudecomz-{{ section.id }} p,
    #loudecomz-{{ section.id }} li {
      font-size: {{ subheading_block.settings.mobile_text_size }}px !important;
    }
  }

  #loudecomz-{{ section.id }} h1,
  #loudecomz-{{ section.id }} h2,
  #loudecomz-{{ section.id }} h3,
  #loudecomz-{{ section.id }} h4,
  #loudecomz-{{ section.id }} h5 {
    font-size: {{ heading_block.settings.headline_size }}px;
    {% if section.settings.override_fonts %}
      font-family: {{ heading_block.settings.headline_font.family }}, {{ heading_block.settings.headline_font.fallback_families }};
    {% endif %}
    font-weight: {{ heading_block.settings.heading_text_weight }};
    {% if heading_block.settings.headline_line_height != 'inherit' %}line-height: {{ heading_block.settings.headline_line_height }};{% endif %}
    margin: 0 0 {{ section.settings.element_spacing }}px 0;
    padding: 0;
    color: {{ heading_block.settings.headline_color }} !important;
  }

  @media (max-width: 800px) {
    #loudecomz-{{ section.id }} h1,
    #loudecomz-{{ section.id }} h2,
    #loudecomz-{{ section.id }} h3,
    #loudecomz-{{ section.id }} h4,
    #loudecomz-{{ section.id }} h5 {
      font-size: {{ heading_block.settings.mobile_headline_size }}px;
    }
  }

  #loudecomz-{{ section.id }} h2 { font-size: {{ heading_block.settings.headline_size | minus:5  | at_least:13 }}px; }
  #loudecomz-{{ section.id }} h3 { font-size: {{ heading_block.settings.headline_size | minus:10 | at_least:13 }}px; }
  #loudecomz-{{ section.id }} h4 { font-size: {{ heading_block.settings.headline_size | minus:15 | at_least:13 }}px; }
  #loudecomz-{{ section.id }} h5 { font-size: {{ heading_block.settings.headline_size | minus:20 | at_least:13 }}px; }

  @media (max-width: 800px) {
    #loudecomz-{{ section.id }} h2 { font-size: {{ heading_block.settings.mobile_headline_size | minus:5 | at_least:13 }}px; }
    #loudecomz-{{ section.id }} h3 { font-size: {{ heading_block.settings.mobile_headline_size | minus:10 | at_least:13 }}px; }
    #loudecomz-{{ section.id }} h4 { font-size: {{ heading_block.settings.mobile_headline_size | minus:15 | at_least:13 }}px; }
    #loudecomz-{{ section.id }} h5 { font-size: {{ heading_block.settings.mobile_headline_size | minus:20 | at_least:13 }}px; }
  }

  #loudecomz-{{ section.id }} {
    background-color: {{ section.settings.section_background_color }};
    {% if section.settings.section_background_image %}
      position: relative;
    {% endif %}
    width: 100%;
    box-sizing: border-box;
    padding: {{ section.settings.section_padding_top }}px {{ section.settings.section_padding_left_right }}px {{ section.settings.section_padding_bottom }}px {{ section.settings.section_padding_left_right }}px;
    overflow: hidden;
  }

  {% if section.settings.section_background_image %}
    #loudecomz-{{ section.id }}::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: url({{ section.settings.section_background_image | image_url | default: 'https://www.redhouseoriginals.com/wp-content/uploads/dark-placeholder.png' }}) center/{{ section.settings.section_background_size }} no-repeat;
      {% if section.settings.section_background_image_color %}
        background-color: {{ section.settings.section_background_image_color }};
      {% endif %}
      filter: brightness({{ section.settings.background_image_brightness }}%);
      z-index: -1;
    }
  {% else %}
    /* If no background image is set, use the placeholder */
    #loudecomz-{{ section.id }}::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      filter: brightness({{ section.settings.background_image_brightness }}%);
      z-index: -1;
    }
  {% endif %}

  @media (max-width: 800px) {
    #loudecomz-{{ section.id }} {
      padding: {{ section.settings.mobile_section_padding_top }}px {{ section.settings.mobile_section_padding_left_right }}px {{ section.settings.mobile_section_padding_bottom }}px {{ section.settings.mobile_section_padding_left_right }}px;
    }
  }

  {% if section.settings.show_on_device == 'mobile' %}
    @media (min-width: 801px) {
      #loudecomz-{{ section.id }} { display: none; }
    }
  {% endif %}
  {% if section.settings.show_on_device == 'desktop' %}
    @media (max-width: 800px) {
      #loudecomz-{{ section.id }} { display: none; }
    }
  {% endif %}

  #loudecomz-{{ section.id }} .loudecomz-container {
    position: relative;
    margin: 0 auto;
    background-color: {{ section.settings.container_background_color }};
    max-width: {{ section.settings.container_max_width }}px;
    padding: {{ section.settings.container_padding_top }}px {{ section.settings.container_padding_left_right }}px {{ section.settings.container_padding_bottom }}px {{ section.settings.container_padding_left_right }}px;
  }
  @media (max-width: 800px) {
    #loudecomz-{{ section.id }} .loudecomz-container {
      padding: {{ section.settings.mobile_container_padding_top }}px {{ section.settings.mobile_container_padding_left_right }}px {{ section.settings.mobile_container_padding_bottom }}px {{ section.settings.mobile_container_padding_left_right }}px;
    }
  }

  #loudecomz-{{ section.id }} .loudecomz-headline p {
    font-size: {{ subheading_block.settings.text_size }}px;
    {% if section.settings.override_fonts %}
      font-family: {{ subheading_block.settings.text_font.family }}, {{ subheading_block.settings.text_font.fallback_families }};
      font-weight: {{ subheading_block.settings.text_font.weight }};
    {% endif %}
    color: {{ subheading_block.settings.text_color }};
    line-height: 1.15;
    margin: 0;
    padding: 0 0 25px 0;
    text-align: {{ section.settings.text_alignment }};
  }
  #loudecomz-{{ section.id }} .loudecomz-headline {
    margin: 0;
    padding: 0 0 {{ section.settings.headline_spacing }}px 0;
  }
  #loudecomz-{{ section.id }} .loudecomz-headline * {
    text-align: {{ section.settings.text_alignment }};
  }
  @media only screen and (max-width: 800px) {
    #loudecomz-{{ section.id }} .loudecomz-headline * {
      text-align: {{ section.settings.mobile_text_alignment }};
    }
  }

  #loudecomz-{{ section.id }} .loudecomz-grid {
    display: grid;
    margin: 0 auto;
    grid-auto-columns: {{ section.settings.item_width }}px;
    grid-auto-flow: column;
    gap: {{ section.settings.grid_gap }}px; /* Desktop gap */
    {% if section.settings.timer_alignment == 'left' %}
      justify-content: start;
    {% elsif section.settings.timer_alignment == 'center' %}
      justify-content: center;
    {% elsif section.settings.timer_alignment == 'right' %}
      justify-content: end;
    {% endif %}
    font-size: {{ section.settings.overall_countdown_size }}px;
  }
  @media only screen and (max-width: 800px) {
    #loudecomz-{{ section.id }} .loudecomz-grid {
      display: grid;
      grid-auto-columns: 1fr;
      gap: {{ section.settings.grid_gap_mobile }}px; /* Mobile gap */
    }
  }

  /* Countdown Background with RGBA */
  #loudecomz-{{ section.id }} .loudecomz-grid-item {
    {% if section.settings.enable_countdown_background %}
      background-color: {{ section.settings.countdown_background_color }};
      min-width: 110px !important; /* Increase the size */
      border-radius: {{ section.settings.countdown_background_border_radius }}px;
    {% else %}
      background: none;
    {% endif %}
    padding: {{ section.settings.countdown_padding }}px;
    text-align: center;
  }

  #loudecomz-{{ section.id }} .loudecomz-timer,
  #loudecomz-{{ section.id }} .loudecomz-label {
    {% if section.settings.override_fonts %}
      font-family: {{ subheading_block.settings.text_font.family }}, {{ subheading_block.settings.text_font.fallback_families }};
      font-weight: {{ subheading_block.settings.text_font.weight }};
    {% endif %}
    font-size: {{ section.settings.timer_size }}px; /* Desktop timer size */
    line-height: 1;
    text-align: center;
    display: block;
    {% if section.settings.enable_timer_gradient %}
      background: linear-gradient({{ section.settings.gradient_degrees }}, {{ section.settings.gradient_start_color }}, {{ section.settings.gradient_middle_color }}, {{ section.settings.gradient_end_color }});
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    {% else %}
      font-weight: bold;
      color: {{ section.settings.timer_color }};
    {% endif %}
  }

  @media only screen and (max-width: 800px) {
    #loudecomz-{{ section.id }} .loudecomz-timer {
      font-size: {{ section.settings.timer_size_mobile }}px; /* Mobile timer size */
    }
  }

  /* Override countdown numbers font weight with custom setting */
  #loudecomz-{{ section.id }} .loudecomz-timer { font-weight: {{ section.settings.countdown_font_weight }}; }
  #loudecomz-{{ section.id }} .loudecomz-label { font-size: {{ section.settings.label_size }}px; line-height: 1; }

  @media (max-width: 800px) {
    #loudecomz-{{ section.id }} .loudecomz-label {
      font-size: {{ section.settings.mobile_label_size }}px !important;
    }
  }

  /* Hours text color */
  #loudecomz-{{ section.id }} .loudecomz-grid-item:nth-child(1) .loudecomz-label { color: {{ section.settings.hours_text_color }} !important; }
  /* Minutes text color */
  #loudecomz-{{ section.id }} .loudecomz-grid-item:nth-child(2) .loudecomz-label { color: {{ section.settings.minutes_text_color }} !important; }
  /* Seconds text color */
  #loudecomz-{{ section.id }} .loudecomz-grid-item:nth-child(3) .loudecomz-label { color: {{ section.settings.seconds_text_color }} !important; }

  #loudecomz-{{ section.id }} .loudecomz-section { position: relative; padding: 10px; margin: 0; }
  #loudecomz-{{ section.id }} .loudecomz-section * { box-sizing: border-box; }

  {%- endcapture -%}
  {{ loudecomz_content | strip }}
</style>

<!-- start content -->
<section id="loudecomz-{{ section.id }}" class="loudecomz-section" loudecomz-section data-section-id="{{ section.id }}">
  <section class="loudecomz-container" loudecomz-container>
    <div class="loudecomz-headline">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'heading' %}
            <h2>{{ block.settings.headline }}</h2>
          {% when 'subheading' %}
            <p>{{ block.settings.text }}</p>
        {% endcase %}
      {% endfor %}
    </div>
    <div class="loudecomz-grid">
      <div class="loudecomz-grid-item">
        <div class="loudecomz-countdown">
          <span id="loudecomz-hours-{{ section.id }}" class="loudecomz-timer">{{ section.settings.start_hours | default: 0 | plus: 0 | prepend: '' }}</span>
          <span class="loudecomz-label">{{ section.settings.hours_text }}</span>
        </div>
      </div>
      <div class="loudecomz-grid-item">
        <div class="loudecomz-countdown">
          <span id="loudecomz-minutes-{{ section.id }}" class="loudecomz-timer">{{ section.settings.start_minutes | default: 0 | plus: 0 | prepend: '' | split: '' | first | default: '00' }}</span>
          <span class="loudecomz-label">{{ section.settings.minutes_text }}</span>
        </div>
      </div>
      <div class="loudecomz-grid-item" {% if section.settings.show_seconds == false %}style="display:none;"{% endif %}>
        <div class="loudecomz-countdown">
          <span id="loudecomz-seconds-{{ section.id }}" class="loudecomz-timer">{{ section.settings.start_seconds | default: 0 | plus: 0 | prepend: '' | split: '' | first | default: '00' }}</span>
          <span class="loudecomz-label">{{ section.settings.seconds_text }}</span>
        </div>
      </div>
    </div>
  </section>
</section>
<!-- end Sections.AI content -->

<script>
(function(){
  var secId = "{{ section.id }}";
  var hoursEl   = document.getElementById('loudecomz-hours-{{ section.id }}');
  var minutesEl = document.getElementById('loudecomz-minutes-{{ section.id }}');
  var secondsEl = document.getElementById('loudecomz-seconds-{{ section.id }}');

  // Initial values from settings
  var startH = parseInt("{{ section.settings.start_hours | default: 0 }}", 10)   || 0;
  var startM = parseInt("{{ section.settings.start_minutes | default: 0 }}", 10) || 0;
  var startS = parseInt("{{ section.settings.start_seconds | default: 0 }}", 10) || 0;

  // Normalize minutes/seconds into total ms
  var totalMs = ((startH * 3600) + (startM * 60) + startS) * 1000;
  if (totalMs < 0) totalMs = 0;

  // Unique storage keys per section
  var storageKey = "loudecomzCountdownTarget_" + secId;
  var versionKey = "loudecomzCountdownVersion_" + secId;

  // Version signature changes when the configured duration changes
  var currentVersion = [startH, startM, startS].join(":");

  // Helper: safe storage (falls back if localStorage is blocked)
  var storage = (function(){
    try {
      var t = "__test__";
      window.localStorage.setItem(t, "1");
      window.localStorage.removeItem(t);
      return window.localStorage;
    } catch(e) {
      // fallback to in-memory
      var mem = {};
      return {
        getItem: function(k){ return mem[k] || null; },
        setItem: function(k,v){ mem[k] = String(v); },
        removeItem: function(k){ delete mem[k]; }
      }
    }
  })();

  function now(){ return Date.now(); }

  function getOrInitTarget() {
    var savedTarget = storage.getItem(storageKey);
    var savedVersion = storage.getItem(versionKey);

    // If no target yet OR the configured duration changed in the editor, re-seed
    if (!savedTarget || savedVersion !== currentVersion) {
      var newTarget = now() + totalMs;
      storage.setItem(storageKey, String(newTarget));
      storage.setItem(versionKey, currentVersion);
      return newTarget;
    }
    return parseInt(savedTarget, 10);
  }

  var targetTime = getOrInitTarget();
  var rafId = null;
  var tickInterval = null;

  function render(diffMs){
    if (diffMs < 0) diffMs = 0;

    var hrs = Math.floor(diffMs / 3600000);
    var mins = Math.floor((diffMs % 3600000) / 60000);
    var secs = Math.floor((diffMs % 60000) / 1000);

    if (hoursEl)   hoursEl.textContent   = String(hrs).padStart(2, "0");
    if (minutesEl) minutesEl.textContent = String(mins).padStart(2, "0");
    if (secondsEl) secondsEl.textContent = String(secs).padStart(2, "0");
  }

  function scheduleNextFrame(){
    // Use setInterval for 1s cadence; requestAnimationFrame only for immediate paint
    if (tickInterval) clearInterval(tickInterval);
    render(targetTime - now());
    tickInterval = setInterval(function(){
      var diff = targetTime - now();

      if (diff <= 0) {
        // Restart with the configured duration (looping behavior)
        targetTime = now() + totalMs;
        storage.setItem(storageKey, String(targetTime));
        storage.setItem(versionKey, currentVersion);
        diff = totalMs;
      }

      render(diff);
    }, 1000);
  }

  // Keep accurate when tab visibility changes or device wakes
  function handleVisibility(){
    if (!document.hidden) {
      // Recalculate against stored target to avoid drift
      var stored = storage.getItem(storageKey);
      if (stored) targetTime = parseInt(stored, 10);
      scheduleNextFrame();
    }
  }

  document.addEventListener("visibilitychange", handleVisibility);

  // Kick things off
  scheduleNextFrame();
})();
</script>
<!-- end snippet code -->

{% schema %} 
{
  "name": "Countdown Timer Pro 1",
  "settings": [
    {
      "type": "header",
      "content": "Font",
      "info": "Set the fonts for your section."
    },
    {
      "type": "checkbox",
      "id": "override_fonts",
      "label": "Enable Custom Fonts",
      "default": false,
      "info": "Toggle to enable or disable custom fonts for this section."
    },
    {
      "type": "header",
      "content": "Text",
      "info": "Configure the text settings for your countdown timer section."
    },
    {
      "type": "range",
      "id": "headline_spacing",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 15,
      "label": "Gap Between Texts and Timer",
      "info": "Set the spacing between the text elements and the countdown timer."
    },
    {
      "type": "range",
      "id": "label_size",
      "min": 10,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Labels Text Size (Desktop version)",
      "default": 16,
      "info": "Adjust the font size of the labels (Hours, Minutes, Seconds)."
    },
    {
      "type": "range",
      "id": "mobile_label_size",
      "min": 10,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Labels Text Size (Mobile version)",
      "default": 16,
      "info": "Set the font size for labels on mobile devices."
    },
    {
      "type": "header",
      "content": "Section Design",
      "info": "Configure the overall design and appearance of the countdown timer section."
    },
    {
      "type": "select",
      "id": "show_on_device",
      "label": "Show Section",
      "options": [
        { "value": "all", "label": "All Devices" },
        { "value": "mobile", "label": "Mobile Device Only" },
        { "value": "desktop", "label": "Desktop Device Only" }
      ],
      "default": "all",
      "info": "Determine on which devices the countdown timer section should be displayed."
    },
    {
      "type": "color",
