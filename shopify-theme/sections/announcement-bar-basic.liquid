{% comment %}
  Announcement Bar Section
  This section creates a customizable announcement bar at the top of your Shopify store.
{% endcomment %}

<section
  id="announcement-bar"
  class="unique-announcement-bar"
  style="
    background: {% if section.settings.background_type == 'solid' %}
                 {{ section.settings.background_color }};
               {% elsif section.settings.background_type == 'gradient' %}
                 linear-gradient({{ section.settings.gradient_angle }}deg, {{ section.settings.gradient_start_color }}, {{ section.settings.gradient_end_color }});
               {% endif %};
    color: {{ section.settings.text_color }};
  "
>
  <style>
    /* Scoped CSS for Announcement Bar */
    /* Import Custom Font if Enabled */
    {% if section.settings.enable_custom_font %}
      @import url('https://fonts.googleapis.com/css2?family={{ section.settings.custom_font | replace: ' ', '+' }}&display=swap');
    {% endif %}

    /* Base Styles */
    #announcement-bar.unique-announcement-bar {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 20px;
      box-sizing: border-box;
      transition: all 0.3s ease;
      text-align: center;
      flex-wrap: wrap;
      font-family: {% if section.settings.enable_custom_font %}"{{ section.settings.custom_font }}"{% else %}inherit{% endif %};
      {% if section.settings.enable_custom_font and section.settings.font_weight %}
        font-weight: {{ section.settings.font_weight }};
      {% endif %}
    }
    #announcement-bar.unique-announcement-bar a {
      color: {{ section.settings.text_color }};
      text-decoration: none;
    }
    #announcement-bar.unique-announcement-bar a:hover {
      text-decoration: underline;
    }
    #announcement-bar.unique-announcement-bar .close-button {
      position: absolute;
      right: 20px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      color: {{ section.settings.text_color }};
      font-size: 20px;
      cursor: pointer;
      padding: 0;
      line-height: 1;
      z-index: 1;
    }

    /* Display Section On Settings */
    {% case section.settings.display_section_on %}
      {% when 'display_none' %}
        #announcement-bar.unique-announcement-bar {
          display: none;
        }
      {% when 'display_only_desktop' %}
        /* Hide on Mobile */
        @media (max-width: 767px) {
          #announcement-bar.unique-announcement-bar {
            display: none;
          }
        }
      {% when 'display_mobile' %}
        /* Hide on Desktop */
        @media (min-width: 768px) {
          #announcement-bar.unique-announcement-bar {
            display: none;
          }
        }
      {% when 'display_all' %}
        /* Display on All Devices */
    {% endcase %}

    /* Desktop Styles */
    @media (min-width: 768px) {
      #announcement-bar.unique-announcement-bar {
        height: {{ section.settings.bar_height }}px;
        font-size: {{ section.settings.font_size }}px;
      }
      #announcement-bar.unique-announcement-bar .mobile-message {
        display: none;
      }
      #announcement-bar.unique-announcement-bar .desktop-message {
        display: block;
      }
    }

    /* Mobile Styles */
    @media (max-width: 767px) {
      #announcement-bar.unique-announcement-bar {
        height: {{ section.settings.mobile_bar_height }}px;
        font-size: {{ section.settings.mobile_font_size }}px;
        padding: 15px 10px;
        flex-direction: row;
        align-items: center;
        justify-content: center;
      }
      #announcement-bar.unique-announcement-bar .close-button {
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
      }
      #announcement-bar.unique-announcement-bar a,
      #announcement-bar.unique-announcement-bar span {
        text-align: center;
        flex: 1;
      }

      {% if section.settings.show_close_button_mobile %}
        #announcement-bar.unique-announcement-bar .close-button {
          display: block;
        }
      {% else %}
        #announcement-bar.unique-announcement-bar .close-button {
          display: none;
        }
      {% endif %}

      #announcement-bar.unique-announcement-bar .mobile-message {
        display: none;
      }
      {% if section.settings.message_mobile != blank %}
        #announcement-bar.unique-announcement-bar .mobile-message {
          display: block;
        }
        #announcement-bar.unique-announcement-bar .desktop-message {
          display: none;
        }
      {% endif %}
    }
  </style>

  <!-- Announcement Messages -->
  {% if section.settings.message_mobile != blank %}
    <a
      href="{{ section.settings.link }}"
      class="desktop-message"
      {% if section.settings.open_in_new_tab %} target="_blank"{% endif %}
    >
      {{ section.settings.message }}
    </a>
    <span class="mobile-message">
      {{ section.settings.message_mobile }}
    </span>
  {% else %}
    {% if section.settings.display_section_on != 'display_mobile' %}
      {% if section.settings.link != blank %}
        <a
          href="{{ section.settings.link }}"
          class="desktop-message"
          {% if section.settings.open_in_new_tab %} target="_blank"{% endif %}
        >
          {{ section.settings.message }}
        </a>
      {% else %}
        <span class="desktop-message">
          {{ section.settings.message }}
        </span>
      {% endif %}
    {% endif %}
  {% endif %}

  <!-- Close Button -->
  {% if section.settings.show_close_button %}
    <button class="close-button" aria-label="Close">&times;</button>
  {% endif %}

  <!-- Updated Scoped JavaScript -->
  <script>
    (function() {
      document.addEventListener('DOMContentLoaded', function() {
        var announcementBar = document.getElementById('announcement-bar');
        if (!announcementBar) return;

        // If closed flag exists and is still valid, hide bar immediately
        var closedUntil = localStorage.getItem('announcementBarClosedUntil');
        if (closedUntil && Date.now() < parseInt(closedUntil, 10)) {
          announcementBar.style.display = 'none';
          return;
        }

        var closeButton = announcementBar.querySelector('.close-button');
        if (closeButton) {
          closeButton.addEventListener('click', function() {
            // Hide the bar and set expiry for 1 day
            announcementBar.style.display = 'none';
            var expireTime = Date.now() + 24 * 60 * 60 * 1000; // now + 1 day
            localStorage.setItem('announcementBarClosedUntil', expireTime);
          });
        }
      });
    })();
  </script>
</section>

