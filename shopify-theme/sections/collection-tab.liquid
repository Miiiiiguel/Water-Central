

{%- liquid
  assign st = section.settings
  assign section_width = st.section_width
  assign color_scheme = st.color_scheme
  if st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif

  assign heading = st.heading
  assign subheading = st.subheading

  if st.items_per_row_mobile > 1 and st.items_per_row_mobile < 2
    assign data_free_scroll = 'true'
  endif

  assign display_mode = st.display_mode
  assign items_to_show = st.items_to_show
  assign items_per_row = st.items_per_row
  assign column_gap = st.column_gap
    assign tab_checked_border_thickness = st.tab_checked_border_thickness
assign tab_unchecked_border_thickness = st.tab_unchecked_border_thickness
assign tab_checked_border_color = st.tab_checked_border_color
assign tab_unchecked_border_color = st.tab_unchecked_border_color
  assign show_arrow = st.show_arrow
  assign carousel_pagination = st.pagination
  assign infinite = st.infinite
  assign autoplay = st.autoplay
  assign autorotate_speed = st.autorotate_speed
  assign reveal = st.reveal
  assign rows = st.rows
  assign show_load_more_button = st.show_load_more_button
  assign button_label = st.button_label
  assign items_per_row_mobile = st.items_per_row_mobile
  assign scroll_animation = st.scroll_animation
  assign rows_mobile = st.rows_mobile

  assign tab_switch_animation = st.tab_switch_animation
  assign tab_unchecked_bg_color = st.tab_unchecked_bg_color
  assign tab_checked_bg_color = st.tab_checked_bg_color
  assign tab_unchecked_text_color = st.tab_unchecked_text_color
  assign tab_checked_text_color = st.tab_checked_text_color
  assign tab_border_radius = st.tab_border_radius
  assign tab_font_size = st.tab_font_size

  assign heading_font_size_desktop = st.heading_font_size_desktop
  assign heading_font_size_mobile = st.heading_font_size_mobile
  assign enable_custom_font_weight_heading = st.enable_custom_font_weight_heading
  assign font_weight_heading = st.font_weight_heading
  assign content_alignment = st.content_alignment

  assign subheading_font_size_desktop = st.subheading_font_size_desktop
  assign subheading_font_size_mobile = st.subheading_font_size_mobile
  assign enable_custom_font_weight_subheading = st.enable_custom_font_weight_subheading
  assign font_weight_subheading = st.font_weight_subheading
  assign subheading_color = st.subheading_color

  assign vertical_gap_heading_subheading = st.vertical_gap_heading_subheading
  assign vertical_gap_subheading_section_desktop = st.vertical_gap_subheading_section_desktop
  assign vertical_gap_subheading_section_mobile = st.vertical_gap_subheading_section_mobile
  assign subheading_padding_left_right_desktop = st.subheading_padding_left_right_desktop
  assign subheading_padding_left_right_mobile = st.subheading_padding_left_right_mobile

  assign gap_product_cards_dots = st.gap_product_cards_dots

  assign desktop_arrows = st.desktop_arrows
-%}

{%- capture style -%}
  /* Section spacing variables */
  --section-pt: {{ st.padding_top }};
  --section-pb: {{ st.padding_bottom }};
{%- endcapture -%}

{%- capture col_style -%}
  --col-desktop: {{ items_per_row }};
  --col-number:  {{ items_per_row_mobile }};

  {% if items_per_row > 3 %}
    --col-tablet: 3;
  {% else %}
    --col-tablet: {{ items_per_row }};
  {% endif %}

  {% if column_gap < 15 %}
    --col-gap: {{ column_gap }}px;
  {% else %}
    --col-gap: 15px;
    --col-gap-desktop: {{ column_gap }}px;
  {% endif %}

  --repeat: {{ items_to_show }};
  --col-mobile: {{ items_per_row_mobile }};
{%- endcapture -%}

{%- style -%}
  /* -------------------------------------------------------
     2. Basic Tab Content Defaults
     ------------------------------------------------------- */
  .collection-tab__tab-content {
    transform: translateY(30px);
    -webkit-transform: translateY(30px);
    transition: all 0.3s ease;
  }
  .collection-tab__tab-content.active {
    opacity: 1;
    visibility: visible;
    position: relative;
    transform: translateY(0);
    pointer-events: auto;
  }
  .collection-tab__ta {
    margin-bottom: 20px !important; /* Adjust this value as needed */
  }
  /* -------------------------------------------------------
     3. Tab Items (Un/Checked) + Font Size + Radius
     ------------------------------------------------------- */
  .collection-tab__tab-item {
   background-color: var(--tab-unchecked-bg, transparent) !important;
  color: var(--tab-unchecked-text, inherit) !important;
  font-size: var(--tab-font-size, 14px) !important;
  padding-top: 8px !important;
  padding-bottom: 8px !important;
  padding-left: 28px !important;
  padding-right: 28px !important;
  border-radius: var(--tab-border-radius, 0px) !important;
  border: var(--tab-unchecked-border-thickness, 0px) solid var(--tab-unchecked-border-color, #000000) !important;
  }
  .collection-tab__tab-item.active {
    background-color: var(--tab-checked-bg, #000000) !important;
  color: var(--tab-checked-text, #ffffff) !important;
  font-size: var(--tab-font-size, 14px) !important;
  border: var(--tab-checked-border-thickness, 0px) solid var(--tab-checked-border-color, #000000) !important;
  }
  .collection-tab__ta {
    scrollbar-width: none; /* For Firefox */
    -ms-overflow-style: none; /* For IE and Edge */
  }

  .collection-tab__ta::-webkit-scrollbar {
    display: none; /* For Chrome, Safari, and Opera */
  }
  /* -------------------------------------------------------
     4. Tab Switching Animations
        Note: "default" vs. "none" vs. "fade" are new naming
        plus older "fade-in", "fade-out", etc. + new extras
     ------------------------------------------------------- */

  /* Default (the old 'none' behavior) */
  .collection-tab__tab-content.tab-anim-default {
    /* matches original transform & transitions above */
  }

  /* None (no animation at all) */
  .collection-tab__tab-content.tab-anim-none {
    transition: none !important;
    transform: none !important;
  }
  .collection-tab__tab-content.tab-anim-none.active {
    opacity: 1;
    visibility: visible;
  }

  /* Fade (simple fade) */
  .collection-tab__tab-content.tab-anim-fade {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease;
  }
  .collection-tab__tab-content.tab-anim-fade.active {
    opacity: 1;
    visibility: visible;
  }

  /* Fade In */
  .collection-tab__tab-content.tab-anim-fade-in {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease-in-out;
  }
  .collection-tab__tab-content.tab-anim-fade-in.active {
    opacity: 1;
    visibility: visible;
  }

  /* Fade Out */
  .collection-tab__tab-content.tab-anim-fade-out {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.4s ease-in-out;
  }
  .collection-tab__tab-content.tab-anim-fade-out.active {
    opacity: 1;
    visibility: visible;
  }

  /* Slide Up */
  .collection-tab__tab-content.tab-anim-slide-up {
    transform: translateY(20px);
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s ease-in-out;
  }
  .collection-tab__tab-content.tab-anim-slide-up.active {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }

  /* Slide Down */
  .collection-tab__tab-content.tab-anim-slide-down {
    transform: translateY(-20px);
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s ease-in-out;
  }
  .collection-tab__tab-content.tab-anim-slide-down.active {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }

  /* Zoom In */
  .collection-tab__tab-content.tab-anim-zoom-in {
    transform: scale(0.9);
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s ease-in-out;
  }
  .collection-tab__tab-content.tab-anim-zoom-in.active {
    transform: scale(1);
    opacity: 1;
    visibility: visible;
  }

  /* Zoom Out */
  .collection-tab__tab-content.tab-anim-zoom-out {
    transform: scale(1.1);
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s ease-in-out;
  }
  .collection-tab__tab-content.tab-anim-zoom-out.active {
    transform: scale(1);
    opacity: 1;
    visibility: visible;
  }

  /* ---- 4 Additional Complex Animations ---- */

  /* Flip X */
  .collection-tab__tab-content.tab-anim-flip-x {
    transform: perspective(600px) rotateX(90deg);
    opacity: 0;
    visibility: hidden;
    transition: all 0.6s ease;
  }
  .collection-tab__tab-content.tab-anim-flip-x.active {
    transform: perspective(600px) rotateX(0deg);
    opacity: 1;
    visibility: visible;
  }

  /* Flip Y */
  .collection-tab__tab-content.tab-anim-flip-y {
    transform: perspective(600px) rotateY(90deg);
    opacity: 0;
    visibility: hidden;
    transition: all 0.6s ease;
  }
  .collection-tab__tab-content.tab-anim-flip-y.active {
    transform: perspective(600px) rotateY(0deg);
    opacity: 1;
    visibility: visible;
  }

  /* Rotate Left */
  .collection-tab__tab-content.tab-anim-rotate-left {
    transform: rotate(-90deg);
    opacity: 0;
    visibility: hidden;
    transition: all 0.6s ease;
  }
  .collection-tab__tab-content.tab-anim-rotate-left.active {
    transform: rotate(0deg);
    opacity: 1;
    visibility: visible;
  }

  /* Rotate Right */
  .collection-tab__tab-content.tab-anim-rotate-right {
    transform: rotate(90deg);
    opacity: 0;
    visibility: hidden;
    transition: all 0.6s ease;
  }
  .collection-tab__tab-content.tab-anim-rotate-right.active {
    transform: rotate(0deg);
    opacity: 1;
    visibility: visible;
  }

  /* -------------------------------------------------------
     New: Scroll Animation CSS (fully scoped to .workspace-section)
     ------------------------------------------------------- */
  .workspace-section.scroll-animation-fade-in {
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .workspace-section.scroll-animation-fade {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .workspace-section.scroll-animation-slide-in {
    opacity: 0;
    transform: translateX(-20px);
    transition: opacity 0.3s ease, transform 0.8s ease;
  }
  .workspace-section.scroll-animation-smooth-fade-up {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }

  /* Revealed states */
  .workspace-section.scroll-animation-fade-in.revealed,
  .workspace-section.scroll-animation-fade.revealed {
    opacity: 1;
  }
  .workspace-section.scroll-animation-slide-in.revealed {
    opacity: 1;
    transform: translateX(0);
  }
  .workspace-section.scroll-animation-smooth-fade-up.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* CSS Override for Theme Editor */
  .shopify-design-mode .workspace-section.scroll-animation-fade-in,
  .shopify-design-mode .workspace-section.scroll-animation-fade,
  .shopify-design-mode .workspace-section.scroll-animation-slide-in,
  .shopify-design-mode .workspace-section.scroll-animation-smooth-fade-up {
    opacity: 1 !important;
    transform: none !important;
  }

  /* New CSS for mobile-only dots and desktop-only arrows */
  @media (min-width: 768px) {
    .hidden-desktop {
      display: none !important;
    }
  }
  @media (max-width: 767px) {
    .desktop-only {
      display: none !important;
    }
  }

  /* -------- Placeholder card visual styles -------- */
  .sec__collection-tab .ph-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #fff;
    border-radius: 6px;
    overflow: hidden;
    height: 100%;
  }

  /* Soft tile background like the screenshot, but keep image clear */
  .sec__collection-tab .ph-media-wrap {
    background: #F6EFEA; /* light warm tile */
    border-radius: 6px;
    margin: 0;
    position: relative;
    overflow: hidden;
  }

  /* Instagram-style 4:5 image area */
  .sec__collection-tab .ph-media {
    width: 100%;
    aspect-ratio: 4 / 5;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Placeholder title (shown only when no collection selected) */
  .sec__collection-tab .ph-title {
    margin: 8px 6px 0;
    text-align: center;
    font-size: 14px;
    line-height: 1.35;
    color: #1b1b1b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Default spacing between slides uses your variables */
  .sec__collection-tab .swiper-wrapper {
    gap: var(--col-gap, 15px);
  }
  @media (min-width: 992px) {
    .sec__collection-tab .swiper-wrapper {
      gap: var(--col-gap-desktop, 15px);
    }
  }

  /* Tighter gap ONLY when placeholders are showing */
  .sec__collection-tab .placeholder-mode .swiper-wrapper,
  .sec__collection-tab .placeholder-mode .products-grid__items {
    gap: 10px;
  }
  @media (min-width: 992px) {
    .sec__collection-tab .placeholder-mode .swiper-wrapper,
    .sec__collection-tab .placeholder-mode .products-grid__items {
      gap: 16px;
    }
  }

  /* Heading and Subheading Styles */
  .section__header-heading {
    font-size: {{ heading_font_size_desktop }}px;
    font-weight: {% if enable_custom_font_weight_heading %}{{ font_weight_heading }}{% else %}inherit{% endif %};
  }
  .section__header-subheading {
    font-size: {{ subheading_font_size_desktop }}px;
    color: {{ subheading_color }};
    font-weight: {% if enable_custom_font_weight_subheading %}{{ font_weight_subheading }}{% else %}inherit{% endif %};
    margin-top: {{ vertical_gap_heading_subheading }}px;
    margin-bottom: {{ vertical_gap_subheading_section_desktop }}px;
    padding-left: {{ subheading_padding_left_right_desktop }}px;
    padding-right: {{ subheading_padding_left_right_desktop }}px;
    text-align: {{ content_alignment }};
  }

  @media (max-width: 767px) {
    .section__header-heading {
      font-size: {{ heading_font_size_mobile }}px;
    }
    .section__header-subheading {
      font-size: {{ subheading_font_size_mobile }}px;
      margin-bottom: {{ vertical_gap_subheading_section_mobile }}px;
      padding-left: {{ subheading_padding_left_right_mobile }}px;
      padding-right: {{ subheading_padding_left_right_mobile }}px;
    }
  }

  /* Gap between product cards and navigation dots */
  .sec__collection-tab .swiper-pagination {
    margin-top: {{ gap_product_cards_dots }}px;
  }
{%- endstyle -%}

<div
  id="section-{{ section.id }}"
  class="section workspace-section{% if st.padding_top < 30 %} pt-min{% endif %}{% if st.padding_bottom < 30 %} pb-min{% endif %} sec__collection-tab {% if show_load_more_button %}sec__products-loadmore{% endif %} color-{{ color_scheme }} gradient{{ reset_spacing }}{% if reveal %} overflow-hidden{% endif %}"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    {%- comment -%}
      ------------------------------------------------------
      5. If No Blocks, Show Only Heading (If Any)
      ------------------------------------------------------
    {%- endcomment -%}
    {% if section.blocks.size == 0 %}
      {% if heading != blank or subheading != blank %}
        <div
          class="
            section__header mb-30 mb-sm-20 text-{{ content_alignment }}
            {% if st.section_width == 'full_width' %} px-20{% endif %}
            {% if button_label != blank %} flex gap-15 flex-wrap justify-content-{{ content_alignment }}
              {% if content_alignment == 'right' %}
                flex-row-reverse
              {% endif %}
            {% endif %}
          "
        >
          {% if heading != blank %}
            <h2
              class="section__header-heading heading-letter-spacing {% if scroll_animation != 'none' %}scroll-trigger {{ scroll_animation }}{% endif %} mt-0 mb-0"
            >
              {{ heading }}
            </h2>
          {% endif %}
          {% if subheading != blank %}
            <p class="section__header-subheading mt-0 mb-0">
              {{ subheading }}
            </p>
          {% endif %}
        </div>
      {% endif %}
    {% endif %}

    {%- comment -%}
      ------------------------------------------------------
      6. If Blocks Exist, Render Tabs & Content
      ------------------------------------------------------
    {%- endcomment -%}
    {% if section.blocks.size > 0 %}
      <!-- Forced "horizontal" tab style, "fill" default -->
     <tab-items
  data-type="horizontal"
  style="
    --tab-unchecked-bg: {{ tab_unchecked_bg_color }};
    --tab-checked-bg: {{ tab_checked_bg_color }};
    --tab-unchecked-text: {{ tab_unchecked_text_color }};
    --tab-checked-text: {{ tab_checked_text_color }};
    --tab-border-radius: {{ tab_border_radius }}px;
    --tab-font-size: {{ tab_font_size }}px;
    --tab-checked-border-thickness: {{ tab_checked_border_thickness }}px;
    --tab-unchecked-border-thickness: {{ tab_unchecked_border_thickness }}px;
    --tab-checked-border-color: {{ tab_checked_border_color }};
    --tab-unchecked-border-color: {{ tab_unchecked_border_color }};
  "
>
        <div
          class="
            text-{{ content_alignment }}
            {% if scroll_animation != 'none' %}scroll-trigger {{ scroll_animation }}{% endif %}
            section__header mb-40 mb-sm-30
            {% if st.section_width == 'full_width' %} px-20{% endif %}
          "
          style="--animation-order: 2;"
        >
          <!-- Main Heading -->
          {% if heading != blank %}
            <div class="text-{{ content_alignment }}">
              <h2
                class="section__header-heading heading-letter-spacing mt-0 mb-0"
              >
                {{ heading }}
              </h2>
            </div>
          {% endif %}
          <!-- Subheading -->
          {% if subheading != blank %}
            <div class="text-{{ content_alignment }}">
              <p class="section__header-subheading mt-0 mb-0">
                {{ subheading }}
              </p>
            </div>
          {% endif %}

          <!-- Horizontal Tabs (fill style only) -->
          <div class="mt-30 inline-flex align-center max-w-100 collection-tab__ta overflow-auto gap-15 ">
            {% for block in section.blocks %}
              {% liquid
                assign block_st = block.settings
                assign col_title = block_st.collection_title
                if col_title == blank and block_st.collection != blank
                  assign temp_col = collections[block_st.collection]
                  if temp_col != blank
                    assign col_title = temp_col.title
                  endif
                endif
                if col_title == blank
                  assign col_title = 'Collection'
                endif
              %}
              <div
                data-block-id="{{ block.id }}"
                class="collection-tab__tab-item whitespace-nowrap pointer px-20 pb-8 transition text-center heading-style grey-bg btn-hover btn-rounded px-20 py-10 btn-active{% if forloop.first %} active{% endif %}"
              >
                {{ col_title }}
              </div>
            {% endfor %}
          </div>
        </div>

        {%- comment -%}
          ------------------------------------------------------
          7. TAB CONTENT: Grid or Carousel
          ------------------------------------------------------
        {%- endcomment -%}
        <div class="relative tab-content">
          {% if display_mode == 'grid' %}
            {%- comment -%} GRID MODE {%- endcomment -%}
            {% for block in section.blocks %}
              {% liquid
                assign block_st = block.settings
                assign collection_handle = block_st.collection
                assign all_products_to_show = 0
                assign all_product_visible = rows | times: items_per_row
                assign limit_products_paginate = 0
                if all_products_to_show >= all_product_visible
                  assign limit_products_paginate = all_product_visible
                else
                  assign limit_products_paginate = all_products_to_show
                endif
              %}
              {% if collection_handle != blank %}
                {% assign collection_obj = collections[collection_handle] %}
                {% if collection_obj != blank and collection_obj.products_count > 0 %}
                  {% liquid
                    assign all_products_to_show = 0
                    if collection_obj.products.size >= items_to_show
                      assign all_products_to_show = items_to_show
                    else
                      assign all_products_to_show = collection_obj.products.size
                    endif

                    assign all_product_visible = rows | times: items_per_row
                    assign limit_products_paginate = 0
                    if all_products_to_show >= all_product_visible
                      assign limit_products_paginate = all_product_visible
                    else
                      assign limit_products_paginate = all_products_to_show
                    endif
                  %}
                  {% if show_load_more_button %}
                    {%- paginate collection_obj.products by limit_products_paginate -%}
                      <div
                        class="
                          collection-tab__tab-content tab-anim-{{ tab_switch_animation }}
                          collection-tab-{{ block.id }}
                          absolute invisible inset-0 transition pointer-none
                          {% if forloop.first %} active{% endif %}
                        "
                        data-block-id="{{ block.id }}"
                      >
                        <grid-custom
                          class="swiper products-grid__items flex flex-cols{% if column_gap < 31 %} row-gap-20 row-gap-md-30{% endif %} product-ajax__append flex-wrap"
                          style="{{ col_style | strip | strip_newlines }}"
                          data-enable="false"
                          data-section-id="{{ section.id }}"
                          data-mobile="{{ items_per_row_mobile }}"
                          data-mobile-rows="{{ rows_mobile }}"
                          data-spacing="{{ column_gap }}"
                          data-free-scroll="{{ data_free_scroll }}"
                        >
                          {% for product in collection_obj.products %}
                            {% render 'product-item',
                              card_product: product,
                              container: section_width,
                              colunm: items_per_row,
                              colunm_mobile: items_per_row_mobile,
                              padding: column_gap,
                              scroll_animation: scroll_animation,
                              section_id: section.id,
                              class: 'grid-custom-item',
                              template_enable_action: true,
                              template_enable_product_vendor: true,
                              template_enable_rate: true,
                              template_enable_product_short_description: true,
                              template_enable_color_swatches: true,
                              template_enable_price: true,
                              template_enable_add_cart: true,
                              indexFor: forloop.index,
                              template_enable_product_badges: true
                            %}
                          {% endfor %}
                        </grid-custom>

                        {% if button_label != blank and all_products_to_show > all_product_visible %}
                          <loadmore-function
                            data-all-products="{{ all_products_to_show }}"
                            data-section-id="{{ section.id }}"
                            data-limit="{{ limit_products_paginate }}"
                            data-collection-url="{{ collection_obj.url }}"
                            data-url="?page={{ paginate.current_page | plus: 1 }}"
                            class="block text-center mt-25 w-full col-md-w-custom"
                            style="--col-width: 100%"
                            data-block-id="{{ block.id }}"
                          >
                            <button class="btn-{% if st.use_outline_button_style %}outline{% else %}primary{% endif %} load-more relative">
                              <span class="hidden-on-load">{{ button_label }}</span>
                              <svg
                                width="14"
                                height="14"
                                viewBox="0 0 14 14"
                                fill="none"
                                class="spin opacity-0 icon-load"
                              >
                                <use href="#icon-load"></use>
                              </svg>
                            </button>
                          </loadmore-function>
                        {% endif %}
                      </div>
                      {%- if paginate.pages > 1 -%}{% endif %}
                    {% endpaginate %}
                  {% else %}
                    <div
                      class="
                        collection-tab__tab-content tab-anim-{{ tab_switch_animation }}
                        absolute invisible inset-0 transition pointer-none
                        {% if forloop.first %} active{% endif %}
                      "
                      data-block-id="{{ block.id }}"
                    >
                      <grid-custom
                        class="swiper products-grid__items flex flex-cols{% if column_gap < 31 %} row-gap-20 row-gap-md-30{% endif %} flex-md-wrap placeholder-mode"
                        style="{{ col_style | strip | strip_newlines }}"
                        data-enable="false"
                        data-mobile="{{ items_per_row_mobile }}"
                        data-mobile-rows="{{ rows_mobile }}"
                        data-spacing="{{ column_gap }}"
                        data-free-scroll="{{ data_free_scroll }}"
                      >
                        {%- assign placeholder_count = 4 -%}
                        {%- for i in (1..placeholder_count) -%}
                          <div class="grid-custom-item">
                            <div class="ph-card">
                              <div class="ph-media-wrap">
                                <div
                                  class="ph-media"
                                  style="background-image:url('https://artistintelligence.org/wp-content/uploads/2015/08/import_placeholder.png');"
                                  role="img"
                                  aria-label="Product Placeholder"
                                ></div>
                              </div>
                              <!-- Single placeholder title only when no collection is selected -->
