<!-- Fully scoped JavaScript for Scroll Animation -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Use the unique section ID for scoping
    var section = document.getElementById('section-{{ section.id }}');
    if (section) {
      var animation = '{{ section.settings.scroll_animation }}';
      // In Theme Editor, always show section fully revealed
      if (document.body.classList.contains('shopify-design-mode')) {
        section.classList.add('revealed');
      } else if (animation && animation !== 'none') {
        // Add the scroll animation class (e.g. scroll-animation-fade-in)
        section.classList.add('scroll-animation-' + animation);
        var observer = new IntersectionObserver(function(entries, observer) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              section.classList.add('revealed');
              observer.unobserve(section);
            }
          });
        }, { threshold: 0.15 });
        observer.observe(section);
      }
    }
  });
</script>

