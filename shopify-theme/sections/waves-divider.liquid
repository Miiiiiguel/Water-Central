{%- liquid
  assign padding_horizontal = section.settings.padding_horizontal
  assign padding_horizontal_mobile = section.settings.padding_horizontal_mobile
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign border_color = section.settings.border_color
  assign border_thickness = section.settings.border_thickness
  assign margin_top = section.settings.margin_top
  assign margin_bottom = section.settings.margin_bottom
  assign background_color = section.settings.background_color
  assign background_gradient = section.settings.background_gradient
  assign full_width = section.settings.full_width
  assign content_width = section.settings.content_width
  assign wave_height_mobile = section.settings.wave_height_mobile
  assign wave_height = section.settings.wave_height
  assign wave_color = section.settings.wave_color
  assign wave_rotate = section.settings.wave_rotate
  assign wave_variant = section.settings.wave_variant
  assign enable_second_color = section.settings.enable_second_color
  assign wave_color_2 = section.settings.wave_color_2
-%}

{%- liquid
  case wave_variant
    when 'curve'
      assign wave_path = 'M0,50 C 25,0 75,100 100,50 L100,100 L0,100 Z'
    when 'fan'
      assign wave_path = 'M0,100 L100,0 L100,100 Z'
    when 'curve-opacity'
      assign wave_path = 'M0,60 C 25,10 75,110 100,60 L100,100 L0,100 Z'
    when 'mountains'
      assign wave_path = 'M0,100 L20,40 L40,80 L60,20 L80,70 L100,100 Z'
    when 'curve-asym'
      assign wave_path = 'M0,60 C 15,10 85,90 100,40 L100,100 L0,100 Z'
    when 'curve-asym-alt'
      assign wave_path = 'M0,40 C 15,90 85,10 100,60 L100,100 L0,100 Z'
    when 'tilt'
      assign wave_path = 'M0,0 L100,20 L100,100 L0,100 Z'
    when 'tilt-alt'
      assign wave_path = 'M0,20 L100,0 L100,100 L0,100 Z'
    when 'triangle'
      assign wave_path = 'M0,100 L50,0 L100,100 Z'
    when 'waves'
      assign wave_path = 'M0,50 C 25,40 25,60 50,50 C 75,40 75,60 100,50 L100,100 L0,100 Z'
    when 'waves-opacity'
      assign wave_path = 'M0,50 C 25,30 25,70 50,50 C 75,30 75,70 100,50 L100,100 L0,100 Z'
    when 'waves-opacity2'
      assign wave_path = 'M0,50 C 20,40 40,60 60,50 C 80,40 80,60 100,50 L100,100 L0,100 Z'
    when 'clouds'
      assign wave_path = 'M0,70 C 15,70 15,40 35,40 C 55,40 55,70 75,70 C 95,70 95,40 100,40 L100,100 L0,100 Z'
    when 'speech'
      assign wave_path = 'M0,30 C0,0 100,0 100,30 L100,60 C100,80 80,80 70,90 L60,100 40,80 0,80 Z'
    when 'blob'
      assign wave_path = 'M0,50 C20,30 80,70 100,50 L100,100 L0,100 Z'
    when 'arch'
      assign wave_path = 'M0,50 C10,10 90,10 100,50 L100,100 L0,100 Z'
    when 'arch-alt'
      assign wave_path = 'M0,50 C10,90 90,90 100,50 L100,100 L0,100 Z'
    when 'drops'
      assign wave_path = 'M0,50 C20,20 20,80 50,50 C80,20 80,80 100,50 L100,100 L0,100 Z'
    when 'drops-alt'
      assign wave_path = 'M0,50 C15,25 35,75 50,50 C65,25 85,75 100,50 L100,100 L0,100 Z'
    when 'wave-slope'
      assign wave_path = 'M0,50 C25,10 75,90 100,50 L100,100 L0,100 Z'
    when 'wave-slope-alt'
      assign wave_path = 'M0,50 C25,90 75,10 100,50 L100,100 L0,100 Z'
    when 'slant'
      assign wave_path = 'M0,30 L100,70 L100,100 L0,100 Z'
    when 'slant-alt'
      assign wave_path = 'M0,70 L100,30 L100,100 L0,100 Z'
    when 'peak'
      assign wave_path = 'M0,100 L20,30 L50,0 L80,30 L100,100 Z'
    else
      assign wave_path = 'M0,50 C 25,0 75,100 100,50 L100,100 L0,100 Z'
  endcase
-%}

{%- style -%}
  /* --- Begin Scoped CSS --- */
  /* The styles below use the unique wrapper ID (#waves-divider-{{ section.id }})
     to ensure that they only apply to this instance of the wave divider */
  #waves-divider-{{ section.id }} {
    border-top: solid {{ border_color }} {{ border_thickness }}px;
    border-bottom: solid {{ border_color }} {{ border_thickness }}px;
    margin-top: {{ margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ margin_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ background_color }};
    background-image: {{ background_gradient }};
  }

  #waves-divider-{{ section.id }} .section-{{ section.id }}-settings {
    margin: 0 auto;
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ padding_horizontal_mobile }}rem;
    padding-right: {{ padding_horizontal_mobile }}rem;
  }

  #waves-divider-{{ section.id }} .wave-item-{{ section.id }} svg {
    color: {{ wave_color }};
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
    max-height: {{ wave_height_mobile }}px;
  }

  #waves-divider-{{ section.id }} .wave-parallax2-{{ section.id }} > use {
    opacity: 0.4;
  }
  #waves-divider-{{ section.id }} .wave-parallax3-{{ section.id }} > use {
    opacity: 0.3;
  }
  #waves-divider-{{ section.id }} .wave-parallax4-{{ section.id }} > use {
    opacity: 0.2;
  }

  @media(min-width: 1024px) {
    #waves-divider-{{ section.id }} {
      margin-top: {{ margin_top }}px;
      margin-bottom: {{ margin_bottom }}px;
    }
    #waves-divider-{{ section.id }} .section-{{ section.id }}-settings {
      padding: 0 5rem;
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
      padding-left: {{ padding_horizontal }}rem;
      padding-right: {{ padding_horizontal }}rem;
    }
    #waves-divider-{{ section.id }} .wave-item-{{ section.id }} svg {
      max-height: {{ wave_height }}px;
    }
  }
  /* --- End Scoped CSS --- */
{%- endstyle -%}

{% unless full_width %}
  <style>
    /* --- Begin Scoped CSS for Content Width --- */
    #waves-divider-{{ section.id }} .section-{{ section.id }}-settings {
      max-width: {{ content_width }}rem;
    }
    /* --- End Scoped CSS for Content Width --- */
  </style>
{% endunless %}

{% if wave_rotate %}
  <style>
    /* --- Begin CSS for Wave Rotation --- */
    #waves-divider-{{ section.id }} .wave-item-{{ section.id }} {
      transform: rotate(180deg);
    }
    /* --- End CSS for Wave Rotation --- */
  </style>
{% endif %}

<div id="waves-divider-{{ section.id }}" class="waves-divider-wrapper section-{{ section.id }} wave-{{ section.id }}">
  <div class="section-{{ section.id }}-settings">
    <div class="wave-item-{{ section.id }}">
      <svg class="waves-animated-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" preserveAspectRatio="none">
        <defs>
          <path id="modern-wave-{{ section.id }}" d="{{ wave_path }}"></path>
        </defs>
        <!-- Wave Layer 1 (always uses primary wave color) -->
        <g class="wave-parallax1-{{ section.id }}">
          <use xlink:href="#modern-wave-{{ section.id }}" x="0" y="0" fill="{{ wave_color }}"></use>
        </g>
        <!-- Wave Layer 2 (uses secondary color if enabled) -->
        <g class="wave-parallax2-{{ section.id }}">
          <use xlink:href="#modern-wave-{{ section.id }}" x="0" y="5" fill="{% if enable_second_color %}{{ wave_color_2 }}{% else %}{{ wave_color }}{% endif %}"></use>
        </g>
        <!-- Wave Layer 3 (always uses primary wave color) -->
        <g class="wave-parallax3-{{ section.id }}">
          <use xlink:href="#modern-wave-{{ section.id }}" x="0" y="10" fill="{{ wave_color }}"></use>
        </g>
        <!-- Wave Layer 4 (uses secondary color if enabled) -->
        <g class="wave-parallax4-{{ section.id }}">
          <use xlink:href="#modern-wave-{{ section.id }}" x="0" y="15" fill="{% if enable_second_color %}{{ wave_color_2 }}{% else %}{{ wave_color }}{% endif %}"></use>
        </g>
      </svg>
    </div>
  </div>
</div>

