        { "value": "curve-opacity", "label": "Faded Curve" },
        { "value": "mountains", "label": "Mountain Range" },
        { "value": "curve-asym", "label": "Asymmetric Curve" },
        { "value": "curve-asym-alt", "label": "Alternate Asymmetric Curve" },
        { "value": "tilt", "label": "Tilted Edge" },
        { "value": "tilt-alt", "label": "Alternate Tilt" },
        { "value": "triangle", "label": "Triangular" },
        { "value": "waves", "label": "Double Wave" },
        { "value": "waves-opacity", "label": "Faded Double Wave" },
        { "value": "waves-opacity2", "label": "Subtle Double Wave" },
        { "value": "clouds", "label": "Cloudy Wave" },
        { "value": "speech", "label": "Speech Bubble" },
        { "value": "blob", "label": "Blob Shape" },
        { "value": "arch", "label": "Arch" },
        { "value": "arch-alt", "label": "Alternate Arch" },
        { "value": "drops", "label": "Water Drops" },
        { "value": "drops-alt", "label": "Alternate Drops" },
        { "value": "wave-slope", "label": "Sloped Wave" },
        { "value": "wave-slope-alt", "label": "Alternate Sloped Wave" },
        { "value": "slant", "label": "Slanted Edge" },
        { "value": "slant-alt", "label": "Alternate Slanted Edge" },
        { "value": "peak", "label": "Peak Shape" }
      ],
      "info": "Select the style of the wave divider from the available options."
