      "default": 0,
      "info": "Determines the left/right padding for desktop view."
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 15,
      "step": 0.5,
      "unit": "rem",
      "label": "Side Padding (Mobile)",
      "default": 0,
      "info": "Determines the left/right padding for mobile view."
