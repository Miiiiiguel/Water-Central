{% style %}
  .loudecomz-faq-wrapper .ecomss-faq-answer a {
    color: inherit;
    text-decoration: inherit;
  }

  .loudecomz-faq-wrapper .ecomss-faq-shopify-section {
    margin-bottom: 50px;
  }

  /* FAQ container */
  .loudecomz-faq-wrapper .ecomss-faq-container {
    margin: auto;
    max-width: 1000px;
    margin-top: 20px;
  }

  /* FAQ item wrapper */
  .loudecomz-faq-wrapper .ecomss-faq-container-item {
    margin-bottom: 10px;
    overflow: hidden;
    border-radius: {{ section.settings.question_border_radius }}px;
  }

  /* Question styling */
  .loudecomz-faq-wrapper .ecomss-faq-question {
    display: flex !important;
    justify-content: space-between;
    align-items: center;

    {% if section.settings.enable_question_gradient %}
      background: linear-gradient(
        {{ section.settings.gradient_degrees }},
        {{ section.settings.gradient_color_1 }},
        {{ section.settings.gradient_color_2 }},
        {{ section.settings.gradient_color_3 }}
      );
    {% else %}
      background-color: {{ section.settings.background_color }};
    {% endif %}

    padding: 15px 20px;
    color: {{ section.settings.question_text_color_custom }};
    font-size: {{ section.settings.question_font_size_desktop }}rem;
    font-weight: {{ section.settings.question_font_weight }};
    border: {{ section.settings.question_border_thickness }}px solid {{ section.settings.question_border_color }};
    border-radius: {{ section.settings.question_border_radius }}px;
    transition: background .3s ease, color .3s ease, box-shadow .3s ease;
    cursor: pointer;
    position: relative;
  }

  /* Icon arrow */
  .loudecomz-faq-wrapper .ecomss-faq-question::after {
    color: {{ section.settings.icon_color }};
    content: '\276F';
    display: inline-block;
    transform: rotate(0deg);
    transition: transform .36s cubic-bezier(.22,.61,.36,1);
    margin-left: 12px;
  }

  /* Hover on question */
  .loudecomz-faq-wrapper .ecomss-faq-question:hover {
    color: {{ section.settings.hover_color }};
  }

  /* Answer container (animated with JS via max-height) */
  .loudecomz-faq-wrapper .ecomss-faq-answer {
    padding: 0 20px;
    position: relative;
    width: 100%;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      max-height .42s cubic-bezier(.22,.61,.36,1),
      opacity .36s ease,
      transform .36s ease,
      visibility 0s linear .42s;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;

    color: {{ section.settings.answer_text_color_custom }};
    background-color: {{ section.settings.answer_bg_color }};
    text-align: left;
    font-size: {{ section.settings.answer_font_size_desktop }}rem;
    font-weight: {{ section.settings.answer_font_weight }};
  }

  /* Active (JS toggles this class) */
  .loudecomz-faq-wrapper .ecomss-faq-container-item.is-open .ecomss-faq-answer {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
    transition:
      max-height .42s cubic-bezier(.22,.61,.36,1),
      opacity .36s ease,
      transform .36s ease,
      visibility 0s;
  }
  .loudecomz-faq-wrapper .ecomss-faq-container-item.is-open .ecomss-faq-question::after {
    transform: rotate(90deg);
  }

  /* Mobile Styles */
  @media screen and (max-width: 767px) {
    {% for block in section.blocks %}
      {% if block.type == "heading" %}
        .loudecomz-faq-wrapper h1[block-id="{{ block.id }}"] {
          font-size: {{ block.settings.font_size_mobile }}rem !important;
        }
      {% endif %}
    {% endfor %}
    .loudecomz-faq-wrapper .badge-pill {
      font-size: {{ section.settings.badge_font_size_mobile }}rem;
    }
    .loudecomz-faq-wrapper .ecomss-faq-question {
      font-size: {{ section.settings.question_font_size_mobile }}rem;
    }
    .loudecomz-faq-wrapper .ecomss-faq-answer {
      font-size: {{ section.settings.answer_font_size_mobile }}rem;
    }
    .loudecomz-faq-wrapper .ecomss-faq-shopify-section {
      padding-top: {{ section.settings.section_top_padding_mobile }}px !important;
      padding-bottom: {{ section.settings.section_bottom_padding_mobile }}px !important;
    }
  }
{% endstyle %}

<script>
  (function(){
    var root = document.currentScript.parentElement;
    if(!root) return;

    var items = root.querySelectorAll('.ecomss-faq-container-item');
    items.forEach(function(item){
      var input = item.querySelector('.tab-toggle');
      var label = item.querySelector('.ecomss-faq-question');
      var answer = item.querySelector('.ecomss-faq-answer');

      // Set initial ARIA state
      label.setAttribute('aria-expanded', 'false');
      answer.setAttribute('aria-hidden', 'true');

      // Progressive enhancement: smooth height animation
      function openItem(){
        item.classList.add('is-open');
        answer.style.maxHeight = answer.scrollHeight + 'px';
        label.setAttribute('aria-expanded', 'true');
        answer.setAttribute('aria-hidden', 'false');
      }
      function closeItem(){
        // set explicit height to current to enable reverse animation
        answer.style.maxHeight = answer.scrollHeight + 'px';
        // force reflow so the next line transitions
        answer.offsetHeight; // eslint-disable-line no-unused-expressions
        item.classList.remove('is-open');
        answer.style.maxHeight = '0px';
        label.setAttribute('aria-expanded', 'false');
        answer.setAttribute('aria-hidden', 'true');
      }

      // Sync with checkbox (kept intact from your structure)
      function syncToCheckbox(){
        if(input.checked){ openItem(); }
        else{ closeItem(); }
      }
      syncToCheckbox();

      // Toggle on label click (prevents awkward double-tap on iOS)
      label.addEventListener('click', function(e){
        e.preventDefault();
        input.checked = !input.checked;
        syncToCheckbox();
      });

      // Keyboard: Enter/Space on label for accessibility
      label.addEventListener('keydown', function(e){
        if(e.key === 'Enter' || e.key === ' '){
          e.preventDefault();
          input.checked = !input.checked;
          syncToCheckbox();
        }
      });
    });

    // Single debounced resize listener (prevents N×resize memory leak)
    var resizeTimer;
    window.addEventListener('resize', function(){
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function(){
        items.forEach(function(item){
          if(item.classList.contains('is-open')){
            var ans = item.querySelector('.ecomss-faq-answer');
            if(ans) ans.style.maxHeight = ans.scrollHeight + 'px';
          }
        });
      }, 100);
    });
  })();
</script>