<div class="loudecomz-faq-wrapper">
  <div
    class="ecomss-faq-shopify-section"
    style="
      padding-top: {{ section.settings.section_top_padding }}px;
      padding-bottom: {{ section.settings.section_bottom_padding }}px;
      padding-left: {{ section.settings.section_left_padding_desktop }}px;
      padding-right: {{ section.settings.section_right_padding_desktop }}px;
      background-color: {{ section.settings.section_background_color }};
    "
  >
    {% if section.settings.enable_badge %}
      <div class="badge-wrapper" style="text-align: center; margin-bottom: {{ section.settings.badge_vertical_spacing }}px;">
        <a {% if section.settings.badge_link != blank %}href="{{ section.settings.badge_link }}"{% endif %} class="badge-pill" style="
          font-size: {{ section.settings.badge_font_size_desktop }}rem;
          font-weight: {{ section.settings.badge_font_weight }};
          color: {{ section.settings.badge_text_color }};
          background-color: {{ section.settings.badge_bg_color }};
          border: 1px solid {{ section.settings.badge_border_color }};
          border-radius: {{ section.settings.badge_border_radius }}px;
          padding: 8px 20px;
          display: inline-block;
          text-decoration: none;
        ">
          {{ section.settings.badge_text }}
        </a>
      </div>
    {% endif %}

    {% for block in section.blocks %}
      {% if block.type == "heading" %}
        <h1 block-id="{{ block.id }}" style="
          color: {{ block.settings.text_color }} !important;
          font-weight: {{ block.settings.font_weight }};
          font-size: {{ block.settings.font_size_desktop }}rem;
          margin-bottom: {{ block.settings.vertical_spacing }}px;
          text-align: center;
        ">
          {{ block.settings.heading }}
        </h1>
      {% endif %}
    {% endfor %}

    <div class="ecomss-faq-container" role="list">
      {% for block in section.blocks %}
        {% if block.type == "text" %}
          {% assign _uid = forloop.index | prepend: '-' | prepend: section.id %}
          <div class="ecomss-faq-container-item" role="listitem">
            <!-- Hidden checkbox that toggles each Q&A open/closed -->
            <input style="display:none!important;" type="checkbox" id="tab{{ _uid }}" class="tab-toggle">
            <label for="tab{{ _uid }}" class="ecomss-faq-question" role="button" aria-controls="ans{{ _uid }}" aria-expanded="false">
              {{ block.settings.question }}
            </label>
            <div id="ans{{ _uid }}" class="ecomss-faq-answer" aria-hidden="true">
              {{ block.settings.answer }}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

