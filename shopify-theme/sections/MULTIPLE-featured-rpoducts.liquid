{% style %}
:root {
--loudz-neutral-100: #222;
--loudz-neutral-70: #5e5e5e;
--loudz-neutral-01: #fff;
--loudz-alpha-black-10: rgba(34, 34, 34, 0.1);
--loudz-size-0: 0px;
--loudz-size-1: 1px;
--loudz-size-2: 2px;
--loudz-size-4: 4px;
--loudz-size-6: 6px;
--loudz-size-8: 8px;
--loudz-size-12: 12px;
--loudz-size-14: 14px;
--loudz-size-16: 16px;
--loudz-size-20: 20px;
--loudz-size-24: 24px;
--loudz-size-32: 32px;
--loudz-size-40: 40px;
--loudz-font-weight-400: 400;
--loudz-font-weight-600: 600;
--loudz-line-height-140: 1.4;
--loudz-text-decoration-none: none;
--loudz-text-decoration-underline: underline;
--loudz-text-decoration-line-through: line-through;
--loudz-border-width-1: var(--loudz-size-1);
--loudz-color-bg-fill-default-on-light: var(--loudz-neutral-100);
--loudz-color-bg-fill-inverse-on-light: var(--loudz-neutral-01);
--loudz-color-text-default-on-light: var(--loudz-neutral-100);
--loudz-color-text-disable-on-light: var(--loudz-neutral-70);
--loudz-color-text-on-bg-fill-on-light: var(--loudz-neutral-01);
--loudz-color-border-hover-on-dark: var(--loudz-alpha-black-10);
--loudz-space-0: var(--loudz-size-0);
--loudz-space-2: var(--loudz-size-2);
--loudz-space-4: var(--loudz-size-4);
--loudz-space-6: var(--loudz-size-6);
--loudz-space-8: var(--loudz-size-8);
--loudz-space-12: var(--loudz-size-12);
--loudz-space-16: var(--loudz-size-16);
--loudz-space-20: var(--loudz-size-20);
--loudz-space-24: var(--loudz-size-24);
--loudz-space-32: var(--loudz-size-32);
--loudz-space-40: var(--loudz-size-40);
--loudz-font-size-14: var(--loudz-size-14);
}


{% endstyle %}

<!-- --UUID-32557de6-- -->

<section class="loudz-{{ section.id | handle }}">
	{%- capture card_has_bg_color -%}
		{%- case section.settings.product_card_background_color -%}
			{%- when '' or 'rgba(0,0,0,0)' -%}
				false
			{%- else -%}
				true
		{%- endcase -%}
	{%- endcapture -%}
	{%- capture card_has_border_color -%}
		{%- case section.settings.product_card_border_color -%}
			{%- when '' or 'rgba(0,0,0,0)' -%}
				false
			{%- else -%}
				true
		{%- endcase -%}
	{%- endcapture -%}

	{% for block in section.blocks %}
		{% case block.type %}
			{% when "heading" %}
				{% assign heading_block = block %}
			{% when "products" %}
				{% assign products_block = block %}
			{% when "banner" %}
				{% assign banner_block = block %}
		{% endcase %}
	{% endfor %}

	<div class="loudzProductsGridBanner
						{% if section.settings.section_width == 100 %}loudzProductsGridBanner--fullWidth{% endif %}">
		{%- if heading_block.settings.heading != blank -%}
			<h2
				class="
					loudzProductsGridBanner__Heading
					loudzProductsGridBanner__Heading--style-{{ heading_block.settings.heading_style }}
					loudzProductsGridBanner__Heading--alignment-{{ heading_block.settings.heading_alignment }}
				"
				{{ heading_block.shopify_attributes }}
			>
				{{ heading_block.settings.heading }}
			</h2>
		{%- endif -%}
		<div class="loudzProductsGridBanner__Content 
				loudzProductsGridBanner__Content--bannerPlacement-{{ banner_block.settings.banner_placement }}">
			<div class="loudzProductsGridBanner__Banner" {{ banner_block.shopify_attributes }}>
				<div class="loudzProductsGridBannerImage">
					{%- if banner_block.settings.banner_image != blank -%}
						<div class="loudzProductsGridBannerImage__ImageContainer">
							{{-
								banner_block.settings.banner_image
								| image_url: width: section.settings.image_desktop.width
								| image_tag:
									sizes: "100vw",
									widths: "400, 600, 800, 1200, 1600, 1800, 2400, 2800, 3200",
									fetchpriority: "low",
									loading: "lazy",
									class: "loudzProductsGridBannerImage__Image"
							-}}
						</div>
					{%- else -%}
						<img
							src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E"
							alt="Image with an abstract figure"
							width="580"
							height="580"
							loading="lazy"
							sizes="100vw"
							fetchpriority="low"
							class="loudzProductsGridBannerImage__Image"
						>
					{%- endif -%}
				</div>
				<div
					class="
						loudzProductsGridBannerTextContent
						loudzProductsGridBannerTextContent--desktopPosition-{{ banner_block.settings.desktop_content_position }}
						loudzProductsGridBannerTextContent--mobilePosition-{{ banner_block.settings.mobile_content_position }}
						{% if products_block.settings.product_list.count <= 3 and section.settings.image_aspect_ratio == 'landscape' %}loudzProductsGridBannerTextContent--smallPadding{% endif %}
					"
				>
					{%- if banner_block.settings.banner_heading != blank -%}
						<h2 class="loudzProductsGridBannerTextContent__Heading loudzProductsGridBannerTextContent__Heading--style-{{ banner_block.settings.banner_heading_style }}">
							{{ banner_block.settings.banner_heading }}
						</h2>
					{%- endif -%}
					{%- if banner_block.settings.banner_description != blank -%}
						<div class="loudzProductsGridBannerTextContent__Description">
							{{ banner_block.settings.banner_description }}
						</div>
					{%- endif -%}
					{% if banner_block.settings.banner_button_label != blank %}
						<div class="loudzProductsGridBannerTextContent__Button">
							<a
								class="loudzProductsGridBannerTextContentButton loudzProductsGridBannerTextContentButton--{{ banner_block.settings.banner_button_style }}"
								href="{{ banner_block.settings.banner_button_link | default: "#" }}"
							>
								{{- banner_block.settings.banner_button_label | escape -}}
							</a>
						</div>
					{% endif %}
				</div>
			</div>
			<div class="loudzProductsGridBanner__Products" {{ products_block.shopify_attributes }}>
				{% if products_block.settings.product_list.count > 0 %}
					{% for product in products_block.settings.product_list %}
						<div
							class="
								loudzProductsGridProdCard
								{% if card_has_border_color == 'true' %}loudzProductsGridProdCard--hasBorder{% endif %}
								{% if card_has_bg_color == 'true' %}loudzProductsGridProdCard--hasBackground{% endif %}"
						>
							<div class="loudzProductsGridProdCard__Container">
								<div class="loudzProductsGridProdCardImageContainer 
										 loudzProductsGridProdCardImageContainer--{{ section.settings.image_aspect_ratio }}
										 {% if section.settings.show_second_image_on_hover == false %}
											loudzProductsGridProdCardImageContainer--defaultHover
										 {% endif %}">
									<a href="{{ product.url }}">
										<img
											class="loudzProductsGridProdCardImage primary-image"
											src="{{ product.images[0].src | image_url }}"
											alt="{{ product.images[0].alt }}"
											width="100%"
											height="100%"
										>
										{%- if section.settings.show_second_image_on_hover and product.images[1] -%}
											<img
												class="loudzProductsGridProdCardImage secondary-image"
												src="{{ product.images[1].src | image_url }}"
												alt="{{ product.images[1].alt }}"
												width="100%"
												height="100%"
											>
										{%- endif -%}
									</a>
								</div>
								<div class="loudzProductsGridProdCardTextContainer">
									{% if section.settings.show_vendor %}
										<div class="loudzProductsGridProdCardTextContainer__Vendor">
											{{ product.vendor }}
										</div>
									{% endif %}
									<p
										class="loudzProductsGridProdCardTextContainer__ProductTitle"
										title="{{ product.title }}"
									>
										<a href="{{ product.url }}">{{ product.title }}</a>
									</p>
									<div class="loudzProductsGridProdCardTextContainer__Prices">
										{% if product.compare_at_price %}
											<span class="loudzProductsGridProdCardInitialPrice">
												{{- product.compare_at_price | money -}}
											</span>
										{% endif %}
										<span class="loudzProductsGridProdCardPrice {% if product.compare_at_price %}price-with-red{% endif %}">
											{{ product.price | money }}
										</span>
									</div>
								</div>
							</div>
						</div>
					{% endfor %}
				{% endif %}

				{% comment %}  ***** This block is generated as sample to allow user changes until the products are added to the list ***** {% endcomment %}
				{% if products_block.settings.product_list.count == 0 %}
					{% for i in (1..6) %}
						<div
							class="
								loudzProductsGridProdCard
								{% if card_has_border_color == 'true' %}loudzProductsGridProdCard--hasBorder{% endif %}
								{% if card_has_bg_color == 'true' %}loudzProductsGridProdCard--hasBackground{% endif %}
							"
						>
							<div class="loudzProductsGridProdCard__Container">
								<div class="loudzProductsGridProdCardImageContainer loudzProductsGridProdCardImageContainer--{{ section.settings.image_aspect_ratio }}
								 {% if section.settings.show_second_image_on_hover == false %}
									loudzProductsGridProdCardImageContainer--defaultHover
								 {% endif %}">
									<a href="#">
										<img
											class="loudzProductsGridProdCardImage primary-image"
											src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E"
											alt="Image with an abstract figure"
											width="580"
											height="580"
											loading="lazy"
											sizes="100vw"
											fetchpriority="low"
										>
									</a>
								</div>
								<div class="loudzProductsGridProdCardTextContainer">
									{% if section.settings.show_vendor %}
										<div class="loudzProductsGridProdCardTextContainer__Vendor">VENDOR</div>
									{% endif %}
									<p
										class="loudzProductsGridProdCardTextContainer__ProductTitle"
										title="Product title"
									>
										<a href="#">Product title</a>
									</p>
									<div class="loudzProductsGridProdCardTextContainer__Prices">
										<span class="loudzProductsGridProdCardPrice"> $100.00 </span>
									</div>
								</div>
							</div>
						</div>
					{% endfor %}
				{% endif %}
			</div>
		</div>
	</div>
</section>

{% schema %}
{
	"name": "Featured Products",
	"max_blocks": 3,
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "range",
			"id": "vertical_padding",
