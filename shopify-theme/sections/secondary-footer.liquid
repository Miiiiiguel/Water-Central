{%- style -%}
  {{  input_font | font_face: font_display: 'swap' }}
  {{  submit_font | font_face: font_display: 'swap' }}
  {{  text_font | font_face: font_display: 'swap' }}
  {{  social_text_font | font_face: font_display: 'swap' }}
  {{  link_font | font_face: font_display: 'swap' }}
  {{  title_font | font_face: font_display: 'swap' }}
  {{  copy_font | font_face: font_display: 'swap' }}
  {{  main_title_font | font_face: font_display: 'swap' }}

  .customecomz-section-{{ section.id }} {
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px;
    border-top: solid {{ border_color }} {{ border_thickness }}px;
    border-bottom: solid {{ border_color }} {{ border_thickness }}px;
    margin-top: {{ margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ margin_bottom | times: 0.75 | round: 0 }}px;
  }

  .customecomz-section-{{ section.id }}-settings {
    margin: 0 auto;
    padding-left: {{ padding_horizontal_mobile }}rem;
    padding-right: {{ padding_horizontal_mobile }}rem;
  }

  .customecomz-footer-top-{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-bottom: 40px;
  }

  .customecomz-footer-newsletter-row-{{ section.id }} {
    position: relative;
  }

  .customecomz-footer-newsletter-input-{{ section.id }} {
    width: 100%;
    margin: 0;
    border: {{ input_border_thickness }}px solid {{ input_border_color }};
    color: {{ input_color }};
    background-color: {{ input_bg_color }};
    box-shadow: none;
    border-radius: {{ input_radius }}px !important;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    padding: {{ input_padding_vertical | times: 0.75 | round: 0 }}px {{ input_padding_horizontal | times: 0.75 | round: 0 }}px;
    font-size: {{ input_size_mobile }}px;
    line-height: {{ input_height }}%;
    text-transform: unset;
    border-radius: 1px;
    /*  FIX: use exact border color */
    border: {{ input_border_thickness }}px solid {{ input_border_color }};
  }

  .customecomz-footer-newsletter-input-{{ section.id }}:focus {
    /*  FIX: remove alpha here as well */
    border: {{ input_border_thickness }}px solid {{ input_border_color }};
  }

  .customecomz-footer-newsletter-input-{{ section.id }}::placeholder {
    color: {{ input_placeholder_color }};
  }

  .customecomz-footer-four-top-{{ section.id }} .customecomz-footer-newsletter-input-{{ section.id }} {
    margin-bottom: 10px;
    border-radius: 1px;
    border: {{ input_border_thickness }}px solid {{ input_border_color }};
    color: {{ input_color }};
    background-color: {{ input_bg_color }};
  }

  .customecomz-footer-newsletter-submit-{{ section.id }} {
    margin-top: 16px;
    width: 60%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ submit_size_mobile }}px;
    color: {{ submit_color }};
    line-height: {{ submit_height }}%;
    text-align: center;
    text-transform: unset;
    text-decoration: none;
    padding: {{ submit_padding_vertical | times: 0.75 | round: 0 }}px
    border-radius: {{ submit_radius }}px;
    border: 0px;
    border: {{ submit_border_thickness }}px solid {{ submit_border_color }};
    background-color: {{ submit_bg_color }};
    transition: all 0.25s ease 0s;
    box-shadow: none;
    cursor: pointer;
  }

  .customecomz-footer-newsletter-submit-{{ section.id }}:hover {
    color: {{ submit_hover_color }};
    border: {{ submit_border_thickness }}px solid {{ submit_border_hover_color }};
    background-color: {{ submit_bg_hover_color }};
    transition: all 0.25s ease 0s;
  }

  .customecomz-footer-newsletter-first-row-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 10px;
  }

  .customecomz-footer-main-{{ section.id }} {
    display: grid;
    border-bottom: 1px solid {{ footer_border_color }};
  }

  .customecomz-footer-main-{{ section.id }}.customecomz-footer-second-main-{{ section.id }} {
    border-bottom: 0px;
  }

  .customecomz-footer-second-main-{{ section.id }} {
    padding-top: 0px;
    padding-bottom: 30px;
    gap: 30px;
  }

  .customecomz-footer-main-left-{{ section.id }} {
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .customecomz-footer-logo-{{ section.id }} {
    display: block;
    width: 100%;
    max-width: {{ logo_width_mobile }}px;
    {% case logo_position_mobile %}
      {% when 'left' %}
        margin-left: 0;
        margin-right: auto;
      {% when 'center' %}
        margin-left: auto;
        margin-right: auto;
      {% when 'right' %}
        margin-left: auto;
        margin-right: 0;
    {% endcase %}
  }

  .customecomz-footer-logo-{{ section.id }} img,
  .customecomz-footer-logo-{{ section.id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .customecomz-footer-logo-{{ section.id }} svg {
    background-color: #DEDEDE;
  }

  .customecomz-footer-text-{{ section.id }} {
    margin-top: 0px;
    width: 100%;
  }

  .customecomz-footer-text-{{ section.id }} * {
    margin: 0;
    font-size: {{ text_size_mobile }}px;
    color: {{ text_color }} !important;
    line-height: {{ text_height }}%;
    text-transform: unset;
  }

  .customecomz-footer-main-title-{{ section.id }} {
    margin: 0;
    font-size: {{ main_title_size_mobile }}px;
    color: {{ main_title_color }} !important;
    line-height: {{ main_title_height }}%;
    text-transform: unset;
    margin-bottom: 16px;
  }

  .customecomz-footer-third-main-{{ section.id }} .customecomz-footer-text-{{ section.id }} * {
    text-decoration: none;
  }

  .customecomz-footer-third-main-{{ section.id }} .customecomz-footer-text-{{ section.id }} a:hover {
    text-decoration: underline;
  }

  .customecomz-footer-main-right-top-{{ section.id }} {
    padding-bottom: 32px;
  }

  .customecomz-footer-main-right-top-{{ section.id }} *,
  .customecomz-footer-socials-text-{{ section.id }} * {
    margin: 0;
    font-size: {{ social_text_size_mobile }}px;
    color: {{ social_text_color }};
    line-height: {{ social_text_height }}%;
    text-transform: unset;
  }

  .customecomz-footer-main-right-top-{{ section.id }} a,
  .customecomz-footer-socilas-text-{{ section.id }} a {
    color: {{ social_text_link_color }};
    text-decoration: none;
  }

  .customecomz-footer-main-socials-{{ section.id }} {
    border-top: 1px solid {{ footer_border_color }};
    display: flex;
  }

  .customecomz-footer-main-socials-{{ section.id }}.customecomz-footer-main-second-socials-{{ section.id }} {
    margin-top: 30px;
    border: 0px;
    justify-content: center;
    align-items: center;
    gap: 10px;
  }

  .customecomz-footer-main-social-{{ section.id }} {
    flex: 0 1 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .customecomz-footer-main-social-{{ section.id }} svg {
    width: {{ social_icon_mobile }}px;
    height: {{ social_icon_mobile }}px;
    display: block;
  }

  .customecomz-footer-main-social-{{ section.id }} svg path {
    fill: {{ social_icon_color }};
  }

  /*  NEW: Hover color for social icons */
  .customecomz-footer-main-social-{{ section.id }} a:hover svg path {
    fill: {{ social_icon_hover_color }};
  }

  .customecomz-footer-bottom-{{ section.id }} {
    padding-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .customecomz-footer-list-{{ section.id }} {
    margin: 0px;
    padding: 0px;
    position: relative;
  }

  .customecomz-footer-list-{{ section.id }} li {
    list-style: none;
  }

  /* Remove the underline with :after trick and add a fade on hover instead */
  .customecomz-footer-list-{{ section.id }} li a {
    margin: 0;
    font-size: {{ link_size_mobile }}px;
    color: {{ link_color }} !important;
    line-height: {{ link_height }}%;
    text-transform: unset;
    text-decoration: none;
    transition: opacity 0.3s ease; /* Smooth fade */
  }
  .customecomz-footer-list-{{ section.id }} li a:hover {
    opacity: 0.7; /* Fade effect on hover */
  }

  .customecomz-footer-list-title-{{ section.id }} {
    margin: 0;
    margin-bottom: 16px;
    font-size: {{ title_size_mobile }}px;
    color: {{ title_color }} !important;
    line-height: {{ title_height }}%;
    text-transform: unset;
  }

  .customecomz-footer-second-top-{{ section.id }} {
    padding-bottom: 30px;
    border-bottom: 1px solid {{ footer_border_color }};
    display: grid;
    grid-template-columns: repeat(60, minmax(0, 1fr));
    grid-auto-rows: auto;
    grid-auto-flow: dense;
    row-gap: 32px;
  }

  .customecomz-footer-second-top-item-{{ section.id }} {
    grid-column: span 60;
    padding: 0px;
  }

  .customecomz-footer-second-top-item-logo-{{ section.id }} .customecomz-footer-logo-{{ section.id }} {
    margin-left: auto;
    margin-right: auto;
  }

  .customecomz-footer-payments-{{ section.id }} {
    margin: 0px;
    display: flex;
    align-items: center;
    margin-top: 3px;
    padding: 15px;
    padding-bottom: 14px;
    margin-bottom: 5px;
    transform: translateY(15px);
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0px;
  }

  .customecomz-footer-payment-{{ section.id }} {
    flex: 0 1 38px;
    list-style: none;
  }

  /* Original default is 100% x 100%. We override with new custom sizes below. */
  .customecomz-footer-payment-{{ section.id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .customecomz-footer-copy-text-{{ section.id }} {
    margin-top: 30px;
    transform: translateX(0px);
    text-align: center;
    width: 100%;
  }

  .customecomz-footer-copy-text-{{ section.id }} * {
    margin: 0;
    font-size: {{ copy_size_mobile }}px;
    color: {{ copy_color }};
    line-height: {{ copy_height }}%;
    text-transform: unset;
    text-decoration: none;
  }

  .customecomz-footer-copy-text-{{ section.id }} a:hover {
    text-decoration: underline;
  }

  .customecomz-footer-second-main-{{ section.id }} .customecomz-footer-newsletter-submit-{{ section.id }} {
    margin-top: 0px;
    position: static !important;
    font-weight: 700;
  }

  .customecomz-footer-third-main-{{ section.id }} .customecomz-footer-newsletter-submit-{{ section.id }} {
    font-weight: 400;
  }

  .customecomz-footer-second-main-{{ section.id }} .customecomz-footer-newsletter-row-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .customecomz-footer-second-top-item-{{ section.id }} .customecomz-footer-socials-text-{{ section.id }} {
    margin-bottom: 30px;
  }

  .customecomz-footer-third-top-{{ section.id }} .customecomz-footer-main-socials-{{ section.id }} {
    justify-content: start;
  }

  .customecomz-footer-main-left-top-{{ section.id }} {
    display: grid;
    gap: 20
  }

  @media(min-width: 768px) {

    .customecomz-footer-first-main-socials-{{ section.id }} svg {
      width: {{ social_icon_mobile | times: 2 }}px;
      height: {{ social_icon_mobile | times: 2 }}px;
    }

    .customecomz-footer-newsletter-submit-{{ section.id }} {
      margin-top: 0px;
      max-width: 220px !important;
    }
  }

  @media(min-width: 1024px) {

    .customecomz-section-{{ section.id }} {
      padding-top: {{ padding_top }}px;
      padding-bottom: {{ padding_bottom }}px;
      margin-top: {{ margin_top }}px;
      margin-bottom: {{ margin_bottom }}px;
    }

    .customecomz-section-{{ section.id }}-settings {
      padding: 0 5rem;
      padding-left: {{ padding_horizontal }}rem;
      padding-right: {{ padding_horizontal }}rem;
    }

    .customecomz-footer-top-{{ section.id }} {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

    .customecomz-footer-newsletter-text-{{ section.id }} {
      flex: 0 1 55%;
    }

    .customecomz-footer-newsletter-form-{{ section.id }} {
      flex: 0 1 512px;
    }

    .customecomz-footer-newsletter-input-{{ section.id }} {
      padding: {{ input_padding_vertical }}px {{ input_padding_horizontal }}px;
      font-size: {{ input_size }}px;
      border: {{ input_border_thickness }}px solid {{ input_border_color }};
      color: {{ input_color }};
      background-color: {{ input_bg_color }};
    }

    .customecomz-footer-newsletter-submit-{{ section.id }} {
      padding: {{ submit_padding_vertical }}px {{ submit_padding_horizontal }}px;
      font-size: {{ submit_size }}px;
      border-radius: {{ submit_radius }}px;
    }

    .customecomz-footer-main-{{ section.id }} {
      grid-template-columns: 1fr 1fr;
    }

    .customecomz-footer-logo-{{ section.id }} {
      max-width: {{ logo_width }}px;
      margin-left: 0px;
       margin-top: {{ section.settings.logo_position_vertical_desktop }}px;
      margin-right: 0px;
    }

    .customecomz-footer-text-{{ section.id }} * {
      font-size: {{ text_size }}px;
    }

    .customecomz-footer-main-title-{{ section.id }} {
      font-size: {{ main_title_size }}px;
    }

    .customecomz-footer-main-right-top-{{ section.id }} {
      padding-top: 32px;
      padding-bottom: 32px;
      padding-left: 10%;
      padding-right: 10%;
    }

    .customecomz-footer-main-right-top-{{ section.id }} *,
    .customecomz-footer-socials-text-{{ section.id }} * {
      margin: 0;
      font-size: {{ social_text_size }}px;
    }

    .customecomz-footer-main-right-{{ section.id }} {
      border-left: 1px solid {{ footer_border_color }};
    }

    .customecomz-footer-four-main-{{ section.id }} .customecomz-footer-main-right-{{ section.id }} {
      border-left: 0px;
    }

    .customecomz-footer-main-social-{{ section.id }} svg {
      width: {{ social_icon }}px;
      height: {{ social_icon }}px;
    }

    .customecomz-footer-main-socials-{{ section.id }}.customecomz-footer-main-second-socials-{{ section.id }} {
      margin-top: 5px;
    }

    .customecomz-footer-list-{{ section.id }} li a {
      font-size: {{ link_size }}px;
    }

    .customecomz-footer-bottom-{{ section.id }} {
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      flex-direction: row;
    }

    .customecomz-footer-list-title-{{ section.id }} {
      font-size: {{ title_size }}px;
    }

    .customecomz-footer-second-top-{{ section.id }} {
      row-gap: 15px;
    }

    .customecomz-footer-second-top-item-{{ section.id }}:not(:first-child) {
      border-left: 1px solid {{ footer_border_color }};
    }

    .customecomz-footer-second-top-item-{{ section.id }} {
      grid-column: span 12;
    }

    .customecomz-footer-second-top-item-{{ section.id }}.customecomz-footer-second-top-item-logo-{{ section.id }} {
      grid-column: span 24;
    }

    .customecomz-footer-four-top-{{ section.id }} .customecomz-footer-second-top-item-{{ section.id }} {
      grid-column: span 15;
      border: 0px !important;
    }

    .customecomz-footer-third-top-{{ section.id }} .customecomz-footer-second-top-item-{{ section.id }} {
      padding: 16px 32px 0px;
    }

    .customecomz-footer-copy-text-{{ section.id }} * {
      font-size: {{ copy_size }}px;
    }

    .customecomz-footer-second-main-{{ section.id }} .customecomz-footer-main-right-{{ section.id }} {
      padding: 16px 32px;
    }
  }

