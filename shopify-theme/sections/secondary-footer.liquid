      display: flex;
      align-items: center;
      border: {{ input_border_thickness }}px solid {{ input_border_color }};
      color: {{ input_color }};
      background-color: {{ input_bg_color }};
      justify-content: center;
      font-size: {{ submit_size_mobile }}px;
      color: {{ submit_color }};
      line-height: {{ submit_height }}%;
      text-align: center;
      text-transform: unset;
      text-decoration: none;
      padding: 16px;
      border-radius: {{ submit_radius }}px;
      border: 0px;
      border: {{ submit_border_thickness }}px solid {{ submit_border_color }};
      background-color: {{ submit_bg_color }};
      transition: all 0.25s ease 0s;
      box-shadow: none;
      cursor: pointer;
    }

    .customecomz-footer-payments-{{ section.id }} {
      justify-content: center;
      padding: 15px;
      padding-bottom: 20px;
      margin-bottom: 5px;
      transform: translateX(0px);
    }

    .customecomz-footer-payment-{{ section.id }} {
      flex: 0 3 29px;
      list-style: none;
    }

    .customecomz-footer-copy-text-{{ section.id }} {
      margin-top: 5px;
      text-align: center;
      width: 100%;
      transform: translateX(0px);
    }

    .customecomz-footer-bottom-{{ section.id }} {
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
    }

    .customecomz-footer-copy-text-{{ section.id }},
    .customecomz-footer-payments-{{ section.id }} {
      flex: unset;
      width: 100%;
      text-align: center;
      margin: 10px 0;
