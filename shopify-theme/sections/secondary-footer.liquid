    </div>

    <div class="customecomz-footer-main-{{ section.id }} customecomz-footer-second-main-{{ section.id }} customecomz-footer-third-main-{{ section.id }}">
      <div class="customecomz-footer-main-left-{{ section.id }}">
        {% if title != blank %}
          <h3 class="customecomz-footer-main-title-{{ section.id }}">{{ title }}</h3>
        {% endif %}
        {% if text != blank %}
          <div class="customecomz-footer-text-{{ section.id }}">
            {{ text }}
          </div>
        {% endif %}
        {% if use_payments %}
          <ul class="customecomz-footer-payments-{{ section.id }}">
            {%- for type in shop.enabled_payment_types -%}
              {%- comment -%}
                Skip (continue) if the user disabled a certain brand:
              {%- endcomment -%}
              {% if type == 'american_express' and disable_american_express %}
                {% continue %}
              {% elsif type == 'google_pay' and disable_google_pay %}
                {% continue %}
              {% elsif type == 'maestro' and disable_maestro %}
                {% continue %}
              {% elsif type == 'master' and disable_mastercard %}
                {% continue %}
              {% elsif type == 'paypal' and disable_paypal %}
                {% continue %}
              {% elsif type == 'unionpay' and disable_union_pay %}
                {% continue %}
              {% elsif type == 'visa' and disable_visa %}
                {% continue %}
              {% endif %}
              <li class="customecomz-footer-payment-{{ section.id }}">
                {{ type | payment_type_svg_tag }}
              </li>
            {%- endfor -%}
          </ul>
        {% endif %}

        {% if copy != blank %}
          <div class="customecomz-footer-copy-text-{{ section.id }}">
            {{ copy }}
          </div>
        {% endif %}
      </div>

      {% if use_newsletter and hide_newsletter != true %}
        <div class="customecomz-footer-main-right-{{ section.id }}">
          {% form 'customer', class: 'customecomz-footer-newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">

            <div class="customecomz-footer-newsletter-row-{{ section.id }}">
              <input
                type="email"
                name="contact[email]"
                class="customecomz-footer-newsletter-input-{{ section.id }}"
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="Newsletter-error--{{ section.id }}"
                {% elsif form.posted_successfully? %}
                  aria-describedby="Newsletter-success--{{ section.id }}"
                {% endif %}
                placeholder="{{ input_placeholder }}"
                required
              >
              <button type="submit" class="customecomz-footer-newsletter-submit-{{ section.id }}" name="commit">
                {{ submit }}
              </button>
            </div>
          {% endform %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{%- schema -%}
{"name":"Secondary Footer","settings":[],"presets":[{"name":"Secondary Footer"}]}
{%- endschema -%}

<!-- End of updated Footer Section Pro 1 code -->
