    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "'Read More' Button Border Color (Normal)",
      "default": "#FF7A15",
      "info": "Set the border color of the 'Read More' buttons in normal state."
    },
    {
      "type": "color",
      "id": "button_border_hover_color",
      "label": "'Read More' Button Border Color (Hover)",
      "default": "#ee6600",
      "info": "Set the border color of the 'Read More' buttons on hover."
    },
    {
      "type": "range",
      "id": "read_more_font_size_desktop",
      "label": "Read More Button Font Size (Desktop) (px)",
      "default": 16,
      "min": 10, "max": 30, "step": 1
    },
    {
      "type": "range",
      "id": "read_more_font_size_mobile",
      "label": "Read More Button Font Size (Mobile) (px)",
      "default": 14,
      "min": 10, "max": 30, "step": 1
    },
    {
