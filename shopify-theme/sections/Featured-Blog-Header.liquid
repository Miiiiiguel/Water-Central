      "info": "Customize the text displayed on the 'Read More' buttons."
    },
    {
      "type": "checkbox",
      "id": "remove_description_text",
      "default": true,
      "label": "Disable Description Under Text",
      "info": "Remove the description text from both the featured and additional articles."
    },

    { "type": "header", "content": "Section Spacing & Background" },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "section_top_padding",
      "label": "Section Top Padding (px)",
      "default": 0,
      "min": 0, "max": 200, "step": 10
    },
    {
      "type": "range",
      "id": "section_bottom_padding",
      "label": "Section Bottom Padding (px)",
      "default": 0,
      "min": 0, "max": 200, "step": 10
    },

    { "type": "header", "content": "Section Margins (Desktop)" },
    {
      "type": "range",
      "id": "section_margin_top_desktop",
      "label": "Top Margin Desktop (px)",
      "default": 0,
      "min": -200, "max": 400, "step": 10
    },
    {
      "type": "range",
      "id": "section_margin_bottom_desktop",
      "label": "Bottom Margin Desktop (px)",
      "default": 0,
      "min": -200, "max": 400, "step": 10
    },

    { "type": "header", "content": "Section Margins (Mobile)" },
    {
      "type": "range",
      "id": "section_margin_top_mobile",
      "label": "Top Margin Mobile (px)",
      "default": 0,
      "min": -200, "max": 400, "step": 10
    },
    {
      "type": "range",
      "id": "section_margin_bottom_mobile",
      "label": "Bottom Margin Mobile (px)",
      "default": 0,
      "min": -200, "max": 400, "step": 10
    },

    { "type": "header", "content": "Styling & Appearance" },
    {
      "type": "color",
      "id": "description_maintext_color",
      "label": "Top Text Color",
      "default": "#FFFFFF",
      "info": "Color of the description text in articles."
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "default": "assistant_n4",
      "label": "Article Title Font",
      "info": "Select the font for article titles."
    },
    {
      "type": "font_picker",
      "id": "description_font",
      "default": "assistant_n4",
      "label": "Top Text Font",
      "info": "Select the font for article descriptions."
    },

    { "type": "header", "content": "Button Customizations" },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#FF7A15",
      "info": "Set the background color of the 'Read More' buttons."
    },
    {
      "type": "color",
      "id": "button_bg_hover_color",
      "label": "Button Hover Background Color",
      "default": "#ee6600",
      "info": "Set the background color of the 'Read More' buttons on hover."
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff",
      "info": "Set the text color of the 'Read More' buttons."
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button Border Radius (px)",
      "default": 25,
      "min": 0, "max": 50, "step": 1,
      "info": "Adjust the border radius of the 'Read More' buttons."
    },
    {
      "type": "range",
      "id": "read_more_button_border_weight",
