{% comment %}
  Section: Product Image & Benefits
  Category: Image With Text
  Purpose: Recreate the provided layout — headline + paragraph + stacked benefit chips + CTA, with a large rounded image on the side.
  Notes:
  - Benefits are blocks (reorderable). Each supports a custom SVG icon or emoji.
  - Highly customizable: colors, radii, spacing, alignment, image side, button, etc.
  - Responsive: stacks on mobile; optional mobile-first image placement.
{% endcomment %}

<section
  id="pib-{{ section.id }}"
  class="pib"
  data-section-id="{{ section.id }}"
>
  <style>
    /* ---------- Scoped variables from settings ---------- */
    #pib-{{ section.id }}{
      --pib-bg: {{ section.settings.bg_color }};
      --pib-card-bg: {{ section.settings.benefit_bg }};
      --pib-card-text: {{ section.settings.benefit_text }};
      --pib-icon-bg: {{ section.settings.icon_bg }};
      --pib-radius: {{ section.settings.radius }}px;
      --pib-chip-radius: {{ section.settings.chip_radius }}px;
      --pib-img-radius: {{ section.settings.image_radius }}px;
      --pib-gap: {{ section.settings.column_gap }}px;
      --pib-mobile-gap: {{ section.settings.mobile_gap }}px;
      --pib-pad-top: {{ section.settings.padding_top }}px;
      --pib-pad-bottom: {{ section.settings.padding_bottom }}px;
      --pib-pad-x: {{ section.settings.pad_x }}px;
      --pib-maxw: {{ section.settings.max_width }}px;
      --pib-content-gap: {{ section.settings.content_gap }}px;
      --pib-button-gap: {{ section.settings.button_gap }}px;
      --pib-chip-pad: {{ section.settings.chip_pad }}px;
      --pib-chip-icon-size-d: {{ section.settings.chip_icon_size_desktop }}px;
      --pib-chip-icon-size-m: {{ section.settings.chip_icon_size_mobile }}px;
    }

    /* ---------- Base layout ---------- */
    #pib-{{ section.id }}{
      background: var(--pib-bg);
      border-radius: var(--pib-radius);
    }
    #pib-{{ section.id }} .pib__container{
      max-width: var(--pib-maxw);
      margin: 0 auto;
      padding: var(--pib-pad-top) var(--pib-pad-x) var(--pib-pad-bottom) var(--pib-pad-x);
    }
    #pib-{{ section.id }} .pib__grid{
      display: grid;
      grid-template-columns: 1.06fr 0.94fr;
      gap: var(--pib-gap);
      align-items: center;
    }
    /* Image left/right */
    {% if section.settings.image_position == 'left' %}
      #pib-{{ section.id }} .pib__image-wrap{ order: 0; }
      #pib-{{ section.id }} .pib__content{ order: 1; }
    {% else %}
      #pib-{{ section.id }} .pib__image-wrap{ order: 1; }
      #pib-{{ section.id }} .pib__content{ order: 0; }
    {% endif %}

    /* ---------- Content layout ---------- */
    #pib-{{ section.id }} .pib__content{
      display: flex;
      flex-direction: column;
      gap: var(--pib-content-gap);
      text-align: {{ section.settings.content_align }};
    }

    /* ---------- Typo ---------- */
    #pib-{{ section.id }} .pib__eyebrow{
      font-weight: 700;
      letter-spacing: .02em;
      text-transform: uppercase;
    }
    #pib-{{ section.id }} .pib__heading{
      line-height: 1.05;
      margin: 0;
    }
    #pib-{{ section.id }} .pib__body{
      line-height: 1.55;
      margin: 0;
    }

    /* ---------- Benefits ---------- */
    #pib-{{ section.id }} .pib__chip{
      display: grid;
      grid-template-columns: max-content 1fr;
      align-items: center;
      column-gap: 12px;
      background: var(--pib-card-bg);
      color: var(--pib-card-text);
      padding: var(--pib-chip-pad);
      border-radius: var(--pib-chip-radius);
      transition: opacity .15s ease;
    }
    #pib-{{ section.id }} .pib__chip:hover{
      opacity: .9;
    }
    #pib-{{ section.id }} .pib__icon{
      width: var(--pib-chip-icon-size-d);
      height: var(--pib-chip-icon-size-d);
      display: grid;
      place-items: center;
      border-radius: 10px;
      background: var(--pib-icon-bg);
      line-height: 0;
      overflow: hidden;
    }
    #pib-{{ section.id }} .pib__icon svg{
      width: 100%;
      height: 100%;
      display: block;
    }
    #pib-{{ section.id }} .pib__chip-text{
      line-height: 1.4;
    }

    /* ---------- CTA ---------- */
    #pib-{{ section.id }} .pib__cta{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: var(--pib-button-gap);
      padding: var(--pib-btn-pad-y) var(--pib-btn-pad-x);
      border-radius: var(--pib-btn-radius);
      background: var(--pib-btn-bg);
      color: var(--pib-btn-text);
      text-decoration: none;
      font-weight: 700;
      transition: background .12s ease, color .12s ease, opacity .12s ease;
    }
    #pib-{{ section.id }} .pib__cta:hover{
      background: var(--pib-btn-bg-h);
      color: var(--pib-btn-text-h);
      opacity: .95;
    }

    /* ---------- Image ---------- */
    #pib-{{ section.id }} .pib__image-frame{
      position: relative;
      width: 100%;
      border-radius: var(--pib-img-radius);
      overflow: hidden;
      {% if section.settings.img_shadow %}box-shadow: 0 8px 24px rgba(0,0,0,.12);{% endif %}
    }
    #pib-{{ section.id }} .pib__image-frame:before{
      content: "";
      display: block;
      padding-top: {{ section.settings.image_aspect }}%;
    }
    #pib-{{ section.id }} .pib__image{
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: {{ section.settings.object_position }};
    }

    /* ---------- Responsive ---------- */
    @media (max-width: 990px){
      #pib-{{ section.id }} .pib__grid{
        grid-template-columns: 1fr;
        gap: var(--pib-mobile-gap);
      }
      /* Mobile placement override */
      {% if section.settings.mobile_image_first %}
        #pib-{{ section.id }} .pib__image-wrap{ order: -1; }
      {% endif %}
      #pib-{{ section.id }} .pib__icon{
        width: var(--pib-chip-icon-size-m);
        height: var(--pib-chip-icon-size-m);
      }
    }
  </style>

  <div class="pib__container">
    <div class="pib__grid">
      <div class="pib__content">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'eyebrow' %}
              {% if block.settings.text != blank %}
                <div class="pib__eyebrow" style="color: {{ block.settings.color }}; font-size: {{ block.settings.font_size }}px;">{{ block.settings.text }}</div>
              {% endif %}
            {% when 'heading' %}
              {% if block.settings.text != blank %}
                <h2 class="pib__heading" style="color: {{ block.settings.color }}; font-weight: {{ block.settings.font_weight }}; font-size: {{ block.settings.font_size }}px;">{{ block.settings.text }}</h2>
              {% endif %}
            {% when 'text' %}
              {% if block.settings.text != blank %}
                <div class="pib__body" style="color: {{ block.settings.color }}; font-size: {{ block.settings.font_size }}px;">{{ block.settings.text }}</div>
              {% endif %}
            {% when 'benefit' %}
              <div class="pib__chip" {{ block.shopify_attributes }}>
                <div class="pib__icon" style="background: var(--pib-icon-bg); color: {{ block.settings.icon_color }};">
                  {% if block.settings.icon_svg != blank %}
                    {{ block.settings.icon_svg }}
                  {% else %}
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                      {% case block.settings.icon_type %}
                        {% when 'check' %}
                          <path fill="currentColor" d="M9 16.2L4.8 12l-1.4 1.3L9 19 21 7l-1.4-1.3L9 16.2Z"/>
                        {% when 'star' %}
                          <path fill="currentColor" d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                        {% when 'heart' %}
                          <path fill="currentColor" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                        {% when 'arrow_right' %}
                          <path fill="currentColor" d="M10 6 8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
                        {% when 'bolt' %}
                          <path fill="currentColor" d="M13 10V3L8.5 14h5v7l4.5-11h-5v-1z"/>
                        {% when 'shield' %}
                          <path fill="currentColor" d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
                        {% when 'truck' %}
                          <path fill="currentColor" d="M20 8H4V5c0-1.1.9-2 2-2h11v2h4v3h2v2h-1zM4 19v-1c0-.55.45-1 1-1s1 .45 1 1v1c0 .55-.45 1-1 1s-1-.45-1-1zm14 0v-1c0-.55.45-1 1-1s1 .45 1 1v1c0 .55-.45 1-1 1s-1-.45-1-1zM19 6H5v9h14V6z"/>
                        {% when 'leaf' %}
                          <path fill="currentColor" d="M21 3c-6.5.2-10.9 2.9-13.1 8.1c-1.2 2.8-2.8 4.4-4.9 4.9c1.4 1.5 3.2 2 5.3 1.6c2.7-.5 4.8-2.4 6.1-5.4c.7-1.7 1.5-2.9 2.4-3.8c-1.1.4-2.3 1.1-3.6 2.1l-.8-.9C15.4 6.6 18.7 4.7 23 4.5V3z"/>
                        {% when 'fire' %}
                          <path fill="currentColor" d="M9.5 3H12V2h-1.5V3zM15 3v1h2.5V3H15zM8 19c0 1.7.2 3.8 1 5.4V18l2-3v-2H3v2l3 3v3.6c.5-1 .9-2.9 1-5.4M19 3h-1.5V2H16v1h-1v1h1v1h1.5V4H19V3zm-2 15.8c-1.7 1.3-3.8 2-6 2-2.2 0-4.2-.7-6-2V18h12v.8z"/>
                        {% when 'crown' %}
                          <path fill="currentColor" d="M5 8V5l2.5 1.5L12 2l4.5 4.5L19 5v3l-5 3-3-3-3 3-5-3zM4 19h16v-8L12 9l-8 6v8z"/>
                        {% when 'diamond' %}
                          <path fill="currentColor" d="M12 2L4 9v3l8 6 8-6V9l-8-7z"/>
                        {% when 'clock' %}
                          <path fill="currentColor" d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm3.5 13.5L11 12V7h2v6.5l2.5 2.5-1.5 1.5-2-2z"/>
                        {% when 'user' %}
                          <path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4z"/>
                        {% when 'home' %}
                          <path fill="currentColor" d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                        {% when 'phone' %}
                          <path fill="currentColor" d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
                        {% when 'email' %}
                          <path fill="currentColor" d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                        {% when 'search' %}
                          <path fill="currentColor" d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                        {% when 'plus' %}
                          <path fill="currentColor" d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                        {% when 'minus' %}
                          <path fill="currentColor" d="M16 13H8v-2h8v2z"/>
                        {% when 'info' %}
                          <path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                        {% else %}
                          <path fill="currentColor" d="M9 16.2L4.8 12l-1.4 1.3L9 19 21 7l-1.4-1.3L9 16.2Z"/>
                      {% endcase %}
                    </svg>
                  {% endif %}
                </div>
                {% if block.settings.text != blank %}
                  <div class="pib__chip-text" style="font-weight: {{ block.settings.text_weight }}; font-size: {{ block.settings.text_size }}px;">{{ block.settings.text }}</div>
                {% endif %}
              </div>
            {% when 'button' %}
              {% if block.settings.label != blank %}
                <a class="pib__cta" href="{{ block.settings.link | default: '#' }}" style="--pib-btn-bg: {{ block.settings.bg }}; --pib-btn-text: {{ block.settings.text }}; --pib-btn-bg-h: {{ block.settings.bg_hover }}; --pib-btn-text-h: {{ block.settings.text_hover }}; --pib-btn-pad-y: {{ block.settings.pad_y }}px; --pib-btn-pad-x: {{ block.settings.pad_x }}px; --pib-btn-radius: {{ block.settings.radius }}px; width: {{ block.settings.width }}px; font-weight: {{ block.settings.font_weight }}; margin-top: var(--pib-button-gap);">
                  {{ block.settings.label }}
                </a>
              {% endif %}
          {% endcase %}
        {% endfor %}
      </div>

      <div class="pib__image-wrap">
        <div class="pib__image-frame">
          {% if section.settings.image != blank %}
            <img
              class="pib__image"
              srcset="
                {{ section.settings.image | image_url: width: 480 }} 480w,
                {{ section.settings.image | image_url: width: 720 }} 720w,
                {{ section.settings.image | image_url: width: 960 }} 960w,
                {{ section.settings.image | image_url: width: 1200 }} 1200w,
                {{ section.settings.image | image_url: width: 1600 }} 1600w
              "
              sizes="(max-width: 990px) 100vw, 48vw"
              src="{{ section.settings.image | image_url: width: 1200 }}"
              alt="{{ section.settings.image.alt | escape }}"
              loading="lazy"
            >
          {% else %}
            <img
              class="pib__image"
              src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E"
              alt="Placeholder image"
              loading="lazy"
            >
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  {% schema %}
  {
    "name": "Product Image & Benefits",
    "class": "product-image-benefits",
    "tag": "section",

    "settings": [
      
      { "type": "range", "id": "max_width", "label": "Max width (px)", "min": 800, "max": 1600, "step": 20, "default": 1200 },
      { "type": "range", "id": "padding_top", "label": "Top padding (px)", "min": 0, "max": 120, "step": 4, "default": 40 },
      { "type": "range", "id": "padding_bottom", "label": "Bottom padding (px)", "min": 0, "max": 120, "step": 4, "default": 40 },
      { "type": "range", "id": "pad_x", "label": "Horizontal padding (px)", "min": 0, "max": 60, "step": 2, "default": 20 },
      { "type": "range", "id": "column_gap", "label": "Column gap (px) (desktop version)", "min": 12, "max": 80, "step": 2, "default": 80 },
      { "type": "range", "id": "mobile_gap", "label": "Column gap (px) (mobile version)", "min": 12, "max": 80, "step": 2, "default": 36 },
      { "type": "range", "id": "radius", "label": "Container corner radius (px)", "min": 0, "max": 32, "step": 1, "default": 0 },
      { "type": "select", "id": "content_align", "label": "Content alignment", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ] },
      {
        "type": "select",
        "id": "image_position",
        "label": "Image position (desktop)",
        "default": "right",
        "options": [
          { "value": "left", "label": "Left" },
          { "value": "right", "label": "Right" }
        ]
      },
      { "type": "checkbox", "id": "mobile_image_first", "label": "Show image first on mobile", "default": true },

      
      { "type": "image_picker", "id": "image", "label": "Image" },
      {
        "type": "select",
        "id": "object_position",
        "label": "Image focal position",
        "default": "center center",
        "options": [
          { "value": "center center", "label": "Center" },
          { "value": "top center", "label": "Top" },
          { "value": "center left", "label": "Left" },
          { "value": "center right", "label": "Right" },
          { "value": "bottom center", "label": "Bottom" }
        ]
      },
      {
        "type": "range",
        "id": "image_aspect",
        "label": "Image aspect ratio (as % height of width)",
        "min": 56,
        "max": 130,
        "step": 1,
        "default": 100
      },
      { "type": "range", "id": "image_radius", "label": "Image corner radius (px)", "min": 0, "max": 48, "step": 1, "default": 32 },
      { "type": "checkbox", "id": "img_shadow", "label": "Image soft shadow", "default": true },

      
      { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },

      
      { "type": "color", "id": "benefit_bg", "label": "Benefit chip background", "default": "#F7F7F7" },
      { "type": "color", "id": "benefit_text", "label": "Benefit text color", "default": "#0b0b0b" },
      { "type": "color", "id": "icon_bg", "label": "Benefit icon background", "default": "transparent" },

      
      { "type": "range", "id": "content_gap", "label": "Content gap (px)", "min": 6, "max": 20, "step": 1, "default": 12 },
      { "type": "range", "id": "button_gap", "label": "Gap before button (px)", "min": 0, "max": 40, "step": 2, "default": 20 },
      { "type": "range", "id": "chip_radius", "label": "Benefit chip radius (px)", "min": 4, "max": 20, "step": 1, "default": 12 },
      { "type": "range", "id": "chip_pad", "label": "Benefit chip padding (px)", "min": 8, "max": 22, "step": 1, "default": 14 },
      { "type": "range", "id": "chip_icon_size_desktop", "label": "Benefit icon size desktop (px)", "min": 16, "max": 28, "step": 1, "default": 22 },
      { "type": "range", "id": "chip_icon_size_mobile", "label": "Benefit icon size mobile (px)", "min": 12, "max": 24, "step": 1, "default": 18 }
    ],
    "blocks": [
      {
        "type": "eyebrow",
        "name": "Eyebrow",
        "settings": [
          { "type": "text", "id": "text", "label": "Eyebrow text", "default": "Quality Guarantee" },
          { "type": "color", "id": "color", "label": "Color", "default": "#0C8527" },
          { "type": "range", "id": "font_size", "label": "Font size (px)", "min": 12, "max": 20, "step": 1, "default": 14 }
        ]
      },
      {
        "type": "heading",
        "name": "Heading",
        "settings": [
          { "type": "text", "id": "text", "label": "Heading text", "default": "QUALITY GUARANTEE" },
          { "type": "color", "id": "color", "label": "Color", "default": "#0b0b0b" },
          {
            "type": "select",
            "id": "font_weight",
            "label": "Font weight",
            "default": "700",
            "options": [
              { "value": "300", "label": "300 (Light)" },
              { "value": "400", "label": "400 (Normal)" },
              { "value": "600", "label": "600 (Semi-bold)" },
              { "value": "700", "label": "700 (Bold)" },
              { "value": "900", "label": "900 (Black)" }
            ]
          },
          { "type": "range", "id": "font_size", "label": "Font size (px)", "min": 24, "max": 60, "step": 1, "default": 40 }
        ]
      },
      {
        "type": "text",
        "name": "Body text",
        "settings": [
          { "type": "richtext", "id": "text", "label": "Body text", "default": "<p>Two of our core brand values are quality & trust, which is why everything we do is built on a foundation of excellence & transparency. Our products are:</p>" },
          { "type": "color", "id": "color", "label": "Color", "default": "#4b4b4b" },
          { "type": "range", "id": "font_size", "label": "Font size (px)", "min": 12, "max": 20, "step": 1, "default": 16 }
        ]
      },
      {
        "type": "benefit",
        "name": "Benefit",
        "settings": [
          {
            "type": "select",
            "id": "icon_type",
            "label": "Icon",
            "default": "check",
            "options": [
              { "value": "check", "label": "Check" },
              { "value": "star", "label": "Star" },
              { "value": "heart", "label": "Heart" },
              { "value": "arrow_right", "label": "Arrow Right" },
              { "value": "bolt", "label": "Bolt" },
              { "value": "shield", "label": "Shield" },
              { "value": "truck", "label": "Truck" },
              { "value": "leaf", "label": "Leaf" },
              { "value": "fire", "label": "Fire" },
              { "value": "crown", "label": "Crown" },
              { "value": "diamond", "label": "Diamond" },
              { "value": "clock", "label": "Clock" },
              { "value": "user", "label": "User" },
              { "value": "home", "label": "Home" },
              { "value": "phone", "label": "Phone" },
              { "value": "email", "label": "Email" },
              { "value": "search", "label": "Search" },
              { "value": "plus", "label": "Plus" },
              { "value": "minus", "label": "Minus" },
              { "value": "info", "label": "Info" }
            ]
          },
          { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#0b0b0b" },
          { "type": "textarea", "id": "icon_svg", "label": "Custom SVG icon (optional)", "info": "Paste raw SVG code from svgrepo.com. This overrides the selected icon." },
          { "type": "text", "id": "text", "label": "Text", "default": "100% fruiting body of the mushroom" },
          {
            "type": "select",
            "id": "text_weight",
            "label": "Text font weight",
