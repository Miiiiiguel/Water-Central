			"step": 10,
			"unit": "px",
			"label": "Bottom padding (mobile)",
			"default": 50
		},
		{
			"type": "range",
			"id": "top_margin_mobile",
			"min": 0,
			"max": 100,
			"step": 2,
			"unit": "px",
			"label": "Top margin (mobile)",
			"default": 0
		},
		{
			"type": "range",
			"id": "bottom_margin_mobile",
			"min": 0,
			"max": 100,
			"step": 2,
			"unit": "px",
			"label": "Bottom margin (mobile)",
			"default": 0
		},
		{
			"type": "range",
			"id": "left_padding_mobile",
			"min": 0,
			"max": 100,
			"step": 2,
			"unit": "px",
			"label": "Left padding (mobile)",
			"default": 10
		},
		{
			"type": "range",
			"id": "right_padding_mobile",
			"min": 0,
			"max": 100,
			"step": 2,
			"unit": "px",
			"label": "Right padding (mobile)",
			"default": 10
