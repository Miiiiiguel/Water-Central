{% style %}
:root {
--loudz-neutral-70: #5e5e5e;
--loudz-neutral-01: #fff;
--loudz-size-1: 1px;
--loudz-size-2: 2px;
--loudz-size-4: 4px;
--loudz-size-8: 8px;
--loudz-size-12: 12px;
--loudz-size-14: 14px;
--loudz-size-16: 16px;
--loudz-size-20: 20px;
--loudz-size-24: 24px;
--loudz-size-32: 32px;
--loudz-size-40: 40px;
--loudz-size-80: 80px;
--loudz-font-weight-400: 400;
--loudz-line-height-140: 1.4;
--loudz-text-decoration-none: none;
--loudz-text-decoration-underline: underline;
--loudz-border-width-1: var(--loudz-size-1);
--loudz-color-bg-fill-inverse-on-light: var(--loudz-neutral-01);
--loudz-color-text-disable-on-light: var(--loudz-neutral-70);
--loudz-space-2: var(--loudz-size-2);
--loudz-space-4: var(--loudz-size-4);
--loudz-space-8: var(--loudz-size-8);
--loudz-space-12: var(--loudz-size-12);
--loudz-space-16: var(--loudz-size-16);
--loudz-space-20: var(--loudz-size-20);
--loudz-space-24: var(--loudz-size-24);
--loudz-space-32: var(--loudz-size-32);
--loudz-space-40: var(--loudz-size-40);
--loudz-space-80: var(--loudz-size-80);
--loudz-font-size-14: var(--loudz-size-14);
}
{% endstyle %}

{%- liquid
	assign mobile_image = section.settings.image_mobile
	assign second_mobile_image = section.settings.second_image_mobile

	if mobile_image == blank
		assign mobile_image = section.settings.image_desktop
	endif

	if second_mobile_image == blank
		assign second_mobile_image = section.settings.second_image_desktop
	endif
-%}

<section class="Loudz-{{ section.id | handle }}">
	<div
		class="LoudzImgsOverlapContainer"
	>
		<div class="LoudzImgsOverlap LoudzImgsOverlap--desktopPosition-{{ section.settings.image_position }} LoudzImgsOverlap--mobilePosition-{{ section.settings.image_mobile_position }}">
			<div class="LoudzImgsOverlap__Media LoudzImgsOverlap__Media--layout-{{ section.settings.image_layout }} LoudzImgsOverlap__Media--aspectRatio-{{ section.settings.aspect_ratio }}">
				<div class="LoudzImgsOverlapImages">
					{%- if section.settings.image_desktop != blank -%}
						{{-
							section.settings.image_desktop
							| image_url: width: section.settings.image_desktop.width
							| image_tag:
								sizes: "100vw",
								widths: "400, 600, 800, 1200, 1600, 1800, 2400, 2800, 3200",
								fetchpriority: "low",
								loading: "lazy",
								class: "LoudzImgsOverlap__Media--desktop"
						-}}
					{%- else -%}
						<img
							src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E"
							alt="Image with an abstract figure"
							width="580"
							height="580"
							loading="lazy"
							sizes="100vw"
							fetchpriority="low"
							class="LoudzImgsOverlap__Media--desktop"
						>
					{%- endif -%}
					{%- if section.settings.second_image_desktop != blank -%}
						{{-
							section.settings.second_image_desktop
							| image_url: width: section.settings.second_image_desktop.width
							| image_tag:
								sizes: "100vw",
								widths: "400, 600, 800, 1200, 1600, 1800, 2400, 2800, 3200",
								fetchpriority: "low",
								loading: "lazy",
								class: "LoudzImgsOverlap__Media--second-desktop"
						-}}
					{%- else -%}
						<img
							src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E"
							alt="Image with an abstract figure"
							width="580"
							height="580"
							loading="lazy"
							sizes="100vw"
							fetchpriority="low"
							class="LoudzImgsOverlap__Media--second-desktop"
						>
					{%- endif -%}
					{%- if mobile_image != blank -%}
						{{-
							mobile_image
							| image_url: width: mobile_image.width
							| image_tag:
								sizes: "100vw",
								widths: "400, 600, 800, 1200, 1600, 1800, 2400, 2800, 3200",
								fetchpriority: "low",
								loading: "lazy",
								class: "LoudzImgsOverlap__Media--mobile"
						-}}
					{%- else -%}
						<img
							src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E"
							alt="Image with an abstract figure"
							width="580"
							height="580"
							loading="lazy"
							sizes="100vw"
							fetchpriority="low"
							class="LoudzImgsOverlap__Media--mobile"
						>
					{%- endif -%}
					{%- if second_mobile_image != blank -%}
						{{-
							second_mobile_image
							| image_url: width: second_mobile_image.width
							| image_tag:
								sizes: "100vw",
								widths: "400, 600, 800, 1200, 1600, 1800, 2400, 2800, 3200",
								fetchpriority: "low",
								loading: "lazy",
								class: "LoudzImgsOverlap__Media--second-mobile"
						-}}
					{%- else -%}
						<img
							src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E"
							alt="Image with an abstract figure"
							width="580"
							height="580"
							loading="lazy"
							sizes="100vw"
							fetchpriority="low"
							class="LoudzImgsOverlap__Media--second-mobile"
						>
					{%- endif -%}
				</div>
			</div>
			<div class="LoudzImgsOverlap__Content">
				<div class="LoudzTextBox">
					{%- for block in section.blocks -%}
						{%- case block.type -%}
							{%- when "heading" -%}
								{%- if block.settings.heading_alternative_font -%}
									<style>
										{{- block.settings.heading_font | font_face: font_display: 'swap' -}}
									</style>
								{%- endif -%}
								{%- capture heading_css_variables -%}
									--block-heading-size-desktop: {{- block.settings.heading_size_desktop -}}px;
									--block-heading-size-mobile: {{- block.settings.heading_size_mobile -}}px;
									--block-heading-left-padding-desktop: {{- block.settings.heading_left_padding_desktop -}}px;
									--block-heading-right-padding-desktop: {{- block.settings.heading_right_padding_desktop -}}px;
									--block-heading-left-padding-mobile: {{- block.settings.heading_left_padding_mobile -}}px;
									--block-heading-right-padding-mobile: {{- block.settings.heading_right_padding_mobile -}}px;
									--block-heading-color: {{- block.settings.heading_color -}};
									--block-heading-font: {{- block.settings.heading_font.family -}};
									--block-heading-font-weight: {{- block.settings.heading_font_weight -}};
                  				{%- endcapture -%}
								<h2
									style="{{- heading_css_variables | strip_newlines | escape -}}"
									class="LoudzTextBox__Heading {% if block.settings.heading_alternative_font == true %}LoudzTextBox__Heading--alternativeFont{% endif %}"
									{{ block.shopify_attributes }}
								>
									{{- block.settings.heading -}}
								</h2>
							{%- when "text" -%}
								{%- if block.settings.description_alternative_font -%}
									{%- liquid
										assign body_font_bold = block.settings.description_font | font_modify: 'weight', 'bold'
										assign body_font_italic = block.settings.description_font | font_modify: 'style', 'italic'
										assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
									%}
									<style>
										{{- block.settings.description_font | font_face: font_display: 'swap' -}}
										{{ body_font_bold | font_face: font_display: 'swap' }}
										{{ body_font_italic | font_face: font_display: 'swap' }}
										{{ body_font_bold_italic | font_face: font_display: 'swap' }}
									</style>
								{%- endif -%}
								{%- capture description_css_variables -%}
									--block-description-size-desktop: {{- block.settings.description_size_desktop -}}px;
									--block-description-size-mobile: {{- block.settings.description_size_mobile -}}px;
									--block-description-color: {{- block.settings.description_color -}};
									--block-description-font: {{- block.settings.description_font.family -}};
                  				{%- endcapture -%}
								<div
									style="{{- description_css_variables | strip_newlines | escape -}}"
									class="LoudzTextBox__Description LoudzTextBox__Description--alignment-{{ section.settings.text_alignment }} {% if block.settings.description_alternative_font == true %}LoudzTextBox__Description--alternativeFont{% endif %}"
									{{ block.shopify_attributes }}
								>
									{{- block.settings.description -}}
								</div>
							{%- when "buttons" -%}
								{%- capture buttons_css_variables -%}
									--block-primary-button-text-color: {{- block.settings.primary_text_color -}};
									--block-primary-button-background-color: {{- block.settings.primary_background_color -}};
									--block-primary-button-corner-radius: {{- block.settings.primary_button_corner -}}px;
									--block-primary-button-border-color: {{- block.settings.primary_border_color -}};
					
									--block-secondary-button-text-color: {{- block.settings.secondary_text_color -}};
									--block-secondary-button-background-color: {{- block.settings.secondary_background_color -}};
									--block-secondary-button-corner-radius: {{- block.settings.secondary_button_corner -}}px;
									--block-secondary-button-border-color: {{- block.settings.secondary_border_color -}};
                  				{%- endcapture -%}
								<div
									style="{{- buttons_css_variables | strip_newlines | escape -}}"
									class="LoudzImgsOverlapButtons"
									{{ block.shopify_attributes }}
								>
									{%- if block.settings.primary_button_label != blank -%}
										<a
											{% if block.settings.primary_new_tab == true %}
												target="_blank"
											{% endif %}
											class="LoudzImgsOverlapButtons__Primary LoudzImgsOverlapButtons__Primary--{{ block.settings.primary_button_style }}"
											href="{{ block.settings.primary_button_link }}"
										>
											{{- block.settings.primary_button_label | escape -}}
										</a>
									{%- endif -%}
									{%- if block.settings.secondary_button_label != blank -%}
										<a
											{% if block.settings.secondary_new_tab == true %}
												target="_blank"
											{% endif %}
											class="LoudzImgsOverlapButtons__Secondary LoudzImgsOverlapButtons__Secondary--{{ block.settings.secondary_button_style }}"
											href="{{ block.settings.secondary_button_link }}"
										>
											{{- block.settings.secondary_button_label | escape -}}
										</a>
									{%- endif -%}
								</div>
						{%- endcase -%}
					{%- endfor -%}
				</div>
			</div>
		</div>
	</div>
</section>

{% schema %}
