			"max": 100,
			"step": 4,
			"unit": "px",
			"label": "Vertical gap between heading text and media (mobile version)",
			"default": 20
		},
		{
			"type": "range",
			"id": "desktop_horizontal_gap",
			"min": 0,
			"max": 100,
			"step": 4,
			"unit": "px",
			"label": "Horizontal column gap between media and content (desktop version)",
			"default": 40
		},
		{
			"type": "range",
			"id": "section_max_width",
			"min": 800,
			"max": 1600,
			"step": 50,
			"unit": "px",
			"label": "Max width",
			"default": 1200
		},
		{
			"type": "range",
			"id": "section_width_desktop",
			"min": 70,
			"max": 100,
