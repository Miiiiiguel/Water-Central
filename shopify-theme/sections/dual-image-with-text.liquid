					"value": "landscape",
					"label": "Landscape"
				}
			],
			"default": "portrait"
		},
		{
			"type": "select",
			"id": "image_layout",
			"label": "Image layout",
			"options": [
				{
					"value": "front-bottom",
					"label": "Front bottom"
				},
				{
					"value": "front-top",
					"label": "Front top"
				},
				{
					"value": "back-bottom",
					"label": "Back bottom"
				},
				{
					"value": "back-top",
					"label": "Back top"
				}
			],
			"default": "front-top"
		},
		{
			"type": "range",
			"id": "images_border_radius",
			"min": 0,
			"max": 50,
			"step": 1,
