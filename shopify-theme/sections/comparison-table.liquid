{% schema %}
{
  "name": "Comparison Table",
  "settings": [
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Section Top Spacing",
      "default": 100,
      "info": "Adjust the top padding inside this section."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Section Bottom Spacing",
      "default": 100,
      "info": "Adjust the bottom padding inside this section."
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "rem",
      "label": "Section Left/Right Padding (Mobile)",
      "default": 1,
      "info": "Horizontal padding for mobile, in rem."
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "rem",
      "label": "Section Left/Right Padding (Desktop)",
      "default": 5,
      "info": "Horizontal padding for desktop, in rem."
    },
    {
      "type": "header",
      "content": "Heading (Section Title)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Title",
      "default": "Comparison Table",
      "info": "Main heading text displayed above the table."
    },
    {
      "type": "checkbox",
      "id": "heading_custom",
      "label": "Use Custom Font for Heading",
      "default": false,
      "info": "Enable if you want a specific font for the main heading."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Section Title Font Family",
      "default": "assistant_n4",
      "info": "Choose the font for your main heading."
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 0,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Section Title Font Size",
      "default": 34,
      "info": "Adjust the size of the main heading text."
    },
    {
      "type": "range",
      "id": "heading_height",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "%",
      "label": "Section Title Line Height",
      "default": 100,
      "info": "Sets line height for the main heading."
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Section Title Alignment",
      "default": "center",
      "options": [
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ],
      "info": "Align the main heading text left, center, or right."
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Section Title Font Weight",
      "default": "bold",
      "options": [
        { "label": "Light", "value": "lighter" },
        { "label": "Normal", "value": "normal" },
        { "label": "Bold", "value": "bold" }
      ],
      "info": "Select the font weight for the main heading."
    },
    {
      "type": "header",
      "content": "Subheading"
    },
    {
      "type": "textarea",
      "id": "subheading_text",
      "label": "Subheading Text",
      "default": "Easily Compare Features, Pricing, and Benefits Side by Side to Find the Perfect Option for Your Needs",
      "info": "Text for the subheading that appears under the main heading."
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Subheading Font Size (Desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "subheading_font_size_mobile",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Subheading Font Size (Mobile)",
      "default": 15
    },
    {
      "type": "range",
      "id": "subheading_padding_horizontal",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Subheading Desktop Side Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "subheading_padding_horizontal_mobile",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Subheading Mobile Side Padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Table Header Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_logo_column_one",
      "label": "Enable Logo Image For Column One",
      "default": false,
      "info": "We recommend 400 x 300px. When enabled, hides the heading text in column one and displays a logo."
    },
    {
      "type": "image_picker",
      "id": "logo_image_column_one",
      "label": "Logo Image for Column One",
      "info": "We recommend 400 x 300px. Upload the logo image for Column One (shown if toggle is ON)."
    },
    {
      "type": "text",
      "id": "first_heading",
      "label": "Heading for Column One",
      "default": "Our Brand",
      "info": "Title used for the first comparison column."
    },
    {
      "type": "select",
      "id": "first_heading_weight",
      "label": "Column One Heading Font Weight",
      "default": "normal",
      "options": [
        { "label": "Light", "value": "lighter" },
        { "label": "Normal", "value": "normal" },
        { "label": "Bold", "value": "bold" }
      ]
    },
    {
      "type": "color",
      "id": "first_heading_color_custom",
      "label": "Column One Heading Color",
      "default": "#fff"
    },
    {
      "type": "text",
      "id": "second_heading",
      "label": "Heading for Column Two",
      "default": "Others",
      "info": "Title used for the second comparison column."
    },
    {
      "type": "select",
      "id": "second_heading_weight",
      "label": "Column Two Heading Font Weight",
      "default": "normal",
      "options": [
        { "label": "Light", "value": "lighter" },
        { "label": "Normal", "value": "normal" },
        { "label": "Bold", "value": "bold" }
      ]
    },
    {
      "type": "color",
      "id": "second_heading_color_custom",
      "label": "Column Two Heading Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "third_heading",
      "label": "Heading for Column Three",
      "info": "Title used for the third comparison column. Leave empty for only two columns."
    },
    {
      "type": "select",
      "id": "third_heading_weight",
      "label": "Column Three Heading Font Weight",
      "default": "normal",
      "options": [
        { "label": "Light", "value": "lighter" },
        { "label": "Normal", "value": "normal" },
        { "label": "Bold", "value": "bold" }
      ]
    },
    {
      "type": "color",
      "id": "third_heading_color_custom",
      "label": "Column Three Heading Color",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "table_heading_custom",
      "label": "Use Custom Font for Table Header",
      "default": false,
      "info": "Enable if you want a specific font for table headers."
    },
    {
      "type": "font_picker",
      "id": "table_heading_font",
      "label": "Table Header Font Family",
      "default": "assistant_n4",
      "info": "Choose the font for the table headers."
    },
    {
      "type": "range",
      "id": "table_heading_size",
      "min": 0,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Table Header Font Size",
      "default": 24,
      "info": "Set the font size for table column headers."
    },
    {
      "type": "range",
      "id": "table_heading_size_mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Table Header Font Size (Mobile)",
      "default": 10,
      "info": "Adjust the header font size on mobile devices."
    },
    {
      "type": "range",
      "id": "table_heading_height",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "%",
      "label": "Table Header Line Height",
      "default": 100,
      "info": "Sets the line height for the table column headers."
    },
    {
      "type": "select",
      "id": "table_heading_align",
      "label": "Table Header Text Align",
      "default": "center",
      "options": [
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ],
      "info": "Choose alignment for the table headers."
    },
    {
      "type": "range",
      "id": "table_heading_padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Table Header Padding (Side)",
      "default": 20,
      "info": "Horizontal padding for each table header cell."
    },
    {
      "type": "range",
      "id": "table_heading_padding_horizontal_mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Table Header Padding (Side) - Mobile",
      "default": 4,
      "info": "Horizontal padding for header cells on mobile."
    },
    {
      "type": "range",
      "id": "table_heading_padding_vertical",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Table Header Padding (Top/Bottom)",
      "default": 20,
      "info": "Vertical padding for each table header cell."
    },
    {
      "type": "range",
      "id": "table_heading_padding_vertical_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Table Header Padding (Top/Bottom) - Mobile",
      "default": 10,
      "info": "Vertical padding for table headers on mobile."
    },
    {
      "type": "header",
      "content": "Table Icons Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_icon_color_customizers",
      "label": "Enable Color Customizers for the Icons",
      "default": true,
      "info": "Toggle this to allow customizing the icons' default/active colors."
    },
    {
      "type": "image_picker",
      "id": "table_icon_check",
      "label": "Check Icon (Image)",
      "info": "Optional: upload an image for the Check icon."
    },
    {
      "type": "textarea",
      "id": "table_icon_check_svg",
      "label": "Check Icon (SVG Code)",
      "info": "Paste your custom SVG code for the Check icon."
    },
    {
      "type": "image_picker",
      "id": "table_icon_x",
      "label": "X Icon (Image)",
      "info": "Optional: upload an image for the X icon."
    },
    {
      "type": "textarea",
      "id": "table_icon_x_svg",
      "label": "X Icon (SVG Code)",
      "info": "Paste your custom SVG code for the X icon."
    },
    {
      "type": "range",
      "id": "table_icon_size",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Icon Size (Desktop)",
      "default": 26,
      "info": "The width & height of icons on desktop."
    },
    {
      "type": "range",
      "id": "table_icon_size_mobile",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Icon Size (Mobile)",
      "default": 20,
      "info": "The width & height of icons on mobile."
    },
    {
      "type": "header",
      "content": "Section Width Settings"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width Section",
      "info": "Check to stretch this section to full browser width."
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 0,
      "max": 400,
      "step": 10,
      "unit": "rem",
      "label": "Max Content Width",
      "default": 150,
      "info": "Controls how wide the content can stretch (in rem)."
    },
    {
      "type": "header",
      "content": "Table Settings"
    },
    {
      "type": "range",
      "id": "table_mt",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Spacing Above Table",
      "default": 82,
      "info": "Adds space above the table."
    },
    {
      "type": "range",
      "id": "table_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Table Corner Rounding",
      "default": 10,
      "info": "Controls the table’s overall border radius."
    },
    {
      "type": "range",
      "id": "table_border_thickness",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Table Border Thickness",
      "default": 2,
      "info": "Specifies how thick the table’s border is."
    },
    {
      "type": "select",
      "id": "table_column_active",
      "label": "Which Column is Highlighted?",
      "default": "1",
      "options": [
        {
          "label": "Column 1",
          "value": "1"
        },
        {
          "label": "Column 2",
          "value": "2"
        },
        {
          "label": "Column 3",
          "value": "3"
        }
      ],
      "info": "Choose which column you want to highlight."
    },
    {
      "type": "range",
      "id": "table_column_active_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Active Column Corner Rounding",
      "default": 10,
      "info": "Corner rounding for the highlighted column’s top and bottom."
    },
    {
      "type": "checkbox",
      "id": "enable_active_column_gradient",
      "label": "Enable Gradient Background for Active Column",
      "default": true,
      "info": "Toggle to allow the active column to use a gradient instead of a solid color."
    },
    {
      "type": "color",
      "id": "active_col_gradient_color_1",
      "label": "Active Column Gradient Color #1",
      "default": "#3D3D3D"
    },
    {
      "type": "color",
      "id": "active_col_gradient_color_2",
      "label": "Active Column Gradient Color #2",
      "default": "#303030"
    },
    {
      "type": "color",
      "id": "active_col_gradient_color_3",
      "label": "Active Column Gradient Color #3",
      "default": "#202020"
    },
    {
      "type": "select",
      "id": "active_col_gradient_degrees",
      "label": "Active Column Gradient Degrees",
      "default": "315deg",
      "options": [
        { "label": "0°", "value": "0deg" },
        { "label": "45°", "value": "45deg" },
        { "label": "90°", "value": "90deg" },
        { "label": "135°", "value": "135deg" },
        { "label": "180°", "value": "180deg" },
        { "label": "225°", "value": "225deg" },
        { "label": "270°", "value": "270deg" },
        { "label": "315°", "value": "315deg" }
      ]
    },
    {
      "type": "header",
      "content": "Table Row Settings"
    },
    {
      "type": "range",
      "id": "table_row_padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Row Horizontal Padding",
      "default": 20,
      "info": "Left & right padding for each table cell (rows)."
    },
    {
      "type": "range",
      "id": "table_row_padding_horizontal_mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Row Horizontal Padding (Mobile)",
      "default": 22,
      "info": "Left & right padding for table cells on mobile."
    },
    {
      "type": "range",
      "id": "table_row_padding_vertical",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Row Vertical Padding",
      "default": 20,
      "info": "Top & bottom padding for each table cell (rows)."
    },
    {
      "type": "range",
      "id": "table_row_padding_vertical_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Row Vertical Padding (Mobile)",
      "default": 12,
      "info": "Top & bottom padding for table cells on mobile."
    },
    {
      "type": "header",
      "content": "Table Row Heading Settings"
    },
    {
      "type": "checkbox",
      "id": "table_row_heading_custom",
      "label": "Use Custom Font for Row Headings",
      "default": false,
      "info": "Enable if you want a specific font for the row headings."
    },
    {
      "type": "font_picker",
      "id": "table_row_heading_font",
      "label": "Row Heading Font Family",
      "default": "assistant_n4",
      "info": "Choose the font for the row heading text."
    },
    {
      "type": "range",
      "id": "table_row_heading_size",
      "min": 0,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Row Heading Font Size",
      "default": 26,
      "info": "Controls how large the row headings appear."
    },
    {
      "type": "range",
      "id": "table_row_heading_size_mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Row Heading Font Size (Mobile)",
      "default": 10,
      "info": "Adjust the row heading size for mobile."
    },
    {
      "type": "range",
      "id": "table_row_heading_height",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "%",
      "label": "Row Heading Line Height",
      "default": 100,
      "info": "Sets the line height for row headings."
    },
    {
      "type": "select",
      "id": "table_row_heading_align",
      "label": "Row Heading Alignment",
      "default": "center",
      "options": [
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ],
      "info": "Align the row heading text."
    },
    {
      "type": "header",
      "content": "Section Colors"
    },
    {
      "type": "color",
      "label": "Main Heading Color",
      "id": "heading_color",
      "default": "#000",
      "info": "Choose the color for the main heading text."
    },
    {
      "type": "color",
      "label": "Table Border Color",
      "id": "table_border_color",
      "default": "#D7D8D5",
      "info": "Specifies the border color around table cells."
    },
    {
      "type": "color",
      "label": "Table Header Text",
      "id": "table_heading_color",
      "default": "#fff",
      "info": "Color for the table column headings."
    },
    {
      "type": "color",
      "label": "Table Header Text (Active)",
      "id": "table_heading_active_color",
      "default": "#FFFFFF",
      "info": "Text color for the highlighted column header."
    },
    {
      "type": "color",
      "label": "Active Column Background (solid)",
      "id": "table_column_active_bg_color",
      "default": "#000",
      "info": "Background color for the highlighted column (when gradient is off)."
    },
    {
      "type": "color",
      "label": "Row Heading Color",
      "id": "table_row_heading_color",
      "default": "#040200",
      "info": "Text color for the row headings (first cell)."
    },
    {
      "type": "color",
      "label": "Icon Default Color",
      "id": "table_icon_color",
      "default": "#ACACAC",
      "info": "Normal color of the Check/X icons."
    },
    {
      "type": "color",
      "label": "Icon Active Color",
      "id": "table_icon_active_color",
      "default": "#4594FF",
      "info": "Icon color for the highlighted column."
    },
    {
      "type": "color",
      "label": "Section Background",
      "id": "background_color",
      "default": "transparent",
      "info": "Background color behind the entire section."
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Section Background Gradient",
      "info": "Optional: add a gradient overlay behind the section."
    },
    {
      "type": "header",
      "content": "Entire Table Background"
    },
    {
      "type": "checkbox",
      "id": "enable_table_bg_gradient",
      "label": "Enable Background Gradient for Entire Table",
      "default": false,
      "info": "Use a gradient for the entire table background."
    },
    {
      "type": "color",
      "id": "table_bg_color",
      "label": "Table Background (Color #1)",
      "default": "#ffffff",
      "info": "Primary color for the table background."
    },
    {
      "type": "color",
      "id": "table_bg_color_2",
      "label": "Table Background (Color #2)",
      "default": "#ffffff",
      "info": "Second color for gradient (if enabled)."
    },
    {
      "type": "select",
      "id": "table_bg_gradient_degrees",
      "label": "Table Background Gradient Degrees",
      "default": "90deg",
      "options": [
        { "label": "0°", "value": "0deg" },
        { "label": "45°", "value": "45deg" },
        { "label": "90°", "value": "90deg" },
        { "label": "135°", "value": "135deg" },
        { "label": "180°", "value": "180deg" },
        { "label": "225°", "value": "225deg" },
        { "label": "270°", "value": "270deg" },
        { "label": "315°", "value": "315deg" }
      ],
      "info": "Choose the angle for the table's gradient background."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Row block",
      "settings": [
        {
          "type": "text",
          "id": "row_heading",
          "label": "Row Heading",
          "info": "Text for this row’s title (first cell)."
        },
        {
          "type": "select",
          "id": "row_heading_font_weight",
          "label": "Row Heading Font Weight",
          "default": "normal",
          "options": [
            { "label": "Light", "value": "lighter" },
            { "label": "Normal", "value": "normal" },
            { "label": "Bold", "value": "bold" }
          ]
        },
        {
          "type": "select",
          "id": "first_icon",
          "label": "Icon for Column One",
          "default": "check",
          "options": [
            {
              "label": "Check",
              "value": "check"
            },
            {
              "label": "X",
              "value": "x"
            }
          ],
          "info": "Choose Check or X for column one."
        },
        {
          "type": "select",
          "id": "second_icon",
          "label": "Icon for Column Two",
          "default": "check",
          "options": [
            {
              "label": "Check",
              "value": "check"
            },
            {
              "label": "X",
              "value": "x"
            }
          ],
          "info": "Choose Check or X for column two."
        },
        {
          "type": "select",
          "id": "third_icon",
          "label": "Icon for Column Three",
          "default": "check",
          "options": [
            {
              "label": "Check",
              "value": "check"
            },
            {
              "label": "X",
              "value": "x"
            }
          ],
