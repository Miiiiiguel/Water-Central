{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ table_heading_font | font_face: font_display: 'swap' }}

  .section-{{ section.id }} {
    border-top: solid {{ border_color }} {{ border_thickness }}px !important;
    border-bottom: solid {{ border_color }} {{ border_thickness }}px !important;
    margin-top: {{ margin_top | times: 0.75 | round: 0 }}px !important;
    margin-bottom: {{ margin_bottom | times: 0.75 | round: 0 }}px !important;
  }

  .section-{{ section.id }}-settings {
    margin: 0 auto !important;
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px !important;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px !important;
    /* Mobile left/right padding */
    justify-content: center;
    padding-left: {{ padding_horizontal_mobile }}rem !important;
    padding-right: {{ padding_horizontal_mobile }}rem !important;
  }

  .loudecoms-heading-{{ section.id }} {
    margin: 0 !important;
    font-size: {{ heading_size | times: 0.85 }}px !important;
    /* Font Weight from new setting */
    font-weight: {{ heading_font_weight }} !important;
    color: {{ heading_color }} !important;
    line-height: {{ heading_height }}% !important;
    text-transform: unset !important;
    text-align: {{ heading_align }} !important;
    display: block !important;
    width: 100% !important;
  }

  /* Subheading styles */
  .subheading-{{ section.id }} {
    font-size: {{ subheading_font_size_mobile }}px !important;
    text-align: {{ heading_align }} !important;
    padding-left: {{ subheading_padding_horizontal_mobile }}px !important;
    padding-right: {{ subheading_padding_horizontal_mobile }}px !important;
    margin: 10px auto 0 auto !important;
    line-height: 140% !important;
    display: block !important;
    width: 100% !important;
  }
  @media (min-width: 768px) {
    .subheading-{{ section.id }} {
      font-size: {{ subheading_font_size }}px !important;
      padding-left: {{ subheading_padding_horizontal }}px !important;
      padding-right: {{ subheading_padding_horizontal }}px !important;
    }
  }

  .loudecoms-body-{{ section.id }} {
    margin-top: {{ table_mt | times: 0.75 | round: 0 }}px !important;
  }

  .loudecoms-grid-{{ section.id }} {
    display: grid !important;
    {% if third_heading != blank %}
      grid-template-columns: 29% 24% 23.5% 23.5% !important;
    {% else %}
      grid-template-columns: 40% 30% 30% !important;
    {% endif %}
  }

  .loudecoms-item-{{ section.id }} {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  /* Active column gradient or solid color */
  .loudecoms-item-{{ section.id }}.active {
    {% if enable_active_column_gradient %}
      background: linear-gradient(
        {{ active_col_gradient_degrees }},
        {{ active_col_gradient_color_1 }},
        {{ active_col_gradient_color_2 }},
        {{ active_col_gradient_color_3 }}
      ) !important;
    {% else %}
      background-color: {{ table_column_active_bg_color }} !important;
    {% endif %}
  }

  .loudecoms-grid-header-{{ section.id }} .loudecoms-item-{{ section.id }} {
    padding: {{ table_heading_padding_vertical_mobile }}px {{ table_heading_padding_horizontal_mobile }}px !important;
  }

  .loudecoms-grid-header-{{ section.id }} .loudecoms-item-{{ section.id }}.active {
    border-top-left-radius: {{ table_column_active_radius }}px !important;
    border-top-right-radius: {{ table_column_active_radius }}px !important;
  }

  /* HEADINGS inside columns (by default) */
  .loudecoms-grid-header-{{ section.id }} .loudecoms-item-{{ section.id }} h3 {
    margin: 0 !important;
    font-size: {{ table_heading_size_mobile }}px !important;
    color: {{ table_heading_color }} !important;
    line-height: {{ table_heading_height }}% !important;
    text-transform: unset !important;
    text-align: {{ table_heading_align }} !important;
    display: block !important;
    width: 100% !important;
    font-weight: 700 !important;
  }

  /* Active column heading color */
  .loudecoms-grid-header-{{ section.id }} .loudecoms-item-{{ section.id }}.active h3 {
    color: {{ table_heading_active_color }} !important;
  }

  .loudecoms-grid-header-{{ section.id }} + .loudecoms-grid-{{ section.id }} .loudecoms-item-{{ section.id }}:first-child {
    border-top-left-radius: {{ table_radius }}px !important;
  }

  .loudecoms-grid-header-{{ section.id }} + .loudecoms-grid-{{ section.id }} .loudecoms-item-{{ section.id }}:last-child {
    border-top-right-radius: {{ table_radius }}px !important;
  }

  .loudecoms-grid-header-{{ section.id }} + .loudecoms-grid-{{ section.id }} .loudecoms-item-{{ section.id }}.active:last-child {
    border-top-right-radius: 0px !important;
  }

  .loudecoms-grid-rows-{{ section.id }} .loudecoms-item-{{ section.id }} {
    padding: {{ table_row_padding_vertical_mobile }}px {{ table_row_padding_horizontal_mobile }}px !important;
    border-top: {{ table_border_thickness }}px solid {{ table_border_color }} !important;
  }

  .loudecoms-grid-rows-{{ section.id }} .loudecoms-item-{{ section.id }}:first-child {
    border-left: {{ table_border_thickness }}px solid {{ table_border_color }} !important;
  }

  .loudecoms-grid-rows-{{ section.id }} .loudecoms-item-{{ section.id }}:last-child {
    border-right: {{ table_border_thickness }}px solid {{ table_border_color }} !important;
  }

  /* Active column border color override */
  .loudecoms-grid-rows-{{ section.id }} .loudecoms-item-{{ section.id }}.active {
    position: relative !important;
    border-color: {% if enable_active_column_gradient %}transparent{% else %}{{ table_column_active_bg_color }}{% endif %} !important;
  }

  .loudecoms-grid-rows-{{ section.id }} .loudecoms-item-{{ section.id }}.active::after {
    content: '' !important;
    position: absolute !important;
    width: 100% !important;
    height: 15px !important;
    left: 0 !important;
    bottom: -15px !important;
    {% if enable_active_column_gradient %}
      background: linear-gradient(
        {{ active_col_gradient_degrees }},
        {{ active_col_gradient_color_1 }},
        {{ active_col_gradient_color_2 }},
        {{ active_col_gradient_color_3 }}
      ) !important;
    {% else %}
      background-color: {{ table_column_active_bg_color }} !important;
    {% endif %}
    border-bottom-left-radius: {{ table_column_active_radius }}px !important;
    border-bottom-right-radius: {{ table_column_active_radius }}px !important;
  }

  .loudecoms-grid-rows-{{ section.id }}:last-child .loudecoms-item-{{ section.id }} {
    border-bottom: {{ table_border_thickness }}px solid {{ table_border_color }} !important;
  }

  .loudecoms-grid-rows-{{ section.id }}:last-child .loudecoms-item-{{ section.id }}.active {
    border-color: {% if enable_active_column_gradient %}transparent{% else %}{{ table_column_active_bg_color }}{% endif %} !important;
  }

  .loudecoms-grid-rows-{{ section.id }}:last-child .loudecoms-item-{{ section.id }}:first-child {
    border-bottom-left-radius: {{ table_radius }}px !important;
  }

  .loudecoms-grid-rows-{{ section.id }}:last-child .loudecoms-item-{{ section.id }}:last-child {
    border-bottom-right-radius: {{ table_radius }}px !important;
  }

  .loudecoms-grid-rows-{{ section.id }}:last-child .loudecoms-item-{{ section.id }}.active:last-child {
    border-bottom-right-radius: 0px !important;
  }

  .loudecoms-grid-rows-{{ section.id }}:last-child .loudecoms-item-{{ section.id }}.active:last-child::after {
    border-right: {{ table_border_thickness }}px solid {% if enable_active_column_gradient %}transparent{% else %}{{ table_column_active_bg_color }}{% endif %} !important;
    box-sizing: content-box !important;
  }

  /* Row heading (first cell in each row) */
  .loudecoms-grid-rows-{{ section.id }} .loudecoms-item-{{ section.id }}:first-child h3 {
    margin: 0 !important;
    font-size: {{ table_row_heading_size_mobile }}px !important;
    color: {{ table_row_heading_color }} !important;
    line-height: {{ table_row_heading_height }}% !important;
    text-transform: unset !important;
    text-align: {{ table_row_heading_align }} !important;
    display: block !important;
    width: 100% !important;
    font-weight: 700 !important;
  }

  /* ICONS */
  .loudecoms-icon-{{ section.id }} {
    width: {{ table_icon_size_mobile }}px !important;
    height: {{ table_icon_size_mobile }}px !important;
  }

  /* Only apply custom colors if the toggle is enabled */
  {% if enable_icon_color_customizers %}
    .loudecoms-icon-{{ section.id }}.icon-check-{{ section.id }} svg path,
    .loudecoms-icon-{{ section.id }}.icon-x-{{ section.id }} svg path {
      fill: {{ table_icon_color }} !important;
    }

    .loudecoms-item-{{ section.id }}.active .loudecoms-icon-{{ section.id }}.icon-check-{{ section.id }} svg path,
    .loudecoms-item-{{ section.id }}.active .loudecoms-icon-{{ section.id }}.icon-x-{{ section.id }} svg path {
      fill: {{ table_icon_active_color }} !important;
    }
  {% endif %}

  .loudecoms-icon-{{ section.id }} svg,
  .loudecoms-icon-{{ section.id }} img {
    display: block !important;
    object-fit: contain !important;
    width: 100% !important;
    height: 100% !important;
  }

  /* Single background color/gradient for entire table (all rows) */
  .loudecoms-grid-rows-{{ section.id }} {
    {% if enable_table_bg_gradient %}
      background: linear-gradient(
        {{ table_bg_gradient_degrees }},
        {{ table_bg_color }},
        {{ table_bg_color_2 }}
      ) !important;
    {% else %}
      background-color: {{ table_bg_color }} !important;
    {% endif %}
  }

  /* Logo Image (Column One) */
  .logo-image-col1-{{ section.id }} img.logo-image-col1-img-{{ section.id }} {
    max-width: 100% !important;
    text-align: center;
    object-fit: cover !important;
    display: block !important;
    height: 75px !important;
    justify-content: center;
  }

  @media(min-width: 350px) {
    .loudecoms-grid-{{ section.id }} {
      {% if third_heading != blank %}
        grid-template-columns: 38% 22% 20% 20% !important;
      {% else %}
        grid-template-columns: 40% 30% 30% !important;
      {% endif %}
    }
  }

  @media (max-width: 768px) {
    .logo-image-col1-{{ section.id }} img.logo-image-col1-img-{{ section.id }} {
      max-width: 100% !important;
      text-align: center;
      object-fit: cover !important;
      display: block !important;
      height: 45px !important;
    }
  }

  @media(min-width: 768px) {
    .section-{{ section.id }} {
      margin-top: {{ margin_top }}px !important;
      margin-bottom: {{ margin_bottom }}px !important;
    }

    /* Desktop left/right padding now driven by user setting */
    .section-{{ section.id }}-settings {
      padding-top: {{ padding_top }}px !important;
      padding-bottom: {{ padding_bottom }}px !important;
      padding-left: {{ padding_horizontal }}rem !important;
      padding-right: {{ padding_horizontal }}rem !important;
    }

    .loudecoms-grid-{{ section.id }} {
      {% if third_heading != blank %}
        grid-template-columns: 30% 22% 24% 24% !important;
      {% else %}
        grid-template-columns: 40% 28% 32% !important;
      {% endif %}
    }

    .loudecoms-heading-{{ section.id }} {
      font-size: {{ heading_size }}px !important;
    }

    .loudecoms-body-{{ section.id }} {
      margin-top: {{ table_mt }}px !important;
    }

    .loudecoms-grid-header-{{ section.id }} .loudecoms-item-{{ section.id }} {
      padding: {{ table_heading_padding_vertical }}px {{ table_heading_padding_horizontal }}px !important;
    }

    .loudecoms-grid-header-{{ section.id }} .loudecoms-item-{{ section.id }} h3 {
      font-size: {{ table_heading_size }}px !important;
    }

    .loudecoms-grid-rows-{{ section.id }} .loudecoms-item-{{ section.id }} {
      padding: {{ table_row_padding_vertical }}px {{ table_row_padding_horizontal }}px !important;
    }

    .loudecoms-grid-rows-{{ section.id }} .loudecoms-item-{{ section.id }}.active::after {
      height: 25px !important;
      bottom: -25px !important;
    }

    .loudecoms-grid-rows-{{ section.id }} .loudecoms-item-{{ section.id }}:first-child h3 {
      font-size: {{ table_row_heading_size }}px !important;
    }

    .loudecoms-icon-{{ section.id }} {
      width: {{ table_icon_size }}px !important;
      height: {{ table_icon_size }}px !important;
    }
  }
{%- endstyle -%}

{% unless full_width %}
  <style>
    .section-{{ section.id }}-settings {
      max-width: {{ content_width }}rem !important;
    }
  </style>
{% endunless %}

{% if heading_custom %}
  <style>
    .loudecoms-heading-{{ section.id }} {
      font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }} !important;
      font-weight: {{ heading_font.weight }} !important;
      font-style: {{ heading_font.style }} !important;
    }
  </style>
{% endif %}

{% if table_heading_custom %}
  <style>
    .loudecoms-grid-header-{{ section.id }} .loudecoms-item-{{ section.id }} h3 {
      font-family: {{ table_heading_font.family }}, {{ table_heading_font.fallback_families }} !important;
      font-weight: {{ table_heading_font.weight }} !important;
      font-style: {{ table_heading_font.style }} !important;
    }
  </style>
{% endif %}

{% if table_row_heading_custom %}
  <style>
    .loudecoms-grid-rows-{{ section.id }} .loudecoms-item-{{ section.id }}:first-child h3 {
      font-family: {{ table_row_heading_font.family }}, {{ table_row_heading_font.fallback_families }} !important;
      font-weight: {{ table_row_heading_font.weight }} !important;
      font-style: {{ table_row_heading_font.style }} !important;
    }
  </style>
{% endif %}

<div
  class="section-{{ section.id }} loudecoms-{{ section.id }}"
  style="background-color:{{ background_color }} !important; background-image: {{ background_gradient }} !important;"
>
  <div class="section-{{ section.id }}-settings">
    {% if heading != blank %}
      <h2 class="loudecoms-heading-{{ section.id }}">{{ heading }}</h2>
    {% endif %}
    {% if subheading_text != blank %}
      <div class="subheading-{{ section.id }}">
        {{ subheading_text }}
      </div>
    {% endif %}

    <div class="loudecoms-body-{{ section.id }}">
      <div class="loudecoms-grid-{{ section.id }} loudecoms-grid-header-{{ section.id }}">
        <!-- Empty top-left cell -->
        <div class="loudecoms-item-{{ section.id }}"></div>

        <!-- Column 1 Heading or Logo -->
        <div class="loudecoms-item-{{ section.id }} {% if table_column_active == '1' %}active{% endif %}">
          {% if enable_logo_column_one and logo_image_column_one != blank %}
            <!-- Show Logo -->
            <div class="logo-image-col1-{{ section.id }}">
              <img
                src="{{ logo_image_column_one | image_url }}"
                alt="Logo Column One"
                class="logo-image-col1-img-{{ section.id }}"
              >
            </div>
          {% else %}
            <!-- Show Heading Text -->
            <h3
              style="
                font-weight: {{ first_heading_weight }} !important;
                color: {{ first_heading_color_custom }} !important;
              "
            >
              {{ first_heading }}
            </h3>
          {% endif %}
        </div>

        <!-- Column 2 Heading -->
        <div class="loudecoms-item-{{ section.id }} {% if table_column_active == '2' %}active{% endif %}">
          <h3
            style="
              font-weight: {{ second_heading_weight }} !important;
              color: {{ second_heading_color_custom }} !important;
            "
          >
            {{ second_heading }}
          </h3>
        </div>

        <!-- Column 3 Heading (if any) -->
        {% if third_heading != blank %}
          <div class="loudecoms-item-{{ section.id }} {% if table_column_active == '3' %}active{% endif %}">
            <h3
              style="
                font-weight: {{ third_heading_weight }} !important;
                color: {{ third_heading_color_custom }} !important;
              "
            >
              {{ third_heading }}
            </h3>
          </div>
        {% endif %}
      </div>

      {% for block in section.blocks %}
        {% assign row_weight = block.settings.row_heading_font_weight %}
        <div class="loudecoms-grid-{{ section.id }} loudecoms-grid-rows-{{ section.id }}">
          <!-- Row heading cell -->
          <div class="loudecoms-item-{{ section.id }}">
            <h3 style="font-weight: {{ row_weight }} !important;">
              {{ block.settings.row_heading }}
            </h3>
          </div>

          <!-- Column 1 cell -->
          <div class="loudecoms-item-{{ section.id }} {% if table_column_active == '1' %}active{% endif %}">
            <div class="loudecoms-icon-{{ section.id }} icon-{{ block.settings.first_icon }}-{{ section.id }}">
              {% if block.settings.first_icon == 'check' %}
                {{ icon_check }}
              {% else %}
                {{ icon_x }}
              {% endif %}
            </div>
          </div>

          <!-- Column 2 cell -->
          <div class="loudecoms-item-{{ section.id }} {% if table_column_active == '2' %}active{% endif %}">
            <div class="loudecoms-icon-{{ section.id }} icon-{{ block.settings.second_icon }}-{{ section.id }}">
              {% if block.settings.second_icon == 'check' %}
                {{ icon_check }}
              {% else %}
                {{ icon_x }}
              {% endif %}
            </div>
          </div>

          <!-- Column 3 cell (if any) -->
          {% if third_heading != blank %}
            <div class="loudecoms-item-{{ section.id }} {% if table_column_active == '3' %}active{% endif %}">
              <div class="loudecoms-icon-{{ section.id }} icon-{{ block.settings.third_icon }}-{{ section.id }}">
                {% if block.settings.third_icon == 'check' %}
                  {{ icon_check }}
                {% else %}
                  {{ icon_x }}
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>
