{%- liquid    
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme
  assign reset_spacing = ''
  if section_st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif

  assign column_gap = section_st.column_gap
  assign items_per_row = section_st.items_per_row
  assign items_to_show = section_st.items_to_show

  assign heading = section_st.heading
  assign description = section_st.description

  assign data_free_scroll = ''
  if section_st.items_per_row_mobile > 1 and section_st.items_per_row_mobile < 2
    assign data_free_scroll = 'true'
  endif

  assign show_arrow = section_st.show_arrow
  assign carousel_pagination = section_st.carousel_pagination
  assign infinite = section_st.infinite
  assign autoplay = section_st.autoplay
  assign autorotate_speed = section_st.autorotate_speed

  assign reveal = section_st.reveal
  assign scroll_animation = settings.scroll_animation

  # helper: whether we actually have products
  assign has_products = false
  if section_st.collection and section_st.collection.products_count > 0
    assign has_products = true
  endif
-%}

{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; 
  --section-pb: {{ section_st.padding_bottom }};
  /* NEW: gap variables for View All spacing */
  --gap-viewall-desktop: {{ section_st.gap_products_viewall_desktop | default: 30 }}px;
  --gap-viewall-mobile:  {{ section_st.gap_products_viewall_mobile  | default: 20 }}px;
{%- endcapture -%}

{%- capture col_style -%}
{% if column_gap < 15 %}
  --col-gap: {{ column_gap }}px;
{% else %}
  --col-gap: 15px;--col-gap-desktop: {{ column_gap }}px;
{% endif %}
{%- endcapture -%}

<div
  id="section-{{ section.id }}"
  class="
    section
    {% if section_st.padding_top < 30 %} pt-min{% endif %}
    {% if section_st.padding_bottom < 30 %} pb-min{% endif %}
    sec__products-carousel
    color-{{ color_scheme }}
    gradient{{ reset_spacing }}
    {% if reveal %} overflow-hidden{% endif %}
  "
  style="{{ style | strip | strip_newlines }}"
>
  <!-- Inline styles (hide wishlist, placeholder styling) -->
  <style>
    /* Hide any heart/wishlist buttons inside this section */
    #section-{{ section.id }} .product-item__button-wishlist,
    #section-{{ section.id }} .wishlist,
    #section-{{ section.id }} [data-wishlist],
    #section-{{ section.id }} .js-wishlist,
    #section-{{ section.id }} .card__wishlist {
      display: none !important;
      visibility: hidden !important;
      pointer-events: none !important;
    }

    /* Hide navigation arrows on mobile if disabled */
    @media (max-width: 767px) {
      #section-{{ section.id }} .hide-arrow-on-mobile {
        display: none !important;
      }
    }

    /* Navigation arrows hover transition */
    #section-{{ section.id }} .modern-arrow {
      transition: color 0.3s ease;
    }
    #section-{{ section.id }} .modern-arrow:hover {
      color: {{ section_st.arrow_hover_color }};
    }

    /* Primary button and hover styles (including the "View All" button) */
    #section-{{ section.id }} :is(.btn-primary) {
      background-color: var(--primary-button-bg-color, #0033FF);
      color: var(--primary-button-text-color, #FFFFFF);
      border: var(--primary-button-border-weight, 1px) solid var(--primary-button-border-color, #000000);
      border-radius: var(--primary-button-border-radius, 8px);
      font-size: 16px;
      padding: 11px 18px !important;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none !important;
    }
    #section-{{ section.id }} :is(.btn-primary:hover) {
      background-color: var(--primary-button-hover-bg-color, #0056FF);
      color: var(--primary-button-hover-text-color, #FFFFFF);
      text-decoration: none !important;
    }

    /* Set the inner SVG size based on the Arrow Size setting */
    #section-{{ section.id }} .modern-arrow svg {
      width: {{ section_st.arrow_size }}px;
      height: {{ section_st.arrow_size }}px;
    }

    /* -------- Placeholder card visual styles -------- */
    #section-{{ section.id }} .ph-card {
      display: flex;
      flex-direction: column;
      gap: 10px;
      background: #fff;
      border-radius: 6px;
      overflow: hidden;
      height: 100%;
    }

    /* Soft tile background like the screenshot, but keep image clear */
    #section-{{ section.id }} .ph-media-wrap {
      background: #F6EFEA; /* light warm tile */
      border-radius: 6px;
      margin: 0;
      position: relative;
      overflow: hidden;
    }

    /* Instagram-style 4:5 image area */
    #section-{{ section.id }} .ph-media {
      width: 100%;
      aspect-ratio: 4 / 5;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      display: block;
      user-select: none;
      -webkit-user-drag: none;
    }

    /* Placeholder title (shown only when no collection selected) */
    #section-{{ section.id }} .ph-title {
      margin: 8px 6px 0;
      text-align: center;
      font-size: 14px;
      line-height: 1.35;
      color: #1b1b1b;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Default spacing between slides uses your variables */
    #section-{{ section.id }} .swiper-wrapper {
      gap: var(--col-gap, 15px);
    }
    @media (min-width: 992px) {
      #section-{{ section.id }} .swiper-wrapper {
        gap: var(--col-gap-desktop, 15px);
      }
    }

    /* Tighter gap ONLY when placeholders are showing */
    #section-{{ section.id }} .placeholder-mode .swiper-wrapper {
      gap: 10px;
    }
    @media (min-width: 992px) {
      #section-{{ section.id }} .placeholder-mode .swiper-wrapper {
        gap: 16px;
      }
    }

    /* Existing: Mobile-only control for space between products and dots */
    @media (max-width: 767.98px) {
      #section-{{ section.id }} .swiper-pagination {
        margin-top: {{ section_st.mobile_bullets_gap | default: 12 }}px;
      }
    }

    /* NEW: Responsive spacing before the bottom View All button */
    #section-{{ section.id }} .view-all-wrap {
      margin-top: var(--gap-viewall-desktop);
    }
    @media (max-width: 767.98px) {
      #section-{{ section.id }} .view-all-wrap {
        margin-top: var(--gap-viewall-mobile);
      }
    }
  </style>

  <div class="{{ section_width }}">
    {% if heading != blank or description != blank %}
      <div
        class="
          section__header
          text-{{ section_st.header_alignment }}
          {% if section_st.section_width == 'full_width' %} px-20{% endif %}
          {% if section_st.show_view_all_button %} flex gap-15 gap-md-30 flex-wrap
            {% if section_st.header_alignment == 'center'  %} justify-content-{{ section_st.header_alignment }}
            {% else %} justify-between {% endif %}
            align-center
            {% if section_st.header_alignment == 'right' %} flex-row-reverse{% endif %}
          {% endif %}
        "
        style="margin-bottom: {{ section_st.vertical_gap_description_products }}px;"
      >
        {% if section_st.heading != blank or section_st.description != blank %}
          <div class="section__header-inner">
            {% if section_st.heading != blank %}
              <h2
                class="
                  section__header-heading
                  heading-letter-spacing
                  {% if scroll_animation != 'none' %}scroll-trigger {{ scroll_animation }}{% endif %}
                  mt-0
                  {% if section_st.description == blank %} mb-0{% endif %}
                "
                style="
                  {% if scroll_animation != 'none' %}--animation-order: 0;{% endif %}
                  font-size: {{ section_st.header_font_size }}px;
                  margin-bottom: {{ section_st.vertical_gap_header_description }}px;
                "
              >
                {{ section_st.heading }}
              </h2>
            {% endif %}
            {% if section_st.description != blank %}
              <div
                class="
                  section__header-des
                  {% if scroll_animation != 'none' %}scroll-trigger {{ scroll_animation }}{% endif %}
                  rich__text-m0
                "
                {% if scroll_animation != 'none' %}
                  style="--animation-order: 1;"
                {% endif %}
                style="font-size: {{ section_st.description_font_size }}px;"
              >
                {{ section_st.description }}
              </div>
            {% endif %}
          </div>
        {% endif %}
        {% if section_st.show_view_all_button and section_st.header_alignment != 'center' %}
          <a
            class="inline-flex no-underline btn-primary"
            href="{{ section_st.collection.url }}"
            aria-label="View All"
          >
            View All
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if section_st.items_per_row_mobile > 1 and section_st.items_per_row_mobile < 2 %}
      <div class="free-scroll">
    {% endif %}

    <slide-section
      class="swiper{% if reveal %} reveal_on_scroll{% endif %} {% unless has_products %}placeholder-mode{% endunless %}"
      data-section-id="{{ section.id }}"
      data-autoplay="{{ autoplay }}"
      data-effect="slide"
      data-loop="{{ infinite }}"
      data-speed="500"
      data-autoplay-speed="{{ autorotate_speed }}"
      data-spacing="{{ column_gap }}"
      data-mobile="{{ section_st.items_per_row_mobile }}"
      data-desktop="{{ items_per_row }}"
      data-free-scroll="{{ data_free_scroll }}"
      data-pagination-progressbar="{% if carousel_pagination == 'show_progress_bar' %}true{% else %}false{% endif %}"
      style="{{ col_style | strip | strip_newlines }}"
      data-arrow-centerimage="1"
    >
      {% if show_arrow %}
        <div
          class="swiper-button-prev modern-arrow {% if section_st.disable_arrows_on_mobile %}hide-arrow-on-mobile{% endif %}"
          style="
            color: {{ section_st.arrow_color }};
            background-color: {{ section_st.icon_background_color }};
            border-radius: 50%;
            width: {{ section_st.icon_background_size }}px;
            height: {{ section_st.icon_background_size }}px;
            display: flex;
            align-items: center;
            justify-content: center;
          "
        >
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" />
          </svg>
        </div>
        <div
          class="swiper-button-next modern-arrow {% if section_st.disable_arrows_on_mobile %}hide-arrow-on-mobile{% endif %}"
          style="
            color: {{ section_st.arrow_color }};
            background-color: {{ section_st.icon_background_color }};
            border-radius: 50%;
            width: {{ section_st.icon_background_size }}px;
            height: {{ section_st.icon_background_size }}px;
            display: flex;
            align-items: center;
            justify-content: center;
          "
        >
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z" />
          </svg>
        </div>
      {% endif %}
      <div class="swiper-wrapper">
        {% if has_products %}
          {% for product in section_st.collection.products limit: items_to_show %}
            {% render 'product-item',
              card_product: product,
              section_id: section.id,
              container: section_width,
              colunm: items_per_row,
              colunm_mobile: section_st.items_per_row_mobile,
              padding: column_gap,
              class: 'swiper-slide',
              template_enable_action: true,
              template_enable_product_vendor: true,
              template_enable_rate: true,
              template_enable_product_short_description: true,
              template_enable_color_swatches: true,
              template_enable_price: true,
              template_enable_add_cart: true,
              scroll_animation: scroll_animation,
              indexFor: forloop.index,
              template_enable_product_badges: true
            %}
          {% endfor %}
        {% else %}
          {%- assign placeholder_count = 10 -%}
          {%- for i in (1..placeholder_count) -%}
            <div class="swiper-slide">
              <div class="ph-card">
                <div class="ph-media-wrap">
                  <div
                    class="ph-media"
                    style="background-image:url('https://artistintelligence.org/wp-content/uploads/2015/08/import_placeholder.png');"
                    role="img"
                    aria-label="Product Placeholder"
                  ></div>
                </div>
                <!-- Single placeholder title only when no collection is selected -->
                <div class="ph-title">Product Title</div>
              </div>
            </div>
          {%- endfor -%}
        {% endif %}
      </div>

      {%- if carousel_pagination == 'show_dots'
        or carousel_pagination == 'show_dots_on_mobile'
        or carousel_pagination == 'show_progress_bar'
      -%}
        <div
          class="
            swiper-pagination
            flex
            flex-wrap
            px-15
            lh-1
            bottom-30
            {% if carousel_pagination == 'show_dots_on_mobile' %} hidden-md{% endif %}
            justify-content-center
          "
          style="
            --swiper-pagination-bottom: 3rem;
            --swiper-pagination-position: static;
            --dots-color: {{ section_st.dots_color }};
            --dots-active-color: {{ section_st.dots_active_color }};
            --dots-size: {{ section_st.dots_size }}px;
            --dots-spacing: {{ section_st.dots_spacing }}px;
          "
        ></div>
      {% endif %}
    </slide-section>

    {% if section_st.show_view_all_button and section_st.header_alignment == 'center' %}
      <!-- NEW: use responsive CSS variables instead of fixed margin class -->
      <div class="text-center view-all-wrap">
        <a
          class="inline-flex no-underline btn-primary"
          href="{{ section_st.collection.url }}"
          aria-label="View All"
        >
          View All
        </a>
      </div>
    {% endif %}
    {% if section_st.items_per_row_mobile > 1 and section_st.items_per_row_mobile < 2 %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product Recommendations",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section: Padding & Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Spacing (px)",
      "default": 15,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "info": "Adjust the space above this section."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Spacing (px)",
      "default": 15,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "info": "Adjust the space below this section."
    },
    {
      "type": "header",
      "content": "Layout & Color Theme"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Container Width",
      "default": "container",
      "options": [
        { "value": "container", "label": "Boxed Container" },
        { "value": "fluid_container", "label": "Fluid Container" },
        { "value": "stretch_width", "label": "Stretched Width" },
        { "value": "full_width", "label": "Full Width" }
      ],
      "info": "Select the container style for the section."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Theme",
      "default": "scheme-1",
      "info": "Choose a color scheme to style this section."
    },
    {
      "type": "header",
      "content": "Section Title & Description"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Section Title",
      "default": "Recommended Products",
      "info": "Enter the title for the carousel header."
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "Section Description",
      "default": "Experience the all-in-one shopping experience!",
      "info": "Provide a short description for the header."
    },
    {
      "type": "checkbox",
      "id": "show_view_all_button",
      "label": "Show 'View All' Button",
      "info": "Display a button linking to the full collection if enabled."
    },
    {
      "type": "range",
      "id": "header_font_size",
      "label": "Title Font Size (px)",
      "default": 34,
      "min": 12,
      "max": 80,
      "step": 1,
      "unit": "px",
      "info": "Set the font size for the header text."
    },
    {
      "type": "range",
      "id": "vertical_gap_header_description",
      "label": "Gap Between Title & Description (px)",
      "default": 11,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "info": "Adjust the space between the header and the description."
    },
    {
      "type": "range",
      "id": "vertical_gap_description_products",
      "label": "Gap Between Description & Products (px)",
      "default": 46,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "info": "Control the vertical space between the description and products."
    },

    
    {
      "type": "range",
      "id": "gap_products_viewall_desktop",
      "label": "Gap: Products ↔ View All (Desktop)",
      "default": 60,
      "min": 0,
      "max": 160,
      "step": 10,
      "unit": "px",
      "info": "Space between the product carousel and the bottom View All button on desktop."
    },
    {
      "type": "range",
      "id": "gap_products_viewall_mobile",
      "label": "Gap: Products ↔ View All (Mobile)",
      "default": 40,
      "min": 0,
      "max": 160,
      "step": 10,
      "unit": "px",
      "info": "Space between the product carousel and the bottom View All button on mobile."
    },

    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left Align" },
        { "value": "center", "label": "Center Align" },
        { "value": "right", "label": "Right Align" }
      ],
      "info": "Choose the alignment for the header text."
    },
    {
      "type": "header",
      "content": "Product Collection & Display"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Product Collection",
      "info": "Choose which product collection to display in the carousel."
    },
    {
      "type": "range",
      "id": "items_to_show",
      "label": "Number of Products to Show",
      "min": 2,
      "max": 25,
      "step": 1,
      "default": 5,
      "info": "Set the maximum number of products to display."
    },
    {
      "type": "range",
      "id": "items_per_row",
      "label": "Products per Row (Desktop)",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4,
      "info": "Determine how many products appear per row on desktop."
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column Gap (px)",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 20,
      "unit": "px",
      "info": "Set the spacing between product columns."
    },
    {
      "type": "header",
      "content": "Mobile Display Settings"
    },
    {
      "type": "range",
      "id": "items_per_row_mobile",
      "label": "Products per Row (Mobile)",
      "min": 1,
      "max": 2,
      "step": 0.5,
      "default": 2,
      "info": "Configure how many products are shown per row on mobile."
    },
    {
      "type": "range",
      "id": "mobile_bullets_gap",
      "label": "Gap: Products ↔ Dots (Mobile)",
      "default": 12,
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "info": "Adds vertical space between the product slides and pagination dots on mobile only."
    },
    {
      "type": "header",
      "content": "Carousel Behavior"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show Navigation Arrows",
      "default": true,
      "info": "Toggle to display next/prev arrows on the carousel."
    },
    {
      "type": "select",
      "id": "carousel_pagination",
      "label": "Pagination (Mobile)",
      "options": [
        { "value": "disable", "label": "Disable Dots" },
        { "value": "show_dots_on_mobile", "label": "Show Dots on Mobile" }
      ],
      "info": "Choose whether to display pagination dots on mobile."
    },
    {
      "type": "checkbox",
      "id": "infinite",
      "label": "Enable Infinite Loop",
      "default": false,
      "info": "Enable continuous looping of the carousel slides."
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Auto-Advance",
      "default": true,
      "info": "Automatically move to the next slide after a delay."
    },
    {
      "type": "range",
      "id": "autorotate_speed",
      "label": "Slide Interval (seconds)",
      "max": 6,
      "min": 2,
      "step": 1,
      "unit": "s",
      "default": 5,
      "info": "Set the time interval between automatic slide transitions."
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Enable Reveal Animation",
      "default": false,
      "info": "Apply an animation effect when the carousel appears."
    },
    {
      "type": "header",
      "content": "Navigation Arrows Styling"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow Color",
      "default": "#3D3D3D",
      "info": "Set the color for the navigation arrows."
    },
    {
      "type": "range",
      "id": "arrow_size",
      "label": "Arrow Size (px)",
      "default": 33,
      "min": 16,
      "max": 64,
      "step": 1,
      "unit": "px",
      "info": "Adjust the size of the navigation arrows."
    },
    {
      "type": "color",
      "id": "icon_background_color",
      "label": "Icon Background Color",
      "default": "#ffffff",
      "info": "Customize the background color for the navigation arrow icons."
    },
    {
      "type": "range",
      "id": "icon_background_size",
      "label": "Icon Background Size (px)",
      "default": 47,
      "min": 16,
      "max": 100,
      "step": 1,
      "unit": "px",
      "info": "Adjust the size of the icon background circle."
    },
    {
      "type": "checkbox",
      "id": "disable_arrows_on_mobile",
      "label": "Hide Arrows on Mobile",
      "default": false,
      "info": "Remove navigation arrows on mobile devices if enabled."
    }
  ],
  "presets": [
    {
      "name": "Product Recommendations ",
           	"category": "Products"
    }
  ]
}
{% endschema %}
