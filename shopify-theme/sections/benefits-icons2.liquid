{% style %}
:root {
--loudz-neutral-70: #5e5e5e;
--loudz-neutral-01: #fff;
--loudz-size-2: 2px;
--loudz-size-8: 8px;
--loudz-size-14: 14px;
--loudz-size-16: 16px;
--loudz-size-20: 20px;
--loudz-size-24: 24px;
--loudz-size-32: 32px;
--loudz-size-40: 40px;
--loudz-size-64: 64px;
--loudz-font-weight-400: 400;
--loudz-font-weight-600: 600;
--loudz-line-height-140: 1.4;
--loudz-color-bg-fill-inverse-on-light: var(--loudz-neutral-01);
--loudz-color-text-disable-on-light: var(--loudz-neutral-70);
--loudz-space-2: var(--loudz-size-2);
--loudz-space-8: var(--loudz-size-8);
--loudz-space-16: var(--loudz-size-16);
--loudz-space-20: var(--loudz-size-20);
--loudz-space-24: var(--loudz-size-24);
--loudz-space-32: var(--loudz-size-32);
--loudz-space-40: var(--loudz-size-40);
--loudz-space-64: var(--loudz-size-64);
--loudz-font-size-14: var(--loudz-size-14);
}


{% endstyle %}



<section class="Loudz-{{ section.id | handle }} LoudzValueIcons {% if section.settings.section_width == 100 %}LoudzValueIcons--fullWidth{% endif %}">
	<div
		class="
			LoudzValueIconsContainer
			LoudzValueIconsContainer--backgroundStyle-color
		"
		style="background-color: {{ section.settings.section_background | default: '#ffffff' }};"
	>
		{%- if section.settings.heading != blank -%}
			<h2
				class="
					LoudzValueIconsHeading
					LoudzValueIconsHeading--alignment-{{ section.settings.heading_alignment }}
					LoudzValueIconsHeading--style-{{ section.settings.heading_style }}
				"
			>
				{{ section.settings.heading }}
			</h2>
		{%- endif -%}

		<ul class="LoudzValueIconsList LoudzValueIconsList--mobileLayout-{{ section.settings.icons_mobile_layout }}">
			{%- for block in section.blocks -%}
				{% capture loudz_icon %}
