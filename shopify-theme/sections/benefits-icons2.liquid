				{%- liquid
					assign heading = block.settings.icon_title
					assign description = block.settings.icon_description
					assign icon = block.settings.icon
					assign font_awesome = block.settings.font_awesome
					assign custom_icon = block.settings.custom_icon
				-%}

				<li
					class="LoudzValueIconsBlock"
					{{ block.shopify_attributes }}
				>
					<div class="LoudzValueIconsBlock__IconWrapper">
						{%- if font_awesome != blank -%}
							{% unless content_for_header contains "font-awesome" %}
								<link
									rel="stylesheet"
									href="https://use.fontawesome.com/releases/v5.15.4/css/all.css"
									integrity="sha384-DyZ88mC6Up2uqS4h/KRgHuoeGwBcD4Ng9SiP4dIRy0EXTlnuz47vAwmeGwVChigm"
									crossorigin="anonymous"
								>
							{% endunless %}
							<div class="LoudzValueIconsBlock__Icon">
								{{ font_awesome }}
							</div>
						{%- elsif icon != "none" -%}
							<div class="LoudzValueIconsBlock__Icon">
								{{ loudz_icon }}
							</div>
						{%- elsif custom_icon != blank -%}
							<div class="LoudzValueIconsBlock__Icon">
								{{-
									custom_icon
									| image_url: width: custom_icon.width
									| image_tag:
										sizes: "100vw",
										widths: "400, 600, 800, 1200, 1600, 1800, 2400, 2800, 3200",
										fetchpriority: "low",
										loading: "lazy"
								-}}
							</div>
						{%- else -%}
							<div class="LoudzValueIconsBlock__Icon">
								<img
									src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E"
									alt="Image with an abstract figure"
									width="580"
									height="580"
									loading="lazy"
									sizes="100vw"
									fetchpriority="low"
									class="LoudzValueIconsBlock__IconDefault"
								>
							</div>
						{%- endif -%}
					</div>
					<div class="LoudzValueIconsBlock__TextContent">
						{%- if heading != blank -%}
							<h5 class="LoudzValueIconsBlock__Heading">
								{{- heading -}}
							</h5>
						{%- endif -%}
						{%- if description != blank -%}
							<p class="LoudzValueIconsBlock__Description">
								{{- description -}}
							</p>
						{%- endif -%}
					</div>
				</li>
			{%- endfor -%}
		</ul>
	</div>
</section>

