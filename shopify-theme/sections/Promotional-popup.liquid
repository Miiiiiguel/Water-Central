{%- style -%}
  {{ button_font | font_face: font_display: 'swap' }}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ text_font | font_face: font_display: 'swap' }}
  {{ input_font | font_face: font_display: 'swap' }}
  {{ submit_font | font_face: font_display: 'swap' }}
  {{ copy_font | font_face: font_display: 'swap' }}

  .section-{{ section.id }} {
    border-top: solid {{ border_color }} {{ border_thickness }}px !important;
    border-bottom: solid {{ border_color }} {{ border_thickness }}px !important;
    margin-top: {{ margin_top | times: 0.75 | round: 0 }}px !important;
    margin-bottom: {{ margin_bottom | times: 0.75 | round: 0 }}px !important;
  }

  .section-{{ section.id }}-settings {
    margin: 0 auto !important;
    padding-top: {{ padding_top | times: 0.75 | round: 0 }}px !important;
    padding-bottom: {{ padding_bottom | times: 0.75 | round: 0 }}px !important;
    padding-left: {{ padding_horizontal_mobile }}rem !important;
    padding-right: {{ padding_horizontal_mobile }}rem !important;
  }

  .promobanner-button-{{ section.id }} {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    max-width: fit-content !important;
    font-size: {{ button_size_mobile }}px !important;
    color: {{ button_color }} !important;
    line-height: {{ button_height }}% !important;
    text-align: center !important;
    text-transform: unset !important;
    text-decoration: none !important;
    padding: {{ button_padding_vertical | times: 0.75 | round: 0 }}px {{ button_padding_horizontal | times: 0.75 | round: 0 }}px !important;
    border-radius: {{ button_radius }}px !important;
    border: {{ button_border_thickness }}px solid {{ button_border_color }} !important;
    background-color: {{ button_bg_color }} !important;
    transition: all 0.25s ease 0s !important;
    box-shadow: none !important;
    cursor: pointer !important;
  }

  .promobanner-button-{{ section.id }}:hover {
    color: {{ button_hover_color }} !important;
    border: {{ button_border_thickness }}px solid {{ button_border_hover_color }} !important;
    background-color: {{ button_bg_hover_color }} !important;
    transition: all 0.25s ease 0s !important;
  }

  .promobanner-popup-{{ section.id }} {
    width: 100% !important;
    height: 100% !important;
    top: 0 !important;
    left: 0 !important;
    position: fixed !important;
    display: flex !important;
    align-items: {{ promobanner_vertical_position_mobile }} !important;
    justify-content: {{ promobanner_horizontal_position_mobile }} !important;
    opacity: 0 !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
    pointer-events: none !important;
    background: rgba(0, 0, 0, {{ promobanner_overlay | times: 0.01 }}) !important;
    padding: 10px !important;
    transition: opacity 0.5s ease !important;
  }

  .promobanner-popup-{{ section.id }}.active {
    opacity: 1 !important;
    z-index: 100 !important;
    pointer-events: all !important;
    transition: opacity 0.5s ease !important;
  }

  .promobanner-popup-inner-{{ section.id }} {
    position: relative !important;
    width: 100% !important;
    max-width: {{ promobanner_width_mobile }}% !important;
    max-height: 95vh !important;
    border: {{ promobanner_border_thickness }}px solid {{ promobanner_border_color }} !important;
    background-color: {{ promobanner_bg_color }} !important;
    border-radius: {{ promobanner_radius }}px !important;
    display: grid !important;
    grid-template-columns: 1fr !important;
    overflow: hidden !important;
  }

  .promobanner-popup-left-{{ section.id }} {
    /* Container for the image */
  }

  .promobanner-popup-image-{{ section.id }} {
    margin: 0 auto !important;
    height: 100% !important;
    width: 100% !important;
    max-width: {{ image_width_mobile }}% !important;
  }

  .promobanner-popup-image-{{ section.id }} img,
  .promobanner-popup-image-{{ section.id }} svg {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
  }

  .promobanner-popup-image-{{ section.id }} svg {
    background-color: #DEDEDE !important;
  }

  @media (max-width: 1023px) {
    .promobanner-popup-left-{{ section.id }} {
      max-height: 50vh !important;
      overflow: hidden !important;
    }
  }

  @media (min-width: 1024px) {
    .promobanner-popup-inner-{{ section.id }} {
      max-width: {{ promobanner_width }}% !important;
      grid-template-columns: {{ image_width }}% {{ 100 | minus: image_width }}% !important;
    }

    .promobanner-popup-left-{{ section.id }} {
      height: 100% !important;
      overflow: hidden !important;
    }

    .promobanner-popup-image-{{ section.id }} {
      max-width: 100% !important;
      height: 100% !important;
      display: flex !important;
    }
  }

  {% if banner_hover_animation != 'none' %}
    .promobanner-popup-image-{{ section.id }} img:hover {
      {% if banner_hover_animation == 'smooth_fade' %}
        opacity: 0.8 !important;
        transition: opacity 0.3s ease !important;
      {% elsif banner_hover_animation == 'smooth_blink' %}
        animation: blink 1s infinite !important;
      {% elsif banner_hover_animation == 'fade_in_fade_out' %}
        opacity: 0.5 !important;
        transition: opacity 0.5s ease !important;
      {% endif %}
    }
    {% if banner_hover_animation == 'smooth_blink' %}
      @keyframes blink {
        0% { opacity: 1 !important; }
        50% { opacity: 0.5 !important; }
        100% { opacity: 1 !important; }
      }
    {% endif %}
  {% endif %}

  .promobanner-popup-content-{{ section.id }} {
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    padding: {{ content_padding_vertical_mobile }}px {{ content_padding_horizontal_mobile }}px !important;
  }

  .promobanner-popup-heading-{{ section.id }} {
    text-align: {{ heading_align_mobile }} !important;
  }

  .promobanner-popup-heading-{{ section.id }} * {
    margin: 0 !important;
    font-size: {{ heading_size_mobile }}px !important;
    color: {{ heading_color }} !important;
    line-height: {{ heading_height }}% !important;
    text-transform: unset !important;
  }

  .promobanner-popup-text-{{ section.id }} {
    margin-top: {{ text_mt | times: 0.75 | round: 0 }}px !important;
    text-align: {{ text_align_mobile }} !important;
  }

  .promobanner-popup-text-{{ section.id }} * {
    margin: 0 !important;
    font-size: {{ text_size_mobile }}px !important;
    color: {{ text_color }} !important;
    line-height: {{ text_height }}% !important;
    text-transform: unset !important;
  }

  .promobanner-popup-content-{{ section.id }} form {
    margin-top: {{ form_mt | times: 0.75 | round: 0 }}px !important;
  }

  .promobanner-popup-row-{{ section.id }} {
    display: flex !important;
    align-items: stretch !important;
    gap: 10px !important;
  }

  .promobanner-popup-input-{{ section.id }} {
    flex: 0 1 calc({{ input_width_mobile }}% - 5px) !important;
    margin: 0 !important;
    box-shadow: none !important;
    border: 0px !important;
    padding: {{ input_padding_vertical | times: 0.75 | round: 0 }}px {{ input_padding_horizontal | times: 0.75 | round: 0 }}px !important;
    font-size: {{ input_size_mobile }}px !important;
    color: {{ input_color }} !important;
    line-height: {{ input_height }}% !important;
    text-transform: unset !important;
    border-radius: {{ input_radius }}px !important;
    border: {{ input_border_thickness }}px solid {{ input_border_color }} !important;
    transition: border 0.3s ease !important;
  }

  .promobanner-popup-input-{{ section.id }}::placeholder {
    color: {{ input_placeholder_color }} !important;
  }

  .promobanner-popup-input-{{ section.id }}:focus-visible {
    outline: none !important;
    border: {{ input_border_thickness }}px solid {{ input_highlight_border_color }} !important;
    box-shadow: none !important;
  }

  .promobanner-popup-submit-{{ section.id }} {
    flex: 0 1 calc({{ 100 | minus: input_width_mobile }}% - 5px) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    font-size: {{ submit_size_mobile }}px !important;
    color: {{ submit_color }} !important;
    line-height: {{ submit_height }}% !important;
    text-align: center !important;
    text-transform: unset !important;
    text-decoration: none !important;
    padding: {{ submit_padding_vertical | times: 0.75 | round: 0 }}px {{ submit_padding_horizontal | times: 0.75 | round: 0 }}px !important;
    border-radius: {{ submit_radius }}px !important;
    border: {{ submit_border_thickness }}px solid {{ submit_border_color }} !important;
    background-color: {{ submit_bg_color }} !important;
    transition: all 0.25s ease 0s !important;
    box-shadow: none !important;
    cursor: pointer !important;
  }

  .promobanner-popup-submit-{{ section.id }}:hover {
    color: {{ submit_hover_color }} !important;
    border: {{ submit_border_thickness }}px solid {{ submit_border_hover_color }} !important;
    background-color: {{ submit_bg_hover_color }} !important;
    transition: all 0.25s ease 0s !important;
  }

  .promobanner-popup-copy-{{ section.id }} {
    margin-top: {{ copy_mt | times: 0.75 | round: 0 }}px !important;
    text-align: {{ copy_align_mobile }} !important;
  }

  .promobanner-popup-copy-{{ section.id }} * {
    margin: 0 !important;
    font-size: {{ copy_size_mobile }}px !important;
    color: {{ copy_color }} !important;
    line-height: {{ copy_height }}% !important;
    text-transform: unset !important;
  }

  .promobanner-popup-close-{{ section.id }} {
    position: absolute !important;
    top: 10px !important;
    right: 8px !important;
    box-shadow: none !important;
    background-color: transparent !important;
    border: 0px !important;
    cursor: pointer !important;
  }

  .promobanner-popup-close-{{ section.id }} svg {
    display: block !important;
    width: 20px !important;
    height: 20px !important;
  }

  .promobanner-popup-close-{{ section.id }} svg path {
    fill: {{ close_color }} !important;
  }

  .promobanner-popup-close-{{ section.id }}:hover svg path {
    filter: brightness(0.8) !important;
  }

  @media (min-width: 1024px) {
    .section-{{ section.id }} {
      margin-top: {{ margin_top }}px !important;
      margin-bottom: {{ margin_bottom }}px !important;
    }

    .section-{{ section.id }}-settings {
      padding: 0 5rem !important;
      padding-top: {{ padding_top }}px !important;
      padding-bottom: {{ padding_bottom }}px !important;
      padding-left: {{ padding_horizontal }}rem !important;
      padding-right: {{ padding_horizontal }}rem !important;
    }

    .promobanner-button-{{ section.id }} {
      padding: {{ button_padding_vertical }}px {{ button_padding_horizontal }}px !important;
      font-size: {{ button_size }}px !important;
    }

    .promobanner-popup-{{ section.id }} {
      align-items: {{ promobanner_vertical_position }} !important;
      justify-content: {{ promobanner_horizontal_position }} !important;
    }

    .promobanner-popup-content-{{ section.id }} {
      padding: {{ content_padding_vertical }}px {{ content_padding_horizontal }}px !important;
    }

    .promobanner-popup-heading-{{ section.id }} {
      text-align: {{ heading_align }} !important;
    }

    .promobanner-popup-heading-{{ section.id }} * {
      font-size: {{ heading_size }}px !important;
    }

    .promobanner-popup-text-{{ section.id }} {
      margin-top: {{ text_mt }}px !important;
      text-align: {{ text_align }} !important;
    }

    .promobanner-popup-text-{{ section.id }} * {
      font-size: {{ text_size }}px !important;
    }

    .promobanner-popup-content-{{ section.id }} form {
      margin-top: {{ form_mt }}px !important;
    }

    .promobanner-popup-input-{{ section.id }} {
      flex: 0 1 calc({{ input_width }}% - 5px) !important;
      padding: {{ input_padding_vertical }}px {{ input_padding_horizontal }}px !important;
      font-size: {{ input_size }}px !important;
    }

    .promobanner-popup-submit-{{ section.id }} {
      flex: 0 1 calc({{ 100 | minus: input_width }}% - 5px) !important;
      padding: {{ submit_padding_vertical }}px {{ submit_padding_horizontal }}px !important;
      font-size: {{ submit_size }}px !important;
      gap: 10px !important;
    }

    .promobanner-popup-copy-{{ section.id }} {
      margin-top: {{ copy_mt }}px !important;
      text-align: {{ copy_align }} !important;
    }

    .promobanner-popup-copy-{{ section.id }} * {
      font-size: {{ copy_size }}px !important;
    }
  }

  @media (max-width: 768px) {
    .promobanner-popup-submit-{{ section.id }} {
      padding: calc({{ submit_padding_vertical }}px + 0.5px) calc({{ submit_padding_horizontal }}px + 0.5px) !important;
    }

    .promobanner-popup-input-{{ section.id }} {
      padding: {{ input_padding_vertical | times: 0.75 | round: 0 | plus: 2 }}px {{ input_padding_horizontal | times: 0.75 | round: 0 | plus: 2 }}px !important;
    }
  }

  .promobanner-popup-href-{{ section.id }} {
    max-height: 50px !important;
    margin: 15px 0 !important;
  }

  /* Styles for success and error messages */
  .promobanner-success-message {
    text-align: center;
    color: green;
    font-size: 18px;
    margin-top: 20px;
  }

  .promobanner-error-message {
    text-align: center;
    color: red;
    font-size: 14px;
    margin-top: 10px;
  }
{%- endstyle -%}

{% unless full_width %}
  <style>
    .section-{{ section.id }}-settings {
      max-width: {{ content_width }}rem !important;
    }
  </style>
{% endunless %}

{% if button_custom %}
  <style>
    .promobanner-button-{{ section.id }} {
      font-family: {{ button_font.family }}, {{ button_font.fallback_families }} !important;
      font-weight: {{ button_font.weight }} !important;
      font-style: {{ button_font.style }} !important;
    }
  </style>
{% endif %}

{% if heading_custom %}
  <style>
    .promobanner-popup-heading-{{ section.id }} * {
      font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }} !important;
      font-weight: {{ heading_font.weight }} !important;
      font-style: {{ heading_font.style }} !important;
    }
  </style>
{% endif %}

{% if text_custom %}
  <style>
    .promobanner-popup-text-{{ section.id }} * {
      font-family: {{ text_font.family }}, {{ text_font.fallback_families }} !important;
      font-weight: {{ text_font.weight }} !important;
      font-style: {{ text_font.style }} !important;
    }
  </style>
{% endif %}

{% if input_custom %}
  <style>
    .promobanner-popup-input-{{ section.id }} {
      font-family: {{ input_font.family }}, {{ input_font.fallback_families }} !important;
      font-weight: {{ input_font.weight }} !important;
      font-style: {{ input_font.style }} !important;
    }
  </style>
{% endif %}

{% if submit_custom %}
  <style>
    .promobanner-popup-submit-{{ section.id }} {
      font-family: {{ submit_font.family }}, {{ submit_font.fallback_families }} !important;
      font-weight: {{ submit_font.weight }} !important;
      font-style: {{ submit_font.style }} !important;
    }
  </style>
{% endif %}

{% if copy_custom %}
  <style>
    .promobanner-popup-copy-{{ section.id }} * {
      font-family: {{ copy_font.family }}, {{ copy_font.fallback_families }} !important;
      font-weight: {{ copy_font.weight }} !important;
      font-style: {{ copy_font.style }} !important;
    }
  </style>
{% endif %}

{% if button_align_mobile == 'center' %}
  <style>
    .promobanner-button-{{ section.id }} {
      margin-left: auto !important;
      margin-right: auto !important;
    }
  </style>
{% elsif button_align_mobile == 'right' %}
  <style>
    .promobanner-button-{{ section.id }} {
      margin-left: auto !important;
    }
  </style>
{% endif %}

{% if button_align == 'center' %}
  <style>
    @media(min-width: 1024px) {
      .promobanner-button-{{ section.id }} {
        margin-left: auto !important;
        margin-right: auto !important;
      }
    }
  </style>
{% elsif button_align == 'right' %}
  <style>
    @media(min-width: 1024px) {
      .promobanner-button-{{ section.id }} {
        margin-left: auto !important;
        margin-right: 0px !important;
      }
    }
  </style>
{% else %}
  <style>
    @media(min-width: 1024px) {
      .promobanner-button-{{ section.id }} {
        margin-left: 0px !important;
        margin-right: 0px !important;
      }
    }
  </style>
{% endif %}

{% if image_ratio_mobile == 'portrait' %}
  <style>
    .promobanner-popup-left-{{ section.id }} {
      aspect-ratio: 9.6/12 !important;
    }
  </style>
{% elsif image_ratio_mobile == 'square' %}
  <style>
    .promobanner-popup-left-{{ section.id }} {
      aspect-ratio: 12/12 !important;
    }
  </style>
{% else %}
  <style>
    .promobanner-popup-left-{{ section.id }} {
      aspect-ratio: auto !important;
    }
  </style>
{% endif %}

{% if image_ratio == 'portrait' %}
  <style>
    @media(min-width: 1024px) {
      .promobanner-popup-left-{{ section.id }} {
        aspect-ratio: 9.6/12 !important;
      }
    }
  </style>
{% elsif image_ratio == 'square' %}
  <style>
    @media(min-width: 1024px) {
      .promobanner-popup-left-{{ section.id }} {
        aspect-ratio: 12/12 !important;
      }
    }
  </style>
{% else %}
  <style>
    @media(min-width: 1024px) {
      .promobanner-popup-left-{{ section.id }} {
        aspect-ratio: auto !important;
      }
    }
  </style>
{% endif %}

{% if image_hide_mobile %}
  <style>
    .promobanner-popup-left-{{ section.id }} {
      display: none !important;
    }

    @media(min-width: 1024px) {
      .promobanner-popup-left-{{ section.id }} {
        display: block !important;
      }
    }
  </style>
{% endif %}

{% if image_hide_desktop %}
  <style>
    @media(min-width: 1024px) {
      .promobanner-popup-left-{{ section.id }} {
        display: none !important;
      }

      .promobanner-popup-inner-{{ section.id }} {
        display: block !important;
      }
    }
  </style>
{% endif %}

{% if submit_line_mobile %}
  <style>
    .promobanner-popup-row-{{ section.id }} {
      flex-direction: column !important;
    }
  </style>
{% else %}
  <style>
    .promobanner-popup-row-{{ section.id }} {
      flex-direction: row !important;
    }
  </style>
{% endif %}

{% if submit_line %}
  <style>
    @media(min-width: 1024px) {
      .promobanner-popup-row-{{ section.id }} {
        flex-direction: column !important;
      }
    }
  </style>
{% else %}
  <style>
    @media(min-width: 1024px) {
      .promobanner-popup-row-{{ section.id }} {
        flex-direction: row !important;
      }
    }
  </style>
{% endif %}

{% if enable_logo %}
  <style>
    @media(min-width: 1024px) {
      .promobanner-logo-image {
        width: {{ logo_width }}% !important;
      }
    }
    @media(max-width: 1023px) {
      .promobanner-logo-image {
        width: {{ logo_width_mobile }}% !important;
      }
    }
  </style>
{% endif %}

<style>
  /* Adjust form elements for column layout on mobile */
  @media (max-width: 1023px) {
    {% if submit_line_mobile %}
      .promobanner-popup-input-{{ section.id }}, .promobanner-popup-submit-{{ section.id }} {
        width: 100% !important;
        flex-basis: auto !important;
      }
    {% endif %}
  }

  /* Adjust form elements for column layout on desktop */
  @media (min-width: 1024px) {
    {% if submit_line %}
      .promobanner-popup-input-{{ section.id }}, .promobanner-popup-submit-{{ section.id }} {
        width: 100% !important;
        flex-basis: auto !important;
      }
    {% endif %}
  }
</style>

<div
  class="section-{{ section.id }} promobanner-{{ section.id }}"
  style="background-color:{{ background_color }}; background-image: {{ background_gradient }} !important;"
>
  <div class="section-{{ section.id }}-settings">
    {% if display_options == 'click' %}
      <button class="promobanner-button-{{ section.id }}">{{ button }}</button>
    {% endif %}
  </div>
</div>

<div class="promobanner-popup-{{ section.id }}">
  <div class="promobanner-popup-inner-{{ section.id }}">
    <div class="promobanner-popup-left-{{ section.id }}">
      <div class="promobanner-popup-image-{{ section.id }}">
        {% if image != blank %}
          <img
            src="{{ image | image_url }}"
            alt="{{ image.alt }}"
            {% if lazy %}
              loading="lazy"
            {% endif %}
          >
        {% else %}
          <img
            src="https://numedicousa.com/wp-content/uploads/2022/02/placeholder.jpg"
            alt="Banner Placeholder"
            loading="lazy"
          >
        {% endif %}
      </div>
    </div>
    <div class="promobanner-popup-content-{{ section.id }}">
      {% if enable_logo and logo_image != blank %}
        <div
          class="promobanner-logo-wrapper"
          style="text-align: {{ logo_position }} !important; margin-bottom: {{ logo_margin_bottom }}px !important;"
        >
          <img
            src="{{ logo_image | image_url }}"
            alt="Logo"
            class="promobanner-logo-image"
            style="display: block !important; margin-left: auto !important; margin-right: auto !important;"
          >
        </div>
      {% endif %}

      {% if heading != blank %}
        <div class="promobanner-popup-heading-{{ section.id }}">{{ heading }}</div>
      {% endif %}

      {% if text != blank %}
        <div class="promobanner-popup-text-{{ section.id }}">{{ text }}</div>
      {% endif %}
      {% if section.settings.use_button == true %}
        <a
          href="{{ section.settings.button_url }}"
          class="promobanner-popup-submit-{{ section.id }} promobanner-popup-href-{{ section.id }}"
        >
          {{ section.settings.button_url_text }}
        </a>
      {% else %}
        {% form 'customer', class: 'promobanner-popup-form' %}
          {% if form.posted_successfully? %}
            <div id="Newsletter-success--{{ section.id }}" class="promobanner-success-message">Thank you for subscribing!</div>
          {% else %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="promobanner-popup-row-{{ section.id }}">
              <input
                type="email"
                name="contact[email]"
                class="promobanner-popup-input-{{ section.id }}"
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="Newsletter-error--{{ section.id }}"
                {% endif %}
                placeholder="{{ input_placeholder }}"
                required
              >
              <button type="submit" class="promobanner-popup-submit-{{ section.id }}" name="commit">
                {{ submit }}
              </button>
            </div>
            {% if form.errors %}
              <div id="Newsletter-error--{{ section.id }}" class="promobanner-error-message">
                {% for field in form.errors %}
                  {{ field }} {{ form.errors.messages[field] }}<br>
                {% endfor %}
              </div>
            {% endif %}
          {% endif %}
        {% endform %}
      {% endif %}
      {% if copy != blank %}
        <div class="promobanner-popup-copy-{{ section.id }}">
          {{ copy }}
        </div>
      {% endif %}
    </div>
    <button class="promobanner-popup-close-{{ section.id }}">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12.0002 10.586L4.70718 3.29297L3.29297 4.70718L10.586 12.0002L3.29297 19.2933L4.70718 20.7075L12.0002 13.4145L19.2933 20.7075L20.7075 19.2933L13.4145 12.0002L20.7075 4.70723L19.2933 3.29302L12.0002 10.586Z" fill="white"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  function initPromoBanner() {
    const toggle = document.querySelector('.promobanner-button-{{ section.id }}');
    const promobanner = document.querySelector('.promobanner-popup-{{ section.id }}');
    const close = document.querySelector('.promobanner-popup-close-{{ section.id }}');
    const promobannerKey = 'promobannerDisplayedAt_{{ section.id }}';

    if(toggle) {
      toggle.addEventListener('click', () => {
        if(promobanner) {
          {% if hide_promobanner_days > 0 %}
            if(hasPromoBannerCookieExpired()) {
                promobanner.classList.add('active');
                document.body.style.overflow = 'hidden';
                document.body.style.transform = 'none';
                setPromoBannerCookie();
            }
          {% else %}
            promobanner.classList.add('active');
            document.body.style.overflow = 'hidden';
            document.body.style.transform = 'none';
          {% endif %}
        }
      })
    }

    if(close) {
       close.addEventListener('click', () => {
        document.body.style.overflow = '';
        document.body.style.transform = '';
        promobanner.classList.remove('active');
      });
    }

    document.addEventListener('click', (e) => {
        if (e.target == promobanner) {
          document.body.style.overflow = '';
          document.body.style.transform = '';
          promobanner.classList.remove('active');
        }
    });

    {% if display_options == "after_seconds" %}
      setTimeout(function() {
          if(promobanner) {
            {% if hide_promobanner_days > 0 %}
              if (hasPromoBannerCookieExpired()) {
                  promobanner.classList.add('active');
                  document.body.style.overflow = 'hidden';
                  document.body.style.transform = 'none';
                  setPromoBannerCookie();
              }
            {% else %}
              promobanner.classList.add('active');
              document.body.style.overflow = 'hidden';
            {% endif %}
          }
      }, {{ seconds | times: 1000 }});
    {% endif %}

    {% if display_options == "after_scrolling" %}
      let hasShownScrollMessage = false;

      window.addEventListener("scroll", function() {
          if (!hasShownScrollMessage) {
              var scrollPosition = window.scrollY;
              var windowHeight = window.innerHeight;
              var documentHeight = document.body.clientHeight;

              var scrollPercentage = (scrollPosition + windowHeight) / documentHeight * 100;

              if (scrollPercentage >= 50) {
                {% if hide_promobanner_days > 0 %}
                  if (hasPromoBannerCookieExpired()) {
                      promobanner.classList.add("active");
                      document.body.style.overflow = 'hidden';
                      document.body.style.transform = 'none';
                      hasShownScrollMessage = true;
                      setPromoBannerCookie();
                  }
                {% else %}
                  promobanner.classList.add("active");
                  document.body.style.overflow = 'hidden';
                  document.body.style.transform = 'none';
                  hasShownScrollMessage = true;
                {% endif %}
              }
          }
      });
    {% endif %}

    {% if display_options == "mouse_close" %}
      let hasShownScrollMessage = false;
      document.addEventListener("mouseleave", function(event) {
          if (!hasShownScrollMessage) {
            var promobanner = document.querySelector(".promobanner-popup-{{ section.id }}");
            if (promobanner) {
                {% if hide_promobanner_days > 0 %}
                  if(hasPromoBannerCookieExpired()) {
                      promobanner.classList.add("active");
                      document.body.style.overflow = 'hidden';
                      document.body.style.transform = 'none';
                      hasShownScrollMessage = true;
                      setPromoBannerCookie();
                  }
                {% else %}
                  promobanner.classList.add("active");
                  document.body.style.overflow = 'hidden';
                  document.body.style.transform = 'none';
                  hasShownScrollMessage = true;
                {% endif %}
            }
          }
      });
    {% endif %}

    {% if hide_promobanner_days > 0 %}
      function hasPromoBannerCookieExpired() {
          const lastDisplayed = localStorage.getItem(promobannerKey);
          if (lastDisplayed) {
              const lastDisplayedDate = new Date(lastDisplayed);
              const now = new Date();
              const daysPassed = (now - lastDisplayedDate) / (1000 * 60 * 60 * 24);
              return daysPassed >= {{ hide_promobanner_days }};
          }
          return true;
      }

      function setPromoBannerCookie() {
        localStorage.setItem(promobannerKey, new Date().toISOString());
      }
    {% endif %}
  }

  document.addEventListener('DOMContentLoaded', initPromoBanner);

  if (Shopify.designMode) {
     document.addEventListener('shopify:section:unload', initPromoBanner);
     document.addEventListener('shopify:section:load', initPromoBanner);
  }

  // Close popup after successful form submission
  if (document.getElementById('Newsletter-success--{{ section.id }}')) {
    setTimeout(function() {
      const promobanner = document.querySelector('.promobanner-popup-{{ section.id }}');
      promobanner.classList.remove('active');
      document.body.style.overflow = '';
      document.body.style.transform = '';
    }, 3000); // Closes after 3 seconds
  }
</script>

