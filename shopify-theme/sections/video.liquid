      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "section_padding_left_right",
      "label": "Padding Left/Right",
      "info": "Set the left and right padding of the section.",
      "min": 0,
      "max": 300,
      "step": 30,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "mobile_section_padding_left_right",
