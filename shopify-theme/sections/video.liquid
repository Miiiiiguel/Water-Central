      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Container Design",
      "info": "Customize the container styles for the video section."
    },
    {
      "type": "color",
      "id": "container_background_color",
      "label": "Container Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "container_radius",
