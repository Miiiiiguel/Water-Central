      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "container_shadow",
      "label": "Container Shadow",
      "default": false
    },
    {
      "type": "range",
      "id": "container_border_size",
      "label": "Container Border Size",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "container_border_color",
      "label": "Container Border Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "label": "Container Max Width",
      "min": 200,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "default": 1200
    },
