{%- liquid
  assign heading_tag = 'h2'

  if section.index0 == 0
    assign heading_tag = 'h1'
  endif

  assign image_class = 'loudz__image '
  if section.settings.image_filter != blank
    assign image_class = image_class | append: ' loudz__filter--' | append: section.settings.image_filter
  endif

  assign has_heading = false
  assign has_button = false

  for block in section.blocks
    case block.type
    when 'heading'
      assign has_heading = true
      assign heading_text = block.settings.heading
      assign desktop_heading_size = block.settings.desktop_heading_size
      assign mobile_heading_size = block.settings.mobile_heading_size
      assign heading_font_weight = block.settings.heading_weight
      assign desktop_heading_padding_bottom = block.settings.desktop_heading_padding_bottom
      assign mobile_heading_padding_bottom = block.settings.mobile_heading_padding_bottom
    when 'button'
      assign has_button = true
      assign button_text = block.settings.button_text
      assign button_link = block.settings.button_link
      assign button_target = block.settings.button_target
      assign button_hover = block.settings.button_hover
      assign button_font_size = block.settings.button_font_size
      assign button_font_size_mobile = block.settings.button_font_size_mobile
      assign button_font_weight = block.settings.button_font_weight
      assign desktop_button_padding_vertical = block.settings.desktop_button_padding_vertical
      assign desktop_button_padding_horizontal = block.settings.desktop_button_padding_horizontal
      assign mobile_button_padding_vertical = block.settings.mobile_button_padding_vertical
      assign mobile_button_padding_horizontal = block.settings.mobile_button_padding_horizontal
      assign button_border_radius = block.settings.button_border_radius
    endcase
  endfor
-%}

{%- capture html_id -%}
  {%- if section.settings.html_id != blank -%}
    id="{{ section.settings.html_id | handleize }}"
  {%- endif -%}
{%- endcapture -%}

{% stylesheet %}
  .loudz-gallery-2 * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .loudz-gallery-2 a { color: inherit; }

  .loudz-gallery-2 .loudz__container {
    padding-block: var(--loudz-section-padding);
    flex-direction: var(--loudz-image-placement, column);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-inline: 20px;
    overflow-x: hidden;
  }

  .loudz-gallery-2 .loudz__content {
    position: static;
    transform: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: none;
    width: 100%;
    text-align: center;
    padding-bottom: 24px;
    z-index: 10;
  }

  .loudz-gallery-2 .loudz__tagline {
    max-width: var(--loudz-heading-max-width, 700px);
    font-size: var(--loudz-tagline-size, 16px);
    font-weight: var(--loudz-tagline-font-weight, 400);
    padding-bottom: var(--loudz-tagline-padding-bottom, 10px);
    color: var(--loudz-tagline-text-color, #121212);
    width: 100%;
  }

  .loudz-gallery-2 .loudz__header {
    max-width: var(--loudz-heading-max-width, 700px);
    font-size: var(--loudz-heading-size, 42px);
    font-weight: var(--loudz-heading-weight, 600);
    padding-bottom: var(--loudz-heading-padding-bottom, 30px);
    color: var(--loudz-heading-color, #000000);
    width: 100%;
    line-height: 1.3;
  }

  .loudz-gallery-2 .loudz__button {
    background-color: var(--loudz-button-background-color, #007BFF);
    border-radius: var(--loudz-button-border-radius, 8px);
    font-size: var(--loudz-button-font-size, 16px);
    font-weight: var(--loudz-button-font-weight, 500);
    padding: var(--loudz-button-padding, 12px 13px);
    color: var(--loudz-button-text-color, #FFFFFF);
    border: 1px solid var(--loudz-button-background-color, #007BFF);
    display: block;
    text-decoration: none;
    transition: all 0.3s ease-in-out;
    cursor: pointer;
  }

  .loudz-gallery-2 .loudz__button--fade:hover { opacity: 0.8; }
  .loudz-gallery-2 .loudz__button--invert:hover {
    color: var(--loudz-button-background-color, #007BFF) !important;
    border-color: var(--loudz-button-border-hover-color, var(--loudz-button-background-color, #007BFF));
    background-color: transparent;
  }

  .loudz-gallery-2 .loudz__grid {
    position: static;
    width: 100%;
    height: auto;
    min-height: unset;
    padding-bottom: 45px;
    z-index: 1;
  }

  .loudz-gallery-2 .loudz__image {
    border-radius: var(--loudz-image-border-radius, 4px);
    transition: transform 0.3s ease;
    position: static;
    width: 90%;
    height: auto;
  }

  .loudz-gallery-2 .loudz__image img {
    width: 100%;
    height: auto;
  }

  .loudz-gallery-2 .loudz__filter--grayscale { filter: grayscale(100%); }
  .loudz-gallery-2 .loudz__filter--sepia { filter: sepia(100%) contrast(1.2); }
  .loudz-gallery-2 .loudz__filter--invert { filter: invert(100%); }

  .loudz-gallery-2 .placeholder-svg {
    width: 100%;
    height: 100%;
    aspect-ratio: 1/1;
    background-color: #f4f4f4;
  }

  .loudz-gallery-2 .loudz__grid--desktop {
    display: none;
  }

  .loudz-gallery-2 .loudz__grid--mobile {
    display: flex;
    flex-direction: column;
    position: relative;
    width: 100%;
    max-width: 100vw;
    overflow-x: hidden;
    align-items: center;
    justify-content: center;
    background: none;
    margin: 0 auto;
    padding: 0;
    box-sizing: border-box;
  }

  .loudz-gallery-2 .loudz__carousel-image-wrapper {
    width: 100%;
    max-width: 420px;
    position: relative;
  }

  .loudz-gallery-2 .swiper {
    width: 100%;
    height: 100%;
  }

  .loudz-gallery-2 .swiper-slide {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .loudz-gallery-2 .loudz__grid--mobile .loudz__image {
    padding-bottom: var(--loudz-image-bottom-padding, 24px);
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 420px;
    width: 100%;
    aspect-ratio: 1 / 1;
    height: auto;
    overflow: hidden;
    margin: 0 auto;
  }

  .loudz-gallery-2 .loudz__grid--mobile .loudz__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    display: block;
  }

  .loudz-gallery-2 .loudz__nav-arrows {
    gap: var(--loudz-arrows-gap, 30px);
    padding-bottom: var(--loudz-carousel-bottom-padding, 0px);
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    width: 100%;
    z-index: 1;
  }

  .loudz-gallery-2 .loudz__arrow {
    color: var(--loudz-arrow-icon-color, #000000);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px !important ;
    background: transparent;
    border-radius: 0;
    box-shadow: none;
    cursor: pointer;
    transition: color 0.2s;
    border: none;
  }

  .loudz-gallery-2 .loudz__grid--vertical {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    padding: 20px 0;
  }

  .loudz-gallery-2 .loudz__grid--vertical .loudz__image {
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
    aspect-ratio: auto;
    height: auto;
  }

  .loudz-gallery-2 .loudz__grid--vertical .loudz__image img {
    border-radius: var(--loudz-image-border-radius, 4px);
    width: 100%;
    height: auto;
  }

  @media (min-width: 768px) {
    .loudz-gallery-2 .loudz__grid--mobile,
    .loudz-gallery-2 .loudz__grid--vertical {
      display: none;
    }

    .loudz-gallery-2 .loudz__grid--desktop {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      max-width: 800px;
      width: 100%;
      margin: 0 auto;
      padding: 20px;
      justify-items: center;
    }

    .loudz-gallery-2 .loudz__grid--desktop .loudz__image {
      width: 100%;
    }

    .loudz-gallery-2 .loudz__grid--desktop .loudz__image img {
      width: 100%;
      height: auto;
      object-fit: cover;
      aspect-ratio: 1 / 1;
    }

    .loudz-gallery-2 .loudz__content {
      padding: 40px 0;
    }
  }

  @media (min-width: 1096px) {
    .loudz-gallery-2 .loudz__container {
      max-width: var(--loudz-container-max-width, 1200px);
      padding-block: 500px;
      margin: 0 auto;
    }

    .loudz-gallery-2 .loudz__content {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      padding: 0;
      z-index: 10;
    }

    .loudz-gallery-2 .loudz__grid--desktop {
      display: flex;
    }

    .loudz-gallery-2 .loudz__image:nth-child(1),
    .loudz-gallery-2 .loudz__image:nth-child(2),
    .loudz-gallery-2 .loudz__image:nth-child(3),
    .loudz-gallery-2 .loudz__image:nth-child(4),
    .loudz-gallery-2 .loudz__image:nth-child(5),
    .loudz-gallery-2 .loudz__image:nth-child(6) {
      position: absolute;
      z-index: 1;
      font-size: 0;
    }

    .loudz-gallery-2 .loudz__image:nth-child(1) {
      top: 0px;
      left: 50px;
      max-width: 350px;
      width: 100%;
    }

    .loudz-gallery-2 .loudz__image:nth-child(2) {
      top: 30px;
      left: 420px;
      max-width: 340px;
      width: 100%;
    }

    .loudz-gallery-2 .loudz__image:nth-child(3) {
      top: 52px;
      right: 0px;
      max-width: 320px;
      width: 100%;
    }

    .loudz-gallery-2 .loudz__image:nth-child(4) {
      top: 478px;
      left: 0px;
      max-width: 400px;
      width: 100%;
    }

    .loudz-gallery-2 .loudz__image:nth-child(5) {
      bottom: 0px;
      right: 0px;
      max-width: 420px;
      width: 100%;
    }

    .loudz-gallery-2 .loudz__image:nth-child(6) {
      bottom: 30px;
      left: 420px;
      width: 220px;
    }
  }
{% endstylesheet %}

<style>
  #loudz-{{ section.id }} {
    --loudz-section-padding: {{ section.settings.mobile_top_padding }}px {{ section.settings.mobile_bottom_padding }}px;
    --loudz-background-color: {{ section.settings.background_gradient | default: section.settings.background_color }};
    --loudz-section-width: {{ section.settings.section_width }}px;
    --loudz-container-max-width: 100%;
    --loudz-tagline-size: {{ section.settings.mobile_tagline_size }}px;
    --loudz-tagline-font-weight: {{ section.settings.tagline_font_weight }};
    --loudz-tagline-padding-bottom: {{ section.settings.mobile_tagline_padding_bottom }}px;
    --loudz-tagline-text-color: {{ section.settings.tagline_text_color }};
    --loudz-heading-max-width: {{ section.settings.mobile_heading_max_width }}px;
    --loudz-heading-size: {{ mobile_heading_size | default: 32 }}px;
    --loudz-heading-weight: {{ heading_font_weight | default: section.settings.heading_weight }};
    --loudz-heading-padding-bottom: {{ mobile_heading_padding_bottom | default: 30 }}px;
    --loudz-heading-color: {{ section.settings.heading_color }};
    --loudz-button-font-size: {{ button_font_size_mobile | default: 14 }}px;
    --loudz-button-font-weight: {{ button_font_weight | default: 500 }};
    --loudz-button-background-color: {{ section.settings.button_background_color }};
    --loudz-button-padding: {{ mobile_button_padding_vertical | default: 10 }}px {{ mobile_button_padding_horizontal | default: 24 }}px;
    --loudz-button-border-radius: {{ button_border_radius | default: 8 }}px;
    --loudz-button-text-color: {{ section.settings.button_text_color }};
    --loudz-image-placement: {{ section.settings.image_placement_mobile }};
    --loudz-image-bottom-padding: {{ section.settings.mobile_image_bottom_padding }}px;
    --loudz-carousel-bottom-padding: {{ section.settings.carousel_bottom_padding }}px;
    --loudz-arrow-icon-color: {{ section.settings.arrow_icon_color }};
    --loudz-button-border-hover-color: {{ section.settings.button_border_hover_color }};
    --loudz-arrow-size: {{ section.settings.arrows_size }}px;
    --loudz-arrows-gap: {{ section.settings.arrows_gap }}px;

    background: var(--loudz-background-color);
  }

  @media (min-width: 768px) {
    #loudz-{{ section.id }} {
      --loudz-container-max-width: calc(var(--loudz-section-width) + 40px);
      --loudz-section-padding: {{ section.settings.desktop_top_padding }}px {{ section.settings.desktop_bottom_padding }}px;
      --loudz-tagline-size: {{ section.settings.desktop_tagline_size }}px;
      --loudz-tagline-font-weight: {{ section.settings.tagline_font_weight }};
      --loudz-tagline-padding-bottom: {{ section.settings.desktop_tagline_padding_bottom }}px;
      --loudz-heading-size: {{ desktop_heading_size | default: 42 }}px;
      --loudz-heading-max-width: {{ section.settings.desktop_heading_max_width }}px;
      --loudz-heading-padding-bottom: {{ desktop_heading_padding_bottom | default: 10 }}px;
      --loudz-button-padding: {{ desktop_button_padding_vertical | default: 12 }}px {{ desktop_button_padding_horizontal | default: 30 }}px;
      --loudz-button-font-size: {{ button_font_size | default: 16 }}px;
      --loudz-image-border-radius: {{ section.settings.image_border_radius }}px;

      padding-block: var(--loudz-section-padding);
    }
  }
</style>

<div id="loudz-{{ section.id }}" class="loudz-{{ section.id }}">
  <div {{ html_id }} class="{{ 'loudz__container ' | append: section.settings.html_class | strip }}">
    <div class="loudz__content">
      {% if section.settings.tagline != blank %}
        <div class="loudz__tagline">{{ section.settings.tagline }}</div>
      {% endif %}
      
      {% if heading_text != blank %}
        <{{ heading_tag }} class="loudz__header">{{ heading_text }}</{{ heading_tag }}>
      {% endif %}
      
      {% if button_text != blank %}
        {% if button_link %}
          <a class="loudz__button loudz__button--{{ button_hover | default: 'fade' }}" href="{{ button_link }}" target="{{ button_target | default: '_self' }}">
            {{ button_text }}
          </a>
        {% else %}
          <a class="loudz__button loudz__button--{{ button_hover | default: 'fade' }}">
            {{ button_text }}
          </a>
        {% endif %}
      {% endif %}
    </div>
    
    <div class="loudz__grid loudz__grid--desktop">
      {% for block in section.blocks %}
        {% if block.type == 'gallery_image_02' %}
          <div class="{{ image_class }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', width: block.settings.image.width, height: block.settings.image.height }}
            {%- else -%}
              <img src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E" alt="placeholder" width="100%" height="auto">
            {%- endif -%}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.carousel_on_mobile %}
      <div class="loudz__grid loudz__grid--mobile" id="loudz-gallery-carousel-{{ section.id }}">
        <div class="loudz__carousel-image-wrapper">
          <div class="swiper" id="swiper-{{ section.id }}">
            <div class="swiper-wrapper">
              {% for block in section.blocks %}
                {% if block.type == 'gallery_image_02' %}
                  {% if block.settings.image %}
                    <div class="swiper-slide">
                      <div class="{{ image_class }}">
                        {{ block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', width: block.settings.image.width, height: block.settings.image.height }}
                      </div>
                    </div>
                  {% else %}
                    <div class="swiper-slide">
                      <div class="{{ image_class }}">
                        <img src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E" alt="placeholder" width="100%" height="auto">
                      </div>
                    </div>
                  {% endif %}
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
        <div class="loudz__nav-arrows">
          <button class="loudz__arrow prev-arrow" aria-label="Previous" type="button">
            <svg viewBox="0 0 1024 1024" class="icon" version="1.1" xmlns="http://www.w3.org/2000/svg" fill="currentColor" width="32" height="32"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path d="M768 903.232l-50.432 56.768L256 512l461.568-448 50.432 56.768L364.928 512z" fill="currentColor"></path></g></svg>
          </button>
          <button class="loudz__arrow next-arrow" aria-label="Next" type="button">
            <svg viewBox="0 0 1024 1024" class="icon" version="1.1" xmlns="http://www.w3.org/2000/svg" fill="currentColor" width="32" height="32"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path d="M256 120.768L306.432 64 768 512l-461.568 448L256 903.232 659.072 512z" fill="currentColor"></path></g></svg>
          </button>
        </div>
      </div>
    {% else %}
      <div class="loudz__grid loudz__grid--vertical">
        {% for block in section.blocks %}
          {% if block.type == 'gallery_image_02' %}
            <div class="{{ image_class }}" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', width: block.settings.image.width, height: block.settings.image.height }}
              {%- else -%}
                <img src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E" alt="placeholder" width="100%" height="auto">
              {%- endif -%}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{%- if section.settings.carousel_on_mobile -%}
  {{ 'https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.css' | stylesheet_tag }}
  <script defer src="https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.js"></script>
{%- endif -%}

<script>
  (() => {
    let swiper;

    function initCarousel() {
      {% if section.settings.carousel_on_mobile %}
        const mq = window.matchMedia('(max-width: 768px)');
        if (!mq.matches) return;

        const carousel = document.getElementById('loudz-gallery-carousel-{{ section.id }}');
        const swiperElement = document.getElementById('swiper-{{ section.id }}');
        const prevButton = carousel?.querySelector('.prev-arrow');
        const nextButton = carousel?.querySelector('.next-arrow');

        if (!carousel || !swiperElement || !prevButton || !nextButton) return;

        if (swiper && swiper.destroy) {
          swiper.destroy(true, true);
          swiper = null;
        }

        swiper = new Swiper(swiperElement, {
          slidesPerView: 1,
          loop: true,
          speed: 400,
          allowTouchMove: true,
          navigation: {
            prevEl: prevButton,
            nextEl: nextButton
          }
        });
      {% else %}
        if (swiper && swiper.destroy) {
          swiper.destroy(true, true);
          swiper = null;
        }
      {% endif %}
    }

    function destroyCarousel() {
      if (swiper && swiper.destroy) {
        swiper.destroy(true, true);
        swiper = null;
      }
    }

    document.addEventListener('DOMContentLoaded', initCarousel);
    document.addEventListener('shopify:section:load', initCarousel);
    document.addEventListener('shopify:section:select', initCarousel);
    document.addEventListener('shopify:section:unload', destroyCarousel);
    window.addEventListener('resize', initCarousel);
  })();
</script>

{% schema %}
{
  "name": "Gallery Simple 2",
  "class": "loudz-section loudz-gallery-2",
  "tag": "section",
  "max_blocks": 10,
  "disabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "tagline",
      "label": "Tagline text",
      "default": "Latest interior designs",
      "info": "Short text above the heading."
    },
    {
      "type": "range",
      "id": "desktop_tagline_size",
      "label": "Desktop tagline text size (px)",
      "min": 8,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_tagline_size",
      "label": "Mobile tagline text size (px)",
      "min": 8,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "tagline_font_weight",
      "label": "Tagline font weight",
      "options": [
        {
          "value": "100",
          "label": "Thin"
        },
        {
          "value": "200",
          "label": "Extra light"
        },
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ],
      "default": "400"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "Enable carousel on mobile devices",
      "default": true,
      "info": "Displays images in a sliding carousel on mobile."
    },
    {
      "type": "range",
      "id": "desktop_tagline_padding_bottom",
      "label": "Desktop tagline space below (px)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_tagline_padding_bottom",
      "label": "Mobile tagline space below (px)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Default heading font weight",
      "options": [
        {
          "value": "100",
