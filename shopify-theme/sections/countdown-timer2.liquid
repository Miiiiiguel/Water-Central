{% assign brightness_diff = section.settings.accent_color | brightness_difference: '#ffffff' %}
{% if brightness_diff > 125 %}
  {% assign readable_text_color = '#ffffff' %}
{% else %}
  {% assign readable_text_color = '#242424' %}
{% endif %}

{%- style -%}
  *, *:after, *:before {
    box-sizing: border-box;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  .loudecomz-container,
  .loudecomz-container-fluid {
    width: 100%;
    padding-right: var(--loudecomz-gutter-x, 15px);
    padding-left: var(--loudecomz-gutter-x, 15px);
    margin-right: auto;
    margin-left: auto;
  }

  @media (min-width: 576px) {
    .loudecomz-container {
      max-width: 540px;
    }
  }

  @media (min-width: 750px) {
    .loudecomz-container {
      max-width: 720px;
    }
  }

  @media (min-width: 992px) {
    .loudecomz-container {
      max-width: 960px;
    }
    {% if section.settings.container_max_width >= 720 and section.settings.container_max_width <= 960 %}
      .loudecomz-section__{{sec_id}} .loudecomz-container {
        max-width: {{section.settings.container_max_width}}px;
      }
    {% endif %}
  }

  @media (min-width: 1200px) {
    .loudecomz-container {
      max-width: 1140px;
    }
    {% if section.settings.container_max_width >= 720 and section.settings.container_max_width <= 1140 %}
      .loudecomz-section__{{sec_id}} .loudecomz-container {
        max-width: {{section.settings.container_max_width}}px;
      }
    {% endif %}
  }

  @media (min-width: 1400px) {
    .loudecomz-container {
      max-width: 1320px;
    }
    {% if section.settings.container_max_width >= 720 and section.settings.container_max_width != 1320 %}
      .loudecomz-section__{{sec_id}} .loudecomz-container {
        max-width: {{section.settings.container_max_width}}px;
      }
    {% endif %}
  }

  .loudecomz-section__{{sec_id}} .loudecomz-row {
    display: flex;
    flex-wrap: wrap;
    margin-right: calc(var(--loudecomz-gutter-x, 15px) * -1);
    margin-left: calc(var(--loudecomz-gutter-x, 15px) * -1);
    {% if section.settings.elements_position == 'timer_right' %}
      flex-direction: row;
    {% elsif section.settings.elements_position == 'timer_left' %}
      flex-direction: row-reverse;
    {% endif %}
  }

  .loudecomz-section__{{sec_id}} .loudecomz-row > * {
    box-sizing: border-box;
    flex-shrink: 0;
    width: 100%;
    max-width: 100%;
    padding-right: var(--loudecomz-gutter-x, 15px);
    padding-left: var(--loudecomz-gutter-x, 15px);
  }

  .loudecomz-section__{{sec_id}} .order-1 {
    order: 1;
  }

  .loudecomz-section__{{sec_id}} .order-2 {
    order: 2;
  }

  @media (min-width: 750px) {
    .loudecomz-section__{{sec_id}} .loudecomz-col-md-6 {
      flex: 0 0 auto;
      width: 50%;
    }
    .loudecomz-section__{{sec_id}} .order-md-1 {
      order: 1;
    }
    .loudecomz-section__{{sec_id}} .order-md-2 {
      order: 2;
    }
  }

  @media only screen and (min-width: 992px) {
    .loudecomz-section__{{sec_id}} .timer-wrapper {
      transform: translateY(-{{ section.settings.timer_vertical_position_desktop }}%);
      transform: translateX(-{{ section.settings.timer_horizontal_position_desktop }}%);
       background-color: transparent !important; /* Ensure transparency */
    }
  }

  @media (min-width: 992px) {
    .loudecomz-section__{{sec_id}} .loudecomz-col-lg-6 {
      flex: 0 0 auto;
      width: 50%;
    }
    .loudecomz-section__{{sec_id}} .order-lg-1 {
      order: 1;
    }
    .loudecomz-section__{{sec_id}} .order-lg-2 {
      order: 2;
    }
  }

  .loudecomz-section__{{sec_id}} .align-items-center {
    align-items: center;
  }

  .loudecomz-section__{{sec_id}} .loudecomz-btn,
  .rte .loudecomz-section__{{sec_id}} a.loudecomz-btn:not(.btn) {
    display: inline-block;
    text-decoration: none;
    border: none;
    outline: none;
    text-transform: none;
    text-align: center;
    background-color: {{section.settings.button_bg_color}};
    border-radius: {{section.settings.btn_border_radius}}px;
    color: {{ section.settings.button_text_color }};
    font-weight: 400;
    white-space: normal;
    padding: 16px 36px;
    margin: 0 0 12px 0;
    line-height: 1.5;
    min-width: auto;
    min-height: auto;
    transition: all 0.25s;
    cursor: pointer;
    box-sizing: border-box;
    vertical-align: middle;
    font-size: {{ section.settings.button_size }}px;
  }

  /* Button Hover Animations */
  .loudecomz-section__{{sec_id}} .loudecomz-btn.smooth-fade-in:hover {
    opacity: 0.8;
  }

  .loudecomz-section__{{sec_id}} .loudecomz-btn.smooth-fade-up:hover {
    transform: translateY(-5px);
    opacity: 0.8;
  }

  .loudecomz-section__{{sec_id}} .loudecomz-btn.smooth-shadow:hover {
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
  }

  .loudecomz-section__{{sec_id}} .loudecomz-btn.smooth-glow:hover {
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.7);
  }

  .loudecomz-section__{{sec_id}} .loudecomz-btn.smooth-scale-in:hover {
    transform: scale(1.05);
  }

  .loudecomz-section__{{sec_id}} .loudecomz-btn.smooth-zoom-out:hover {
    transform: scale(0.95);
  }
  /* End Button Hover Animations */

  .loudecomz-section__{{sec_id}} .loudecomz-btn:focus {
    outline: none;
    box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.5);
  }

  .loudecomz-section__{{sec_id}} {
    --loudecomz-gutter-x: 20px;
    padding-top: {{section.settings.section_padding_top}}px;
    padding-bottom: {{section.settings.section_padding_bottom}}px;
    margin-top: {{section.settings.section_margin_top}}px;
    margin-bottom: {{section.settings.section_margin_bottom}}px;
    line-height: 1.5;
    position: relative;
    text-align: {{ section.settings.all_elements_alignment_desktop }};
    {% if section.settings.all_elements_alignment_mobile != section.settings.all_elements_alignment_desktop %}
      @media only screen and (max-width: 749px) {
        text-align: {{ section.settings.all_elements_alignment_mobile }};
      }
    {% endif %}
    {% if section.settings.display_on_devices == 'mobile_only' %}
      display: none;
    {% elsif section.settings.display_on_devices == 'desktop_only' %}
      @media (max-width: 749px) {
        display: none;
      }
    {% endif %}
    {% if section.settings.enable_custom_fonts and section.settings.selected_font != blank %}
      font-family: '{{ section.settings.selected_font }}', sans-serif;
    {% endif %}
  }

  .loudecomz-section__{{sec_id}}.hide_section {
    display: none !important;
  }

  .loudecomz-section__{{sec_id}}.hide_timer .timer-wrapper {
    display: none !important;
  }

  .loudecomz-section__{{sec_id}} .timer-content {
    max-width: 530px;
    text-align: {{ section.settings.all_elements_alignment_desktop }};
    {% if section.settings.all_elements_alignment_mobile != section.settings.all_elements_alignment_desktop %}
      @media only screen and (max-width: 749px) {
        text-align: {{ section.settings.all_elements_alignment_mobile }};
      }
    {% endif %}
    {% if section.settings.enable_custom_fonts and section.settings.selected_font != blank %}
      font-family: '{{ section.settings.selected_font }}', sans-serif;
    {% endif %}
  }

  .loudecomz-section__{{sec_id}} .loudecomz-section-title {
    color: {{section.settings.heading_color}} !important;
    font-weight: {{ section.settings.heading_font_weight }};
    margin-top: 0;
    margin-bottom: 16px;
    font-size: {{ section.settings.heading_size_desktop }}px;
    {% if section.settings.enable_gradient %}
      background: linear-gradient({{ section.settings.gradient_degrees }}, {{ section.settings.gradient_start_color }}, {{ section.settings.gradient_end_color }});
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      text-fill-color: transparent;
    {% endif %}
    {% if section.settings.enable_custom_fonts and section.settings.selected_font != blank %}
      font-family: '{{ section.settings.selected_font }}', sans-serif;
    {% endif %}
  }

  .loudecomz-section__{{sec_id}} .loudecomz-section-subtitle {
    color: {{section.settings.sub_heading_color}};
    margin-top: 0;
    margin-bottom: 16px;
    font-size: {{ section.settings.sub_heading_size_desktop }}px;
    {% if section.settings.enable_custom_fonts and section.settings.selected_font != blank %}
      font-family: '{{ section.settings.selected_font }}', sans-serif;
    {% endif %}
  }

  .loudecomz-section__{{sec_id}} .timer-wrapper {
    text-align: right;
     background-color: transparent !important; /* Ensure transparency */
    height: {{ section.settings.timer_height }}px;
    {% if section.settings.elements_position == 'timer_right' %}
      order: 2;
    {% elsif section.settings.elements_position == 'timer_left' %}
      order: 1;
    {% endif %}
    background-color: {{ section.settings.timer_background_color }};
  }

  .loudecomz-section__{{sec_id}} .timer {
    display: inline-flex;
    /* Brightness filter is applied to the ::before pseudo-element instead */
    {% if section.settings.enable_custom_fonts and section.settings.selected_font != blank %}
      font-family: '{{ section.settings.selected_font }}', sans-serif;
    {% endif %}
  }

  .loudecomz-section__{{sec_id}} .timer-block {
    flex-shrink: 0;
    width: 78px;
    margin-right: 16px;
  }

  .loudecomz-section__{{sec_id}} .timer-block:last-child {
    margin-right: 0;
  }

  .loudecomz-section__{{sec_id}} .timer-block-value {
    position: relative;
    padding-top: 100%;
    border-radius: {{ section.settings.timer_block_border_radius }}px;
    overflow: hidden;
    background-color: {{section.settings.accent_color}};
    margin-bottom: 16px;
    {% if section.settings.enable_timer_gradient %}
      background: linear-gradient({{ section.settings.timer_gradient_degrees }}, {{ section.settings.timer_gradient_start_color }}, {{ section.settings.timer_gradient_middle_color }}, {{ section.settings.timer_gradient_end_color }});
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      text-fill-color: transparent;
    {% endif %}
    {% if section.settings.enable_custom_fonts and section.settings.selected_font != blank %}
      font-family: '{{ section.settings.selected_font }}', sans-serif;
    {% endif %}
  }

  .loudecomz-section__{{sec_id}} .timer-value {
    padding: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    color: {{ section.settings.timer_number_color }};
    font-size: 32px;
    font-weight: {{ section.settings.time_numbers_font_weight }};
    line-height: 1.2;
    {% if section.settings.enable_timer_gradient %}
      background: linear-gradient({{ section.settings.timer_gradient_degrees }}, {{ section.settings.timer_gradient_start_color }}, {{ section.settings.timer_gradient_middle_color }}, {{ section.settings.timer_gradient_end_color }});
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      text-fill-color: transparent;
    {% endif %}
    {% if section.settings.enable_custom_fonts and section.settings.selected_font != blank %}
      font-family: '{{ section.settings.selected_font }}', sans-serif;
    {% endif %}
  }

  .loudecomz-section__{{sec_id}} .timer-block-label {
    text-align: center;
    color: {{section.settings.text_color}};
    font-size: 14px;
    font-weight: 400;
    display: block;
    {% if section.settings.enable_custom_fonts and section.settings.selected_font != blank %}
      font-family: '{{ section.settings.selected_font }}', sans-serif;
    {% endif %}
  }

  {% if section.settings.inherit_fonts == false %}
    .loudecomz-section__{{sec_id}} .loudecomz-btn {
      font-size: {{ section.settings.button_size }}px;
    }
    .loudecomz-section__{{sec_id}} .loudecomz-section-title {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }
    .loudecomz-section__{{sec_id}} .loudecomz-section-subtitle {
      font-size: {{ section.settings.sub_heading_size_desktop }}px;
    }
  {% endif %}

  @media only screen and (max-width: 991px) {
    .loudecomz-section__{{sec_id}} .timer-block {
      width: 70px;
    }
  }

  @media only screen and (max-width: 749px) {
    .loudecomz-section__{{sec_id}} .loudecomz-btn {
      padding: 12px 30px;
      font-size: {{ section.settings.button_size_mobile }}px;
    }
    .loudecomz-section__{{sec_id}} {
      padding-top: {{section.settings.section_padding_top_mobile}}px;
      padding-bottom: {{section.settings.section_padding_bottom_mobile}}px;
      margin-top: {{section.settings.section_margin_top_mobile}}px;
      margin-bottom: {{section.settings.section_margin_bottom_mobile}}px;
    }

    .loudecomz-section__{{sec_id}} .timer-wrapper {
      text-align: left;
      margin-bottom: 25px;
       background-color: transparent !important; /* Ensure transparency */
      text-align: {% case section.settings.timer_position_mobile %}
                  {% when 'left' %} left;
                  {% when 'center' %} center;
                  {% when 'right' %} right;
                  {% else %} center;
      {% endcase %}
      {% if section.settings.elements_position == 'timer_right' %}
        order: 2;
      {% elsif section.settings.elements_position == 'timer_left' %}
        order: 1;
      {% endif %}
    }

    .loudecomz-section__{{sec_id}} .loudecomz-section-title {
      font-size: {{ section.settings.heading_size_mobile }}px;
      {% if section.settings.enable_gradient %}
        background: linear-gradient({{ section.settings.gradient_degrees }}, {{ section.settings.gradient_start_color }}, {{ section.settings.gradient_end_color }});
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        text-fill-color: transparent;
      {% endif %}
    }
    .loudecomz-section__{{sec_id}} .loudecomz-section-subtitle {
      font-size: {{ section.settings.sub_heading_size_mobile }}px;
    }
  }

  @media only screen and (max-width: 490px) {
    .loudecomz-section__{{sec_id}} .timer-block {
      width: 58px;
    }
    .loudecomz-section__{{sec_id}} .timer-value {
      font-size: 28px;
    }
  }
{%- endstyle -%}

{% if section.settings.custom_css != blank %}
  {%- style -%}
    {{section.settings.custom_css}}
  {%- endstyle -%}
{% endif %}

{% if section.settings.is_fullwidth == true %}
  {% assign container = 'loudecomz-container-fluid' %}
{% else %}
  {% assign container = 'loudecomz-container' %}
{% endif %}

{% comment %}
  Import selected Google Font if custom fonts are enabled and a font is selected
{% endcomment %}
{% if section.settings.enable_custom_fonts and section.settings.selected_font != blank %}
  <link
    href="https://fonts.googleapis.com/css2?family={{ section.settings.selected_font | replace: ' ', '+' }}&display=swap"
    rel="stylesheet"
  >
{% endif %}

<style>
  .loudecomz-section__{{sec_id}} {
    position: relative; /* Ensure positioning context for pseudo-element */
    {% if section.settings.background_image != blank %}
      /* Background image handled in ::before */
    {% elsif section.settings.background_color == blank or section.settings.background_color == "rgba(0,0,0,0)" %}
      /* Default background image handled in ::before */
    {% else %}
      background: {{section.settings.background_color}};
    {% endif %}
    text-align: {{ section.settings.all_elements_alignment_desktop }};
    {% if section.settings.all_elements_alignment_mobile != section.settings.all_elements_alignment_desktop %}
      @media only screen and (max-width: 749px) {
        text-align: {{ section.settings.all_elements_alignment_mobile }};
      }
    {% endif %}
    {% if section.settings.enable_custom_fonts and section.settings.selected_font != blank %}
      font-family: '{{ section.settings.selected_font }}', sans-serif;
    {% endif %}
  }

  {% if section.settings.background_image != blank %}
    .loudecomz-section__{{sec_id}}::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: url({{section.settings.background_image | image_url}}) no-repeat center/cover;
      filter: brightness({{ section.settings.image_brightness }}%);
      z-index: -1;
    }
  {% elsif section.settings.background_color == blank or section.settings.background_color == "rgba(0,0,0,0)" %}
    .loudecomz-section__{{sec_id}}::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: url(data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E) no-repeat center/cover;
      filter: brightness({{ section.settings.image_brightness }}%);
      z-index: -1;
    }
  {% endif %}
</style>

<div class="loudecomz-section__{{sec_id}} loudecomz-section {{ section.settings.custom_class }}">
  <div class="{{container}}">
    <div class="loudecomz-row align-items-center">
      <div class="loudecomz-col-md-6 order-2 order-md-1">
        <div class="timer-content">
          {% for block in section.blocks %}
            {% if block.type == 'heading' %}
              <div class="loudecomz-title-wrapper" {{ block.shopify_attributes }}>
                {% if block.settings.heading_text != blank %}
                  <{{ section.settings.heading_tag }} class="loudecomz-section-title">
                    {{ block.settings.heading_text | escape }}
                  </{{ section.settings.heading_tag }}>
                {% endif %}
                {% if block.settings.sub_heading_text != blank %}
                  <p class="loudecomz-section-subtitle">{{ block.settings.sub_heading_text | escape }}</p>
                {% endif %}
              </div>
            {% endif %}

            {% if block.type == 'buttons' and section.settings.show_buttons %}
              <div class="loudecomz-section-btns" {{ block.shopify_attributes }}>
                {% if block.settings.button_label_1 != blank %}
                  <a
                    href="{{block.settings.button_link_1}}"
                    class="loudecomz-btn {% if section.settings.button_hover_animation != 'none' %}{{ section.settings.button_hover_animation | replace: '_', '-' }}{% endif %}"
                  >
                    {{ block.settings.button_label_1 }}
                  </a>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="loudecomz-col-md-6 order-1 order-md-2">
        {% for block in section.blocks %}
          {% if block.type == 'timer1' %}
            <div class="timer-wrapper" {{ block.shopify_attributes }}>
              <div
                class="timer timer-1"
                data-timer1="true"
                data-deadline="{{ block.settings.date_picker }}"
                data-timer-ends="{{section.settings.timer_ends}}"
              >
                <div class="timer-block">
                  <div class="timer-block-value">
                    <span class="t-days timer-value">00</span>
                  </div>
                  {% if section.settings.days_label != blank %}
                    <span class="timer-block-label">{{ section.settings.days_label }}</span>
                  {% endif %}
                </div>
                <div class="timer-block">
                  <div class="timer-block-value">
                    <span class="t-hours timer-value">00</span>
                  </div>
                  {% if section.settings.hours_label != blank %}
                    <span class="timer-block-label">{{ section.settings.hours_label }}</span>
                  {% endif %}
                </div>
                <div class="timer-block">
                  <div class="timer-block-value">
                    <span class="t-minutes timer-value">00</span>
                  </div>
                  {% if section.settings.minutes_label != blank %}
                    <span class="timer-block-label">{{ section.settings.minutes_label }}</span>
                  {% endif %}
                </div>
                <div class="timer-block">
                  <div class="timer-block-value">
                    <span class="t-seconds timer-value">00</span>
                  </div>
                  {% if section.settings.seconds_label != blank %}
                    <span class="timer-block-label">{{ section.settings.seconds_label }}</span>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endif %}

          {% if block.type == 'timer2' %}
            <div class="timer-wrapper" {{ block.shopify_attributes }}>
              <div
                class="timer timer-2"
                data-timer2="true"
                data-period_days="{{ block.settings.period_days }}"
                data-period_hours="{{ block.settings.period_hours }}"
                data-period_minutes="{{ block.settings.period_minutes }}"
                data-period_seconds="{{ block.settings.period_seconds }}"
                data-countdown_restart="{{ block.settings.countdown_restart }}"
                data-timer-ends="{{section.settings.timer_ends}}"
              >
                <div class="timer-block">
                  <div class="timer-block-value">
                    <span class="t-days timer-value">00</span>
                  </div>
                  {% if section.settings.days_label != blank %}
                    <span class="timer-block-label">{{ section.settings.days_label }}</span>
                  {% endif %}
                </div>
                <div class="timer-block">
                  <div class="timer-block-value">
                    <span class="t-hours timer-value">00</span>
                  </div>
                  {% if section.settings.hours_label != blank %}
                    <span class="timer-block-label">{{ section.settings.hours_label }}</span>
                  {% endif %}
                </div>
                <div class="timer-block">
                  <div class="timer-block-value">
                    <span class="t-minutes timer-value">00</span>
                  </div>
                  {% if section.settings.minutes_label != blank %}
                    <span class="timer-block-label">{{ section.settings.minutes_label }}</span>
                  {% endif %}
                </div>
                <div class="timer-block">
                  <div class="timer-block-value">
                    <span class="t-seconds timer-value">00</span>
                  </div>
                  {% if section.settings.seconds_label != blank %}
                    <span class="timer-block-label">{{ section.settings.seconds_label }}</span>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<script>
  function getTimeRemaining(endtime) {
    let t = Date.parse(endtime) - Date.parse(new Date());
    let seconds = Math.floor((t / 1000) % 60);
    let minutes = Math.floor((t / 1000 / 60) % 60);
    let hours = Math.floor((t / (1000 * 60 * 60)) % 24);
    let days = Math.floor(t / (1000 * 60 * 60 * 24));
    return {
      'total': t,
      'days': days,
      'hours': hours,
      'minutes': minutes,
      'seconds': seconds
    };
  }

  function initializeClock(parentSelector, endtime) {
    let clock = document.querySelector(parentSelector);
    let daysSpan = clock.querySelector('.t-days');
    let hoursSpan = clock.querySelector('.t-hours');
    let minutesSpan = clock.querySelector('.t-minutes');
    let secondsSpan = clock.querySelector('.t-seconds');

    let timerEnds = clock.getAttribute("data-timer-ends");
    let timerEndsCLass = "do_nothing";
    if (timerEnds === "hide_timer") {
      timerEndsCLass = "hide_timer";
    }
    if (timerEnds === "hide_section") {
      timerEndsCLass = "hide_section";
    }
    if (timerEnds === "do_nothing") {
      timerEndsCLass = "do_nothing";
    }

    function updateClock() {
      let t = getTimeRemaining(endtime);

      daysSpan.innerHTML = t.days;
      hoursSpan.innerHTML = ('0' + t.hours).slice(-2);
      minutesSpan.innerHTML = ('0' + t.minutes).slice(-2);
      secondsSpan.innerHTML = ('0' + t.seconds).slice(-2);

      if (t.total <= 0) {
        daysSpan.innerHTML = '00';
        hoursSpan.innerHTML = '00';
        minutesSpan.innerHTML = '00';
        secondsSpan.innerHTML = '00';

        clearInterval(timeinterval);
        showMessage("End timer!!!");
        clock.closest('.loudecomz-section').classList.add(timerEndsCLass);
      }
    }

    updateClock();
    var timeinterval = setInterval(updateClock, 1000);
  }

  function showMessage(message) {
    console.log(message);
  }

  function setCookie(name, value, days) {
    let expires = '';
    if (days) {
      let date = new Date();
      date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
      expires = '; expires=' + date.toUTCString();
    }
    document.cookie = name + '=' + (value || '') + expires + '; path=/';
  }

  function getCookie(name) {
    let nameEQ = name + '=';
    let ca = document.cookie.split(';');
    for (let i = 0; i < ca.length; i++) {
      let c = ca[i];
      while (c.charAt(0) === ' ') c = c.substring(1, c.length);
      if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length, c.length);
    }
    return null;
  }

  {

    let sectionName = 'seez-timer';

    var _obj = _obj || {};

    _obj['loader_' + sectionName] = true;

    document.addEventListener('DOMContentLoaded', function() {

      let section_name = sectionName;

      let sec_id = '{{sec_id}}';

      _obj[section_name + sec_id] = function(id) {

          let section = '.loudecomz-section__' + '{{sec_id}}';

          let is_timer1 = document.querySelector(section + ' .timer-1');
          if(is_timer1 !== null) {
            is_timer1 = is_timer1.getAttribute('data-timer1') === 'true' ? true : false;
          }

          let is_timer2 = document.querySelector(section + ' .timer-2');
          if(is_timer2 !== null) {
            is_timer2 = is_timer2.getAttribute('data-timer2') === 'true' ? true : false;
          }

          if(is_timer1) {

            let deadline  = document.querySelector(section + ' .timer-1').getAttribute('data-deadline');
            deadline = new Date(deadline);
            initializeClock(section + ' .timer-1', deadline);
          }

          if(is_timer2) {

            let days, hours, minutes, seconds, resetPeriod, cookieExpiry, deadline2 = 0;
            let timer2  = document.querySelector(section + ' .timer-2');
            days        = +timer2.getAttribute('data-period_days');
            hours       = +timer2.getAttribute('data-period_hours');
            minutes     = +timer2.getAttribute('data-period_minutes');
            seconds     = +timer2.getAttribute('data-period_seconds');
            resetPeriod =  timer2.getAttribute('data-countdown_restart');

            if (resetPeriod === 'hour') {
              cookieExpiry = 1 / 24; // 1 hour
            } else if (resetPeriod === 'day') {
              cookieExpiry = 1; // 1 day
            } else if (resetPeriod === 'week') {
              cookieExpiry = 7; // 1 week
            } else if (resetPeriod === 'month') {
              cookieExpiry = 30; // 1 month
            } else if (resetPeriod === 'none') {
              cookieExpiry = -1;
            }

            deadline2 = new Date();
            deadline2.setDate(deadline2.getDate() + days);
            deadline2.setHours(deadline2.getHours() + hours);
            deadline2.setMinutes(deadline2.getMinutes() + minutes);
            deadline2.setSeconds(deadline2.getSeconds() + seconds);

            let cookieName = 'countdownData__' + sec_id;
            let savedData = getCookie(cookieName);

            let timer_duration = '' + days + hours + minutes + seconds;
            let timer_duration_from_cookie = getCookie('timer_duration__' + sec_id);
            let oldcookieExpiry = +getCookie('cookieExpiry__' + sec_id);

            if (savedData && timer_duration === timer_duration_from_cookie && oldcookieExpiry === cookieExpiry ) {
              savedData = JSON.parse(savedData);
              let savedEndTime = new Date(savedData.endTime);
              let currentTime = new Date();

              if (savedEndTime > currentTime) {
                initializeClock(section + ' .timer-2', savedEndTime);
              } else {
                initializeClock(section + ' .timer-2', new Date());
              }

            } else {

              // set cookie
              let countdownData = {
                endTime: deadline2.toISOString()
              };

              setCookie('timer_duration__' + sec_id, timer_duration, cookieExpiry);
              setCookie('cookieExpiry__' + sec_id, cookieExpiry, cookieExpiry);
              setCookie(cookieName, JSON.stringify(countdownData), cookieExpiry);

              initializeClock(section + ' .timer-2', deadline2);

            }
          }
      };

      _obj[section_name + sec_id](sec_id);

    });

  }
</script>

