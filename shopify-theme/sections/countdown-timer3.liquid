{% style %}
:root {
--loudz-neutral-70: #5e5e5e;
--loudz-neutral-03: #f8f8f8;
--loudz-neutral-01: #fff;
--loudz-size-1: 1px;
--loudz-size-2: 2px;
--loudz-size-4: 4px;
--loudz-size-8: 8px;
--loudz-size-12: 12px;
--loudz-size-14: 14px;
--loudz-size-16: 16px;
--loudz-size-20: 20px;
--loudz-size-24: 24px;
--loudz-size-32: 32px;
--loudz-size-40: 40px;
--loudz-size-48: 48px;
--loudz-font-weight-400: 400;
--loudz-font-weight-600: 600;
--loudz-line-height-140: 1.4;
--loudz-text-decoration-none: none;
--loudz-text-decoration-underline: underline;
--loudz-border-width-1: var(--loudz-size-1);
--loudz-border-width-2: var(--loudz-size-2);
--loudz-color-bg-fill-inverse-on-light: var(--loudz-neutral-01);
--loudz-color-bg-surface-tertiary-on-light: var(--loudz-neutral-03);
--loudz-color-text-disable-on-light: var(--loudz-neutral-70);
--loudz-space-2: var(--loudz-size-2);
--loudz-space-4: var(--loudz-size-4);
--loudz-space-8: var(--loudz-size-8);
--loudz-space-12: var(--loudz-size-12);
--loudz-space-16: var(--loudz-size-16);
--loudz-space-20: var(--loudz-size-20);
--loudz-space-24: var(--loudz-size-24);
--loudz-space-32: var(--loudz-size-32);
--loudz-space-40: var(--loudz-size-40);
--loudz-font-size-12: var(--loudz-size-12);
--loudz-font-size-14: var(--loudz-size-14);
--loudz-font-size-16: var(--loudz-size-16);
--loudz-font-size-20: var(--loudz-size-20);
--loudz-font-size-24: var(--loudz-size-24);
--loudz-font-size-32: var(--loudz-size-32);
--loudz-font-size-48: var(--loudz-size-48);
}


{% endstyle %}

<!-- --UUID-01a02399-- -->

{%- liquid
	assign timer_block = section.blocks | where: "type", "timer" | first
	assign caption_block = section.blocks | where: "type", "caption" | first
	assign heading_block = section.blocks | where: "type", "heading" | first
	assign text_block = section.blocks | where: "type", "text" | first
	assign button_block = section.blocks | where: "type", "button" | first

	assign is_block_text_empty = false

	assign is_caption_empty = false
	assign is_heading_empty = false
	assign is_text_empty = false
	assign is_button_empty = false

	if caption_block == blank or caption_block.settings.caption == blank
		assign is_caption_empty = true
	endif

	if heading_block == blank or heading_block.settings.heading == blank
		assign is_heading_empty = true
	endif

	if button_block == blank or button_block.settings.primary_button_label == blank
		assign is_text_empty = true
	endif

	if text_block == blank or text_block.settings.description == blank
		assign is_button_empty = true
	endif

	if is_caption_empty == true and is_heading_empty == true and is_text_empty == true and is_button_empty == true
		assign is_block_text_empty = true
	endif
-%}

<section class="loudz-{{ section.id | handle }} loudzFlashTimer" {% if is_heading_empty == false %}aria-labelledby="loudzFlashTimerHeading-{{ section.id }}"{% else %}aria-label="Flash Sale Countdown"{% endif %}>
	<div class="loudzFlashTimerContainer">
		<div class="loudzFlashCountdownTimer loudzFlashCountdownTimer--desktopPosition-{{ section.settings.timer_position_desktop }} loudzFlashCountdownTimer--mobilePosition-{{ section.settings.timer_position_mobile }}">
			<div class="loudzFlashCountdownTimer__Content {% if is_block_text_empty == true %}loudzFlashCountdownTimer__Content--onlyTimer{% endif %}">
				<div class="loudzTextBox">
					{%- for block in section.blocks -%}
						{%- case block.type -%}
							{%- when "heading" -%}
								{%- if block.settings.heading_alternative_font -%}
									<style>
										{{- block.settings.heading_font | font_face: font_display: 'swap' -}}
									</style>
								{%- endif -%}
								{%- capture heading_css_variables -%}
                                    --block-heading-size: {{- block.settings.heading_size -}}px;
                                    --block-heading-color: {{- block.settings.heading_color -}};
                                    --block-heading-font: {{- block.settings.heading_font.family -}};
                                  {%- endcapture -%}
								<h2
									style="{{- heading_css_variables | strip_newlines | escape -}}"
									class="loudzTextBox__Heading loudzTextBox__Heading--style-{{ block.settings.heading_style }} {% if block.settings.heading_alternative_font == true %}loudzTextBox__Heading--alternativeFont{% endif %}"
									id="loudzFlashTimerHeading-{{ section.id }}"
									{{ block.shopify_attributes }}
								>
									{{- block.settings.heading -}}
								</h2>
							{%- when "caption" -%}
								{%- if block.settings.caption_alternative_font -%}
									<style>
										{{- block.settings.caption_font | font_face: font_display: 'swap' -}}
									</style>
								{%- endif -%}
								{%- capture caption_css_variables -%}
                                    --block-caption-size: {{- block.settings.caption_size -}}px;
                                    --block-caption-color: {{- block.settings.caption_color -}};
                                    --block-caption-font: {{- block.settings.caption_font.family -}};
                                    --block-caption-weight: {{- block.settings.caption_weight -}};
                                  {%- endcapture -%}
								<p
									style="{{- caption_css_variables | strip_newlines | escape -}}"
									class="loudzTextBox__Caption {% if block.settings.caption_alternative_font == true %}loudzTextBox__Caption--alternativeFont{% endif %}"
									{{ block.shopify_attributes }}
								>
									{{- block.settings.caption -}}
								</p>
							{%- when "text" -%}
								{%- if block.settings.description_alternative_font -%}
									{%- liquid
										assign body_font_bold = block.settings.description_font | font_modify: 'weight', 'bold'
										assign body_font_italic = block.settings.description_font | font_modify: 'style', 'italic'
										assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
									%}
									<style>
										{{- block.settings.description_font | font_face: font_display: 'swap' -}}
										{{ body_font_bold | font_face: font_display: 'swap' }}
										{{ body_font_italic | font_face: font_display: 'swap' }}
										{{ body_font_bold_italic | font_face: font_display: 'swap' }}
									</style>
								{%- endif -%}
								{%- capture description_css_variables -%}
                                    --block-description-size: {{- block.settings.description_size -}}px;
                                    --block-description-color: {{- block.settings.description_color -}};
                                    --block-description-font: {{- block.settings.description_font.family -}};
                                  {%- endcapture -%}
								<div
									style="{{- description_css_variables | strip_newlines | escape -}}"
									class="loudzTextBox__Description loudzTextBox__Description--alignment-{{ section.settings.text_alignment }} {% if block.settings.description_alternative_font == true %}loudzTextBox__Description--alternativeFont{% endif %}"
									{{ block.shopify_attributes }}
								>
									{{- block.settings.description -}}
								</div>
							{%- when "button" -%}
								{%- capture buttons_css_variables -%}
                                    --block-primary-button-text-color: {{- block.settings.primary_text_color -}};
                                    --block-primary-button-background-color: {{- block.settings.primary_background_color -}};
                                    --block-primary-button-corner-radius: {{- block.settings.primary_button_corner -}}px;
                                    --block-primary-button-border-color: {{- block.settings.primary_border_color -}};
                                  {%- endcapture -%}
								<div
									style="{{- buttons_css_variables | strip_newlines | escape -}}"
									class="loudzImgTextButtons"
									{{ block.shopify_attributes }}
								>
									{%- if block.settings.primary_button_label != blank -%}
										<a
											{% if block.settings.primary_new_tab == true %}
												target="_blank"
												rel="noopener noreferrer"
											{% endif %}
											class="loudzImgTextButtons__Primary loudzImgTextButtons__Primary--{{ block.settings.primary_button_style }}"
											href="{{ block.settings.primary_button_link | default: "#" }}"
										>
											{{- block.settings.primary_button_label | escape -}}
										</a>
									{%- endif -%}
								</div>
						{%- endcase -%}
					{%- endfor -%}
				</div>
			</div>
			{%- if timer_block -%}
                <loudz-countdown-timer
					class="
						loudzFlashCountdownTimer__Timer
						{% if timer_block.settings.show_numbers == true %}loudzFlashCountdownTimer__Timer--onlyNumbers{% endif %}
						{% if is_block_text_empty == true %}loudzFlashCountdownTimer__Timer--onlyTimer{% endif %}
					"
					{{ timer_block.shopify_attributes }}
				>
					{%- assign end_date = timer_block.settings.end_date -%}
					{%- assign end_time = timer_block.settings.end_time -%}

					{%- capture heading_css_variables -%}
                        --block-numbers-color: {{- timer_block.settings.numbers_color -}};
                        --block-text-color: {{- timer_block.settings.text_color -}};
                    {%- endcapture -%}
					<div
						style="{{- heading_css_variables | strip_newlines | escape -}}"
						id="loudzCountdownTimer"
						class="loudzCountdownTimer"
						{%- if end_date != blank and end_time != blank -%}
							data-end-date="{{ end_date }}"
							data-end-time="{{ end_time }}"
						{%- endif -%}
						data-completed-text="{{ section.settings.completed_message }}"
						data-hide-section="{{ section.settings.hide_section }}"
						role="timer"
						aria-live="polite"
						aria-atomic="true"
						aria-label="Time remaining: 00 days, 00 hours, 00 minutes"
					>
						<div
							class="
								loudzCountdownTimerActive
								loudzCountdownTimerActive--{{ timer_block.settings.countdown_size }}
								loudzCountdownTimerActive--{{ timer_block.settings.numbers_style }}
							"
							aria-hidden="true"
						>
							<div class="loudzCountdownTimerActive__Item">
								<h6 class="loudzCountdownTimerActive__Number loudzDays">00</h6>
								<span class="loudzCountdownTimerActive__Text">days</span>
							</div>
							<span class="loudzCountdownTimerActive__Divider">:</span>
							<div class="loudzCountdownTimerActive__Item">
								<h6 class="loudzCountdownTimerActive__Number loudzHours">00</h6>
								<span class="loudzCountdownTimerActive__Text">hours</span>
							</div>
							<span class="loudzCountdownTimerActive__Divider">:</span>
							<div class="loudzCountdownTimerActive__Item">
								<h6 class="loudzCountdownTimerActive__Number loudzMinutes">00</h6>
								<span class="loudzCountdownTimerActive__Text">min</span>
							</div>
							<span class="loudzCountdownTimerActive__Divider">:</span>
							<div class="loudzCountdownTimerActive__Item">
								<h6 class="loudzCountdownTimerActive__Number loudzSeconds">00</h6>
								<span class="loudzCountdownTimerActive__Text">sec</span>
							</div>
						</div>
					</div>
				</loudz-countdown-timer>
			{%- endif -%}
		</div>
	</div>
</section>

{% schema %}
{
	"name": "Countdown Timer Pro 3",
	"settings": [
		{
			"type": "header",
			"content": "General"
		},
		{
			"type": "color",
			"id": "section_background",
			"label": "Section background color",
			"default": "#000000"
		},
		{
			"type": "select",
			"id": "timer_position_desktop",
			"label": "Timer position on desktop",
			"options": [
				{
					"value": "left",
					"label": "Left"
				},
				{
					"value": "right",
					"label": "Right"
				}
			],
			"default": "left",
			"info": "Controls where the countdown timer appears relative to other content on desktop screens."
		},
		{
			"type": "select",
			"id": "timer_position_mobile",
			"label": "Timer position on mobile",
			"options": [
				{
					"value": "above",
					"label": "Above content"
				},
				{
					"value": "bellow",
					"label": "Below content"
				}
			],
			"default": "above"
		},
		{
			"type": "select",
			"id": "text_alignment",
			"label": "Text alignment on desktop",
			"options": [
				{
					"value": "left",
					"label": "Left"
				},
				{
					"value": "center",
					"label": "Center"
				},
				{
					"value": "right",
					"label": "Right"
				}
			],
			"default": "left"
		},
		{
			"type": "select",
			"id": "text_alignment_mobile",
			"label": "Text alignment on mobile",
			"options": [
				{
					"value": "left",
					"label": "Left"
				},
				{
					"value": "center",
					"label": "Center"
				},
				{
					"value": "right",
					"label": "Right"
				}
			],
			"default": "center"
		},
		{
			"type": "checkbox",
			"id": "hide_section",
			"label": "Hide entire section after countdown ends",
			"default": true
		},
		{
			"type": "text",
			"id": "completed_message",
			"label": "Message after countdown completes",
			"info": "Visible only if 'Hide entire section after countdown ends' is disabled. This text will replace the timer."
		},
		{
			"type": "color",
			"id": "completed_message_color",
			"label": "Completed message text color",
			"default": "#222222"
		},
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "range",
			"id": "vertical_padding",
			"min": 0,
			"max": 100,
			"step": 2,
			"unit": "px",
			"label": "Desktop top and bottom padding",
			"default": 40,
			"info": "Adds space inside the section on the top and bottom for desktop views."
		},
		{
			"type": "range",
			"id": "vertical_padding_mobile",
			"min": 0,
			"max": 100,
			"step": 2,
			"unit": "px",
			"label": "Mobile top and bottom padding",
			"default": 20
		},
		{
			"type": "range",
			"id": "vertical_margin",
			"min": 0,
			"max": 100,
			"step": 2,
			"unit": "px",
			"label": "Desktop top and bottom margin",
			"default": 0,
			"info": "Adds space outside the section on the top and bottom for desktop views."
		},
		{
			"type": "range",
			"id": "vertical_margin_mobile",
			"min": 0,
			"max": 100,
			"step": 2,
			"unit": "px",
			"label": "Mobile top and bottom margin",
			"default": 0
		},
		{
			"type": "range",
			"id": "section_width",
			"min": 70,
			"max": 100,
			"step": 1,
			"unit": "%",
			"label": "Section width percentage",
			"default": 70
		},
		{
			"type": "text",
			"id": "section_max_width",
			"label": "Custom maximum width in pixels (optional)",
			"info": "Enter a pixel value to set a fixed maximum width, overriding the percentage if specified."
		}
	],
	"blocks": [
		{
			"type": "heading",
			"name": "Heading",
			"limit": 1,
			"settings": [
				{
					"type": "text",
					"id": "heading",
					"default": "Flash Sale Countdown",
					"label": "Heading text"
				},
				{
					"type": "select",
					"id": "heading_size",
					"label": "Heading font size",
					"options": [
						{
							"value": "24",
							"label": "Small (24px)"
						},
						{
							"value": "32",
							"label": "Medium (32px)"
						},
						{
							"value": "48",
							"label": "Large (48px)"
						}
					],
					"default": "32"
				},
				{
					"type": "select",
					"id": "heading_style",
					"label": "Heading font weight",
					"options": [
						{
							"value": "regular",
							"label": "Regular"
						},
						{
							"value": "bold",
							"label": "Bold"
						}
					],
					"default": "bold"
				},
				{
					"type": "color",
					"id": "heading_color",
					"label": "Heading text color",
					"default": "#fff"
				},
				{
					"type": "header",
					"content": "Alternative font"
				},
				{
					"type": "checkbox",
					"id": "heading_alternative_font",
					"label": "Use alternative font for heading",
					"default": false,
					"info": "Enables a custom font family for this heading block."
				},
				{
					"type": "font_picker",
					"id": "heading_font",
					"label": "Custom font family",
					"default": "sans_serif_n4"
				}
			]
		},
		{
			"type": "caption",
			"name": "Caption",
			"limit": 1,
			"settings": [
				{
					"type": "text",
					"id": "caption",
					"label": "Caption text"
				},
				{
					"type": "select",
					"id": "caption_size",
					"label": "Caption font size",
					"options": [
						{
							"value": "12",
							"label": "Small (12px)"
						},
						{
							"value": "16",
							"label": "Medium (16px)"
						},
						{
							"value": "20",
							"label": "Large (20px)"
						}
					],
					"default": "16"
				},
				{
					"type": "select",
					"id": "caption_weight",
					"label": "Caption font weight",
					"options": [
						{
							"value": "400",
							"label": "Regular (400)"
						},
						{
							"value": "600",
							"label": "Semi-bold (600)"
						}
					],
					"default": "400"
				},
				{
					"type": "color",
					"id": "caption_color",
					"label": "Caption text color",
					"default": "#222222"
				},
				{
					"type": "header",
					"content": "Alternative font"
				},
				{
					"type": "checkbox",
					"id": "caption_alternative_font",
					"label": "Use alternative font for caption",
					"default": false
				},
				{
					"type": "font_picker",
					"id": "caption_font",
					"label": "Custom font family",
					"default": "sans_serif_n4"
				}
			]
		},
		{
			"type": "text",
			"name": "Description",
			"limit": 1,
			"settings": [
				{
					"type": "richtext",
					"id": "description",
					"default": "<p>Share details about your exclusive limited-time offer or special promotion.</p>",
					"label": "Description text"
				},
				{
					"type": "select",
					"id": "description_size",
					"label": "Description font size",
					"options": [
						{
							"value": "12",
							"label": "Small (12px)"
						},
						{
							"value": "16",
							"label": "Medium (16px)"
						},
						{
							"value": "20",
							"label": "Large (20px)"
						}
					],
					"default": "16"
				},
				{
					"type": "color",
					"id": "description_color",
					"label": "Description text color",
					"default": "#D8D8D8"
				},
				{
					"type": "header",
					"content": "Alternative font"
				},
				{
					"type": "checkbox",
					"id": "description_alternative_font",
					"label": "Use alternative font for description",
					"default": false
				},
				{
					"type": "font_picker",
					"id": "description_font",
					"label": "Custom font family",
					"default": "sans_serif_n4"
				}
			]
		},
		{
			"type": "button",
			"name": "Button",
			"limit": 1,
			"settings": [
				{
					"type": "header",
					"content": "Primary button"
				},
				{
					"type": "text",
					"id": "primary_button_label",
					"label": "Button label text"
				},
				{
					"type": "url",
					"id": "primary_button_link",
					"label": "Button link URL"
				},
				{
					"type": "select",
					"id": "primary_button_style",
					"label": "Button appearance style",
					"options": [
						{
							"value": "solid",
							"label": "Filled (solid background)"
						},
						{
							"value": "outline",
							"label": "Outline (border only)"
						},
						{
							"value": "link",
							"label": "Text link (no background)"
						}
					],
					"default": "solid"
				},
				{
					"type": "color",
					"id": "primary_text_color",
					"label": "Button text color",
					"default": "#ffffff"
				},
				{
					"type": "color",
					"id": "primary_background_color",
					"label": "Button background color",
					"default": "#222222",
					"visible_if": "{{ block.settings.primary_button_style == 'solid' }}"
				},
				{
					"type": "color",
					"id": "primary_border_color",
					"label": "Button border color",
					"default": "#222222",
					"visible_if": "{{ block.settings.primary_button_style == 'outline' }}"
				},
				{
					"type": "range",
					"id": "primary_button_corner",
					"min": 0,
					"max": 100,
					"step": 2,
					"unit": "px",
					"label": "Button corner radius",
					"visible_if": "{{ block.settings.primary_button_style != 'link' }}",
					"default": 0,
					"info": "Rounds the corners of the button for a softer look."
				},
				{
					"type": "checkbox",
					"id": "primary_new_tab",
					"label": "Open button link in new tab",
					"default": false
				}
			]
		},
		{
			"type": "timer",
			"name": "Countdown timer",
			"limit": 1,
			"settings": [
				{
					"type": "text",
					"id": "end_date",
					"label": "Countdown end date",
					"info": "Format: MM-DD-YYYY. Timezone based on your store's primary timezone."
				},
				{
					"type": "select",
