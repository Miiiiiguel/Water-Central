{%- liquid
  assign section_st = section.settings
  assign theme_st = settings
  assign section_width = section_st.section_width
  assign transparent = section_st.transparent_header
  assign transparent_mobile = section_st.transparent_mobile
  assign transparent_color = section_st.transparent_text_icon_color
  assign sticky_header_type = section_st.sticky_header_type
  assign sticky_mobile = section_st.sticky_header_mobile
  assign color_scheme = section_st.color_scheme
  assign logo_position = section_st.logo_position
  assign top_search = section_st.show_search
  assign section_st = section.settings
  assign cart_icon_svg = section_st.cart_icon_svg
  assign my_account = section_st.show_account_icon

  assign recently_viewed = section_st.show_recently_viewed
  assign cart_icon_svg = settings.cart_icon_svg
  assign wishlist = section_st.show_wishlist_icon
  assign minicart = section_st.show_shopping_cart
  assign logo_image = section.settings.mobile_nav_logo_image
  assign show_country = section_st.show_currency
  assign show_language = section_st.show_language
  assign transparent_class = ''
  assign transparent_mobile_class = ''
if request.page_type == 'index' and transparent
  assign transparent_class = ' transparent absolute-1025 inset-x-0 z-15'
  if transparent_mobile
    assign transparent_mobile_class = ' transparent-mobile absolute'
  else
    assign transparent_mobile_class = ''
  endif
endif
-%}
<script src="{{ 'header.js' | asset_url }}" defer></script>

{{ 'logo.css' | asset_url | stylesheet_tag }}

{{ 'navigation.css' | asset_url | stylesheet_tag }}
{{ 'critical.css' | asset_url | stylesheet_tag }}

{% if section.settings.enable_glassmorphism_header %}
  {{ 'glassmorphism.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- capture style -%}
--section-pt: {{ section_st.padding_top }}; 
--section-pb: {{ section_st.padding_bottom }};
{%- endcapture -%}
{% if settings.search_type == 'default' %}
  {%- style -%}
      @media screen and (min-width: 768px) {
         .mobile-only {
      display: none;
    }
        header-inner.show-search-form.logo-left {
          grid-template-columns: auto auto 1fr;
        }
      }
  {%- endstyle -%}
{% endif %}
{% if transparent %}


<style>
  /* Size the transparent logo (from settings) */
  .section-header.transparent:not(.shopify-section-header-sticky) .header__transparent-logo{
    width: var(--transparent-logo-size);
    height: auto;
  }

  /* Move the LOGO LINK itself, not the container */
  .section-header.transparent:not(.shopify-section-header-sticky) .header__logo > a.logo-img,
  .section-header.transparent:not(.shopify-section-header-sticky) .header__logo > a.header__logo-link{
    display: inline-flex;          /* ensure transform applies */
    transform: translateX(var(--transparent-logo-shift));
    will-change: transform;
  }

  /* Swap to transparent logo on real transparent header only */
  .section-header.transparent:not(.shopify-section-header-sticky) .header__transparent-logo { display: inline-block; }
  .section-header.transparent:not(.shopify-section-header-sticky) .header__normal-logo      { display: none; }
  .section-header:not(.transparent) .header__transparent-logo,
  .section-header.shopify-section-header-sticky .header__transparent-logo { display: none; }
  .section-header:not(.transparent) .header__normal-logo,
  .section-header.shopify-section-header-sticky .header__normal-logo { display: inline-flex; }

  /* On mobile, if transparent is disabled, force normal logo */
  @media (max-width:1024.98px){
    header.transparent:not(.transparent-mobile) .header__transparent-logo{ display:none !important; }
    header.transparent:not(.transparent-mobile) .header__normal-logo{ display:inline-block !important; }
  }
</style>





  {%- style -%}
    
                     
                                  .section-header:not(.shopify-section-header-sticky) .transparent,
                                  .section-header:not(.shopify-section-header-sticky) .transparent-mobile {
                                    background-color: transparent;
                                    --input-bg: transparent;
    }

                      .nav-toggle {
                           color: {{ section.settings.menu_toggle_color_transparent }} !important;

         }

                                 .section-header:not(.shopify-section-header-sticky) .transparent .header-color,
               



                        .section-header:not(.shopify-section-header-sticky) .transparent .header__action svg {

                                 color: var(--transparent-color);
                                  }
                                  @media screen and (min-width: 1025px) {
                                    .section-header:not(.shopify-section-header-sticky) .transparent .header-color,
                                   
                                      color: var(--transparent-color);
          


                 }
                                       .section-header:not(.shopify-section-header-sticky) .transparent .header-color,
                            .section-header:not(.shopify-section-header-sticky) .transparent header-inner .button-localization,
                            .section-header:not(.shopify-section-header-sticky) .transparent .navigation > ul > li > a,


                            .section-header:not(.shopify-section-header-sticky) .transparent .header__action svg {
                                              color: var(--transparent-color);
                                                opacity: 1;
                              transition: opacity 0.3s ease-in-out, color 0.3s ease-in-out;

            }
            

                  .navigation svg.icon-down {
  color: var(--transparent-color) !important;
  filter: brightness(0.75) drop-shadow(1px 1px 0.7px rgba(0, 0, 0, 0.1));
  margin-bottom: -1.8px !important;
}

/* menu toggle color in transparent header */
.nav-toggle {
  color: {{ section.settings.menu_toggle_color_transparent }} !important;
}

/* subtle hover only, no color change */
.section-header:not(.shopify-section-header-sticky) .transparent .navigation a:hover,
.navigation svg.icon-down:hover,
.section-header:not(.shopify-section-header-sticky) .transparent .header__action svg:hover {
  opacity: 0.92;



                    }






                                    .section-header:not(.shopify-section-header-sticky) .transparent .level0 > menu-item > a {
                                      --color-heading: var(--transparent-color);
                                    }
                                    body:has(header.transparent) .h-full_screen {
                                      --height-header: 0px;
                                    }
                                  }
                                  @media screen and (max-width: 1024.98px) {
                                    .transparent:not(.transparent-mobile) .header__transparent-logo {
                                      display: none;
                                    }
                                    .transparent:not(.transparent-mobile) .header__normal-logo {
                                      display: block;
                                    }
                                  }
  {%- endstyle -%}





{% endif %}
<header
  class="
    header relative section
    {% if section_st.padding_top < 30 %} pt-min{% endif %}
    {% if section_st.padding_bottom < 30 %} pb-min{% endif %}
    gradient remove_spacing color-{{ color_scheme }}
    {% if transparent_class != '' %}{{ transparent_class }}{% endif %}
    {% if transparent_mobile_class != '' %}{{ transparent_mobile_class }}{% endif %}
    {% if request.page_type == 'index' and section_st.separator_line == 'homepage' %} border-bottom{% endif %}
    {% if section_st.separator_line == 'all-page' %} border-bottom{% endif %}
  {% if request.page_type == 'index' and section_st.separator_line == 'homepage' %} border-bottom{% endif %}
    {% if section_st.separator_line == 'all-page' %} border-bottom{% endif %}
    {% if request.page_type != 'index' and section_st.separator_line == 'inner_page' %} border-bottom{% endif %}
    {% if section.settings.enable_bottom_border %} custom-border{% endif %}
    popup-search-mobile
    {% if request.page_type != 'index' and section_st.separator_line == 'inner_page' %} border-bottom{% endif %}
    popup-search-mobile
    {% if section.settings.enable_glassmorphism_header %} glassmorphism{% endif %}
  "
  data-section-id="{{ section.id }}"
  data-sticky="{{ sticky_header_type }}"
  data-sticky-mobile="{{ sticky_mobile }}"
 style="
  {%- if section.settings.enable_bottom_border -%}
    {%- if request.page_type == 'index' and section.settings.hide_border_on_homepage -%}
      border-bottom: none;
    {%- else -%}
      border-bottom: 1px solid {{ section.settings.bottom_border_color }};
    {%- endif -%}
  {%- endif -%}
     {{ style | strip | strip_newlines }}
    --transparent-color: {{ section.settings.transparent_menu_text_color }} !important;
    --transparent-logo-size:  {{ settings.logo_transparent_width | default: settings.desktop_logo_width | default: 110 }}px;
    --transparent-logo-shift: {{ settings.logo_transparent_position | default: 0 }}px;
  "

>
  <div class="header__inner header__layout-1" id="header-sticky">
    <div class="{{ section_width }}">
      <header-inner class="logo-position {% if settings.search_type == 'default' %}show-search-form relative static-sm {% endif %}grid logo-{{ logo_position }} gap-10 gap-xl-50 header-middle align-center">
        <div class="header__logo text-center text-left-1025 inline-flex align-center">
          {%- render 'logo', isTransparent: transparent -%}
        </div>
        <div class="header__menu">
          {%- render 'toggle-menu' -%}
          {%- liquid
            render 'horizontal-menu', class: 'min-h-1025-50'
          -%}
        </div>
        <div class="header__action flex flex-end align-center">
          {% if show_language or show_country %}
            <div class="lang__currency-mobile-header hidden-1025-up flex align-center gap-5">
              {% if show_language %}
                {% render 'language-switcher' %}
              {% endif %}
              {% if show_country %}
                {% render 'country-switcher' %}
              {% endif %}
            </div>
          {% endif %}
