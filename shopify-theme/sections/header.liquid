       <style>
@media screen and (max-width: 1024px) {
  .header__logo {
    justify-content: center !important;
    text-align: center !important;
    width: 100%;
  }
  .header__logo img {
    margin: 0 auto !important;
  }
}
</style>

          {% if show_language or show_country %}
            <div class="lang__currency-desktop me-20 gap-15">
              {% if show_language %}
                {% render 'language-switcher' %}
              {% endif %}
              {% if show_country %}
                {% render 'country-switcher' %}
              {% endif %}
            </div>
          {% endif %}
          {%- liquid
            if top_search
              render 'top-search'
            endif
            if my_account
              render 'my-account'
            endif
            if recently_viewed
              render 'recently-viewed'
            endif
            if wishlist
              render 'wishlist'
            endif
            if minicart and theme_st.show_add_cart
              render 'minicart'
            endif
          -%}
        </div>
      </header-inner>
    </div>
  </div>
</header>   

<style>
                :root {
    /* ===================== Logo sizes & positions ===================== */
    /* Global (theme) logo sizes */
    --desktop-logo-size: {{ settings.desktop_logo_width | default: 110 }}px;
    --mobile-logo-size:  {{ settings.mobile_logo_size  | default: settings.desktop_logo_width | default: 110 }}px;
--menu-toggle-color-normal: {{ section.settings.menu_toggle_color_normal }};
    /* Transparent logo (theme settings you added) */
    --transparent-logo-size:  {{ settings.logo_transparent_width    | default: settings.desktop_logo_width | default: 110 }}px;
    --transparent-logo-size:  {{ section.settings.logo_transparent_width }}px;
--transparent-logo-shift: {{ section.settings.logo_transparent_position }}px;
    --transparent-logo-shift: {{ settings.logo_transparent_position | default: 0 }}px;

    /* Section-level positional tweaks (if you still use these elsewhere) */
    --mobile-logo-position:  {{ section.settings.mobile_logo_position  | default: 0 }}px;
    --desktop-logo-position: {{ section.settings.desktop_logo_position | default: 0 }}px;

    /* ===================== Navigation / layout ===================== */
    --nav-font-size: {{ section.settings.navigation_font_size }}px;
    --nav-translate-x: {{ section.settings.navigation_translate_x }}px;
    --nav-link-gap: {{ section.settings.navigation_link_gap }}px;

    --dropdown-width: {{ section.settings.dropdown_width }}px;
    --dropdown-border-radius: {{ section.settings.dropdown_border_radius }}px;
    --dropdown-bg-color: {{ section.settings.dropdown_background_color }};

    --mobile-nav-width: {{ section.settings.mobile_nav_width }}%;
    --transparent-logo-size:  {{ settings.logo_transparent_width | default: settings.desktop_logo_width | default: 110 }}px;
--transparent-logo-shift: {{ settings.logo_transparent_position | default: 0 }}px;

    /* ===================== Colors ===================== */
    --menu-link-color: {{ section.settings.menu_link_color }};
    --menu-link-hover-color: {{ section.settings.menu_link_hover_color }};
    --menu-link-text-color-desktop: {{ section.settings.menu_link_text_color_desktop }};
    --menu-link-hover-color-desktop: {{ section.settings.menu_link_hover_color_desktop }};

    --toggle-menu-color: {{ section.settings.toggle_menu_color }};
    --nav-icon-color: {{ section.settings.mobile_nav_icon_color }};
    --nav-close-color: {{ section.settings.nav_close_color }};

    --search-popup-bg-color: {{ section.settings.search_popup_bg_color }};
    --search-icon-color: {{ section.settings.search_icon_color }};
    --close-icon-color: {{ section.settings.close_icon_color }};
    --search-placeholder-color: {{ section.settings.search_placeholder_color }};

    --quick-url-bg-color: {{ section.settings.quick_url_bg_color }};
    --quick-url-text-color: {{ section.settings.quick_url_text_color }};
    --quick-url-hover-bg-color: {{ section.settings.quick_url_hover_bg_color }};
    --quick-url-hover-text-color: {{ section.settings.quick_url_hover_text_color }};

    --product-title-color: {{ section.settings.product_title_color }};
    --trending-search-color: {{ section.settings.trending_search_color }};

    /* ===================== Buttons (mobile nav) ===================== */
    --button-border-radius: {{ section.settings.button_border_radius }}px;
    --button-min-height: {{ section.settings.mobile_nav_button_min_height }}px;
    --button-min-width: {{ section.settings.mobile_nav_button_min_width }}px;
    --button-font-size: {{ section.settings.mobile_nav_button_font_size }}px;
    --button-text-color: {{ section.settings.mobile_nav_button_text_color }};

    --button-login-bg-color: {{ section.settings.mobile_nav_button_login_bg_color }};
    --button-login-text-color: {{ section.settings.mobile_nav_button_login_text_color }};
    --button-login-hover-bg-color: {{ section.settings.mobile_nav_button_login_hover_bg_color }};
