/* Transparent header: width + horizontal shift from SECTION vars above */
.section-header:not(.shopify-section-header-sticky) header.transparent .header__transparent-logo{
  width: var(--transparent-logo-size);
  height: auto;
}
/* Normal header (non-transparent) */
  .section-header header:not(.transparent) .nav-toggle {
    color: var(--menu-toggle-color-normal, {{ section.settings.menu_toggle_color_normal }}) !important;
  }

  /* Sticky header behaves like normal */
  .section-header.shopify-section-header-sticky .nav-toggle,
  .section-header header.shopify-section-header-sticky .nav-toggle {
    color: var(--menu-toggle-color-normal, {{ section.settings.menu_toggle_color_normal }}) !important;
  }
.section-header:not(.shopify-section-header-sticky) header.transparent .header__logo{
  transform: translateX(var(--transparent-logo-shift));
}
.section-header.transparent:not(.shopify-section-header-sticky) .header__transparent-logo{
  width: var(--transparent-logo-size);
  height: auto;
  transform: translateX(var(--transparent-logo-shift));
}
  /* Keep main menu titles unchanged */
  .menu_item-link.no-underline.heading-style.py-10.py-1025-5.min-h-55.min-h-1025-unset.inline-flex.align-center {
      color: inherit !important;
    font-size : 17.2px !important;
      font-weight: inherit !important;
  }

  /* Apply submenu styles only if enabled */
    {% if section.settings.enable_custom_submenu_colors %}
    .navigation ul li ul li ul li a {
        color: {{ section.settings.submenu_text_color }} !important;
      opacity: 1px !important;
        font-weight: {{ section.settings.submenu_font_weight }} !important;
        font-size: {{ section.settings.submenu_font_size }}px !important;
    }

    .navigation ul li ul li ul li a:hover {
        color: {{ section.settings.submenu_hover_text_color }} !important;
      opacity: 0.89 !important;
    }
    {% endif %}

    /* Smooth underline effect */
    {% if section.settings.enable_smooth_underline %}
    .navigation ul li ul li ul li a {
       position: relative;
      text-decoration: none !important;
      display: inline-block; /* Ensures the underline matches text width */
    }

    .navigation ul li ul li ul li a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -1px;
        width: 0;
        height: 1px;
        background-color: {{ section.settings.submenu_text_color }};
        transition: width 0.3s ease-in-out;
    }
@media (min-width:1025px){
  header-inner.logo-center .navigation{
    /* From 0px (very wide screens) to -220px (narrow desktop) */
    margin-left: clamp(10px, -3vw, 0px) !important;
    margin-right: 0 !important; /* neutralize any fixed right margin you set elsewhere */
    transition: margin-left .2s ease;
  }

  /* If your links live directly under .navigation > ul, you can target that instead: */
  header-inner.logo-center .navigation > ul{
    margin-left: clamp(10px, -2vw, 0px) !important;
    transition: margin-left .2s ease;
  }

  /* Safety: keep logo above links so they never overlap visually while shifting */
  header-inner.logo-center .header__logo{ z-index: 2; position: relative; }
}
    .navigation ul li ul li ul li a:hover::after {
        width: 100%;
    }
    {% endif %}

    /* Smooth right-moving effect */
    {% if section.settings.enable_smooth_right_move %}
    .navigation ul li ul li ul li a {
        transition: transform 0.3s ease-in-out;
    }

    .navigation ul li ul li ul li a:hover {
        transform: translateX(5px);
    }
    {% endif %}


    @media (min-width: 1025px) {
