<style>
    :root {
      --arrow-vertical-position: {{ section.settings.arrow_vertical_position | default: 50 }}%;
      --arrow-vertical-position-mobile: {{ section.settings.arrow_vertical_position_mobile | default: 50 }}%;
    }

  @media screen and (max-width: 767.98px) {
    .split-images-container img:nth-child(2) {
      display: none !important;
    }
    .split-images-container img:nth-child(1) {
      width: 100% !important;
    }
  }



    .custom-arrow {
      position: absolute;
      top: var(--arrow-vertical-position);
      transform: translateY(-50%);
      z-index: 10;
      cursor: pointer;
      /* existing arrow styles */

      width: var(--arrow-size, 40px);
      height: var(--arrow-size, 40px);
      background: var(--arrow-background-color, rgba(0,0,0,0.3));
      color: var(--arrow-icon-color, #ffffff);
      border-radius: 50%;
      opacity: 0.96 !important;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.3s ease, background-color 0.3s ease, color 0.3s ease;
    }
    .hero-container:hover .custom-arrow {
      opacity: 1;
      transform: translateY(-50%) translateX(0);
    }

    .swiper-button-prev.custom-arrow {
      left: 15px;
    }
    .swiper-button-next.custom-arrow {
      right: 15px;
    }

    .custom-arrow:hover {
      transform: translateY(-50%) scale(1.1);
    }

    /* Mobile adjustments */
    @media screen and (max-width: 767.98px) {
      .custom-arrow {
        top: var(--arrow-vertical-position-mobile);
        width: calc(var(--arrow-size, 40px) * 0.75);
        height: calc(var(--arrow-size, 40px) * 0.75);
      }
      .swiper-button-prev.custom-arrow {
        left: 10px;
      }
      .swiper-button-next.custom-arrow {
        right: 10px;
      }
    }
    .sec__inner .banner__media :is(picture, source, img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .sec__inner .banner__media .image-picture {
      display: block;
    }
    @media screen and (max-width: 767.98px) {
      .text-below-mb[style*="--aspect-ratio"]:before {
        display: none;
      }
      .text-below-mb .py-custom {
        padding-top: 0;
        padding-bottom: 0;
      }
      .text-below-mb.h-custom,
      .text-below-mb.h-full_screen,
      .text-below-mb .h-full_screen {
        min-height: auto;
      }
      .text-below-mb.h-custom .banner__media {
        height: var(--height);
        position: relative;
      }
      multi-content.swiper.row-gap {
        row-gap: 0;
      }
      multi-content[data-enable="true"] > .section__block:not(:first-child) {
        display: none;
      }
    }
    .sec__content:not(.show-content-box):is(
        .container:not(.px-custom),
        .fluid_container:not(.px-custom)
      ) {
      padding-left: 0;
      padding-right: 0;
      margin-top: 50px !important;
      margin-bottom: 25px;
    }
    :where(.px-custom:not(.x-min-value)) {
      padding-left: clamp(
        15px,
        calc(15px + (var(--padding-inline) - 15) * var(--responsive-rate)),
        calc(var(--padding-inline) * 1px)
      );
      padding-right: clamp(
        15px,
        calc(15px + (var(--padding-inline) - 15) * var(--responsive-rate)),
        calc(var(--padding-inline) * 1px)
      );
    }
    :where(.x-min-value) {
      padding-left: calc(var(--padding-inline) * 1px);
      padding-right: calc(var(--padding-inline) * 1px);
    }
    :where(.px-custom.min-value:not(.container, .fluid_container)) {
      padding-left: clamp(
        calc(var(--padding-inline) * 1px),
        calc(15px + (var(--padding-inline) - 15) * var(--responsive-rate)),
        calc(var(--padding-inline) * 1px)
      );
      padding-right: clamp(
        calc(var(--padding-inline) * 1px),
        calc(15px + (var(--padding-inline) - 15) * var(--responsive-rate)),
        calc(var(--padding-inline) * 1px)
      );
    }
    :where(.y-min-value) {
      padding-top: calc(var(--padding-block) * 1px);
      padding-bottom: calc(var(--padding-block) * 1px);
    }
    :where(.py-custom:not(.y-min-value)) {
      padding-top: clamp(
        (var(--padding-block) * 0.64px),
        calc(
          (var(--padding-block) * 0.64px) +
            (var(--padding-block) - (var(--padding-block) * 0.64)) *
            var(--responsive-rate)
        ),
        calc(var(--padding-block) * 1px)
      );
      padding-bottom: clamp(
        (var(--padding-block) * 0.64px),
        calc(
          (var(--padding-block) * 0.64px) +
            (var(--padding-block) - (var(--padding-block) * 0.64)) *
            var(--responsive-rate)
        ),
        calc(var(--padding-block) * 1px)
      );
    }
    .h-custom {
      min-height: var(--height);
    }
    @media (min-width: 992px) {
      .h-custom {
        min-height: var(--height-desktop);
      }
      .w-as-max {
        width: var(--max-width);
      }
    }
    @media (min-width: 768px) {
      .rounded-md {
        border-radius: var(--rounded-radius);
        overflow: hidden;
      }
      .rounded-md .remove-rounded {
        border-radius: 0;
      }
      .py-md-10 {
        padding-block: 1rem;
      }
    }
    multi-content.rounded .remove-rounded {
      border-radius: 0;
    }
    video-section.h-full video {
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
    @media (min-width: 992px) {
      .p-lg-content-btn {
        padding: 1.5rem 5.5rem;
      }
    }
    {% if section.settings.enable_no_padding %}
    .slideshow {
      padding: 0 !important;
      margin: 0 !important;
    }
    .slideshow .swiper-slide {
      padding: 0 !important;
      margin: 0 !important;
    }
    .slideshow .swiper-wrapper {
      padding: 0 !important;
      margin: 0 !important;
    }
    .slideshow .banner__media {
      padding: 0 !important;
      margin: 0 !important;
    }
    .slideshow .swiper-slide-active {
      padding: 0 !important;
      margin: 0 !important;
    }
    {% endif %}
    .slideshow .swiper-wrapper .swiper-slide:not(:first-child):not(.swiper-slide-active) {
      opacity: 0 !important;
      padding-top: 0px !important;
      margin-top: 10px;
    }
    .slideshow .swiper-slide-active .sec__content-inner {
      opacity: 1;
      margin-top: 35px !important;
      margin-bottom: 20px;
      margin-left: 20px;
      margin-right: 20px;
      visibility: visible;
    }
    .slideshow .swiper-slide-active .sec__content-inner > * {
      -webkit-animation-duration: 0.8s;
      animation-duration: 0.8s;
      -webkit-animation-fill-mode: both;
      animation-fill-mode: both;
    }
    .swiper-slide-active .sec__content-inner > *:nth-child(1) {
      -webkit-animation-delay: 0.6s;
      animation-delay: 0.6s;
    }
    .swiper-slide-active .sec__content-inner > *:nth-child(2) {
      -webkit-animation-delay: 0.8s;
      animation-delay: 0.8s;
    }
    .swiper-slide-active .sec__content-inner > *:nth-child(3) {
      -webkit-animation-delay: 1s;
      animation-delay: 1s;
    }
    .swiper-slide-active .sec__content-inner > *:nth-child(4) {
      -webkit-animation-delay: 1.2s;
      animation-delay: 1.2s;
    }
    .slideshow .swiper-slide-active .effect_fadein > * {
      -webkit-animation-name: fadeInslideshow;
      animation-name: fadeInslideshow;
    }
    .slideshow .swiper-slide-active .effect_fadeinup > * {
      -webkit-animation-name: fadeInUpslideshow;
      animation-name: fadeInUpslideshow;
    }
    .slideshow .swiper-slide-active .effect_fadeinleft > * {
      -webkit-animation-name: fadeInLeftslideshow;
      animation-name: fadeInLeftslideshow;
    }
    .slideshow .swiper-slide-active .effect_fadeinright > * {
      -webkit-animation-name: fadeInRightslideshow;
      animation-name: fadeInRightslideshow;
    }
    .slideshow .swiper-slide-active .effect_zoomin > * {
      -webkit-animation-name: zoomInSlideshow;
      animation-name: zoomInSlideshow;
    }
    .slideshow .swiper-slide-active .effect_zoomout > * {
      -webkit-animation-name: zoomOutSlideshow;
      animation-name: zoomOutSlideshow;
    }
    /* New slider effects */
    .slideshow .swiper-slide-active .effect_slidein > * {
      -webkit-animation-name: slideInSlideshow;
      animation-name: slideInSlideshow;
    }
    .slideshow .swiper-slide-active .effect_rotate > * {
      -webkit-animation-name: rotateSlideshow;
      animation-name: rotateSlideshow;
    }
    .slideshow .swiper-slide-active .effect_flip > * {
      -webkit-animation-name: flipSlideshow;
      animation-name: flipSlideshow;
    }
    .slideshow .swiper-slide-active .effect_scaleup > * {
      -webkit-animation-name: scaleUpSlideshow;
      animation-name: scaleUpSlideshow;
    }
    .slideshow .swiper-slide-active .effect_bounce > * {
      -webkit-animation-name: bounceSlideshow;
      animation-name: bounceSlideshow;
    }

    /* Keyframes for existing animations */
    @-webkit-keyframes fadeInslideshow {
      0% {
        opacity: 0;
        -webkit-transform: translateY(-10px);
        transform: translateY(-10px);
      }
      100% {
        opacity: 1;
        -webkit-transform: translateY(0);
        transform: translateY(0);
      }
    }
    @keyframes fadeInslideshow {
      0% {
        opacity: 0;
        transform: translateY(-10px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @-webkit-keyframes fadeInUpslideshow {
      from {
        opacity: 0;
        -webkit-transform: translate3d(0, 40px, 0);
        transform: translate3d(0, 40px, 0);
      }
      to {
        opacity: 1;
        -webkit-transform: none;
        transform: none;
      }
    }
    @keyframes fadeInUpslideshow {
      from {
        opacity: 0;
        transform: translate3d(0, 40px, 0);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @-webkit-keyframes fadeInLeftslideshow {
      from {
        opacity: 0;
        -webkit-transform: translate3d(-40px, 0, 0);
        transform: translate3d(-40px, 0, 0);
      }
      to {
        opacity: 1;
        -webkit-transform: none;
        transform: none;
      }
    }
    @keyframes fadeInLeftslideshow {
      from {
        opacity: 0;
        transform: translate3d(-40px, 0, 0);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @-webkit-keyframes fadeInRightslideshow {
      from {
        opacity: 0;
        -webkit-transform: translate3d(40px, 0, 0);
        transform: translate3d(40px, 0, 0);
      }
      to {
        opacity: 1;
        -webkit-transform: none;
        transform: none;
      }
    }
    @keyframes fadeInRightslideshow {
      from {
        opacity: 0;
        transform: translate3d(40px, 0, 0);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @-webkit-keyframes zoomInSlideshow {
      0% {
        opacity: 0;
        transform: scale(0.7);
      }
      50% {
        opacity: 0.5;
      }
      100% {
        opacity: 1;
        transform: scale(1);
      }
    }
    @keyframes zoomInSlideshow {
      0% {
        opacity: 0;
        transform: scale(0.7);
      }
      50% {
        opacity: 0.5;
      }
      100% {
        opacity: 1;
        transform: scale(1);
      }
    }
    @-webkit-keyframes zoomOutSlideshow {
      0% {
        opacity: 0;
        transform: scale(1.3);
      }
      50% {
        opacity: 0.5;
      }
      100% {
        opacity: 1;
        transform: scale(1);
      }
    }
    @keyframes zoomOutSlideshow {
      0% {
        opacity: 0;
        transform: scale(1.3);
      }
      50% {
        opacity: 0.5;
      }
      100% {
        opacity: 1;
        transform: scale(1);
      }
    }
    /* New keyframes for additional effects */
    @-webkit-keyframes slideInSlideshow {
      0% {
        opacity: 0;
        -webkit-transform: translateX(-100%);
        transform: translateX(-100%);
      }
      100% {
        opacity: 1;
        -webkit-transform: translateX(0);
        transform: translateX(0);
      }
    }
    @keyframes slideInSlideshow {
      0% {
        opacity: 0;
        transform: translateX(-100%);
      }
      100% {
        opacity: 1;
        transform: translateX(0);
      }
    }
    @-webkit-keyframes rotateSlideshow {
      0% {
        opacity: 0;
        -webkit-transform: rotate(-90deg);
        transform: rotate(-90deg);
      }
      100% {
        opacity: 1;
        -webkit-transform: rotate(0deg);
        transform: rotate(0deg);
      }
    }
    @keyframes rotateSlideshow {
      0% {
        opacity: 0;
        transform: rotate(-90deg);
      }
      100% {
        opacity: 1;
        transform: rotate(0deg);
      }
    }
    @-webkit-keyframes flipSlideshow {
      0% {
        opacity: 0;
        -webkit-transform: perspective(400px) rotateY(90deg);
        transform: perspective(400px) rotateY(90deg);
      }
      100% {
        opacity: 1;
        -webkit-transform: perspective(400px) rotateY(0deg);
        transform: perspective(400px) rotateY(0deg);
      }
    }
    @keyframes flipSlideshow {
      0% {
        opacity: 0;
        transform: perspective(400px) rotateY(90deg);
      }
      100% {
        opacity: 1;
        transform: perspective(400px) rotateY(0deg);
      }
    }
    @-webkit-keyframes scaleUpSlideshow {
      0% {
        opacity: 0;
        -webkit-transform: scale(0.5);
        transform: scale(0.5);
      }
      100% {
        opacity: 1;
        -webkit-transform: scale(1);
        transform: scale(1);
      }
    }
    @keyframes scaleUpSlideshow {
      0% {
        opacity: 0;
        transform: scale(0.5);
      }
      100% {
        opacity: 1;
        transform: scale(1);
      }
    }
    @-webkit-keyframes bounceSlideshow {
      0% {
        opacity: 0;
        -webkit-transform: translateY(-50%);
        transform: translateY(-50%);
      }
      50% {
        opacity: 1;
        -webkit-transform: translateY(0);
        transform: translateY(0);
      }
      100% {
        opacity: 1;
        -webkit-transform: translateY(-10%);
        transform: translateY(-10%);
      }
    }
    @keyframes bounceSlideshow {
      0% {
        opacity: 0;
        transform: translateY(-50%);
      }
      50% {
        opacity: 1;
        transform: translateY(0);
      }
      100% {
        opacity: 1;
        transform: translateY(-10%);
      }
    }

    /* Loading Bar Styles */
    {% if section.settings.enable_bottom_loading_bar %}
    .loading-bar {
      position: absolute;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      width: 80%;
      height: {{ section.settings.loading_bar_height }}px;
      background-color: {{ section.settings.loading_bar_bg_color }};
      border-radius: 999px;
      overflow: hidden;
    }
    .loading-bar-fill {
      height: 100%;
      width: 0%;
      background-color: {{ section.settings.loading_bar_fill_color }};
    }
    {% if section.settings.disable_loading_bar_on_mobile %}
    @media screen and (max-width: 767.98px) {
      .loading-bar { display: none !important; }
    }
    {% endif %}
    {% endif %}

    /* Split Images Container Styles */
    .split-images-container {
      display: flex;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
    }
    .split-images-container img {
      width: 50%;
      height: 100%;
      object-fit: cover;
    }

    /* ── Full-width fix: video & image always cover entire slide ── */
    .slideshow .banner__media video,
    .slideshow .banner__media img,
    .slideshow .banner__media picture {
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      object-position: center center !important;
    }
    /* Make sure the media container itself fills the slide */
    .slideshow .banner__media {
      position: absolute !important;
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
      overflow: hidden;
    }
    /* Content always on top and centered */
    .slideshow .sec__content {
      position: relative;
      z-index: 2;
      width: 100% !important;
    }
    .slideshow .sec__inner {
      position: relative;
      width: 100%;
      overflow: hidden;
    }

    /* ── Mobile optimizations ── */
    @media screen and (max-width: 767px) {
      /* Prevent heading overflow on mobile */
      .slideshow .sec__content-heading {
        font-size: 38px !important;
        line-height: 1.1 !important;
        word-break: break-word !important;
      }
      /* Better content padding on mobile */
      .slideshow .swiper-slide-active .sec__content-inner {
        margin-left: 16px !important;
        margin-right: 16px !important;
        margin-top: 0 !important;
      }
      /* CTA button full width on mobile for easier tap */
      .slideshow .sec__content-btn {
        width: 100%;
        justify-content: center !important;
      }
      .slideshow .sec__content-btn a {
        width: auto;
        min-width: 200px;
        text-align: center;
      }
      /* Better overlay on mobile for text readability */
      .slideshow .overlay-bg::after {
        background: rgba(0, 0, 0, 0.35) !important;
      }
    }
</style>

{% liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign slide_height = section_st.slide_height
  assign color_scheme = section_st.color_scheme
  assign autoplay = section_st.autoplay
  assign autorotate_speed = section_st.autorotate_speed

  assign carousel_pagination = section_st.carousel_pagination
%}

{%- capture video_attribute -%}
    muted autoplay
{%- endcapture -%}
{%- capture style -%}
--section-pt: {{ section_st.padding_top }};--section-pb: {{ section_st.padding_bottom }};
{%- if slide_height == 'custom' -%}
  --height: {{ section_st.mobile_height }}px;--height-desktop: {{ section_st.desktop_height }}px;
{%- endif -%}
{%- endcapture -%}
<div
  id="{{ section.id }}"
  class="section gradient slideshow color-{{ color_scheme }}"
  style="{{ style | strip | strip_newlines }}"
  data-id="{{ section.id }}"
>
  <div class="{{ section_width }}">
    {% if section.blocks.size > 0 %}
      <slide-section
        id="swiper-{{ section.id }}"
        class="
          swiper lazy-loading-swiper-before
          {% if section_st.content_reveal_animation == 'fade_in' %} effect_fadein
          {% elsif section_st.content_reveal_animation == 'fade_up' %} effect_fadeinup
          {% elsif section_st.content_reveal_animation == 'smooth_zoomin' %} effect_zoomin
          {% elsif section_st.content_reveal_animation == 'smooth_scale_in_up' %} effect_scaleup
          {% endif %}
        "
        data-section-id="{{ section.id }}"
        data-autoplay="{{ autoplay }}"
        data-autoplay-speed="{{ autorotate_speed }}"
        data-effect="fade"
        data-loop="true"
        data-speed="500"
        data-slideshow="1"
        data-mobile="1"
        data-tablet="1"
        data-desktop="1"
      >
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% liquid
              assign block_st = block.settings
              assign image = block_st.image
              assign image_mobile = block_st.image_mobile | default: image
              assign slider_effect = block_st.slider_effect
              assign local_video = block_st.local_video
              assign video_url = block_st.video_url
              assign lazy_load = false
              assign ratio_dk = ''
              assign ratio_mb = ''

              if slide_height == 'adapt' or slide_height == 'full_screen'
                if section.blocks.first.settings.image != blank and section.blocks.first.settings.image_mobile != blank
                  assign ratio_dk = section.blocks.first.settings.image.aspect_ratio
                  assign ratio_mb = section.blocks.first.settings.image_mobile.aspect_ratio | default: ratio_dk
                elsif section.blocks.first.settings.image == blank and section.blocks.first.settings.image_mobile != blank
                  assign ratio_dk = section.blocks.first.settings.image_mobile.aspect_ratio
                  assign ratio_mb = section.blocks.first.settings.image_mobile.aspect_ratio
                elsif section.blocks.first.settings.image != blank and section.blocks.first.settings.image_mobile == blank
                  assign ratio_dk = section.blocks.first.settings.image.aspect_ratio
                  assign ratio_mb = section.blocks.first.settings.image.aspect_ratio
                elsif section.blocks.first.settings.local_video != blank
                  assign ratio_dk = section.blocks.first.settings.local_video.aspect_ratio
                  assign ratio_mb = section.blocks.first.settings.local_video.aspect_ratio
                else
                  assign ratio_dk = '3/2'
                  assign ratio_mb = '2/3'
                endif
              else
                assign ratio_dk = '3/2'
                assign ratio_mb = '2/3'
              endif

              if forloop.first
                assign lazy_load = true
              endif
            %}
            <div {{ block.shopify_attributes }} class="swiper-slide">
              <div
                class="sec__inner flex relative{% if section_st.content_below_image %} flex-column flex-md-row text-below-mb{% endif %}{% if slide_height == 'adapt' and image_mobile != blank %} ratio-mobile{% endif %} h-{{ slide_height }}"
                style="--overlay-opacity: {{ block_st.overlay_opacity }}%;{% if slide_height == 'adapt' or slide_height == 'full_screen' %}--aspect-ratio: {{ ratio_dk }};--aspect-ratio-mb: {{ ratio_mb }};{% endif %}"
              >
                <div
                  class="banner__media w-full overlay-bg{% if section_st.section_width != 'full_width' %} rounded{% endif %}{% if section_st.content_below_image %} absolute-md mb-40 mb-md-0{% else %} absolute{% endif %} inset-0{% if slide_height == 'adapt' and image_mobile != blank %} ratio-mobile{% endif %}{% if slide_height == 'full_screen' %} h-{{ slide_height }}{% endif %}"
                  style="--aspect-ratio: {{ ratio_dk }};--aspect-ratio-mb: {{ ratio_mb }};--point:{{ image.presentation.focal_point }};"
                >
                  {% if block_st.enable_split_images %}
                    {%- comment -%}
                      When Split Images is enabled, compute the brightness from overlay opacity.
                    {%- endcomment -%}
                    {% assign overlay_decimal = block_st.overlay_opacity | divided_by: 100 %}
                    {% assign brightness_value = 1 | minus: overlay_decimal %}
                    <div
                      class="split-images-container {% if slider_effect != 'none' %}{{ slider_effect }}{% endif %}"
                      style="filter: brightness({{ brightness_value }});"
                    >
                      <img
                        src="{% if block_st.split_image_left != blank %}{{ block_st.split_image_left | img_url: 'master' }}{% else %}data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E{% endif %}"
                        alt="Split Image Left"
                      >
                      <img
                        src="{% if block_st.split_image_right != blank %}{{ block_st.split_image_right | img_url: 'master' }}{% else %}data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E{% endif %}"
                        alt="Split Image Right"
                      >
                    </div>
                  {% else %}
                    {% if image != blank or image_mobile != blank or local_video != blank or video_url != blank %}
                      {% if video_url != blank %}
                        <video
                          class="slideshow absolute inset-0 w-full h-full object-fit-cover"
                          loop="true"
                          playsinline="true"
                          muted
                          autoplay
                          preload="auto"
                          style="width:100%;height:100%;object-fit:cover;display:block;"
                          src="{{ video_url }}"
                        ></video>
                      {% elsif local_video != blank %}
                        {%- liquid
                          assign source = local_video.sources
                          assign source_url = ''
                          for s in source
                            if s.format == 'mp4'
                              assign source_url = s.url
                              break
                            endif
                          endfor
                          assign mobile_url = ''
                          assign desktop_url = ''
                          if image_mobile
                            assign mobile_url = image_mobile
                          endif
                          if image
                            assign desktop_url = image
                          endif
                          assign poster = local_video.preview_image | image_url: width: 1100
                          assign poster_desktop = image | default: mobile_url
                          assign poster_mobile = image_mobile | default: desktop_url
                        -%}
                        <video
                          class="slideshow"
                          loop="true"
                          {% if poster_mobile != blank %}
                            data-posterMobile="{{ poster_mobile | image_url: width: 1100 }}"
                          {% endif %}
                          {% if poster_desktop != blank %}
                            data-posterDesktop="{{ poster_desktop | image_url: width: 1100 }}"
                          {% endif %}
                          data-src="{{ source_url }}"
                          poster="{{ poster }}"
                          playsinline="true"
                          {{ video_attribute }}
                        ></video>
                      {% endif %}
                      {% if image != blank and video_url == blank and local_video == blank %}
                        {% render 'responsive-image', type: 'banner', container: section_width, image: image, image_mobile: image_mobile, image_alt: block_st.image.alt, default: block_st.heading, lazy_load: lazy_load %}
                      {% endif %}
                    {% else %}
                      <img
                        src="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E"
                        alt="Placeholder Image"
                        class="absolute inset-0 w-full h-full object-fit-cover"
                      >
                    {% endif %}
                  {% endif %}
                </div>

                {% if block_st.heading != blank
                  or block_st.subheading != blank
                  or block_st.description != blank
                  or block_st.first_button_label != blank
                  or block_st.second_button_label != blank
                %}
                  <div
                    class="sec__content relative z-1 flex{% if block_st.content_width == 'full_width' %} w-full{% else %} w-1024-full{% endif %} {{ block_st.content_position }} {{ block_st.content_width }} text-{{ block_st.content_alignment }}"
                  >
                    <div
                      class="sec__content-inner w-full w-md-unset invisible max-w-custom {% if slider_effect %}{{ slider_effect }}{% endif %}"
                      style="--max-width: {{ block_st.content_max_width }}%;"
                    >
                      {% if block_st.subheading != blank %}
                        <div
                          class="sec__content-subheading heading{% if section_st.subheading_spacing_bottom > 41 %} mb-big{% elsif section_st.subheading_spacing_bottom > 30 %} mb-medium{% else %} mb-custom{% endif %} fs-custom {{ section_st.subheading_font_weight }}"
                        style="
  --font-size: {{ section_st.subheading_font_size }};--space-bottom: {{ section_st.subheading_spacing_bottom }} !important;
  {% if block_st.enable_custom_text_colors %} color: {{ block_st.subheading_text_color }} !important; {% endif %}
"
                        >
                          {{ block_st.subheading | escape }}
                        </div>
                      {% endif %}
                      {% if block_st.heading != blank %}
                        <h2
                          class="
                            sec__content-heading heading-letter-spacing mt-0
                            {% if section_st.heading_spacing_bottom > 41 %} mb-big{% elsif section_st.heading_spacing_bottom > 30 %} mb-medium{% else %} mb-custom{% endif %}
                            {% if section_st.heading_uppercase %} uppercase{% endif %}
                            {% if section_st.heading_font_size_desktop > 41 %} fs-big{% elsif section_st.heading_font_size_desktop > 24 %} fs-medium{% else %} fs-custom{% endif %}
                            {{ section_st.heading_font_weight }}
                          "
                        style="
  --space-bottom: {{ section_st.heading_spacing_bottom }} !important;
  {% if section_st.enable_heading_gradient %}
    background: linear-gradient({{ section_st.heading_gradient_degrees }}, {{ section_st.heading_gradient_color1 }}, {{ section_st.heading_gradient_color2 }}, {{ section_st.heading_gradient_color3 }}) !important;
    -webkit-background-clip: text !important;
    color: transparent !important;
  {% else %}
    {% if block_st.enable_custom_text_colors %}
      color: {{ block_st.heading_text_color }} !important;
    {% endif %}
  {% endif %}
  {% if section_st.enable_custom_heading_font %}
    font-family: {{ section_st.heading_font }} !important;
  {% endif %}
  {% if section_st.heading_extra_light %}
    font-weight: 200 !important;
  {% endif %}
"
                          {{ block.shopify_attributes }}
                        >
                          {{ block_st.heading }}
                        </h2>

                        <style>
                          /* Mobile defaults */
                          #{{ section.id }} .swiper-slide h2.sec__content-heading {
                            font-size: {{ section_st.heading_font_size_mobile }}px !important;
                            line-height: {{ section_st.heading_line_height_mobile }} !important;
                            width: {{ section_st.heading_width_mobile }}% !important;
                            padding-left: {{ section_st.heading_left_padding_mobile }}px !important;
                            padding-right: {{ section_st.heading_right_padding_mobile }}px !important;
                          }
                          @media (min-width: 768px) {
                            #{{ section.id }} .swiper-slide h2.sec__content-heading {
                              font-size: {{ section_st.heading_font_size_desktop }}px !important;
                              line-height: {{ section_st.heading_line_height_desktop }} !important;
                              width: {{ section_st.heading_width_desktop }}% !important;
                              padding-left: {{ section_st.heading_left_padding_desktop }}px !important;
                              padding-right: {{ section_st.heading_right_padding_desktop }}px !important;
                            }
                          }
                        </style>
                      {% endif %}
                      {% if block_st.description != blank %}
                        <div
                          class="
                            sec__content-des rich__text-m0
                            {% if section_st.des_spacing_bottom > 41 %} mb-big{% elsif section_st.des_spacing_bottom > 30 %} mb-medium{% else %} mb-custom{% endif %}
                            {% if section_st.des_font_size > 24 %} fs-medium{% else %} fs-custom{% endif %}
                            {{ section_st.des_font_weight }}
                          "
                         style="
  --font-size: {{ section_st.des_font_size }};--space-bottom: {{ section_st.des_spacing_bottom }} !important;
  {% if block_st.enable_custom_text_colors %} color: {{ block_st.description_text_color }} !important; {% endif %}
"
                          {{ block.shopify_attributes }}
                        >
                          {{ block_st.description }}
                        </div>
                      {% endif %}
                      {% if block_st.first_button_label != blank or block_st.second_button_label != blank %}
                        <div class="sec__content-btn align-center flex flex-wrap gap-15 justify-content-{{ block_st.content_alignment }}">
                        {% if block_st.first_button_label != blank %}
  {% if block_st.enable_custom_buttons %}
    <a
      id="btn-{{ block.id }}-first"
      {% if block_st.first_button_link == blank %}
        role="link" aria-disabled="true"
      {% else %}
        href="{{ block_st.first_button_link | default: "#" }}"
      {% endif %}
      aria-label="{{ block_st.first_button_label }}"
      class="inline-flex no-underline custom-btn"
    >
      {{ block_st.first_button_label }}
    </a>
    <style>
      #btn-{{ block.id }}-first {
        background-color: {{ block_st.first_button_bg_color }};
        color: {{ block_st.first_button_text_color }};
        border-radius: {{ block_st.first_button_border_radius }}px;
        padding: 10px 16px !important;
        font-size: 17px;
        border: {{ block_st.first_button_border_thickness }}px solid {{ block_st.first_button_border_color }};
      }
      #btn-{{ block.id }}-first:hover {
        background-color: {{ block_st.first_button_bg_hover_color }};
        color: {{ block_st.first_button_text_hover_color }};
      }
    </style>
  {% else %}
    <a
      {% if block_st.first_button_link == blank %}
        role="link" aria-disabled="true"
      {% else %}
        href="{{ block_st.first_button_link | default: "#" }}"
      {% endif %}
      aria-label="{{ block_st.first_button_label }}"
      class="inline-flex no-underline {% if block_st.first_button_style %} btn-outline{% else %} btn-primary{% endif %}"
    >
      {{ block_st.first_button_label }}
    </a>
                            {% else %}
                              <a
                                {% if block_st.first_button_link == blank %}
                                  role="link" aria-disabled="true"
                                {% else %}
                                  href="{{ block_st.first_button_link | default: "#" }}"
                                {% endif %}
                                aria-label="{{ block_st.first_button_label }}"
                                class="inline-flex no-underline {% if block_st.first_button_style %} btn-outline{% else %} btn-primary{% endif %}"
                              >
                                {{ block_st.first_button_label }}
                              </a>
                            {% endif %}
                          {% endif %}
                          {% if block_st.second_button_label != blank %}
                            {% if block_st.enable_custom_buttons %}
                              <a
                                id="btn-{{ block.id }}-second"
                                {% if block_st.second_button_link == blank %}
                                  role="link" aria-disabled="true"
                                {% else %}
                                  href="{{ block_st.second_button_link | default: "#" }}"
                                {% endif %}
                                aria-label="{{ block_st.second_button_label }}"
                                class="inline-flex no-underline custom-btn"
                              >
                                {{ block_st.second_button_label }}
                              </a>
                              <style>
                               #btn-{{ block.id }}-second {
    background-color: {{ block_st.second_button_bg_color }};
    color: {{ block_st.second_button_text_color }};
    border-radius: {{ block_st.second_button_border_radius }}px;
     padding: 9px 15px !important;
                              
    border: {{ block_st.second_button_border_thickness }}px solid {{ block_st.second_button_border_color }};
  }
  #btn-{{ block.id }}-second:hover {
    background-color: {{ block_st.second_button_bg_hover_color }};
    color: {{ block_st.second_button_text_hover_color }};
  }
                              </style>
                            {% else %}
                              <a
                                {% if block_st.second_button_link == blank %}
                                  role="link" aria-disabled="true"
                                {% else %}
                                  href="{{ block_st.second_button_link | default: "#" }}"
                                {% endif %}
                                aria-label="{{ block_st.second_button_label }}"
                                class="inline-flex no-underline {% if block_st.second_button_style %} btn-outline{% else %} btn-primary{% endif %}"
                              >
                                {{ block_st.second_button_label }}
                              </a>
                            {% endif %}
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>
                  </div>

                  {%- comment -%}
                    If "Enable Content Centering On Mobile Device" is ON, force center on mobile
                  {%- endcomment -%}
                  {% if block_st.enable_content_centering_on_mobile %}
                    <style>
                      @media(max-width:767px){
                        #{{ section.id }} .swiper-slide:nth-child({{ forloop.index }}) .sec__content-inner {
                          text-align: center !important;
                        }
                        #{{ section.id }} .swiper-slide:nth-child({{ forloop.index }}) .sec__content-btn {
                          justify-content: center !important;
                        }
                      }
                    </style>
                  {% endif %}
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>

        {% if section.settings.show_navigation_arrows %}
          <!-- Navigation Arrows with custom styling -->
          <div
            class="swiper-button-prev custom-arrow"
            style="
              width: {{ section.settings.arrow_size }}px;
              height: {{ section.settings.arrow_size }}px;
              background-color: {{ section.settings.arrow_background_color }};
            "
          >
            <svg viewBox="0 0 24 24" style="fill: {{ section.settings.arrow_color }};">
              <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
            </svg>
          </div>
          <div
            class="swiper-button-next custom-arrow"
            style="
              width: {{ section.settings.arrow_size }}px;
              height: {{ section.settings.arrow_size }}px;
              background-color: {{ section.settings.arrow_background_color }};
            "
          >
            <svg viewBox="0 0 24 24" style="fill: {{ section.settings.arrow_color }};">
              <path d="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z"/>
            </svg>
          </div>
        {% endif %}

        {%- comment -%}
          Show pagination dots if "show_dots" or "show_dots_on_mobile" is selected
        {%- endcomment -%}
        {% if section.settings.carousel_pagination != 'disable' %}
          <div class="swiper-pagination"></div>
          {% if section.settings.carousel_pagination == 'show_dots_on_mobile' %}
            <style>
              @media(min-width:768px){
                #{{ section.id }} .swiper-pagination {
                  display: none;
                }
              }
            </style>
          {% endif %}
        {% endif %}
      </slide-section>
    {% endif %}

    {% if section.settings.enable_bottom_loading_bar %}
      <div class="loading-bar">
        <div class="loading-bar-fill"></div>
      </div>
    {% endif %}
  </div>
</div>

{%- comment -%}
  Enable Image Parallax Mouse Move script
{%- endcomment -%}
{% if section.settings.enable_parallax_mouse_move %}
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const slideshowSection = document.getElementById('{{ section.id }}');
      if (!slideshowSection) return;

      // Find background containers (image or video)
      const heroBackgrounds = slideshowSection.querySelectorAll('.banner__media');
      if (!heroBackgrounds.length) return;

      slideshowSection.addEventListener('mousemove', function(e) {
        const rect = slideshowSection.getBoundingClientRect();
        const offsetX = e.clientX - rect.left;
        const offsetY = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const strength = 0.03;

        const moveX = (offsetX - centerX) * strength;
        const moveY = (offsetY - centerY) * strength;

        heroBackgrounds.forEach(function(bg) {
          bg.style.transform = `translate(${moveX}px, ${moveY}px) scale(1.04)`;
        });
      });
    });
  </script>
{% endif %}

<script>
  document.addEventListener('DOMContentLoaded', function() {
     var swiper = new Swiper('#swiper-{{ section.id }}', {
         speed: 500,
         loop: true,
         effect: 'fade',  // Added fade effect
         fadeEffect: { crossFade: true }, // Ensures smooth transition

         autoplay: {% if section.settings.autoplay %}{
             delay: {{ section.settings.autorotate_speed }}000,
             disableOnInteraction: false
         }{% else %}false{% endif %},

         navigation: {
             nextEl: '#swiper-{{ section.id }} .swiper-button-next.custom-arrow',
             prevEl: '#swiper-{{ section.id }} .swiper-button-prev.custom-arrow',
         },

         {% if section.settings.carousel_pagination != 'disable' %}
         pagination: {
             el: '#swiper-{{ section.id }} .swiper-pagination',
             clickable: true,
         },
         {% endif %}
     });
  });
</script>

