<style>
  {%- capture sp_content -%}
  {% if section.settings.override_fonts %}
      {{ section.settings.text_font | font_face }}
      {{ section.settings.headline_font | font_face }}
  {% endif %}

  /* Text Elements */
  #loudecoms-{{ section.id }} p {
      font-size: {{ section.settings.description_size }}px;
      {% if section.settings.override_fonts %}
      font-family: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
      font-weight: {{ section.settings.text_font.weight }};
      {% endif %}
      margin: 0 0 {{ section.settings.element_spacing }}px 0;
      padding: 0;
      color: {{ section.settings.description_text_color }};
  }

  #loudecoms-{{ section.id }} ul,
  #loudecoms-{{ section.id }} ol {
    margin: 0 0 {{ section.settings.element_spacing }}px 0;
  }

  #loudecoms-{{ section.id }} li {
    font-size: {{ section.settings.description_size }}px;
    {% if section.settings.override_fonts %}
    font-family: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
    font-weight: {{ section.settings.text_font.weight }};
    {% endif %}
    margin: 0 0 5px 0;
    padding: 0;
    color: {{ section.settings.description_text_color }};
  }

  #loudecoms-{{ section.id }} li:last-child {
    margin: 0;
  }

  @media (max-width: 800px) {
      #loudecoms-{{ section.id }} p,
      #loudecoms-{{ section.id }} li {
        font-size: {{ section.settings.mobile_description_size }}px;
      }
  }

  /* Section Container */
  #loudecoms-{{ section.id }} {
      position: relative;
      {% if section.settings.enable_background_gradient %}
         background: linear-gradient({{ section.settings.section_background_custom_color }}, {{ section.settings.section_background_custom_color }});
      {% else %}
         background-color: {{ section.settings.section_background_custom_color }};
      {% endif %}
      width: 100%;
      box-sizing: border-box;
      padding: {{ section.settings.section_padding_top }}px {{ section.settings.section_padding_left_right }}px {{ section.settings.section_padding_bottom }}px {{ section.settings.section_padding_left_right }}px;
      overflow: hidden;
  }

  {% if section.settings.section_background_image %}
  #loudecoms-{{ section.id }}::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image: url({{ section.settings.section_background_image | image_url }});
      background-repeat: no-repeat;
      background-position: center;
      background-size: {{ section.settings.section_background_size }};
      filter: brightness({{ section.settings.section_bg_image_brightness }}%);
      z-index: -1;
  }
  {% endif %}

  @media (max-width: 800px) {
      #loudecoms-{{ section.id }} {
        padding: {{ section.settings.mobile_section_padding_top }}px {{ section.settings.mobile_section_padding_left_right }}px {{ section.settings.mobile_section_padding_bottom }}px {{ section.settings.mobile_section_padding_left_right }}px;
      }
  }

  {% if section.settings.show_on_device == 'mobile' %}
    @media (min-width: 801px) {
        #loudecoms-{{ section.id }} {
            display: none;
        }
    }
  {% endif %}

  {% if section.settings.show_on_device == 'desktop' %}
    @media (max-width: 800px) {
        #loudecoms-{{ section.id }} {
            display: none;
        }
    }
  {% endif %}

  /* Inner Container */
  #loudecoms-{{ section.id }} .loudecoms-container {
      position: relative;
      margin: 0 auto;
      background: {{ section.settings.container_background_color }};
      border-radius: {{ section.settings.container_radius }}px;
      border: {{ section.settings.container_border_size }}px solid {{ section.settings.container_border_color }};
      max-width: {{ section.settings.container_max_width }}px;
      padding: {{ section.settings.container_padding_top_bottom }}px {{ section.settings.container_padding_left_right }}px;
  }

  @media (max-width: 800px) {
      #loudecoms-{{ section.id }} .loudecoms-container {
        padding: {{ section.settings.mobile_container_padding_top_bottom }}px {{ section.settings.mobile_container_padding_left_right }}px;
      }
  }

  .loudecoms-headline {
    margin: 0;
    padding: 0 0 {{ section.settings.headline_spacing }}px 0;
  }

  #loudecoms-{{ section.id }} .loudecoms-headline * {
    text-align: {{ section.settings.text_alignment }};
  }

  @media only screen and (max-width: 800px) {
    #loudecoms-{{ section.id }} .loudecoms-headline * {
      text-align: {{ section.settings.mobile_text_alignment }};
    }
  }

  /* Grid Layout */
  #loudecoms-{{ section.id }} .loudecoms-grid {
    margin: {{ section.settings.vertical_gap }}px auto 0;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    max-width: 1000px;
    gap: 20px;
  }

  @media only screen and (max-width: 800px) {
    #loudecoms-{{ section.id }} .loudecoms-grid {
      grid-template-columns: 1fr;
      margin: {{ section.settings.mobile_vertical_gap | default: section.settings.vertical_gap }}px 10px 0;
    }
  }

  /* Count Display */
  #loudecoms-{{ section.id }} .loudecoms-col h3 {
    font-size: {{ section.settings.count_size }}px;
    font-weight: {{ section.settings.count_font_weight }} !important;
    color: {{ section.settings.count_color }} !important;
    padding: 0;
    margin: 0 0 {{ section.settings.count_spacing }}px 0;
    text-align: {{ section.settings.count_alignment }};
    line-height: 1;
    display: flex;
    align-items: baseline;
    justify-content: {{ section.settings.count_alignment }};
  }

  @media (max-width: 800px) {
    #loudecoms-{{ section.id }} .loudecoms-col h3 {
      font-size: {{ section.settings.mobile_count_size }}px;
    }
  }

  #loudecoms-{{ section.id }} .loudecoms-col p {
    padding: 0;
    margin: 0;
    color: {{ section.settings.description_text_color }};
    text-align: {{ section.settings.count_alignment }};
    line-height: 1;
    font-size: {{ section.settings.description_size }}px;
    {% if section.settings.override_fonts %}
    font-family: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
    font-weight: {{ section.settings.text_font.weight }};
    {% endif %}
  }

  @media (max-width: 800px) {
    #loudecoms-{{ section.id }} .loudecoms-col p {
      font-size: {{ section.settings.mobile_description_size }}px;
    }
  }

  /* Plus Sign for Count Display */
  #loudecoms-{{ section.id }} .loudecoms-plus {
      font-size: {{ section.settings.plus_size }}px !important;
      color: {{ section.settings.count_color }} !important;
      margin-left: 5px;
  }

  {% for block in section.blocks %}
    {% if block.type == 'headline' %}
    #loudecoms-{{ section.id }} .headline-{{ block.id }} {
      font-size: {{ block.settings.size }}px;
      {% if section.settings.override_fonts %}
      font-family: {{ section.settings.headline_font.family }}, {{ section.settings.headline_font.fallback_families }};
      {% endif %}
      font-weight: {{ block.settings.font_weight }};
      {% if block.settings.line_height != 'inherit' %}line-height: {{ block.settings.line_height }};{% endif %}
      margin: 0 0 {{ section.settings.heading_subheading_gap }}px 0;
      padding: 0;
      color: {{ block.settings.color }} !important;
    }

    @media (max-width: 800px) {
      #loudecoms-{{ section.id }} .headline-{{ block.id }} {
        font-size: {{ block.settings.mobile_size }}px;
        margin: 0 0 {{ section.settings.mobile_heading_subheading_gap }}px 0;
      }
    }
    {% elsif block.type == 'subheadline' %}
    #loudecoms-{{ section.id }} .subheadline-{{ block.id }} {
      font-size: {{ block.settings.size }}px;
      {% if section.settings.override_fonts %}
      font-family: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
      font-weight: {{ section.settings.text_font.weight }};
      {% endif %}
      {% if block.settings.line_height != 'inherit' %}line-height: {{ block.settings.line_height }};{% endif %}
      margin: 0;
      padding: 0;
      color: {{ block.settings.color }};
    }

    @media (max-width: 800px) {
      #loudecoms-{{ section.id }} .subheadline-{{ block.id }} {
        font-size: {{ block.settings.mobile_size }}px;
      }
    }
    {% endif %}
  {% endfor %}

  {%- endcapture -%}
  {%- liquid
    assign chunks = sp_content | strip_newlines | split: ' ' | join: ' ' | split: '*/'
    for chunk in chunks
      assign mini = chunk | split: '/*' | first | strip | replace: ': ', ':' | replace: '; ', ';' | replace: '} ', '}' | replace: '{ ', '{' | replace: ' {', '{' | replace: ';}', '}'
      echo mini
    endfor
  %}
</style>

<div id="loudecoms-{{ section.id }}" class="loudecoms-section" loudecoms-section>
  <div class="loudecoms-container" loudecoms-container>
    <div class="loudecoms-headline">
      {% for block in section.blocks %}
        {% if block.type == 'headline' %}
          <h2 class="headline-{{ block.id }}">{{ block.settings.content }}</h2>
        {% elsif block.type == 'subheadline' %}
          <p class="subheadline-{{ block.id }}">{{ block.settings.content }}</p>
        {% endif %}
      {% endfor %}
    </div>

    <div class="loudecoms-grid">
      {% for block in section.blocks %}
        {% if block.type == 'count_box' %}
          <div class="loudecoms-col">
            <h3>
              <span class="loudecoms-count-up" data-value="{{ block.settings.number }}">
                {{- block.settings.number -}}
              </span>
              {% if section.settings.enable_plus_sign %}
                <span class="loudecoms-plus">+</span>
              {% endif %}
            </h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<script>
  const enableDotSpacer = {{ section.settings.enable_dot_spacer | default: false | json }};
  class CountUp {
    constructor(target, endVal, options = {}) {
      this.el = typeof target === 'string' ? document.getElementById(target) : target;
      this.endVal = Math.round(Number(endVal) || 0);
      this.options = { startVal: 0, duration: 2, ...options };
      this.startVal = Math.round(this.options.startVal);
      this.frameVal = this.startVal;
      this.duration = this.options.duration * 1000;
      this.countDown = this.startVal > this.endVal;
    }
    start(callback) {
      this.startTime = null;
      this.animate(callback);
    }
    animate(callback) {
      const step = (timestamp) => {
        if (!this.startTime) this.startTime = timestamp;
        const progress = Math.min((timestamp - this.startTime) / this.duration, 1);
        this.frameVal = this.countDown
          ? this.startVal - (this.startVal - this.endVal) * progress
          : this.startVal + (this.endVal - this.startVal) * progress;
        this.printValue(Math.round(this.frameVal));
        if (progress < 1) requestAnimationFrame(step);
        else if (callback) callback();
      };
      requestAnimationFrame(step);
    }
    printValue(value) {
      let formatted = value.toLocaleString();
      if (enableDotSpacer) {
        formatted = formatted.replace(/,/g, '.');
      }
      if (this.el) this.el.textContent = formatted;
    }
  }
  function countStart(el) {
    el.querySelectorAll('.loudecoms-count-up').forEach((item) => {
      new CountUp(item, item.dataset.value).start();
    });
  }
  const el = document.querySelector('#loudecoms-{{ section.id }}');
  if (el) {
    new IntersectionObserver(([entry], observer) => {
      if (entry.isIntersecting) {
        countStart(el);
        observer.disconnect();
      }
    }, { threshold: 0.75 }).observe(el);
  }
</script>

