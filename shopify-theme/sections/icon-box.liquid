{%- liquid
  assign section_st = section.settings
  assign section_width = section_st.section_width
  assign color_scheme = section_st.color_scheme
  assign carousel_on_mobile = section_st.carousel_on_mobile
  assign items_per_row_mobile = section_st.items_per_row_mobile
  assign scroll_animation = settings.scroll_animation
-%}
{%- capture style -%}
  padding-top: {{ section_st.padding_top }}px;
  padding-bottom: {{ section_st.padding_bottom }}px;
  --section-pt: {{ section_st.padding_top }}px;
  --section-pb: {{ section_st.padding_bottom }}px;
  --gap: {{ section_st.space_between_text }}px;
  --section-pl-desktop: {{ section_st.padding_left_desktop }}px;
  --section-pr-desktop: {{ section_st.padding_right_desktop }}px;
  --section-pl-mobile: {{ section_st.padding_left_mobile }}px;
  --section-pr-mobile: {{ section_st.padding_right_mobile }}px;
{%- endcapture -%}

{% capture icon_box_style %}
  --col-gap: {{ section_st.column_gap_desktop }}px;
  --col-number: {{ section_st.items_per_row_mobile }};
  {% if section.blocks.size > 3 %}
    --col-tablet: 2;
    --col-desktop-small: 2;
  {% endif %}
  --col-desktop: {{ section.blocks.size }};
{%- endcapture -%}

<div
  id="benefits-pro-{{ section.id }}"
  class="section sec__icon-box color-{{ color_scheme }} gradient"
  style="{{ style | strip | strip_newlines }}"
>
  <div
    class="{{ section_width }}{% if section_st.mobile_full_width %} mobile-full-width{% endif %}"
    style="
      padding-left: var(--section-pl-desktop);
      padding-right: var(--section-pr-desktop);
    "
  >
    <icon-box
      class="sec__icon-box-inner grid grid-cols gap"
      data-enable="{{ carousel_on_mobile }}"
      data-mobile="{{ items_per_row_mobile }}"
      data-spacing="{{ section_st.column_gap_desktop }}"
      style="{{ icon_box_style | strip | strip_newlines }}"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign block_st = block.settings
          assign image = block_st.icon_image
          assign icon_position = ''
          if section_st.icon_position == 'top-left'
            assign icon_position = 'flex-column align-start'
          elsif section_st.icon_position == 'top-right'
            assign icon_position = 'flex-column align-end'
          elsif section_st.icon_position == 'bottom-left'
            assign icon_position = 'flex-column-reverse align-start'
          elsif section_st.icon_position == 'bottom-right'
            assign icon_position = 'flex-column-reverse align-end'
          elsif section_st.icon_position == 'left'
            assign icon_position = 'flex-row'
          elsif section_st.icon_position == 'right'
            assign icon_position = 'flex-row-reverse'
          elsif section_st.icon_position == 'top'
            assign icon_position = 'flex-column'
          elsif section_st.icon_position == 'bottom'
            assign icon_position = 'flex-column-reverse'
          endif
        -%}
        <div
          class="sec__icon-switch-slide {% if scroll_animation != 'none' %} scroll-trigger {{ scroll_animation }} {% endif %}"
          style="{% if scroll_animation != 'none' %} --animation-order: {{ forloop.index }} {% endif %}"
        >
          {% if section_st.enable_card_background %}
            <div
              class="card-background"
              style="
                width: {{ section_st.card_bg_width_desktop }}px;
                height: {{ section_st.card_bg_height_desktop }}px;
                border-radius: {{ section_st.card_bg_border_radius }}px;
                background-color: {{ section_st.card_bg_color }};
                border: {{ section_st.card_border_thickness }}px solid {{ section_st.card_border_color }};
                padding-top: {{ section_st.card_bg_padding_top }}px;
                padding-bottom: {{ section_st.card_bg_padding_bottom }}px;
              "
            >
          {% endif %}
          <div
            class="sec__icon-box-item flex {{ icon_position }}{% if section_st.icon_position == 'top' or section_st.icon_position == 'bottom' and section_st.content_alignment == 'center' %} align-center{% endif %}{% if section_st.content_alignment == 'right' %}{% if section_st.icon_position == 'top' or section_st.icon_position == 'bottom' %} align-end{% endif %}{% endif %}{% if section_st.content_alignment == 'left' %}{% if section_st.icon_position == 'top' or section_st.icon_position == 'bottom' %} align-start{% endif %}{% endif %}{% if section_st.spacing > 15 %} gap-custom-big{% else %} gap-custom{% endif %}{% if section_st.icon_position == 'top' and section_st.content_alignment == 'center' %} align-center{% endif %}"
            style="--gap: {{ section_st.spacing }};"
          >
            {%- if image != blank or block_st.custom_svg != blank -%}
              <div
                class="sec__icon-box-content-icon lh-1{% if image != blank %} w-custom max-w-100 flex-auto {% endif %}{% if section_st.icon_position == 'left' or section_st.content_alignment == 'right' %} align-self-center{% endif %}"
                style="--custom-width: {{ section_st.icon_size }}px"
              >
                {%- if image != blank -%}
                  {%- assign sizes = section_st.icon_size | append: 'px' -%}
                  {%- assign image_alt = image.alt | default: 'images' -%}
                  {% render 'responsive-image',
                    type: 'other',
                    image: image,
                    image_alt: image_alt,
                    sizes: sizes,
                    custom_widths: '185, 120, 60, 30'
                  %}
                {%- elsif block_st.custom_svg != blank -%}
                  {% if section_st.enable_svg_bg_circle %}
                    <span
                      class="svg-bg-circle"
                      style="background-color: {{ section_st.svg_bg_circle_color }}; width: {{ section_st.svg_bg_circle_size }}px; height: {{ section_st.svg_bg_circle_size }}px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;"
                    >
                      <span class="custom-svg w-custom w-custom-svg" style="color: {{ section_st.svg_icon_color }};">
                        {{ block_st.custom_svg }}
                      </span>
                    </span>
                  {% else %}
                    <span class="custom-svg w-custom w-custom-svg" style="color: {{ section_st.svg_icon_color }};">
                      {{ block_st.custom_svg }}
                    </span>
                  {% endif %}
                {%- endif -%}
              </div>
            {% endif %}
            {% if block_st.heading != blank or block_st.description != blank %}
              <div class="sec__icon-box-content text-{{ section_st.content_alignment }} word-break{% if section_st.icon_position == 'left' or section_st.content_alignment == 'right' %} align-self-center{% endif %}">
                {% if block_st.heading != blank %}
                  <h3
                    class="sec__icon-box-content-heading mt-0 fs-custom mb-custom {{ section_st.heading_font_weight }}{% if section_st.heading_uppercase %} uppercase{% endif %}"
                    style="--font-size: {{ section_st.heading_font_size }}; --space-bottom: {{ section_st.heading_spacing_bottom }}"
                  >
                    {{ block_st.heading }}
                  </h3>
                {% endif %}
                {% if block_st.description != blank %}
                  <div
                    class="sec__icon-box-content-des rich__text-m0 fs-custom {{ section_st.des_font_weight }}"
                    style="--font-size: {{ section_st.des_font_size }}; padding-left: {{ section_st.description_padding_left }}px; padding-right: {{ section_st.description_padding_right }}px;"
                  >
                    {{ block_st.description }}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </div>
          {% if section_st.enable_card_background %}
            </div>
          {% endif %}
        </div>
      {%- endfor -%}
    </icon-box>
  </div>
</div>

<style>
  /* Mobile Overrides */
  @media only screen and (max-width: 768px) {
    #benefits-pro-{{ section.id }} .card-background {
      width: {{ section_st.card_bg_width_mobile }}px !important;
      height: {{ section_st.card_bg_height_mobile }}px !important;
    }

    #benefits-pro-{{ section.id }} .sec__icon-box-inner {
      gap: {{ section_st.column_gap_mobile }}px !important;
    }

    #benefits-pro-{{ section.id }} .{{ section_width }} {
      padding-left: var(--section-pl-mobile) !important;
      padding-right: var(--section-pr-mobile) !important;
    }
  }

  /* Desktop: Ensure card backgrounds are centered */
  @media only screen and (min-width: 769px) {
    #benefits-pro-{{ section.id }} .card-background {
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>


