{% schema %}  
{
  "name": "Announcement Bar Pro 1",
  "settings": [
    {
      "type": "header",
      "content": "Announcement Messages",
      "info": "Configure the messages displayed in the announcement bar."
    },
    {
      "type": "inline_richtext",
      "id": "message_1",
      "label": "Announcement Message 1",
      "default": "FAST—FREE PACKING AND SHIPPING",
      "info": "First announcement message displayed in the bar."
    },
    {
      "type": "inline_richtext",
      "id": "message_2",
      "label": "Announcement Message 2",
      "default": "SIGN UP FOR SALE OFF YOUR FIRST ORDER",
      "info": "Second announcement message displayed in the bar."
    },
    {
      "type": "inline_richtext",
      "id": "message_3",
      "label": "Announcement Message 3",
      "info": "Optional third announcement message."
    },
    {
      "type": "inline_richtext",
      "id": "message_4",
      "label": "Announcement Message 4",
      "info": "Optional fourth announcement message."
    },
    {
      "type": "header",
      "content": "Appearance Settings",
      "info": "Customize the look and feel of the announcement bar."
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Background Type",
      "options": [
        { "value": "solid", "label": "Solid Color" },
        { "value": "gradient", "label": "Gradient" }
      ],
      "default": "solid",
      "info": "Select the type of background for the bar."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#4135F5",
      "info": "Background color when using a solid color type."
    },
    {
      "type": "color",
      "id": "gradient_start_color",
      "label": "Gradient Start Color",
      "default": "#007BFF",
      "info": "Starting color of the gradient background."
    },
    {
      "type": "color",
      "id": "gradient_end_color",
      "label": "Gradient End Color",
      "default": "#00BFFF",
      "info": "Ending color of the gradient background."
    },
    {
      "type": "range",
      "id": "gradient_angle",
      "label": "Gradient Angle (degrees)",
      "min": 0,
      "max": 360,
      "step": 10,
      "default": 90,
      "info": "Set the angle of the gradient background."
    },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Bar Height (px)",
      "min": 30,
      "max": 100,
      "step": 1,
      "default": 52,
      "info": "Adjust the height of the announcement bar."
    },
    {
      "type": "color",
      "id": "message_text_color",
      "label": "Announcement Message Text Color",
      "default": "#FFFFFF",
      "info": "Color of the announcement messages text."
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size (px)",
      "min": 12,
      "max": 100,
      "step": 1,
      "default": 15,
      "info": "Adjust the size of the announcement text."
    },

    
    {
      "type": "select",
      "id": "message_font_weight",
      "label": "Announcement Message Font Weight",
      "options": [
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semibold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "600",
      "info": "Font weight for the announcement messages."
    },

    {
      "type": "range",
      "id": "message_spacing",
      "label": "Spacing Between Messages (px)",
      "min": 10,
      "max": 50,
      "step": 1,
      "default": 22,
      "info": "Space between individual announcement messages."
    },
    {
      "type": "range",
      "id": "repetition_spacing",
      "label": "Spacing Between Repetitions (px)",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 35,
      "info": "Space between repeated cycles of messages."
    },
    {
      "type": "header",
      "content": "Animation Settings",
      "info": "Control the animations applied to the announcement bar."
    },
    {
      "type": "select",
      "id": "background_animation",
      "label": "Background Animation",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "animation1", "label": "Subtle Pulse" },
        { "value": "animation6", "label": "Blur Transition" },
        { "value": "animation7", "label": "Zoom In-Out" },
        { "value": "animation10", "label": "Opacity Change" }
      ],
      "default": "none",
      "info": "Select the animation style for the background."
    },
    {
      "type": "select",
      "id": "hover_effect",
      "label": "Hover Effect",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "grow", "label": "Grow" },
        { "value": "color_change", "label": "Color Change" }
      ],
      "default": "none",
      "info": "Effect applied when the user hovers over the bar."
    },
    {
      "type": "header",
      "content": "Font Settings",
      "info": "Customize the typography of the announcement text."
    },
    {
      "type": "checkbox",
      "id": "enable_custom_font",
      "label": "Enable Custom Font",
      "default": false,
      "info": "Toggle to enable or disable custom fonts for text."
    },
    {
      "type": "font_picker",
      "id": "announcement_font",
