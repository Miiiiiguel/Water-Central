},"testimonial_EaJVrm":{"type":"testimonial","settings":{"stars_rating":5,"testimonial_text":"I'm an athlete and needed something that really works. Sudafin is perfect: it controls sweat, eliminates odor and my skin feels smooth. I use it after training and at competitions. Definitely my favorite deodorant!","author_name":"Juan Pablo G.","author_additional_text":"Cali, Colombia"}},"testimonial_3AdjiA":{"type":"testimonial","disabled":true,"settings":{"stars_rating":5,"testimonial_text":"Excellent product. I tried several expensive deodorants and Sudafin is just as good, if not better. It lasts an incredible amount of time, doesn't stain clothes and smells great. Definitely worth every penny.","author_name":"Alejandra P.","author_additional_text":"Barranquilla, Colombia"}},"testimonial_kJbpbg":{"type":"testimonial","disabled":true,"settings":{"stars_rating":5,"testimonial_text":"I work in a very hot environment and Sudafin is a lifesaver. It keeps my skin protected without irritation, and the protection lasts my entire 12-hour shift. I recommend it to all my coworkers.","author_name":"Roberto S.","author_additional_text":"Santa Marta, Colombia"}}},"block_order":["heading_Ea9XRU","description_UQEV4Y","testimonial_E9kyYq","testimonial_zJbabz","testimonial_EaJVrm","testimonial_3AdjiA","testimonial_kJbpbg"],"name":"Testimonial 2","settings":{"top_padding_desktop":72,"bottom_padding_desktop":36,"top_padding_mobile":58,"bottom_padding_mobile":44,"vertical_margin":0,"vertical_margin_mobile":0,"section_width":90,"testimonials_space_between":20,"enable_reviewer_photo":true,"stars_shape":"stars","stars_size":"20","stars_color":"#d9c316","empty_stars_color":"#b1b1b1","testimonial_per_row":"2","testimonial_color":"#222222","testimonial_text_size":"16","testimonial_box_style":"color","testimonial_box_color":"#f8f8f8","testimonial_border_color":"#222222","testimonial_box_corner":14,"author_color":"#222222","inactive_arrows_color":"#222222","section_background":"","text_color":"#ff